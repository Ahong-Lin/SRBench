# Copy to .env.harbor at the repository root and fill the matching credentials.
# Codex uses the Responses API. Use a base URL ending at /v1, not /chat/completions.
OPENAI_API_KEY=replace_with_your_responses_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
DAYTONA_API_KEY=replace_with_your_daytona_api_key
