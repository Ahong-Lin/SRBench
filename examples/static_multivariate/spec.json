{
  "discipline": "biology",
  "integrator": "evaluate_explicit",
  "independent_variables": [
    {"symbol": "N", "range": [0.1, 100.0], "scale": "log", "n_points": 80},
    {"symbol": "R", "range": [0.2, 8.0], "scale": "linear", "n_points": 80},
    {"symbol": "T", "range": [10.0, 35.0], "scale": "linear", "n_points": 80}
  ],
  "dependent_variable": "growth",
  "parameters": [{"symbol": "r", "value": 0.7}, {"symbol": "K", "value": 120.0}, {"symbol": "h", "value": 1.2}],
  "rhs_for_integrator": "r*N*(1-N/K)*(R/(h+R))*exp(0.025*(T-20))",
  "noise": 0.0
}
