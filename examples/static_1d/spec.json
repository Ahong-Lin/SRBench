{
  "discipline": "physics",
  "integrator": "evaluate_explicit",
  "independent_variables": [{"symbol": "x", "range": [0.0, 5.0], "scale": "linear", "n_points": 5000}],
  "dependent_variable": "F",
  "parameters": [{"symbol": "k", "value": 2.0}, {"symbol": "alpha", "value": 0.08}],
  "rhs_for_integrator": "-k*x/(1 + alpha*x**2)",
  "noise": 0.0
}
