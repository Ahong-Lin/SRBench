# OpenAI-compatible Chat Completions (--provider openai)
# Put real credentials in .env, never in this template.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
# For a proxy, use its matching API key and /v1 URL (a full /chat/completions URL also works).
# Optional: 300s read timeout and one retry (at most two HTTP attempts).
# Generation correction loops do not retry transport/service failures again.
# SRBENCH_OPENAI_READ_TIMEOUT=300
# SRBENCH_OPENAI_MAX_RETRIES=1

# Anthropic Messages / Claude SDK (--provider anthropic)
ANTHROPIC_API_KEY=""
ANTHROPIC_AUTH_TOKEN=""
ANTHROPIC_BASE_URL="https://api.anthropic.com"

# OpenRouter (--provider openrouter)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# SRBENCH_OPENROUTER_READ_TIMEOUT=300
# SRBENCH_OPENROUTER_MAX_RETRIES=1

# Optional, for generate --executor daytona or Harbor --env daytona.
DAYTONA_API_KEY=""
# DAYTONA_API_URL="https://app.daytona.io/api"
# DAYTONA_TARGET="us"
