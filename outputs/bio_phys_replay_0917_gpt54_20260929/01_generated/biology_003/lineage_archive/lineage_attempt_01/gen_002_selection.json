{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The inflow to contagiousness is linear in the mature latent pool, dC_dt = progression_rate*M - clearance_rate*C, so each mature latent individual contributes the same per-capita hazard regardless of how many remain in M.",
      "child_relation": "Replace the constant per-capita progression from M to C with a state-dependent hazard that decreases as M is depleted, so the mapping from M to dC_dt bends away from a single straight line while preserving nonnegative flow.",
      "affected_inputs": [
        "M",
        "progression_rate"
      ],
      "observable_effect": "Across trajectories with the same progression_rate and clearance_rate but different realized mature-latent occupancy over time, the contagious rise and peak become more right-skewed and flatten at high M or late-stage depletion in a way a single constant-gain parent law cannot match over the full observation window."
    },
    "diagnostic_groups": [
      {
        "name": "latent_to_contagious_flux_parent",
        "expression": "progression_rate*M",
        "role": "Parent inflow from mature latent to contagious"
      },
      {
        "name": "mature_latent_occupancy",
        "expression": "M",
        "role": "Available pool eligible to become contagious"
      },
      {
        "name": "contagious_net_growth_parent",
        "expression": "progression_rate*M - clearance_rate*C",
        "role": "Parent target mapping before refinement"
      }
    ],
    "activation_condition": "Observable when the mature latent pool spans a substantial fraction of its admissible range during the 0-30 time window, so that per-capita maturation from M need not remain effectively constant over the whole trajectory.",
    "train_hidden_contrast": "In training, the same cohort progression already traverses low and moderate M where curvature can be seen in the rise and recession of C; in holdout, longer or more strongly populated mature-latent occupancy extends that same nonlinearity and accentuates the altered peak shape.",
    "continuation_path": "Recover the parent by taking the added state-dependence strength to zero, giving a constant progression hazard from M to C.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent assumes that eligibility-to-contagiousness within the mature latent compartment is perfectly memoryless with a constant per-capita hazard, even though maturation readiness within that compartment can be heterogeneous and change as the compartment is depleted.",
    "baseline_assumption": "All cohort members in the mature latent stage share the same time-independent progression hazard into contagiousness.",
    "scientific_mechanism": "Residual within-stage heterogeneity in biological readiness to begin shedding causes the effective progression hazard out of the mature latent compartment to vary with mature-latent occupancy rather than remain constant.",
    "affected_symbols": [
      "M",
      "progression_rate",
      "C",
      "clearance_rate"
    ],
    "rationale": "A realistic next refinement is to relax the constant-hazard assumption already present in the M->C transition rather than add an unrelated process. The parent target mapping uses a single gain from M to dC_dt: holding C fixed, changing M changes dC_dt with constant slope progression_rate. That is a scientific shortcut because the mature latent stage aggregates individuals with differing readiness to become contagious. Under the same no-new-infections cohort protocol and fixed clearance mechanism, this heterogeneity appears as a changed M-to-dC_dt relationship, not merely altered hidden trajectories: for equal C, the child would predict a smaller or larger incremental inflow from M depending on occupancy within M, changing the curvature of C(t), its ascent, and its peak timing/shape. The contrast is observable when M is appreciably populated and then depleted over the sampled interval; if M stays near zero throughout, the effect is weak and should not be overstated. No new state is necessary because the omitted idealization concerns the mathematical form of an existing transition, and a scientifically meaningful parent limit exists when the occupancy dependence vanishes."
  },
