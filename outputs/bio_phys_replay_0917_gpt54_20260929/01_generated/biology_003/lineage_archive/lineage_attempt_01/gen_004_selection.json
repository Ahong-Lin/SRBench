{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "The inflow to C is an instantaneous function of the current mature-latent pool M and contagious pool C, so for fixed parameters the timing of C growth is tied directly to the contemporaneous M trajectory.",
      "child_relation": "Introduce a finite-duration intermediate presymptomatic shedding stage between M and fully contagious C, so the contribution of mature latent individuals to the observed C rate is delayed and filtered through an additional stage rather than appearing immediately.",
      "affected_inputs": [
        "M",
        "C",
        "progression_rate",
        "clearance_rate"
      ],
      "observable_effect": "At fixed initial conditions and progression/clearance scales, the rise of C is delayed and the peak occurs later and can be broader; early-time C growth is weaker even when M is already substantial."
    },
    "diagnostic_groups": [
      {
        "name": "latent_to_contagious_balance",
        "expression": "progression_rate*M/(clearance_rate + progression_rate*(1 + maturation_heterogeneity*M)*(1 + contagious_feedback*C))",
        "role": "Compares the available mature-latent supply to the characteristic removal and transition timescale, indicating when an added pre-contagious phase can visibly delay C buildup."
      },
      {
        "name": "feedback_load",
        "expression": "contagious_feedback*C",
        "role": "Dimensionless strength of contemporaneous suppression of progression, useful for separating delay-induced timing shifts from direct feedback suppression."
      }
    ],
    "activation_condition": "Observable when the added intermediate-stage residence time is not negligible relative to 1/clearance_rate and the cohort is observed during the rise and peak of C; especially when M accumulates early from large initial L and then drains into later contagiousness.",
    "train_hidden_contrast": "Within the observed no-new-infection cohort, training trajectories with different progression_rate and clearance_rate values already vary the latent-to-clearance timescale ratio; adding an intermediate shedding phase produces a systematic later, smoother C response across those conditions and remains visible in holdout on the same observation window.",
    "continuation_path": "Recover the parent law in the limit that the intermediate-stage residence time tends to zero, collapsing the added phase into instantaneous entry to C.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A genuine delay in appearance of observed contagious individuals cannot be represented by refitting existing fixed hazards alone without introducing memory; one additional state is the minimal ODE embedding of that finite residence-time stage.",
    "gap_statement": "The current model assumes individuals who leave the mature latent compartment become fully counted in C immediately, omitting a biologically plausible short presymptomatic shedding or partially contagious phase that delays entry into the observed contagious class.",
    "baseline_assumption": "Progression from mature latent eligibility to the tracked contagious compartment is instantaneous once the M-to-C transition fires.",
    "scientific_mechanism": "After maturation, infected people may pass through a finite-duration early shedding stage before reaching the fully observable contagious state, creating an additional transit delay and smoothing between latent readiness and counted contagious prevalence.",
    "affected_symbols": [
      "M",
      "C",
      "progression_rate",
      "clearance_rate"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-phase assumption for latent-to-contagious progression. Vary progression_rate and clearance_rate across admissible cohort conditions while holding the initial conditions and the no-new-infection protocol fixed. In the parent, once M is present, the same transition term immediately drives C, so one shared parameter set yields a tightly linked M-to-C timing relationship. In the child, a finite intermediate phase shifts and smooths that transfer, so C can rise later and peak later even when the M trajectory is similar. This is a direct change in the scored target mapping dC_dt because the inflow to C is no longer an instantaneous algebraic function of M alone. The contrast is observable when the intermediate residence time is comparable to the contagious clearance timescale and the observation window includes the ascending and peak portions of C. A single parent parameter set cannot generally reproduce both an early buildup of M and a systematically delayed, broadened C response across such conditions, because changing progression_rate only rescales both M production and immediate C inflow together rather than inserting an additional dynamical lag. Limitation: if the intermediate stage is extremely short relative to all sampled timescales, the refinement collapses back to the parent and will not be distinguishable."
  },
