{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target mapping is linear in arterial pressure for fixed heart rate: dP_a_dt = (stroke_volume*H/seconds_per_minute)/arterial_compliance - P_a/(systemic_vascular_resistance*arterial_compliance), so vascular runoff has one constant slope with respect to P_a.",
      "child_relation": "Relax constant arterial compliance so effective pressure storage changes with P_a; then the same net inflow-outflow is divided by a pressure-dependent compliance, making the dP_a_dt versus P_a relationship curved rather than a single straight line even when H is held fixed.",
      "affected_inputs": [
        "P_a",
        "H",
        "arterial_compliance"
      ],
      "observable_effect": "Across otherwise identical perturbations that visit lower versus higher pressure ranges, pressure decays faster per mmHg at high P_a than predicted by one shared linear runoff/storage slope, yielding asymmetric return-to-baseline curvature in dP_a_dt versus P_a."
    },
    "diagnostic_groups": [
      {
        "name": "cardiac_inflow",
        "expression": "stroke_volume*H/seconds_per_minute",
        "role": "cardiac volume inflow to the arterial compartment"
      },
      {
        "name": "vascular_outflow",
        "expression": "P_a/systemic_vascular_resistance",
        "role": "systemic runoff from the arterial compartment"
      },
      {
        "name": "pressure_storage_ratio",
        "expression": "P_a/arterial_compliance",
        "role": "scale comparing pressure level to nominal arterial storage capacity"
      }
    ],
    "activation_condition": "Observable when perturbations move P_a far enough from the set point that arterial wall stiffening over the visited pressure range is not negligible, while remaining within a short-term regime where stroke volume and systemic vascular resistance can still be treated as fixed.",
    "train_hidden_contrast": "In training, moderate perturbations may already show slight asymmetry between recovery from above versus below baseline; in holdout, larger excursions amplify this same pressure-dependent storage effect rather than introducing a different mechanism.",
    "continuation_path": "Recover the parent law in the limit of pressure-independent compliance over the sampled range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes arterial compliance is constant across the entire sampled pressure excursion, so each added mmHg stores the same volume regardless of pressure.",
    "baseline_assumption": "Arterial compliance is constant over the sampled pressure range.",
    "scientific_mechanism": "Pressure-dependent arterial stiffening makes compliance decrease as arterial pressure rises, altering how net inflow translates into pressure change.",
    "affected_symbols": [
      "P_a",
      "H",
      "arterial_compliance"
    ],
    "rationale": "A realistic next refinement is to relax the constant-compliance idealization already present in the pressure equation. In the parent, with H fixed, dP_a_dt changes with P_a through a single linear slope because runoff is proportional to P_a and storage capacity is constant. In the child, the pressure-to-storage map acquires curvature because higher pressure corresponds to a stiffer arterial compartment and therefore a smaller effective compliance. The varied condition is the size of the pressure excursion after the brief perturbation; held fixed are stroke_volume, systemic_vascular_resistance, and the same heart-rate feedback law. The concrete contrast is that high-pressure segments of the trajectory show larger-magnitude pressure decay per unit net flow than low-pressure segments, so one shared parent parameter set cannot match both near-baseline and elevated-pressure dP_a_dt versus P_a behavior if the sampled range is broad enough. This changes the scored target mapping directly, not merely an auxiliary trajectory. The effect is admissible in short baroreflex experiments because arterial stiffening is immediate and mechanical, but it may be weak if perturbations remain very small around the set point; in that small-signal limit the parent is a good approximation."
  },
