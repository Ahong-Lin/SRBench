{
  "plan": {
    "operation": "add_term",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With uniform fields and no dissipation, dv_x_dt depends only on the instantaneous Lorentz-force factor q/(m*sqrt(1-(v_x**2+v_y**2)/signal_speed**2)) multiplying electric_field_x + magnetic_field_z*v_y, so at fixed fields the target acceleration is set solely by the current transverse velocity state.",
      "child_relation": "Add radiation-reaction damping from accelerated charge motion in crossed fields, so dv_x_dt gains a speed- and field-dependent opposing contribution. The target mapping then depends not only on the Lorentz drive but also on the acceleration-induced energy-loss scale, bending the approach to high-speed motion and reducing late-time acceleration more strongly when electric_field_x and magnetic_field_z are larger.",
      "affected_inputs": [
        "v_x",
        "v_y",
        "electric_field_x",
        "magnetic_field_z",
        "signal_speed",
        "particle_charge",
        "particle_mass"
      ],
      "observable_effect": "Holding particle_charge, particle_mass, and signal_speed fixed while varying field strength, the child predicts stronger late-time flattening and lower attainable transverse speed under stronger fields than the parent, beyond the parent's relativistic saturation alone."
    },
    "diagnostic_groups": [
      {
        "name": "beta2",
        "expression": "(v_x**2 + v_y**2)/signal_speed**2",
        "role": "dimensionless relativistic speed controlling inertial enhancement"
      },
      {
        "name": "lorentz_drive_x",
        "expression": "electric_field_x + magnetic_field_z*v_y",
        "role": "instantaneous transverse x Lorentz driving term"
      },
      {
        "name": "cyclotron_scale",
        "expression": "particle_charge*magnetic_field_z/particle_mass",
        "role": "magnetic turning-rate scale that sets transverse acceleration magnitude"
      }
    ],
    "activation_condition": "Observable when the particle experiences sustained transverse acceleration in sufficiently strong electric and/or magnetic fields so radiation losses are not negligible over the modeled time window, while still remaining below signal_speed.",
    "train_hidden_contrast": "Across trajectories with the same initial conditions and particle constants but different field amplitudes, training already shows that stronger forcing produces extra downward bending of dv_x_dt versus speed; in holdout at larger field magnitudes this curvature enhancement becomes more pronounced rather than remaining a simple rescaling.",
    "continuation_path": "In the weak-radiation limit, equivalently over short times or low acceleration where the damping coefficient tends to zero, the successor reduces continuously to the parent relativistic Lorentz-force law.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model omits radiation reaction: an accelerating charge in electromagnetic fields radiates and loses energy-momentum, which feeds back as a damping correction to the transverse acceleration.",
    "baseline_assumption": "Collisions, radiation reaction, gravity, and field back-reaction are neglected.",
    "scientific_mechanism": "Radiative energy loss from accelerated charged-particle motion in crossed electric and magnetic fields introduces self-damping that opposes the Lorentz-driven acceleration.",
    "affected_symbols": [
      "v_x",
      "v_y",
      "electric_field_x",
      "magnetic_field_z",
      "particle_charge",
      "particle_mass",
      "signal_speed"
    ],
    "rationale": "A natural next refinement is to relax the explicit neglect of radiation losses. The parent target mapping has a fixed-environment shortcut: once the uniform fields and constants are set, dv_x_dt is determined only by the instantaneous Lorentz drive and relativistic inertia, so stronger fields mainly rescale the acceleration before relativistic saturation. Vary electric_field_x and/or magnetic_field_z across admissible trajectories while holding particle_charge, particle_mass, signal_speed, and initial conditions fixed. Then compare the dv_x_dt-versus-speed trend over time. The child with radiation reaction predicts an additional field-strength-dependent suppression of dv_x_dt that grows with acceleration, producing more pronounced downward curvature and a lower late-time speed ceiling than the parent can reproduce with one shared parameter set, because the parent has no mechanism tying extra damping specifically to acceleration strength at fixed speed. This effect is scientifically admissible when acceleration is sustained long enough and fields are strong enough for radiative losses to accumulate, but it may be weak in low-field or short-duration data; in that weak-loss regime the parent is recovered."
  },
