{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target mapping is the difference of two local emigration fluxes, each increasing quadratically with its own patch abundance through a single shared crowding coefficient, so the imbalance-relaxation strength grows without bound as densities rise.",
      "child_relation": "Replace the unbounded linear-in-density crowding effect on per-capita emigration with a saturating crowding response, so the net exchange still depends on both patch abundances but the increase in imbalance-relaxation strength bends over at high abundance.",
      "affected_inputs": [
        "N1",
        "N2",
        "crowding_sensitivity"
      ],
      "observable_effect": "For the same total population size, increasing crowding strengthens |dN1_dt| strongly at moderate densities, but this acceleration weakens at high densities instead of continuing with the parent's quadratic growth."
    },
    "diagnostic_groups": [
      {
        "name": "imbalance",
        "expression": "N2 - N1",
        "role": "Signed spatial abundance difference driving net movement direction"
      },
      {
        "name": "total_abundance",
        "expression": "N1 + N2",
        "role": "Conserved crowding scale setting whether density effects are moderate or near saturation"
      },
      {
        "name": "local_crowding_contrast",
        "expression": "N2*(1 + crowding_sensitivity*N2) - N1*(1 + crowding_sensitivity*N1)",
        "role": "Parent-law density-amplified flux contrast to be replaced by a saturating version"
      }
    ],
    "activation_condition": "Observable when the conserved total abundance is large enough that crowding modifies emigration appreciably, especially when crowding_sensitivity*(N1+N2) is not small; at very low densities the child should reduce close to the parent low-density behavior.",
    "train_hidden_contrast": "Across trajectories with different initial imbalance but the same conserved total abundance, both models predict relaxation toward equal abundances; the hidden contrast appears when comparing low-versus-high total-abundance regimes, where the parent implies ever-steepening density amplification but the child predicts diminishing returns in |dN1_dt| at high crowding.",
    "continuation_path": "In the weak-crowding limit, or when the saturation scale is taken very large so the crowding correction remains in its near-linear regime over the observed abundances, the child recovers the parent law approximately.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes crowding increases per-capita emigration indefinitely with local abundance, which is unrealistic if movement decisions, exit sites, or behavioral responses saturate.",
    "baseline_assumption": "The already-present density-dependent dispersal effect is modeled as an unbounded linear increase in per-capita emigration with local density.",
    "scientific_mechanism": "Saturating crowding-driven emigration: local interference or finite behavioral responsiveness causes the density effect on dispersal propensity to level off at high patch occupancy.",
    "affected_symbols": [
      "N1",
      "N2",
      "crowding_sensitivity",
      "dispersal_rate"
    ],
    "rationale": "A realistic next refinement is to relax the mathematical form of the existing crowding effect rather than add a new process. The parent response relationship uses one shared gain-like crowding coefficient to amplify emigration ever more strongly as either patch becomes denser, so for fixed imbalance the predicted target magnitude can keep curving upward with total abundance. Holding dispersal_rate fixed and comparing conditions with similar imbalance direction but increasing conserved total abundance, the child instead predicts that the effect of extra crowding on dN1_dt eventually weakens because emigration propensity cannot increase indefinitely. This is a change in the scored target mapping itself, not only in an auxiliary trajectory, since dN1_dt as a function of observed N1 and N2 changes curvature. The admissible observable regime is finite but realistic: moderate-to-high occupancy where crowding matters, while still preserving nonnegativity, conservation, and symmetric relaxation toward balance. The limitation is that if all observations remain in a weak-crowding range, the distinction from the parent may be hard to detect."
  },
