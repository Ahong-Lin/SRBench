{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The infectious growth term is bilinear in S and I with a constant transmission rate beta, so for fixed total population and fixed I the target dI_dt changes linearly with S and has a single epidemic threshold set by beta*S/(S+I+R)=gamma.",
      "child_relation": "Replace constant per-contact transmission with a saturating transmission efficiency at high infectious prevalence, so dI_dt depends nonlinearly on I through the force of infection; for fixed total population and S, added infectious individuals produce diminishing incremental growth.",
      "affected_inputs": [
        "S",
        "I",
        "beta"
      ],
      "observable_effect": "Across trajectories with similar S but different I, the parent predicts proportional scaling of the infection term with I, whereas the child predicts sublinear growth and a flatter approach to the epidemic peak when I is no longer small."
    },
    "diagnostic_groups": [
      {
        "name": "susceptible_fraction",
        "expression": "S/(S + I + R)",
        "role": "Remaining transmission opportunity in the closed population"
      },
      {
        "name": "infectious_fraction",
        "expression": "I/(S + I + R)",
        "role": "Crowding level of infectious individuals that can activate transmission saturation"
      },
      {
        "name": "net_growth_margin",
        "expression": "beta*S/(S + I + R) - gamma",
        "role": "Parent-model instantaneous growth margin before saturation correction"
      }
    ],
    "activation_condition": "Observable when infectious prevalence is not negligible, i.e. I/(S+I+R) reaches moderate values during the sampled outbreak so that transmission efficiency can decrease with further increases in I; at low prevalence the child should closely match the parent.",
    "train_hidden_contrast": "Early outbreak data with small I remain approximately bilinear in both models, while later outbreak segments at higher I reveal reduced incremental growth per infectious individual and a lower, broader peak under the child mechanism.",
    "continuation_path": "In the limit of vanishing saturation strength, the transmission law reduces to the parent constant-beta mass-action form.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes each additional infectious person contributes the same marginal transmission opportunity regardless of how many infectious people are already present.",
    "baseline_assumption": "Transmission and removal rates are constant over time, with transmission entering as a strictly bilinear homogeneous-mixing term beta*S*I/(S+I+R).",
    "scientific_mechanism": "Behavioral/contact saturation or repeated-contact redundancy at higher infectious prevalence, causing effective transmission per infectious individual to diminish as I increases.",
    "affected_symbols": [
      "S",
      "I",
      "beta"
    ],
    "rationale": "A realistic next refinement is to relax the idealized bilinear transmission assumption without changing the closed-population bookkeeping. In the parent target mapping, holding total population and S fixed makes the infection term increase proportionally with I, so the slope of dI_dt with respect to I is effectively constant apart from the linear removal term. That creates a single-threshold, single-phase response: infectious growth rises and then declines only because S depletes. A scientifically plausible child instead lets transmission efficiency saturate when infectious prevalence becomes appreciable, representing repeated contacts with the same susceptible people or crowding/behavioral limits on distinct risky encounters. Under admissible conditions already reachable from the given initial state, early times with I small should still follow the parent closely, but later when I/(S+I+R) is moderate the child gives smaller marginal increases in new infections from additional I. With S held similar across such times or trajectories, the parent with one shared parameter set cannot reproduce both the near-linear early regime and the later sublinear regime because its infection term remains bilinear in I throughout. This changes the scored target mapping dI_dt itself, not merely auxiliary trajectories. The refinement preserves nonnegativity and fixed total population and does not require a new state if represented as a saturating modification of transmission."
  },
