{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed S, I, R, and beta, the target depends on infectious prevalence through one hyperbolic saturation factor, so incidence rises with S*I/N and is damped by a single prevalence-dependent denominator before linear removal.",
      "child_relation": "Retain the same mass-action and prevalence-saturation structure but relax the assumption of linear removal by allowing infectious removal pressure to increase with infectious burden, so the target acquires stronger downward curvature as I/N grows even when transmission-side quantities are held fixed.",
      "affected_inputs": [
        "S",
        "I",
        "R",
        "beta",
        "gamma"
      ],
      "observable_effect": "Two times with similar transmission-side state (similar beta and S/N) but different I/N can show disproportionately faster decline of dI_dt at higher I in the child because the loss term steepens with burden, whereas the parent can only change decline linearly in I."
    },
    "diagnostic_groups": [
      {
        "name": "N",
        "expression": "S + I + R",
        "role": "Closed-population size used to form prevalence and normalize force of infection"
      },
      {
        "name": "sus_frac",
        "expression": "S/(S + I + R)",
        "role": "Remaining susceptible fraction controlling depletion-driven transmission reduction"
      },
      {
        "name": "inf_frac",
        "expression": "I/(S + I + R)",
        "role": "Infectious prevalence determining both existing transmission saturation and proposed burden-dependent removal deviation"
      },
      {
        "name": "foi_parent",
        "expression": "beta*S*I/((S + I + R)*(1 + alpha*I/(S + I + R)))",
        "role": "Parent infection inflow term to compare against altered outflow curvature"
      }
    ],
    "activation_condition": "Observable when infectious prevalence is not negligible, so isolation/recovery throughput or symptom-triggered removal intensifies with burden; practically at moderate to high I/(S+I+R), while at low prevalence the child should reduce to near-linear removal.",
    "train_hidden_contrast": "During observed outbreak trajectories, early low-prevalence growth remains close to the parent, but around and after the incidence peak the child permits sharper turnover of dI_dt versus I/N at similar beta and S/N; this same burden-dependent curvature extends into holdout segments with larger outbreak peaks.",
    "continuation_path": "In the limit of vanishing burden dependence in removal, the child collapses back to the parent law with removal approximately gamma*I.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes removal from the infectious class is strictly first-order in I, omitting plausible prevalence-dependent acceleration of recovery/isolation processes during acute outbreaks.",
    "baseline_assumption": "Removal can be represented by a constant per-capita rate gamma that does not depend on infectious burden.",
    "scientific_mechanism": "Burden-dependent removal or isolation intensity, where rising case numbers increase case finding, symptom recognition, self-isolation, or operational throughput enough to make effective infectious exit faster than linear in I over part of the outbreak.",
    "affected_symbols": [
      "I",
      "gamma",
      "S",
      "R",
      "beta"
    ],
    "rationale": "A realistic next refinement is to relax the linear-removal assumption rather than add a wholly new compartment. The parent already includes one nonlinear prevalence effect on the transmission side, but its target mapping still has a single-phase decline mechanism: once S, R, and beta are specified, the only infectious-burden effect beyond the inflow saturation is the linear term -gamma*I. Varying I while holding beta and S/(S+I+R) approximately fixed therefore changes dI_dt with fixed removal slope from the loss term. In many acute outbreaks, however, larger infectious burden can increase effective exit from infectiousness through stronger symptom-triggered isolation, faster detection, or intensified response, creating extra downward curvature in dI_dt as I/(S+I+R) rises. This is scientifically admissible in a closed-population SIR setting because it redistributes flow only from I to R and preserves nonnegativity and population conservation. The contrast is observable along the actual trajectory near moderate or high prevalence: compared at similar beta and susceptible fraction, the child predicts a sharper fall or earlier rollover in dI_dt at larger I/N than the parent with one shared parameter set can reproduce, since the parent can steepen decline only by globally changing gamma or altering transmission for all phases. At low prevalence the refinement should be weak, preserving the parent as a valid limiting case."
  },
