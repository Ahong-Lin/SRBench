{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "The infectious growth term depends only on the current compartment sizes through prevalence-dependent transmission saturation, so for a given (S,I,R) the target dI_dt is time-invariant apart from depletion-driven movement along the outbreak trajectory.",
      "child_relation": "The transmission rate is allowed to relax over outbreak time through endogenous contact reduction or operational response, so the same compartment configuration can yield a smaller dI_dt later than earlier in the outbreak.",
      "affected_inputs": [
        "S",
        "I",
        "R",
        "beta"
      ],
      "observable_effect": "Holding the observed compartment counts approximately fixed across comparable prevalence windows, the decline in dI_dt can occur earlier and more strongly than susceptible depletion alone predicts; the epidemic peak is shifted earlier and the descending branch is steeper even before S becomes very small."
    },
    "diagnostic_groups": [
      {
        "name": "prevalence",
        "expression": "I/(S + I + R)",
        "role": "infectious fraction controlling existing transmission saturation"
      },
      {
        "name": "susceptible_fraction",
        "expression": "S/(S + I + R)",
        "role": "remaining transmission opportunity under depletion"
      },
      {
        "name": "force_parent",
        "expression": "beta*S*I/((S + I + R)*(1 + alpha*I/(S + I + R)))",
        "role": "parent infection inflow before allowing time-varying transmission intensity"
      }
    ],
    "activation_condition": "Observable when outbreak duration is long enough for transmission behavior or operational response to change on a timescale comparable to infection and removal, i.e. not in extremely fast outbreaks where beta is effectively constant over the sampled window.",
    "train_hidden_contrast": "In training, depletion and saturation already bend growth; in holdout, a delayed transmission reduction creates an additional late-time suppression of dI_dt at similar prevalence, extending the same within-outbreak mechanism beyond what one fixed beta can match.",
    "continuation_path": "Recover the parent law when the transmission-rate state remains constant over time, equivalently in the zero-relaxation or zero-response limit so beta stays fixed at its initial value.",
    "freedom_change": "parameter_to_state",
    "promoted_symbol": "beta",
    "promotion_reason": "A fixed beta cannot represent within-outbreak evolution of contact or control intensity while preserving the closed-population SIR bookkeeping. Promoting beta to a state is the minimal way to encode endogenous time variation without adding external inputs unavailable in the contract.",
    "gap_statement": "The model assumes transmission intensity is constant over time, aside from prevalence saturation, but acute outbreaks often show within-outbreak attenuation of effective contact rate due to rapid behavior change or operational isolation response.",
    "baseline_assumption": "Transmission and removal rates are constant over time.",
    "scientific_mechanism": "Endogenous decay of effective transmission rate during the outbreak due to adaptive contact reduction or strengthening isolation practices.",
    "affected_symbols": [
      "S",
      "I",
      "R",
      "beta"
    ],
    "rationale": "A realistic next refinement is to relax the constant-transmission assumption rather than add a new compartment process. The parent target mapping is effectively fixed-environment: once S, I, and R are specified, dI_dt is fully determined by one shared beta, gamma, and alpha. Varying time along the outbreak while holding compartment composition approximately fixed gives no additional variation in the parent's target. In the child, beta can decrease during the outbreak, so the mapping from observed states to dI_dt acquires a phase dependence: at the same or very similar (S,I,R), later times can have lower infection inflow and thus lower dI_dt. This changes the scored target directly, not just auxiliary trajectories, because dI_dt itself is altered for supplied S, I, R histories. The contrast is scientifically admissible when outbreak response evolves over days to weeks, especially at moderate prevalence where the existing alpha-saturation is active but not dominant; then the child can produce an earlier peak and faster downturn than the parent with a single fixed beta. A single refitted parent parameter set cannot reproduce both early high growth and later extra suppression across such conditions if the observed S depletion is insufficient, because with fixed beta any additional downturn must come only through lower S or higher I-induced saturation already encoded by alpha. Limitation: if the outbreak is too short for contact behavior or operations to change appreciably, the promoted beta state would remain nearly constant and the parent may already suffice."
  },
