{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With fixed environment, p_inf depends on D and tau through a single monotone cumulative-burden adaptation law: increasing D or tau always moves risk along one shared smooth saturation shape set by gamma_adapt, gamma_spread, beta_inf, and kappa_inf.",
      "child_relation": "Replace the current adaptation kernel's implicit assumption of indefinitely increasing cumulative effective contact opportunity with a stronger burden-dependent attenuation of incremental infection opportunity, so that high-D short exposures and low-D long exposures with similar D*tau no longer lie on the same curvature family.",
      "affected_inputs": [
        "D",
        "tau",
        "q",
        "gamma_adapt",
        "gamma_spread"
      ],
      "observable_effect": "At low burden the child matches the parent, but once gamma_adapt*D*tau is order 1 or larger, risk rises less with further tau at high D than the parent predicts, producing stronger concavity in tau and a dose-dependent distortion of iso-risk curves."
    },
    "diagnostic_groups": [
      {
        "name": "burden",
        "expression": "gamma_adapt*D*tau",
        "role": "dimensionless cumulative adaptation burden controlling when within-episode susceptibility loss becomes appreciable"
      },
      {
        "name": "effective_challenge",
        "expression": "beta_inf*q*D*tau",
        "role": "baseline infection-driving exposure scale before strong adaptation"
      },
      {
        "name": "intensity",
        "expression": "gamma_adapt*D",
        "role": "instantaneous susceptibility-depletion pressure distinguishing short intense from long mild exposure"
      }
    ],
    "activation_condition": "Observable when environmental conditions are fixed and D and tau are varied such that gamma_adapt*D*tau is not small, especially comparing higher-intensity shorter episodes against lower-intensity longer episodes at similar cumulative dose D*tau.",
    "train_hidden_contrast": "In training, moderate variation in D and tau already reveals monotone but intensity-dependent bending; in holdout, the same mechanism extends to more extreme high-D or long-tau regimes where attenuation of added exposure becomes stronger without changing the low-burden limit.",
    "continuation_path": "Recover the parent law in the weak-adaptation limit gamma_adapt*D*tau << 1, or by taking the added nonlinear attenuation back to the parent's current kernel form.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model treats acute susceptibility depletion with one specific smeared-onset form, effectively imposing a single-phase adaptation geometry for all exposure intensities once burden is summarized through the existing kernel.",
    "baseline_assumption": "Within-episode susceptibility depletion follows the current generalized-exponential burden kernel with a fixed shape across all dose-duration combinations.",
    "scientific_mechanism": "As exposure burden accumulates, remaining infectable opportunities can become progressively harder to realize than implied by the current kernel because refractory or depleted target availability compounds, strengthening attenuation of later exposure contributions.",
    "affected_symbols": [
      "D",
      "tau",
      "q",
      "gamma_adapt",
      "gamma_spread",
      "beta_inf",
      "kappa_inf"
    ],
    "rationale": "A realistic next refinement is to relax the exact mathematical form of the already-present within-episode adaptation process rather than adding a new biological pathway. The parent already includes monotone adaptation, but it forces a single response family: once D, tau, q vary under fixed environment, all risk curves are governed by one shared burden-to-opportunity transform. The scientific gap is that target depletion/refractoriness may intensify as susceptible opportunities are consumed, causing later increments of exposure to contribute less than the current kernel allows. This changes the scored target mapping itself, not only an auxiliary latent trajectory: for the same fixed q and environment, varying D and tau can reveal that high-dose short episodes flatten with tau more sharply than lower-dose longer episodes of similar D*tau. A single refit of the parent parameters cannot generally reproduce both the low-burden near-parent behavior and the stronger high-burden curvature if the discrepancy is specifically an intensity-dependent reshaping rather than a global gain or timescale shift. The effect is admissible and observable when gamma_adapt*D*tau is around 1 or larger; for very small burden the distinction is weak, which is also the natural continuation path back to the parent."
  },
