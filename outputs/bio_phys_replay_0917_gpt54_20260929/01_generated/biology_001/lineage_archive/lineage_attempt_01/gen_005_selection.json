{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed q, risk rises monotonically with cumulative exposure through one adaptation phase whose attenuation strength changes smoothly with D but has a single shared curvature pattern over tau.",
      "child_relation": "Keep the same monotone saturation structure but replace the current adaptation kernel with a steeper late-exposure attenuation law, so risk initially follows the parent at short tau and low burden, then bends over more sharply at longer tau when cumulative burden is high.",
      "affected_inputs": [
        "D",
        "tau",
        "q",
        "gamma_adapt",
        "gamma_crowd"
      ],
      "observable_effect": "For matched short-duration data, the refined model predicts stronger flattening of p_inf versus tau at high D than at low D, with a larger long-duration dose-duration interaction than the parent can realize using one shared parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "burden",
        "expression": "D*tau",
        "role": "cumulative inhaled infectious burden over the episode"
      },
      {
        "name": "adapt_load",
        "expression": "gamma_adapt*D*tau",
        "role": "dimensionless exposure burden controlling onset of within-episode susceptibility depletion"
      },
      {
        "name": "crowded_intensity",
        "expression": "gamma_crowd*gamma_adapt*D",
        "role": "instantaneous intensity scale at which high dose strengthens attenuation of later exposure"
      }
    ],
    "activation_condition": "Visible when gamma_adapt*D*tau is not small and especially when gamma_crowd*gamma_adapt*D is order 1 or larger; negligible in the low-burden short-episode regime.",
    "train_hidden_contrast": "In training, the mechanism appears as mild extra concavity of p_inf versus tau at moderate-to-high D; in holdout, the same mechanism extends to longer tau or higher D where the late-episode flattening becomes stronger.",
    "continuation_path": "Recover the parent by sending the new curvature-control refinement to its parent limit so the susceptibility-loss kernel returns to the current single-phase form.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model already includes burden-dependent susceptibility depletion, but it assumes one specific phase shape for how attenuation accumulates through the episode; it cannot represent a sharper transition from early accumulation to late refractory flattening without changing that kernel form.",
    "baseline_assumption": "Within-episode susceptibility depletion accumulates with a single fixed-shape onset law across the whole episode once dose intensity is specified.",
    "scientific_mechanism": "As readily infectable opportunities are consumed, the remaining opportunities become progressively harder to infect, causing superlinear strengthening of attenuation of later exposure contributions relative to the current kernel.",
    "affected_symbols": [
      "D",
      "tau",
      "q",
      "gamma_adapt",
      "gamma_crowd",
      "gamma_spread"
    ],
    "rationale": "Varied conditions are D and tau, with q also varying across hosts, while environmental conditions remain fixed. The parent mapping is monotone and saturating, but after fixing one parameter set it enforces one shared adaptation-phase shape: fitting early-time rise versus tau constrains the later-time flattening. A realistic refinement is to relax that shape assumption so depletion becomes more strongly self-reinforcing at high accumulated burden. Then at low D or short tau the child is close to the parent, but at high D and longer tau it shows extra concavity and earlier approach to a dose-dependent plateau. This is a changed target mapping, not merely an auxiliary reinterpretation, because p_inf(D,tau,q) itself changes observably. The contrast is admissible when gamma_adapt*D*tau is moderate to large; when burden is small the refinement should be effectively hidden and the parent recovered approximately. A single refit of existing parent parameters cannot generally reproduce both the short-tau slope and the stronger long-tau flattening across multiple D levels because the parent has only one fixed adaptation-phase geometry."
  },
