{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "slope_change",
      "parent_relation": "The parent maps ionic condition only into a saturating horizontal shift of the voltage-activation curve, while the voltage sensitivity scale slope_factor is shared across all I_cond.",
      "child_relation": "Retain the ionic-condition-dependent threshold shift but allow ionic condition to also modulate the effective steepness of activation, so the same change in I_cond can broaden or sharpen the sigmoid in addition to shifting it.",
      "affected_inputs": [
        "V",
        "I_cond"
      ],
      "observable_effect": "At two fixed ionic conditions with similar midpoint displacement, the child can show different transition widths in V, whereas the parent can only translate one common-shape curve along the voltage axis."
    },
    "diagnostic_groups": [
      {
        "name": "deltaI",
        "expression": "(I_cond - I_ref)/ionic_scale",
        "role": "normalized ionic-condition displacement from the reference environment"
      },
      {
        "name": "vshift",
        "expression": "V - (V_half + ionic_shift_max*tanh((I_cond - I_ref)/ionic_scale))",
        "role": "voltage relative to the parent ionic-condition-shifted activation center"
      },
      {
        "name": "z_parent",
        "expression": "(V - (V_half + ionic_shift_max*tanh((I_cond - I_ref)/ionic_scale)))/slope_factor",
        "role": "parent reduced voltage controlling the fixed-shape occupancy curve"
      }
    ],
    "activation_condition": "Observable when I_cond spans values differing by order ionic_scale so that surface screening or state stabilization changes are appreciable, and V is sampled through the activation flank where transition width can be estimated rather than only extreme saturations.",
    "train_hidden_contrast": "In training, moderate ionic-condition changes can already reveal unequal steepness of the activation flank; in holdout, the same mechanism extends to stronger ionic shifts where both midpoint displacement and slope modulation approach saturation together.",
    "continuation_path": "Recover the parent law when ionic-condition dependence of the slope vanishes, i.e. the effective slope becomes constant and equal to slope_factor for all I_cond.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes ionic conditions alter only the activation threshold, not the sharpness of the voltage-dependent occupancy transition.",
    "baseline_assumption": "The shared voltage-sensitivity scale slope_factor is fixed across ionic conditions after accounting for a threshold shift.",
    "scientific_mechanism": "Ionic screening or ion-dependent stabilization can change the effective field coupling and heterogeneity of sequential permissive conformational steps, making activation broader or steeper under different ionic environments even at steady state.",
    "affected_symbols": [
      "V",
      "I_cond",
      "slope_factor",
      "I_ref",
      "ionic_scale",
      "ionic_shift_max",
      "V_half"
    ],
    "rationale": "Parent response relationship: with V varied and temperature held fixed, changing I_cond only translates the composite sigmoidal activation curve through the tanh shift in its center; its flank width in voltage is otherwise identical for all ionic conditions. Child refinement: allow I_cond to modulate the effective steepness as well, creating a genuine change in the scored mapping m_inf(V,I_cond), not merely an auxiliary reinterpretation. Concrete contrast: compare two admissible ionic settings on opposite sides of I_ref while sampling V densely across the activation range. The parent with one shared parameter set can align midpoints by its shift term but cannot make one condition display a sharper rise and the other a broader rise if both remain monotone and bounded. This is scientifically admissible when ionic perturbations are large enough to alter electrostatic screening or conformational stabilization but not so large as to violate the steady-state static setting. Limitation: if experiments only sample voltages deep in the saturating tails, the slope change is weakly identifiable."
  },
