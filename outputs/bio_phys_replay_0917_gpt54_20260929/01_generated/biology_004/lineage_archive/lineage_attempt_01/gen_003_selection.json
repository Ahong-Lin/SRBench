{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "threshold_surface",
      "parent_relation": "For fixed c0 and rho, suppression begins exactly at p_trigger and then depends only on the normalized excess prevalence above that same trigger, so activation and intensity are tied to one threshold scale.",
      "child_relation": "Keep the prevalence-triggered intervention but relax the idealized assumption of exact prevalence measurement by letting the applied suppression depend on a smoothed activation around p_trigger rather than an abrupt Heaviside switch.",
      "affected_inputs": [
        "p",
        "p_trigger",
        "rho",
        "c0"
      ],
      "observable_effect": "When p is scanned through values near p_trigger with c0 and rho held fixed, the parent shows a kink with zero suppression immediately below the trigger and finite onset exactly at it, whereas the child shows partial pre-trigger activation and a rounded transition over a narrow prevalence band."
    },
    "diagnostic_groups": [
      {
        "name": "rel_prev",
        "expression": "(p - p_trigger)/p_trigger",
        "role": "normalized distance of measured prevalence from the nominal trigger"
      },
      {
        "name": "near_trigger",
        "expression": "Abs((p - p_trigger)/p_trigger)",
        "role": "proximity to the activation region where onset-shape differences are observable"
      }
    ],
    "activation_condition": "Observable when prevalence samples lie in a neighborhood of the trigger, with |p-p_trigger|/p_trigger not large; away from the trigger both parent and child approach the same inactive or saturated-active behavior.",
    "train_hidden_contrast": "Training can see ordinary above-trigger tightening, while holdout can emphasize dense sampling near the trigger; the same mechanism appears in both, but only near-threshold conditions reveal the rounded onset absent from the parent.",
    "continuation_path": "In the limit of vanishing measurement/decision smoothing width, the rounded activation recovers the parent Heaviside-triggered law.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current law assumes exact, instantaneous threshold recognition, producing an unrealistically sharp activation boundary in the scored mapping from measured prevalence to controlled contact rate.",
    "baseline_assumption": "The intervention activates immediately at the trigger with no uncertainty or smoothing in the decision boundary.",
    "scientific_mechanism": "In practice, surveillance noise, reporting aggregation, and decentralized implementation make activation probabilistic or smoothed across a narrow prevalence band around the nominal trigger.",
    "affected_symbols": [
      "p",
      "p_trigger",
      "rho",
      "c0"
    ],
    "rationale": "A realistic next refinement is to change the activation assumption rather than add a new process: the program is still prevalence-triggered and still suppresses contacts by a bounded fraction, but the onset should be rounded near the trigger instead of perfectly discontinuous. The parent target mapping uses a single hard threshold: varying p while holding c0, rho, and p_trigger fixed gives c_eff=c0 for all p<p_trigger and then an immediate departure once p reaches p_trigger. The child would instead produce a smooth threshold surface in the existing input space, so small positive and negative deviations of p around p_trigger already change c_eff. This is an observable change in the scored static mapping itself, not only in an auxiliary trajectory. A single refit of the parent parameters cannot reproduce both exact zero suppression just below threshold and partial suppression in that same near-threshold region, because the Heaviside branch structure forbids any below-trigger response. The contrast is scientifically admissible when sampled prevalence values resolve a band around p_trigger; if all observations sit far below or far above the trigger, the refinement is weakly identifiable, which should be stated rather than hidden."
  },
