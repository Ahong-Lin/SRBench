{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed c0, rho, and p_trigger, suppression above the trigger is governed by a single normalized prevalence scale x=(p-p_trigger)/p_trigger, so the active-regime approach from no suppression to approximately rho is tied to one shared rise shape.",
      "child_relation": "Keep the same trigger-centered activation but relax the assumption that post-trigger tightening follows a single-scale rise in x; instead allow weak suppression just above threshold and disproportionately stronger tightening only when prevalence is well above the trigger, changing the curvature of c_eff versus normalized excess prevalence within the active regime.",
      "affected_inputs": [
        "p",
        "p_trigger",
        "rho"
      ],
      "observable_effect": "For two admissible above-trigger conditions with the same c0, rho, and p_trigger, one just above threshold and one far above it, the child predicts closer-to-baseline contact rates near threshold but stronger suppression deeper in the active regime than the parent can match simultaneously with one refitted shape."
    },
    "diagnostic_groups": [
      {
        "name": "x_excess",
        "expression": "(p - p_trigger)/p_trigger",
        "role": "normalized excess prevalence above the nominal activation threshold"
      },
      {
        "name": "active_gate",
        "expression": "(1 + tanh((p - p_trigger)/p_trigger))/2",
        "role": "smoothed active-regime indicator already implied by the parent"
      },
      {
        "name": "supp_frac",
        "expression": "1 - c_eff/c0",
        "role": "realized suppression fraction relative to baseline contact rate"
      }
    ],
    "activation_condition": "Observable when p_trigger>0 and sampled prevalence spans from near-threshold p≈p_trigger to clearly above-threshold p>p_trigger, so curvature inside the active regime can be resolved rather than only binary on/off activation.",
    "train_hidden_contrast": "The same post-trigger curvature mechanism appears in training when comparing modest versus larger exceedance above p_trigger, and extends in holdout to more extreme exceedance where the stronger deep-active tightening becomes clearer.",
    "continuation_path": "In the limit where the revised active-regime curvature parameter recovers the parent's single-scale shape, the child reduces continuously to the current law.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes one fixed post-trigger rise shape for suppression intensity, so near-threshold and far-above-threshold responsiveness are locked together.",
    "baseline_assumption": "Compliance tightening above the trigger follows a single-scale exponential-like progression in normalized excess prevalence.",
    "scientific_mechanism": "Operational escalation is often initially cautious just after activation because enforcement and adherence are still mobilizing, then tightens more strongly once prevalence is unmistakably above the trigger, producing altered curvature within the active regime even without adding delay or a new threshold.",
    "affected_symbols": [
      "p",
      "p_trigger",
      "rho"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-shape assumption for how suppression strengthens after activation. The parent already includes smooth activation and graded intensification, but it still maps normalized excess prevalence x=(p-p_trigger)/p_trigger to suppression with one shared curvature, so if p varies while c0, rho, and p_trigger are held fixed, the near-threshold slope and the deeper active-regime approach toward maximum suppression cannot vary independently. Scientifically, implementation often remains partial immediately after the trigger is crossed, with stronger tightening only once prevalence is clearly above target. This changes the scored static mapping c_eff(p,c0,p_trigger,rho), not merely an auxiliary trajectory. The contrast is observable when sampled conditions include both slight exceedance and substantial exceedance of p_trigger: the child gives higher c_eff than the parent near activation but lower c_eff at larger exceedance, after matching the same baseline and allowable saturation. Because the parent has only one shared post-trigger shape, a single refit cannot generally reproduce both weaker early response and stronger late response across those conditions without sacrificing one region. This stays within constraints because suppression remains between 0 and rho, c_eff stays between 0 and c0, and stronger rho still cannot increase c_eff."
  },
