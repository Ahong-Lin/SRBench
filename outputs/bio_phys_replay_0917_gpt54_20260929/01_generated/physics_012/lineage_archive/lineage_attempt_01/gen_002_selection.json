{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "For fixed masses and pre-collision velocities, v1_after depends on the relative speed only through a single shared collision_efficiency factor, so changing m1:m2 rescales the same dissipation contribution without changing its efficiency law.",
      "child_relation": "Retain the same momentum-balance structure but relax the assumption of one shared collision_efficiency by making the effective restitution depend on impact partition through the existing masses, so the relative-speed loss varies with both closing speed and mass ratio.",
      "affected_inputs": [
        "m1",
        "m2",
        "v1_before",
        "v2_before",
        "collision_efficiency"
      ],
      "observable_effect": "At the same relative speed and same nominal collision_efficiency, a strongly mass-mismatched pair shows a different post-collision velocity shift than an equal-mass pair beyond the pure prefactor already present in the parent, because the effective dissipation law itself changes with mass ratio."
    },
    "diagnostic_groups": [
      {
        "name": "rel_speed",
        "expression": "Abs(v1_before - v2_before)",
        "role": "impact severity scale already driving the parent saturation"
      },
      {
        "name": "mass_ratio_sym",
        "expression": "m1*m2/(m1 + m2)**2",
        "role": "symmetric mass-partition factor distinguishing equal-mass from highly unequal collisions"
      },
      {
        "name": "impulse_prefactor",
        "expression": "m2/(m1 + m2)",
        "role": "parent kinematic leverage of dissipative impulse on v1_after"
      }
    ],
    "activation_condition": "Observable when relative speed is not near zero and the sampled masses span both near-equal and strongly unequal pairs; then mass-partition dependence of effective restitution can appear while momentum conservation remains valid.",
    "train_hidden_contrast": "Within training, varying relative speed at moderate mass ratios exposes the baseline speed dependence already present; extending to broader mass-ratio variation reveals that one shared efficiency law is insufficient because equal-mass and unequal-mass impacts bend differently as functions of closing speed.",
    "continuation_path": "Recover the parent law when the mass-partition modulation is removed so the effective restitution reduces to the constant nominal collision_efficiency for all m1,m2.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the same nominal collision efficiency applies identically to all mass ratios, even though real rigid-body impacts can show mass-partition-dependent effective restitution because deformation and contact-time losses depend on reduced mass.",
    "baseline_assumption": "The collision efficiency is fixed across all samples.",
    "scientific_mechanism": "Effective restitution depends on reduced-mass-controlled contact deformation and internal loss partition, so impact dissipation is jointly shaped by closing speed and mass ratio rather than by speed alone.",
    "affected_symbols": [
      "m1",
      "m2",
      "v1_before",
      "v2_before",
      "collision_efficiency"
    ],
    "rationale": "Parent response: with collision_efficiency fixed, the target mapping from supplied inputs to v1_after uses masses only as linear momentum weights and as the existing m2/(m1+m2) impulse prefactor; the efficiency law itself is environment-independent. Child refinement: let the effective loss law depend on mass partition, creating a genuine interaction between masses and relative speed in the scored target mapping, not merely in an auxiliary quantity. Distinguishing condition: vary m1:m2 across near-equal and highly unequal collisions while holding collision_efficiency fixed and comparing cases at similar nonzero Abs(v1_before-v2_before). The parent with one shared parameter set predicts the same normalized speed-loss law across these mass-ratio groups apart from the known prefactor, whereas the child predicts different curvature/slope of v1_after versus relative speed because effective restitution changes with reduced-mass scale. This is scientifically admissible for rigid isolated impacts with positive masses and finite velocities. Limitation: if sampled mass ratios cluster tightly or relative speeds are all very small, the contrast weakens and the parent may remain hard to distinguish."
  },
