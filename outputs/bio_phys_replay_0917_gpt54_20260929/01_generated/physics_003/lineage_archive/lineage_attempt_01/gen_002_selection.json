{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed temperature, pressure is a cubic polynomial in density with a temperature-independent third-virial correction B3, so the density curvature pattern is the same at all temperatures except for the overall rho*T prefactor and the supplied B2 variation.",
      "child_relation": "Retain the virial form but relax the assumption that B3 is constant across the sampled temperature window; let the three-body correction vary with temperature, so the rho^3 contribution changes relative weight with T.",
      "affected_inputs": [
        "rho",
        "T",
        "B2",
        "B3"
      ],
      "observable_effect": "Comparing two temperatures at the same moderate density and similar B2 scale, the child allows different excess-pressure curvature versus rho because the rho^3 coefficient changes with T; the parent with one shared B3 cannot match both curvatures simultaneously."
    },
    "diagnostic_groups": [
      {
        "name": "z2",
        "expression": "B2*rho",
        "role": "pair-correction strength relative to ideal pressure"
      },
      {
        "name": "z3",
        "expression": "B3*rho**2",
        "role": "three-body virial contribution before any temperature refinement"
      },
      {
        "name": "rhoT",
        "expression": "rho*T",
        "role": "ideal-gas pressure scale multiplying virial corrections"
      }
    ],
    "activation_condition": "Moderately dilute but not asymptotically dilute states where |B2*rho| is observable and rho^2 terms are still credible, with temperature varied enough that three-body configurational weighting changes measurably while the fluid remains homogeneous and single-phase.",
    "train_hidden_contrast": "Within training, changing T already changes the leading scale and B2 contribution; in holdout, the same T variation also changes the density-curvature of excess pressure through the third-virial piece, especially at the upper end of the admissible rho range.",
    "continuation_path": "Recover the parent law in a narrow temperature window or in the limit of negligible temperature sensitivity of the third virial coefficient, where B3 becomes effectively constant.",
    "freedom_change": "parameter_to_input",
    "promoted_symbol": "B3",
    "promotion_reason": "A fixed B3 cannot express temperature-dependent three-body cluster corrections across equilibrium states; releasing B3 as an input is the minimal added freedom needed to encode that environmental dependence without adding an unrelated variable.",
    "gap_statement": "The current model assumes the third virial correction is constant over the sampled temperatures, omitting temperature-dependent changes in three-particle configurational statistics.",
    "baseline_assumption": "Effective interaction coefficients are treated as constant over the chosen temperature window except for the explicit leading thermal factor.",
    "scientific_mechanism": "Three-body cluster integrals generally depend on temperature because Boltzmann weighting of short-range interaction geometries changes with T, altering the magnitude and sometimes sign trend of the third virial coefficient.",
    "affected_symbols": [
      "rho",
      "T",
      "B3"
    ],
    "rationale": "Parent response: at fixed T, P/(rho*T)=1+B2*rho+B3*rho^2 is a quadratic in rho with one shared B3 across all temperatures. Proposed refinement: keep the same low-density virial structure but allow B3 itself to vary between sampled equilibrium states. Vary T across an admissible stable range and compare pressure-density curves while holding the fluid identity and homogeneous single-phase conditions fixed; at moderate rho where the rho^3 pressure term matters but truncation remains credible, the child predicts temperature-dependent curvature in P versus rho beyond what comes from the explicit prefactor and B2 alone. A single refitted constant B3 can shift average curvature but cannot reproduce distinct curvature across multiple temperatures with one shared parameter set. The effect is scientifically admissible only where three-body corrections are measurable yet still small enough that higher virial orders do not dominate."
  },
