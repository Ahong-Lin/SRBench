{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed q, the dissipation equation feeds epsilon from the cascade with a term proportional to k*q/(q_saturation+q), so the k-to-depsilon_dt contribution is linear in k with one shared gain.",
      "child_relation": "Replace the linear dependence of cascade feeding on k by a nonlinear large-eddy strength dependence, so at fixed q the k-to-depsilon_dt contribution bends with k and changes relative amplification between energetic and weak-decay states.",
      "affected_inputs": [
        "k",
        "q",
        "epsilon"
      ],
      "observable_effect": "Across trajectories that differ in k while having comparable q occupancy, the child predicts stronger-than-linear dissipation feeding at high k and weaker feeding at low k, changing the curvature of epsilon(t) and therefore the subsequent decay rate of k(t)."
    },
    "diagnostic_groups": [
      {
        "name": "cascade_occupancy",
        "expression": "q/(q_saturation + q)",
        "role": "Current saturation level of delayed cascade transfer into the dissipative range"
      },
      {
        "name": "specific_dissipation",
        "expression": "epsilon/k",
        "role": "Instantaneous small-scale depletion rate relative to turbulent energy"
      },
      {
        "name": "energetic_state",
        "expression": "k",
        "role": "Large-eddy energy level controlling cascade-feed intensity in the planned refinement"
      }
    ],
    "activation_condition": "Observable when free-decay trajectories visit a broad enough range of k while q is neither negligible nor fully saturated, so the cascade-feed term materially contributes to depsilon_dt.",
    "train_hidden_contrast": "The same decay records already show early energetic stages and later weak-energy stages; the refinement uses that in-training variation and extends it to holdout trajectories with more pronounced separation between high-k and low-k cascade response.",
    "continuation_path": "Recover the parent law in the limit where the nonlinear k-dependence reduces to linear dependence over the sampled range, or exactly when the added nonlinearity parameter takes its parent-recovery value.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes cascade feeding into dissipation scales linearly with turbulent kinetic energy once q is fixed, which is an overly rigid representation of how energetic large eddies drive transfer during free decay.",
    "baseline_assumption": "The unresolved cascade feed term is proportional to k times a saturating function of q with one fixed gain.",
    "scientific_mechanism": "Energy-containing eddies can drive dissipation production with a nonlinearly varying efficiency as turbulence intensity changes, reflecting changing cascade effectiveness across decay stages even without mean shear or forcing.",
    "affected_symbols": [
      "k",
      "q",
      "epsilon",
      "C_cascade",
      "q_saturation"
    ],
    "rationale": "A realistic next refinement is to relax the parent's linear-in-k cascade-feed assumption rather than adding a wholly new process. Vary the initial decay stage or any admissible trajectory segment so that k changes substantially, while holding the modeled context fixed: homogeneous, unforced, constant-density free decay with the same q-mediated memory mechanism. In the parent, once q is specified, the cascade contribution to depsilon_dt is just a single-gain linear function of k, so one shared parameter set imposes the same proportional sensitivity at both energetic and weak stages. The child instead allows the cascade-feed sensitivity to bend with k, producing a concrete target-mapping contrast: epsilon rises or decays differently at high k versus low k even when q occupancy is similar, and this propagates into a changed k(t) decay curvature because dk_dt=-epsilon. This is observable only when the cascade-feed term is active, meaning q is in an intermediate admissible range and epsilon is not dominated entirely by its destruction term. The refinement remains scientifically admissible, preserves nonnegative-energy decay structure, and has an honest continuation back to the parent when the nonlinear dependence collapses to linear over the sampled regime."
  },
