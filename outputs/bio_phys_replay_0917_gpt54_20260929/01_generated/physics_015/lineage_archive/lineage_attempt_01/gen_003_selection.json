{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "dz_dt is proportional to y with a z-only gain factor g*(1 - saturation_strength*z**2), so at fixed observed y and g the target depends on z only through a symmetric quadratic saturation.",
      "child_relation": "retain coherent exchange through y but replace the quadratic saturation assumption by a stronger bounded odd-in-z nonlinear renormalization of the exchange channel, so the target acquires different curvature versus |z| while preserving sign reversal with y.",
      "affected_inputs": [
        "y",
        "z",
        "g",
        "saturation_strength"
      ],
      "observable_effect": "Across trajectories that pass through moderate versus near-extreme population imbalance while holding detuning and coupling parameters fixed, the slope of dz_dt versus y bends more sharply at large |z| than the parent predicts, reducing exchange near saturation without a uniform gain rescaling."
    },
    "diagnostic_groups": [
      {
        "name": "exchange_drive",
        "expression": "g*y",
        "role": "instantaneous coherent exchange drive before population-dependent suppression"
      },
      {
        "name": "imbalance_magnitude",
        "expression": "z**2",
        "role": "distance from equal population controlling saturation strength"
      },
      {
        "name": "parent_suppression",
        "expression": "1 - saturation_strength*z**2",
        "role": "current quadratic exchange-channel reduction assumed by the parent"
      }
    ],
    "activation_condition": "Most visible when trajectories explore sizable imbalance, with saturation_strength*z**2 not negligible and especially as |z| approaches its bounded limit while y remains appreciable; weak-saturation or near-z=0 segments show little contrast.",
    "train_hidden_contrast": "The same population-dependent suppression is visible in training over moderate |z|, while holdout segments extending to larger |z| reveal the stronger curvature of the child law; the effect is a continuation of the same mechanism rather than a new regime requiring unseen variables.",
    "continuation_path": "Recover the parent in the weak-nonlinearity limit where the refined saturation law is expanded to leading quadratic order in z, or when saturation_strength -> 0 so exchange becomes effectively unsuppressed.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current target law assumes the population-dependent renormalization of coherent exchange is exactly quadratic in imbalance, which is an overly specific closure for bounded two-level dressing.",
    "baseline_assumption": "Population-imbalance-dependent saturation enters only through the factor 1 - saturation_strength*z**2.",
    "scientific_mechanism": "Higher-order bounded self-saturation of the effective transition matrix element as the system approaches full population imbalance, still within reversible two-level dynamics.",
    "affected_symbols": [
      "y",
      "z",
      "g",
      "saturation_strength"
    ],
    "rationale": "A realistic next refinement is to relax the exact quadratic saturation ansatz rather than add a new process. The parent target mapping has a single-gain shortcut: once g and y are known, all z-dependence is compressed into one symmetric quadratic factor. Vary the observed imbalance magnitude along trajectories, while holding the fixed detuning, coupling_strength, dressing_strength, and dressing_relaxation_rate protocol unchanged. Then compare segments with moderate |z| against segments near |z| close to one. The parent predicts one specific curvature of dz_dt/(g*y) versus z, set by a single quadratic law, so one shared parameter set cannot simultaneously match both moderate suppression and stronger near-boundary flattening if the true exchange channel saturates more sharply but remains bounded and reversible. This changes the scored target mapping directly, not merely auxiliary trajectories, because dz_dt itself gains a different dependence on observed z at fixed observed y and g. The effect is admissible and observable only when the sampled trajectories actually visit sufficiently large |z| with non-negligible coherence y; near z=0 or for very small saturation_strength, parent and child are practically indistinguishable."
  },
