{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "separable_product",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "The parent uses a separable effective exposure term beta_inf*q*D*tau/((1 + alpha_clump*D)*(1 + gamma_att*tau)), so dose crowding and within-episode attenuation act independently and the dose-response shape as a function of D is the same at every tau up to a scalar time factor before the outer saturation.",
      "child_relation": "Refine the attenuation assumption so that later-time attenuation becomes stronger when dose is higher, making the effective contribution of added duration depend on D and producing a non-separable D-by-tau interaction inside the infection hazard.",
      "affected_inputs": [
        "D",
        "tau"
      ],
      "observable_effect": "At fixed q, increasing tau raises infection risk much less at high D than at low D, beyond what any single separable parent parameter set can match across both short and long episodes."
    },
    "diagnostic_groups": [
      {
        "name": "dose_load",
        "expression": "D",
        "role": "instantaneous inhaled infectious dose level driving crowding and competition"
      },
      {
        "name": "episode_time",
        "expression": "tau",
        "role": "exposure duration controlling cumulative opportunity and late-time attenuation"
      },
      {
        "name": "parent_hazard_core",
        "expression": "beta_inf*q*D*tau/((1 + alpha_clump*D)*(1 + gamma_att*tau))",
        "role": "current separable pre-saturation effective hazard for the episode"
      },
      {
        "name": "dose_time_product",
        "expression": "D*tau",
        "role": "cumulative exposure coordinate where dose-dependent attenuation would become visible"
      }
    ],
    "activation_condition": "Observable when gamma_att*tau is not negligible and alpha_clump*D is at least moderate, so later exposure contributes less strongly at higher dose than at lower dose; weak in the dilute short-episode regime alpha_clump*D << 1 and gamma_att*tau << 1.",
    "train_hidden_contrast": "Within training, compare short versus longer tau at low and moderate D; in holdout, extend to larger D*tau where the suppression of duration benefit at high D becomes stronger than the parent's fixed separable scaling permits.",
    "continuation_path": "Recover the parent law in the limit that the added dose dependence of attenuation vanishes, so time attenuation reverts to depending only on tau.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes that within-episode attenuation over time is independent of inhaled dose level, so dose crowding and temporal attenuation combine only multiplicatively and cannot modify each other's strength.",
    "baseline_assumption": "Relax the parent assumption that later-exposure attenuation is governed by a single tau-only factor with the same form at all dose levels.",
    "scientific_mechanism": "Higher inhaled dose can accelerate depletion of the most permissive target sites or trigger faster local defensive changes, so the marginal infectivity of later-arriving pathogens decays more rapidly during the episode when D is higher.",
    "affected_symbols": [
      "D",
      "tau",
      "gamma_att",
      "alpha_clump"
    ],
    "rationale": "Parent response: with q fixed and environment fixed, p_inf increases monotonically with D and tau, but the effect of tau is separable from D inside the hazard apart from the outer exponential saturation; equivalently, the dose-response curve at different tau values is constrained to a shared shape modulated by a single time factor. Child response: keep monotonicity but allow a dose-dependent strengthening of within-episode attenuation, so extending duration has a relatively larger effect at low D and a relatively smaller effect at high D. Distinguishing condition: vary D and tau while holding q fixed; compare the increment from tau_short to tau_long at low versus high D. In the admissible regime with moderate-to-large D and nontrivial gamma_att*tau, the child predicts compression of duration sensitivity at high D that a single refitted parent parameter set cannot reproduce across both dose strata because the parent's D and tau effects are separable in the pre-saturation hazard. Limitation: this contrast is weak in very short or very dilute exposures, where both models reduce toward the same dilute cumulative-exposure behavior."
  },
