{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed D and C, V_delta_p scales as p*(1-p) times a saturating increasing function of heterozygosity 4*p*(1-p), so the excess-variance multiplier is always concave-up-then-saturating with a single fixed saturation shape.",
      "child_relation": "Retain the same boundary zeros and N^{-1} scaling, but relax the specific Michaelis-like saturation assumption for how family-clustering modifies overdispersion, allowing a sharper mid-frequency concentration of excess variance than the parent can produce with one shared C.",
      "affected_inputs": [
        "p",
        "C",
        "D",
        "N"
      ],
      "observable_effect": "When N and D are held fixed and p varies, the child can produce a narrower, more sharply peaked inflation around intermediate p while matching weaker inflation at moderately off-center frequencies; the parent with one shared C cannot simultaneously fit both the shoulder and the center because its heterozygosity response has one fixed saturation curvature."
    },
    "diagnostic_groups": [
      {
        "name": "het",
        "expression": "4*p*(1 - p)",
        "role": "symmetric heterozygosity coordinate controlling how strongly both alleles co-occur among contributing families"
      },
      {
        "name": "infl_parent",
        "expression": "1 + D*(1 + (C*4*p*(1 - p))/(1 + C*4*p*(1 - p)))",
        "role": "current overdispersion multiplier before division by 2*N"
      },
      {
        "name": "drift_core",
        "expression": "p*(1 - p)/(2*N)",
        "role": "baseline Wright-Fisher variance scale"
      }
    ],
    "activation_condition": "Observable when D is appreciable and C*4*p*(1-p) spans sub-saturating to saturating values across the sampled p range, especially for intermediate allele frequencies away from the boundaries but not restricted to exactly p=0.5.",
    "train_hidden_contrast": "In training, variation over p already exposes the parent's single saturation shape; in holdout, the same mechanism appears as stronger center-versus-shoulder contrast under the same inputs rather than a new regime requiring unseen variables.",
    "continuation_path": "Recover the parent by returning to the specific current saturation law for heterozygosity-dependent excess variance, i.e. the sharper family-contrast refinement tends continuously back to the present Michaelis-type form in the appropriate shape limit.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model already includes clustering-dependent excess drift, but it assumes one specific low-order saturating dependence on heterozygosity, which may be too smooth to represent realistic concentration of between-family allele contrast around intermediate frequencies.",
    "baseline_assumption": "The clustering effect of reproductive overdispersion on variance inflation follows a fixed Michaelis-like saturation in the symmetric heterozygosity coordinate 4*p*(1-p).",
    "scientific_mechanism": "In finite sets of contributing families or demes, between-family allele contrast can rise more abruptly once both alleles are represented across enough lineages, giving a steeper mid-frequency amplification of overdispersed sampling than a single simple saturation curve.",
    "affected_symbols": [
      "p",
      "C",
      "D",
      "N"
    ],
    "rationale": "The parent target mapping depends on p only through p*(1-p) and a single shared saturating function of 4*p*(1-p). Vary p while holding N, D, and C fixed: the parent predicts one fixed relationship between the center peak near p=0.5 and the shoulders at intermediate off-center frequencies. A scientifically plausible refinement is to change the mathematical form of the already-present clustering modulation so that excess variance can be more concentrated near intermediate frequencies, reflecting sharper onset of lineage competition when both alleles are sufficiently represented among contributing families. This changes the scored mapping itself, not merely an auxiliary trajectory. The contrast is observable for admissible p in the interior of [0,1], especially when D>0 and C is large enough that some p values are below and others near the clustering-activation scale. A single refit of existing parent parameters cannot fully absorb a systematically sharper center-versus-shoulder pattern across p because the parent family has only one fixed saturation curvature once D and C are chosen. The refinement remains symmetric in allele labels, nonnegative, vanishes at p=0 and p=1, and can reduce continuously to the parent law."
  },
