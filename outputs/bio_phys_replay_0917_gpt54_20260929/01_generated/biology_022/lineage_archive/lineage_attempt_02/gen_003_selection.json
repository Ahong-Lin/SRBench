{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "weight_exchange",
      "parent_relation": "The bound fraction is a monotone two-subpopulation Hill mixture with a fixed high-affinity fraction frac_high_affinity that does not change across samples, so changing L only moves occupancy along one invariant curve shape.",
      "child_relation": "Keep rapid equilibrium binding but relax the assumption that the subpopulation weights are fixed: the effective high-affinity fraction becomes condition-dependent through an independently varied extracellular condition, causing the occupancy curve versus L to shift not only by affinity/steepness but by redistribution of receptor weight between high- and low-affinity branches.",
      "affected_inputs": [
        "L"
      ],
      "observable_effect": "Across conditions with different membrane/environmental context, the low-L occupancy and the shoulder between affinity branches change in a way that looks like a transfer of receptor mass from the low-affinity to the high-affinity component; one shared parent parameter set with fixed frac_high_affinity cannot match both curves simultaneously."
    },
    "diagnostic_groups": [
      {
        "name": "logL_over_Kd",
        "expression": "log(L/K_d)",
        "role": "Position of ligand concentration relative to the high-affinity transition"
      },
      {
        "name": "logL_over_Kd_low",
        "expression": "log(L/K_d_low)",
        "role": "Position relative to the low-affinity transition"
      },
      {
        "name": "affinity_separation",
        "expression": "log(K_d_low/K_d)",
        "role": "Extent to which two occupancy phases are resolvable"
      }
    ],
    "activation_condition": "Observable when ligand is sampled across the transition region spanning the two dissociation constants, especially with K_d < L < K_d_low or when the two Kd values are separated by at least a few-fold so branch-weight redistribution alters the curve shape appreciably.",
    "train_hidden_contrast": "In training, varying L already reveals the mixed-branch shape; in held-out conditions that alter receptor microenvironment, the same mechanism appears as a systematic exchange in apparent branch weights rather than a mere global gain or single Kd shift.",
    "continuation_path": "Recover the parent law when the environmental modulation is absent or constant across all samples, so the effective subpopulation weight reduces to a fixed frac_high_affinity.",
    "freedom_change": "add_input",
    "promoted_symbol": null,
    "promotion_reason": "The omitted mechanism is condition-dependent redistribution of receptors between pre-existing affinity microstates. Existing variables only vary ligand concentration, so they cannot represent between-sample environmental context that changes the target mapping while preserving rapid equilibrium.",
    "gap_statement": "The current model assumes the fraction of receptors in the high-affinity subpopulation is fixed across all experimental samples, omitting plausible condition-dependent receptor partitioning among membrane or conformational environments.",
    "baseline_assumption": "Relax the assumption that receptor-subpopulation weights are fixed constants across samples; allow the high-affinity fraction to depend on one independently varied extracellular condition while maintaining bounded rapid equilibrium occupancy.",
    "scientific_mechanism": "Extracellular context such as membrane-active cofactor, ionic condition, or accessory surface factor can shift receptors between pre-existing high- and low-affinity microstates before rapid ligand binding, changing the apparent mixture weights without changing total receptor abundance.",
    "affected_symbols": [
      "L",
      "frac_high_affinity",
      "K_d",
      "K_d_low"
    ],
    "rationale": "Parent response relationship: with L varied and receptor abundance/background held fixed, f_bound increases monotonically toward saturation along a single two-branch Hill curve whose branch weights are fixed by frac_high_affinity. A realistic next refinement is to keep the same rapid-equilibrium occupancy forms but release the fixed-environment assumption behind frac_high_affinity. Under independently sampled environmental context values, still at fixed total receptor abundance and immediate readout, the child predicts a changed target mapping: the apparent contribution of the high-affinity branch increases or decreases across conditions, altering low-dose occupancy and the curvature/shoulder between K_d and K_d_low. This is observable when the ligand range covers both transition scales and the affinity classes are sufficiently separated; if L is only far below both Kd values or far above both, the contrast is weak. A single refitted parent parameter set cannot reproduce two such condition-specific curves because fixed frac_high_affinity enforces one invariant mixture shape across all samples, whereas the child requires condition-dependent branch-weight exchange. This is a scientifically admissible static refinement, not just a decorative term, and it reduces continuously to the parent when the added environmental condition is held constant or has no effect."
  },
