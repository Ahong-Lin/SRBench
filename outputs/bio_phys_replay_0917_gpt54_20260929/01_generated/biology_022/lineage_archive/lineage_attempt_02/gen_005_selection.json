{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "threshold_surface",
      "parent_relation": "At any fixed context C, both receptor subpopulations share the same effective cooperativity exponent, so C mainly shifts mixture weight and a common Hill steepness while each branch keeps a context-independent half-occupancy scale set by K_d or K_d_low.",
      "child_relation": "Allow context C to also modulate the effective dissociation constant of at least one affinity microstate, so C changes not only the branch weights and common slope but also the ligand threshold surface itself.",
      "affected_inputs": [
        "L",
        "C"
      ],
      "observable_effect": "Across context levels spanning the modulation scale, the ligand concentration needed to reach a fixed occupancy fraction shifts horizontally in C-dependent fashion even when changes in branch weight alone are insufficient, producing stronger left/right displacement of the binding curve at intermediate occupancies."
    },
    "diagnostic_groups": [
      {
        "name": "logit_bound_high",
        "expression": "log(L/K_d)",
        "role": "baseline high-affinity branch occupancy drive"
      },
      {
        "name": "logit_bound_low",
        "expression": "log(L/K_d_low)",
        "role": "baseline low-affinity branch occupancy drive"
      },
      {
        "name": "context_fraction_shift",
        "expression": "C/(K_context + C)",
        "role": "existing context redistribution scale"
      },
      {
        "name": "context_coop_shift",
        "expression": "C/(K_cooperativity_context + C)",
        "role": "existing context cooperativity-modulation scale"
      }
    ],
    "activation_condition": "Observable when C varies over the same order as the relevant context half-effect scale and ligand L spans the transition region around K_d or K_d_low; strongest when context-dependent affinity shift is comparable to or larger than the parent's weight-redistribution effect.",
    "train_hidden_contrast": "In training, moderate C variation already shows that equal-occupancy ligand thresholds move with C beyond what a single shared exponent and mixture-weight shift can capture; in holdout, the same mechanism extends this threshold displacement to more extreme C while preserving bounded monotone saturation.",
    "continuation_path": "Recover the parent by taking the context-induced affinity-shift amplitude to zero, leaving only context-dependent microstate weights and cooperativity.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model lets context redistribute receptors between pre-existing affinity classes and alter cooperativity, but assumes each class's intrinsic ligand affinity constant itself is unaffected by context.",
    "baseline_assumption": "Each affinity microstate has a fixed dissociation constant independent of extracellular context C.",
    "scientific_mechanism": "Extracellular context can allosterically tune receptor-ligand affinity within a given microstate, for example through ionic screening, cofactor-mediated stabilization, or membrane-environment changes that alter the binding free energy without changing total receptor number.",
    "affected_symbols": [
      "C",
      "K_d",
      "K_d_low",
      "K_context",
      "K_cooperativity_context"
    ],
    "rationale": "Varied conditions: extracellular ligand concentration L and independently sampled context level C. Held fixed: total surface receptor abundance and cellular background. Parent mapping: C changes the mixture weight between high- and low-affinity branches and a shared Hill exponent, but each branch still turns on around a fixed K_d or K_d_low. Child mapping: C also moves at least one branch's effective affinity, so the occupancy-versus-L curve undergoes a genuine C-dependent horizontal threshold shift, not only a change in steepness or branch weighting. This is scientifically admissible when context alters binding free energy directly, such as through pH/ionic or membrane-cofactor effects, while rapid equilibrium and bounded occupancy remain valid. A single refitted parent parameter set cannot generally reproduce the same family of C-dependent half-occupancy shifts across low, intermediate, and high C because with fixed K_d and K_d_low it has only weight exchange plus shared-cooperativity modulation; those change shape but do not supply independent branch threshold motion. Limitation: if the tested C range is very small or the affinity modulation is negligible relative to weight redistribution, the contrast may be weak."
  },
