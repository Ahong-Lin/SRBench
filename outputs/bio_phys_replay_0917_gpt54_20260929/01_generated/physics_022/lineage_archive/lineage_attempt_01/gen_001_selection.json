{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "For fixed Q and epsilon, the parent gives a pure inverse-square mapping E(r)=Q/(4*pi*epsilon*r**2), so log E vs log r has constant slope -2 and one shared parameter set only rescales amplitude.",
      "child_relation": "Relax the point-like-source assumption so the near field outside a finite charged object departs from exact inverse-square behavior and approaches the parent law only at larger r; the r-to-E mapping gains finite-size-induced curvature rather than a constant log-log slope.",
      "affected_inputs": [
        "r",
        "Q",
        "epsilon"
      ],
      "observable_effect": "When Q and epsilon are held fixed and r is swept from distances comparable to the object size to distances several times larger, the measured field falls less like a perfect single power law near the surface but tends toward the inverse-square law farther out."
    },
    "diagnostic_groups": [
      {
        "name": "inv_r2",
        "expression": "Q/(4*pi*epsilon*r**2)",
        "role": "parent Coulombic far-field scaling"
      },
      {
        "name": "log_slope_ref",
        "expression": "-2",
        "role": "reference radial exponent of the parent mapping"
      }
    ],
    "activation_condition": "Observable when the measurement distance is outside but not asymptotically larger than the object's characteristic size, i.e. in the near exterior region excluded by the point-like approximation; the contrast weakens for r much larger than the source size.",
    "train_hidden_contrast": "Training can sample only moderate exterior distances where deviations from inverse-square curvature are visible, while holdout extends to larger r where the law crosses back toward the parent far-field scaling; the same finite-size mechanism governs both regimes.",
    "continuation_path": "In the limit that the object's characteristic size becomes negligible compared with all sampled r, the refined law reduces continuously to E=Q/(4*pi*epsilon*r**2).",
    "freedom_change": "add_input",
    "promoted_symbol": null,
    "promotion_reason": "A finite-size correction cannot be expressed from Q, r, and epsilon alone because the parent has no variable encoding the source's spatial extent; one additional sampled input for object size is needed to make the altered target mapping observable.",
    "gap_statement": "The current model omits finite spatial extent of the charged object, forcing an exact inverse-square dependence at all exterior distances.",
    "baseline_assumption": "The source is point-like relative to the observation distance.",
    "scientific_mechanism": "Finite-size charge-distribution geometry modifies the external near field, producing a crossover from surface-influenced behavior to the Coulomb far field.",
    "affected_symbols": [
      "Q",
      "r",
      "epsilon"
    ],
    "rationale": "Parent response relationship: with Q and epsilon fixed, varying r changes E only through a single inverse-square factor, so one refitted amplitude reproduces all conditions. Child change: if the object is not negligibly small compared with observation distance, the field outside the object is no longer exactly point-like at all r; instead the radial decay shows curvature, with near-surface measurements differing systematically from the same inverse-square line that fits farther away. Distinguishing condition: vary r across a range that includes distances comparable to the object's size while holding Q and epsilon fixed and comparing objects of different size. Then the child predicts a size-dependent crossover in E(r), whereas the parent with one shared parameter set cannot match both the near-field deviation and the far-field recovery because it has only a single gain and fixed radial exponent. This is a changed target mapping, not merely an auxiliary latent change, because the scored output E as a function of supplied inputs changes directly. Admissible limitation: if all sampled r are much larger than the object size, the refinement is effectively unobservable and the parent remains adequate."
  },
