{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The per-capita growth rate declines linearly with abundance, so dN_dt is a quadratic unimodal function of N with a fixed symmetric crowding shape.",
      "child_relation": "Crowding remains negative but strengthens nonlinearly with abundance, so dN_dt keeps the same low-density limit while its decline toward zero becomes more sharply curved near carrying levels.",
      "affected_inputs": [
        "N",
        "carrying_capacity"
      ],
      "observable_effect": "Across trajectories spanning low to high abundance under fixed intrinsic_growth_rate and carrying_capacity, the child predicts weaker suppression at intermediate N but stronger suppression close to carrying density than the parent's single quadratic shape."
    },
    "diagnostic_groups": [
      {
        "name": "relative_density",
        "expression": "N/carrying_capacity",
        "role": "Crowding level relative to the characteristic abundance scale"
      },
      {
        "name": "low_density_growth",
        "expression": "intrinsic_growth_rate*N",
        "role": "Density-free recruitment trend recovered when crowding is negligible"
      },
      {
        "name": "parent_crowding_factor",
        "expression": "1 - N/carrying_capacity",
        "role": "Linear crowding reduction assumed by the parent"
      }
    ],
    "activation_condition": "Observable when trajectories sample a broad range of relative densities, especially N/carrying_capacity from moderate to near 1, where linear and nonlinear crowding produce measurably different curvature in dN_dt versus N.",
    "train_hidden_contrast": "In training, both models agree near low density because crowding is weak; in extended holdout reaching higher relative density, the nonlinear crowding law alters the approach to saturation in a way the parent's single quadratic mapping cannot match with one shared parameter set.",
    "continuation_path": "Recover the parent law in the limit where the nonlinear crowding shape parameter equals 1.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes crowding depresses net growth with a strictly linear dependence on abundance, excluding scientifically common accelerating density dependence from interference, space preemption, or resource depletion near saturation.",
    "baseline_assumption": "Crowding acts instantaneously and its strength increases linearly with abundance through the factor 1 - N/carrying_capacity.",
    "scientific_mechanism": "Accelerating density dependence: as abundance rises, each additional individual causes disproportionately stronger competition or interference, making suppression of net growth increasingly steep near carrying levels.",
    "affected_symbols": [
      "N",
      "intrinsic_growth_rate",
      "carrying_capacity"
    ],
    "rationale": "A realistic next refinement is to relax the parent's linear crowding assumption without adding a new process. The parent target mapping is a single-phase quadratic response: with fixed intrinsic_growth_rate and carrying_capacity, varying N alone determines dN_dt through one fixed concave parabola. The child instead keeps positive low-density growth and bounded saturation, but allows the crowding feedback to change curvature with N so the response is not locked to that one quadratic shape. The distinguishing condition is observation of the same closed population under fixed demographic conditions while abundance moves from low values toward carrying levels. Held fixed are intrinsic_growth_rate, carrying_capacity, closure, and no explicit environmental variation. Varied is N along the observed trajectory. Qualitatively, the parent with one shared parameter set cannot simultaneously match near-exponential growth when rare and a sharper late-stage slowdown if suppression accelerates close to carrying capacity, because its per-capita decline is forced to be linear in N. This is observable only when the data include moderate to high relative density; if observations stay near N much less than carrying_capacity, the refinement is weakly identifiable and the parent is effectively recovered."
  },
