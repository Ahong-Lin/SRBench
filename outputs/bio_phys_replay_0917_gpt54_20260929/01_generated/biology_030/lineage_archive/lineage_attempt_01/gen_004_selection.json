{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "threshold_surface",
      "parent_relation": "The sign change in dN_dt is controlled by a single crowding threshold based only on the arithmetic crowding load (N + crowding_memory)/(2*carrying_capacity), so any combination of current and lagged crowding with the same average produces the same instantaneous growth response.",
      "child_relation": "Replace the equal-weight crowding average by a dynamically varying realized-crowding sensitivity, so dN_dt depends on both the total crowding load and the current-versus-lagged composition of that load. The zero-growth threshold becomes state-dependent rather than fixed at one averaged crowding level.",
      "affected_inputs": [
        "N",
        "crowding_memory",
        "crowding_adjustment_rate"
      ],
      "observable_effect": "During transients where N and crowding_memory differ substantially, two trajectories with similar average crowding but different mismatch between current and lagged crowding can show different instantaneous suppression of growth; the parent predicts no such contrast after one global refit."
    },
    "diagnostic_groups": [
      {
        "name": "avg_crowding_load",
        "expression": "(N + crowding_memory)/(2*carrying_capacity)",
        "role": "Parent realized crowding coordinate controlling suppression"
      },
      {
        "name": "crowding_mismatch",
        "expression": "(N - crowding_memory)/carrying_capacity",
        "role": "Current-versus-lagged density imbalance during transient adjustment"
      },
      {
        "name": "memory_timescale_ratio",
        "expression": "crowding_adjustment_rate/intrinsic_growth_rate",
        "role": "Relative speed of crowding-memory relaxation versus population growth"
      }
    ],
    "activation_condition": "Observable when transient mismatch is appreciable, |N - crowding_memory| comparable to carrying_capacity times a non-small fraction, especially for intermediate memory adjustment where crowding_memory lags but is not frozen.",
    "train_hidden_contrast": "In training, the mechanism appears as altered transient suppression when current abundance outruns or undershoots realized crowding. In holdout, the same mismatch-dependent threshold shift persists over broader lag regimes or larger excursions without changing the low-density growth limit.",
    "continuation_path": "Recover the parent law when realized crowding sensitivity becomes constant so current and lagged crowding always enter with fixed equal weight.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A mismatch-dependent weighting of current versus lagged crowding requires its own internal relaxation variable; existing states only provide the crowding level itself, not the evolving sensitivity that changes how that level maps to dN_dt.",
    "gap_statement": "The model assumes current abundance and lagged crowding always contribute equally to effective density dependence, regardless of whether the system is in a rapidly rising, declining, or near-equilibrium phase.",
    "baseline_assumption": "Realized competition commonly reflects both immediate encounters among currently present individuals and residual effects of recent crowding; the parent idealizes this by fixing their contribution to an equal arithmetic average.",
    "scientific_mechanism": "Adaptive crowding sensitivity or physiological/behavioral adjustment can make the effective weight of immediate versus remembered crowding depend on recent disequilibrium, so instantaneous competition pressure is not determined by a fixed 50:50 blend.",
    "affected_symbols": [
      "N",
      "crowding_memory",
      "crowding_adjustment_rate",
      "carrying_capacity"
    ],
    "rationale": "A realistic next refinement is to relax the equal-weight assumption in the density-feedback term rather than adding a wholly new ecological process. The parent target mapping has a single-threshold shortcut: for fixed parameters, dN_dt is fully determined by N multiplied by one suppression factor based on the average of N and crowding_memory, so the same average crowding implies the same instantaneous response. Holding intrinsic_growth_rate, carrying_capacity, crowding_exponent, and crowding_adjustment_rate fixed, vary the transient relationship between N and crowding_memory along admissible trajectories generated from the stated initial-condition protocol and subsequent time evolution. Under the child mechanism, periods with N > crowding_memory (rapid increase relative to remembered crowding) can differ systematically from periods with N < crowding_memory (after overshoot or decline) even when the parent average crowding coordinate is similar, because the effective crowding threshold shifts with mismatch. This changes the scored target mapping dN_dt(N, crowding_memory, ...) itself, not merely an auxiliary unobserved trajectory, since the new state would modulate the N equation directly. The contrast is scientifically admissible when the memory lag is strong enough for N and crowding_memory to separate but not so extreme that one stays effectively constant. A single refitted parent parameter set cannot reproduce composition-sensitive suppression across both rising and falling transients if those conditions share similar averages but differ in mismatch, because the parent collapses them onto the same suppression coordinate."
  },
