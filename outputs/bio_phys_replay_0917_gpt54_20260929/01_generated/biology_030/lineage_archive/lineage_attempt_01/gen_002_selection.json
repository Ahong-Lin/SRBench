{
  "plan": {
    "operation": "add_term",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "For fixed parameters, dN_dt is an instantaneous single-valued function of the current abundance N alone, so trajectories with the same N have the same growth rate regardless of whether the population recently came from lower or higher density.",
      "child_relation": "Introduce delayed crowding via one internal state so dN_dt depends on current N and a lagged density signal; at the same current N, growth can remain higher during recent increase and lower during recent decline because realized crowding adjusts with delay.",
      "affected_inputs": [
        "N"
      ],
      "observable_effect": "Across trajectories that pass through the same intermediate abundance under the same fixed demographic conditions, the child permits hysteresis in dN_dt versus N and transient overshoot or undershoot around carrying levels, which the parent cannot produce."
    },
    "diagnostic_groups": [
      {
        "name": "crowding_fraction",
        "expression": "N/carrying_capacity",
        "role": "Current abundance relative to the equilibrium crowding scale"
      },
      {
        "name": "parent_density_suppression",
        "expression": "(N/carrying_capacity)**crowding_exponent",
        "role": "Instantaneous crowding feedback assumed by the parent"
      }
    ],
    "activation_condition": "Observable when population abundance changes on a timescale comparable to or faster than adjustment of realized competition, especially after release from low density or after approach to carrying capacity, so that current density and effective crowding are temporarily mismatched.",
    "train_hidden_contrast": "In training, mild lag yields asymmetric approach to equilibrium and slight overshoot near carrying capacity; in holdout, stronger mismatch between current density and delayed crowding extends the same mechanism into clearer hysteresis at the same N without changing fixed vital rates.",
    "continuation_path": "Recover the parent law in the limit of vanishing crowding-adjustment delay, where the lagged crowding state instantaneously tracks N and dN_dt again becomes a function of N alone.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A true crowding delay is history dependent and cannot be represented with the current single state N and fixed parameters alone; one additional dynamic state is needed to encode realized competitive pressure from recent density.",
    "gap_statement": "The current model assumes crowding acts instantaneously, omitting realistic delayed adjustment of resource depletion, waste accumulation, or social interference that can make net growth depend on recent abundance history, not only current N.",
    "baseline_assumption": "Crowding acts without a time delay.",
    "scientific_mechanism": "Delayed density dependence through a slowly adjusting crowding environment or realized competition level.",
    "affected_symbols": [
      "N",
      "carrying_capacity",
      "crowding_exponent",
      "intrinsic_growth_rate"
    ],
    "rationale": "Vary the timescale of recent abundance change along observed trajectories while holding intrinsic growth, carrying capacity, and crowding exponent fixed. In the parent, the response mapping is memoryless: one shared parameter set gives the same dN_dt for every occurrence of a given N, so no loop or phase lag in the dN_dt-versus-N relationship is possible. A scientifically natural refinement is delayed density dependence, where competitive conditions adjust after abundance changes. Then, during rapid increase from low density, the population can still grow relatively fast at a given intermediate N because realized crowding lags behind current abundance; during decline from above carrying levels, suppression can remain stronger at that same N because crowding lags in the opposite direction. This changes the scored target mapping itself, not only an auxiliary trajectory, because dN_dt at fixed observed N becomes history dependent. The effect is admissible under the existing closed-population scenario and is visible when trajectories traverse moderate to high fractions of carrying capacity quickly enough for delay to matter; if adjustment is effectively instantaneous, the refinement collapses back to the parent."
  },
