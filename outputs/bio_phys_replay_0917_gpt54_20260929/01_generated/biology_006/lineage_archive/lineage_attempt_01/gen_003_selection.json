{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed consumer abundance P, prey loss increases with H as a single Holling-type saturating term capture_rate*H*P/(half_saturation_prey + H + consumer_interference_rate*P), so prey net growth is linear renewal minus one saturating loss with a single prey-saturation scale shared across all prey densities.",
      "child_relation": "Relax the assumption that prey intrinsic renewal stays density-independent; make prey renewal self-limiting so the target dH_dt becomes positive at low H but bends downward with H even before consumer removal saturates, introducing prey-density curvature independent of the predation term.",
      "affected_inputs": [
        "H",
        "P",
        "prey_growth_rate"
      ],
      "observable_effect": "When P is held fixed and H varies through low to high values, the parent predicts prey per-capita renewal remains constant while only predation saturates; the child predicts an additional downturn in dH_dt at high H, including weaker net prey increase or possible decline at high prey abundance despite similar low-H behavior."
    },
    "diagnostic_groups": [
      {
        "name": "consumer_pressure",
        "expression": "P/(half_saturation_prey + H + consumer_interference_rate*P)",
        "role": "instantaneous predator pressure entering the current capture law"
      },
      {
        "name": "prey_to_halfsat",
        "expression": "H/half_saturation_prey",
        "role": "whether prey are in the low-density or saturation-transition regime of the current functional response"
      },
      {
        "name": "interference_ratio",
        "expression": "consumer_interference_rate*P/(half_saturation_prey + H)",
        "role": "strength of consumer crowding relative to prey-dependent search limitation"
      }
    ],
    "activation_condition": "Observable when prey abundance reaches a substantial fraction of the prey carrying scale so self-limitation is not negligible, while consumers remain present at moderate levels; low-H dynamics still approximate the parent.",
    "train_hidden_contrast": "In training, moderate excursions of H already show slight downward bending of prey net growth at fixed or slowly varying P; in holdout, larger H excursions amplify that same curvature and reveal that one shared parent parameter set cannot match both low-H and high-H prey recovery slopes.",
    "continuation_path": "Take the self-limitation strength to zero, recovering density-independent intrinsic prey renewal and the parent law exactly.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The prey renewal term assumes unlimited exponential increase at all prey densities, omitting within-prey crowding or resource limitation that commonly reduces prey growth before predation alone controls abundance.",
    "baseline_assumption": "Demographic coefficients remain constant and prey intrinsic renewal is strictly linear in H with no prey self-limitation.",
    "scientific_mechanism": "Intraspecific competition or shared resource depletion within the prey population causes density-dependent reduction in prey net renewal.",
    "affected_symbols": [
      "H",
      "P",
      "prey_growth_rate"
    ],
    "rationale": "A realistic next refinement is to keep the existing predator functional response but relax the idealized prey-growth law. The parent target mapping from observed states to dH_dt is linear in prey renewal and uses only a single saturating predation loss; therefore, at fixed P it attributes all curvature in dH_dt versus H to the consumption term. Vary H while holding P approximately fixed over snapshots or local phases of the trajectory: the parent predicts low-H positive slope near prey_growth_rate minus a predation-dependent offset, then gradual flattening as predation saturates. The child would add prey self-limitation so the slope of dH_dt with respect to H decreases further at moderate-to-high H, potentially producing a peak and downturn in net prey growth not reproducible by merely refitting the existing predation parameters without spoiling low-H behavior. This is scientifically admissible when prey become abundant enough for crowding or food limitation to matter; if all observed H remain far below that scale, the refinement will be weak, which is an explicit limitation rather than a reason to invent a different mechanism."
  },
