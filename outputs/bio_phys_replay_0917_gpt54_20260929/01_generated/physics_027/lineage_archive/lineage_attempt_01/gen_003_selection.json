{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target acceleration decreases linearly with U at fixed R through dU_dt = pressure_gradient_magnitude/fluid_density - viscous_drag_rate*R*U, with R relaxing toward an affine drag factor 1 + nonlinear_drag_coefficient*U.",
      "child_relation": "Keep the same forcing-memory structure but relax the affine drag-target assumption so the effective resistance grows nonlinearly with U, causing dU_dt versus U to bend downward more strongly at larger U through the existing R-mediated drag channel.",
      "affected_inputs": [
        "U",
        "R",
        "nonlinear_drag_coefficient"
      ],
      "observable_effect": "Across trajectories spanning weak to stronger startup speeds under the same fixed parameters, the child predicts a faster-than-linear late-startup reduction in acceleration and a lower high-speed asymptotic velocity than the parent, while remaining close to the parent near U≈0."
    },
    "diagnostic_groups": [
      {
        "name": "drag_loading",
        "expression": "R*U",
        "role": "instantaneous resistive loading already controlling mean-flow deceleration"
      },
      {
        "name": "quasistatic_drag_target",
        "expression": "1 + nonlinear_drag_coefficient*U",
        "role": "parent's assumed velocity-dependent resistance target to be relaxed"
      },
      {
        "name": "startup_nonlinearity_scale",
        "expression": "nonlinear_drag_coefficient*U",
        "role": "dimensionless speed level marking where non-affine drag growth becomes observable"
      }
    ],
    "activation_condition": "Observable when nonlinear_drag_coefficient*U is not small during the sampled startup, so trajectories explore moderate mean speeds before reaching steady state; negligible in the low-speed limit nonlinear_drag_coefficient*U << 1.",
    "train_hidden_contrast": "In training, moderate-speed segments already show slight downward bending of dU_dt versus U; in holdout, trajectories reaching larger U amplify this same non-affine drag-growth effect into stronger curvature.",
    "continuation_path": "Recover the parent law in the low-speed limit where the refined drag target is linearized in U, or by taking the added non-affine correction strength to zero.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the laminar resistance target increases only affinely with mean velocity, which is an overly rigid closure once finite-speed corrections make wall-drag growth stronger than linear over the admissible startup range.",
    "baseline_assumption": "The lagged hydraulic-resistance state relaxes toward the exact instantaneous target 1 + nonlinear_drag_coefficient*U.",
    "scientific_mechanism": "Non-affine growth of laminar hydraulic resistance with mean velocity, representing higher-order finite-speed corrections to the cross-sectionally averaged wall-shear relation while preserving dissipative drag.",
    "affected_symbols": [
      "U",
      "R",
      "nonlinear_drag_coefficient",
      "resistance_relaxation_rate",
      "viscous_drag_rate"
    ],
    "rationale": "Vary the imposed pressure-gradient magnitude across trajectories while holding fluid_density, viscous_drag_rate, resistance_relaxation_rate, and nonlinear_drag_coefficient fixed. In the parent, after accounting for lag through R, acceleration falls with U through an effectively single affine drag-growth law, so one shared parameter set imposes nearly the same dU_dt-versus-U curvature structure at all accessible speeds. A realistic next refinement is to relax that affine resistance-target assumption: at modest startup speeds the child remains close to the parent, but when nonlinear_drag_coefficient*U reaches order unity the resistance should increase faster than linearly, producing stronger downward curvature in the target mapping from observed (U,R) to dU_dt and a lower saturation speed. This changes the scored target relationship itself, not merely the auxiliary R trajectory, because dU_dt directly depends on the resistance level generated by the refined U-to-R target. The effect is admissible in laminar startup provided the added drag growth stays nonnegative and dissipative; it is weak near U=0, so the refinement is specifically justified only when sampled trajectories reach moderate speeds."
  },
