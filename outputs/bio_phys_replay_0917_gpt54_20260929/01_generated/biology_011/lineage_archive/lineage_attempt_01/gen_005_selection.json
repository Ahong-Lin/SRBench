{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "For fixed recombination_rate and occupancy_buffer, dD_dt is an odd monotone function of D whose magnitude changes with |D| only through a single rational dependence on D**2, so positive and negative associations with the same |D| decay with the same one-phase shape.",
      "child_relation": "Retain decay toward zero but relax the assumption that the occupancy limitation responds instantaneously with one linear relaxation mode; introduce a slowly accumulating refractory occupancy memory so the effective erosion at a given current |D| depends on recent prior |D| exposure, changing the local curvature of the D-to-dD_dt mapping during sustained large-|D| episodes versus transient ones.",
      "affected_inputs": [
        "D",
        "occupancy_buffer"
      ],
      "observable_effect": "Two trajectories that pass through the same current D can show different |dD_dt| depending on whether they arrived after prolonged high |D| or after a brief excursion; sustained high |D| yields stronger temporary suppression of erosion than the parent can produce from current D alone."
    },
    "diagnostic_groups": [
      {
        "name": "ld_amplitude",
        "expression": "Abs(D)",
        "role": "current disequilibrium magnitude setting the instantaneous parent erosion scale"
      },
      {
        "name": "buffered_decay_scale",
        "expression": "recombination_rate*(1 + nonlinear_ld_coupling*D**2)/(1 + occupancy_buffer + boundary_compression_strength*D**2)",
        "role": "current effective linear-in-D decay coefficient implied by the parent mapping"
      },
      {
        "name": "buffer_load_mismatch",
        "expression": "occupancy_sensitivity*D**2 - occupancy_buffer",
        "role": "distance of the fast occupancy buffer from its quasi-steady LD-dependent level, indicating whether recent history can matter if an additional slower occupancy phase exists"
      }
    ],
    "activation_condition": "Observable when |D| remains moderately large for times comparable to or longer than the occupancy response timescale, so a slow occupancy-refractory component can separate sustained from transient exposure; weak near D≈0 or under very rapid passage through low |D|.",
    "train_hidden_contrast": "Within training, trajectories with different recombination_rate relaxation histories can generate the same instantaneous D but different recent high-|D| dwell times; in holdout, the same memory mechanism extends this contrast to longer sustained episodes and larger occupancy buildup.",
    "continuation_path": "Recover the parent law when the refractory occupancy contribution is absent or relaxes infinitely fast so the additional memory collapses into the existing occupancy_buffer response.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A genuine history-dependent occupancy refractory effect cannot be represented by refitting existing algebraic D dependence or the single occupancy_buffer state, because those make dD_dt at a given current state depend only on present D and present buffer, not on an additional slow hidden occupancy phase created by past sustained LD.",
    "gap_statement": "The current model assumes a single-timescale occupancy limitation, so all suppression of recombinational erosion is determined by one buffer that relaxes linearly toward a D**2 target.",
    "baseline_assumption": "Occupancy limitation is fully captured by one fast linear relaxation variable slaved to current D**2, with no slower refractory or crowding-memory phase.",
    "scientific_mechanism": "Sustained excess occupancy of overrepresented haplotypes can leave a slower refractory crowding state that continues to limit effective recombinant reshuffling even after instantaneous LD has already begun to relax, while still preserving decay toward D=0.",
    "affected_symbols": [
      "D",
      "occupancy_buffer",
      "occupancy_relaxation_rate",
      "occupancy_sensitivity"
    ],
    "rationale": "A realistic next refinement is to relax the one-phase occupancy assumption rather than add an unrelated process. In the parent, if current D, recombination_rate, and occupancy_buffer are the same, then dD_dt is fixed; any two trajectories intersecting the same state have identical target dynamics. That is a single-phase shortcut. Biologically, finite haplotype occupancy can have a slower refractory component: prolonged strong association can leave persistent crowding or access limitation beyond the fast buffer. Vary the duration of prior large-|D| exposure while holding the current observed D and the fixed parameters comparable; under admissible conditions with sustained moderate-to-large |D|, the child can produce temporarily smaller |dD_dt| after long exposure than after a brief excursion, whereas the parent with one shared parameter set cannot because its target mapping is Markov in the existing state tuple and has no extra memory. This changes the scored target mapping, not merely an auxiliary trajectory, provided the new slow state enters the D equation. The effect should remain weak near D=0 and disappears in the limit of vanishing or infinitely fast refractory occupancy, which cleanly recovers the parent."
  },
