{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target mapping is dD_dt = -recombination_rate*D, so for any observed recombination_rate the decay magnitude is a single linear gain in |D| with constant local slope -recombination_rate.",
      "child_relation": "Replace the strictly linear erosion law with a bounded odd dependence on D so the effective decay gain decreases as |D| approaches its admissible maximum, while retaining the sign toward zero. Then dD_dt remains zero at D=0 and opposite in sign to D, but the |D|->|dD_dt| relation becomes curved rather than purely linear.",
      "affected_inputs": [
        "D",
        "recombination_rate"
      ],
      "observable_effect": "At fixed observed recombination_rate, small |D| still decays approximately exponentially, but larger |D| decays more slowly than the linear parent predicts, producing state-dependent curvature in D(t) and a smaller-than-linear magnitude of dD_dt at high |D|."
    },
    "diagnostic_groups": [
      {
        "name": "signed_decay_gain",
        "expression": "-dD_dt/D",
        "role": "Instantaneous effective erosion rate when D != 0"
      },
      {
        "name": "ld_magnitude",
        "expression": "Abs(D)",
        "role": "Strength of allelic association determining proximity to admissible LD bounds"
      },
      {
        "name": "normalized_flux",
        "expression": "Abs(dD_dt)/(recombination_rate*(Abs(D)+1.0e-12))",
        "role": "Deviation from the parent's constant-unit linear decay gain"
      }
    ],
    "activation_condition": "Observable when trajectories sample a non-negligible range of |D|, especially moderate-to-large |D| relative to its feasible scale; effect is weak near D=0 where the child must reduce to the parent approximately.",
    "train_hidden_contrast": "In training, modest |D| already shows near-zero versus moderate-|D| differences in effective decay gain; in holdout, larger |D| extends this same curvature, with stronger attenuation of decay magnitude than any single linear gain can match across all sampled states.",
    "continuation_path": "Recover the parent law in the weak-association limit where |D| is small compared with its saturation scale, so the nonlinear erosion factor linearizes to 1.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A saturation scale is needed to express when finite feasible haplotype constraints begin to blunt the proportional erosion of LD. Existing symbols provide only D and a time-varying recombination_rate, which cannot by themselves encode a separate internal measure of available recombinantizable association without collapsing back to a refit linear gain.",
    "gap_statement": "The current model assumes recombination removes a fixed fraction of LD per unit time regardless of how close the association is to the maximal values permitted by fixed allele frequencies.",
    "baseline_assumption": "The loss of association is exactly proportional to D over the full admissible range.",
    "scientific_mechanism": "Finite-haplotype occupancy can limit the amount of association that is effectively available to be broken down, making recombination-driven erosion saturate at large |D| even though it still points toward linkage equilibrium.",
    "affected_symbols": [
      "D",
      "recombination_rate"
    ],
    "rationale": "Vary the observed state D along trajectories while holding the recombination-rate relaxation parameters fixed. In the parent, once recombination_rate is given, the target mapping from D to dD_dt is a single straight line through the origin with slope -recombination_rate. A realistic refinement is that at larger |D|, finite feasible haplotype occupancy reduces the marginal amount of further recombinant breakup available, so the decay magnitude grows sublinearly with |D|. This changes the scored target mapping itself, not merely the auxiliary recombination_rate trajectory, because two times with the same recombination_rate but different |D| would have different normalized decay gains in the child and identical gains in the parent. The contrast is scientifically admissible when initial or transient LD is not infinitesimal; near D=0 the refinement should become hard to distinguish and recover the parent approximately. A single refitted parent parameter set cannot reproduce both the near-origin slope and the attenuated large-|D| decay across one dataset spanning those conditions, because its D-to-dD_dt map remains exactly linear for all D."
  },
