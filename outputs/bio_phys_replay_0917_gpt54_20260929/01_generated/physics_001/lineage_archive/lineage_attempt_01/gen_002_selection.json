{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed critical temperature, chi is a sum of two pure powers of L, so the log-log slope drifts monotonically toward critical_exponent_ratio with only one leading correction scale.",
      "child_relation": "Keep the same critical-point finite-size setting but relax the assumption that one irrelevant field dominates over the sampled sizes; include a second subleading correction so the effective log-log slope shows additional curvature before reaching the asymptotic exponent.",
      "affected_inputs": [
        "L"
      ],
      "observable_effect": "Across increasing L at fixed geometry, boundary conditions, couplings, and temperature, the child can produce a two-stage approach of the effective exponent versus 1/L-scale, whereas the parent only allows a single-stage monotonic drift tied to one correction exponent."
    },
    "diagnostic_groups": [
      {
        "name": "log_slope_parent",
        "expression": "(critical_exponent_ratio*susceptibility_amplitude*L**critical_exponent_ratio + (critical_exponent_ratio - correction_exponent)*correction_amplitude*L**(critical_exponent_ratio - correction_exponent))/(susceptibility_amplitude*L**critical_exponent_ratio + correction_amplitude*L**(critical_exponent_ratio - correction_exponent))",
        "role": "Parent effective log-log exponent of susceptibility versus size"
      },
      {
        "name": "leading_correction_ratio",
        "expression": "correction_amplitude*L**(-correction_exponent)/susceptibility_amplitude",
        "role": "Relative size of the leading irrelevant-field correction compared with the asymptotic critical term"
      }
    ],
    "activation_condition": "Observable when the sampled sizes span a broad enough preasymptotic-to-asymptotic window that one irrelevant correction is no longer sufficient, e.g. moderate L where the leading correction has started to decay but higher-order finite-size effects are still not negligible.",
    "train_hidden_contrast": "In training on moderate system sizes the extra preasymptotic curvature appears as systematic residuals to a one-correction fit; in holdout at larger L the same mechanism persists but weakens, producing a continued crossover toward the asymptotic slope that the parent cannot match with one shared parameter set.",
    "continuation_path": "Recover the parent law by taking the added subleading correction amplitude to zero or by sending its exponent sufficiently large that its contribution is negligible over the sampled L range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes a single dominant irrelevant scaling field controls all observable finite-size deviations, which can be too restrictive over realistic finite size windows.",
    "baseline_assumption": "The leading finite-size correction alone captures the observable departure from asymptotic critical scaling across the sampled system sizes.",
    "scientific_mechanism": "Multiple irrelevant renormalization-group fields or analytic finite-size contributions generate an additional subleading correction-to-scaling term at criticality.",
    "affected_symbols": [
      "L",
      "correction_amplitude",
      "correction_exponent",
      "susceptibility_amplitude",
      "critical_exponent_ratio"
    ],
    "rationale": "The parent response maps L to chi through one asymptotic power plus one correction power, so after refitting all parent parameters it still enforces a single-crossover shape in the effective exponent as size increases. A realistic next refinement is to relax the one-irrelevant-field approximation and allow a second subleading correction that changes the target mapping itself, not merely hidden auxiliary structure. The varied condition is L; temperature, field, geometry, boundary conditions, and microscopic couplings remain fixed. The observable contrast is that the child can show extra curvature in chi(L) on log-log axes or a two-stage drift in d log chi / d log L across moderate to large L, while one parent parameter set cannot reproduce that pattern across the same size window because it has only one correction exponent and one correction amplitude controlling all preasymptotic deviation. This is scientifically admissible when the sampled sizes are finite enough that subleading irrelevant or analytic corrections have not fully died out, yet large enough to remain in the critical finite-size scaling regime. The continuation to the parent is straightforward when the extra correction becomes negligible."
  },
