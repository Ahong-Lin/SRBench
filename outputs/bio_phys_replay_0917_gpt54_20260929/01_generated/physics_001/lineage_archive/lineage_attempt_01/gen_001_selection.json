{
  "plan": {
    "operation": "add_term",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed critical temperature and zero field, susceptibility is a pure power law chi(L)=susceptibility_amplitude*L**critical_exponent_ratio with constant log-log slope critical_exponent_ratio.",
      "child_relation": "Add the leading finite-size correction from an irrelevant scaling field so chi(L) keeps the asymptotic power law but acquires scale-dependent curvature in log-log coordinates, with the effective slope drifting toward the asymptotic exponent as L increases.",
      "affected_inputs": [
        "L"
      ],
      "observable_effect": "Across small-to-moderate versus large system sizes, the apparent exponent extracted from local log-log slopes changes systematically; one shared pure-power parent fit cannot reproduce this size-dependent bending while also matching the large-L asymptote."
    },
    "diagnostic_groups": [
      {
        "name": "log_slope_parent",
        "expression": "critical_exponent_ratio",
        "role": "Parent predicts a size-independent effective exponent."
      },
      {
        "name": "scaled_susceptibility",
        "expression": "L**(-critical_exponent_ratio)",
        "role": "Under the parent, chi multiplied by this factor is constant; departures indicate correction-to-scaling structure."
      }
    ],
    "activation_condition": "Observable when the sampled sizes include a preasymptotic finite-size regime where the leading irrelevant-field correction has not yet decayed away, typically moderate L rather than only asymptotically large L; the correction must remain subleading so chi stays positive and still grows overall with L.",
    "train_hidden_contrast": "In training, moderate and large sizes can already show a gentle log-log bend away from a single straight line; in holdout at larger L the same mechanism predicts approach back toward the parent power law rather than a new phase or threshold.",
    "continuation_path": "Recover the parent law by sending the correction amplitude to zero or by taking L to asymptotically large values so the irrelevant-field contribution vanishes.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current law omits the standard leading correction-to-scaling at criticality caused by irrelevant operators or residual lattice/boundary effects, treating all finite sizes as already exactly asymptotic.",
    "baseline_assumption": "The parent assumes finite-size critical susceptibility is an exact single power of L over the entire sampled size range, with no preasymptotic correction.",
    "scientific_mechanism": "At criticality, irrelevant renormalization-group fields generate subleading finite-size contributions that modify the amplitude in an L-dependent way while preserving the same asymptotic exponent ratio.",
    "affected_symbols": [
      "L",
      "susceptibility_amplitude",
      "critical_exponent_ratio"
    ],
    "rationale": "Parent response: varying L while holding temperature at bulk criticality, field at zero, and geometry/boundary conditions fixed gives a straight line on log chi versus log L with constant slope critical_exponent_ratio. Real finite-size data often show a systematic preasymptotic deviation from this straight line because the leading asymptotic scaling form is corrected by irrelevant fields. Child change: the target mapping itself changes, not merely an auxiliary trajectory, because chi(L) gains scale-dependent curvature or a drifting local slope over the accessible L range. Distinguishing condition: compare moderate L and larger L under the same fixed critical conditions; the parent with one shared parameter set can only choose one constant slope and one amplitude, so it cannot simultaneously match a visibly bent log-log trend and the large-L asymptotic trend unless the bend is negligible. This refinement is scientifically admissible when sizes are not all deep in the asymptotic regime. Limitation: if only very large L are sampled and corrections are below noise, the parent may be effectively sufficient."
  },
