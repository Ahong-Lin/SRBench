{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At one fixed critical environment, chi(L) is a sum of power-law finite-size terms, so log-chi versus log-L approaches a size-independent asymptotic slope with only algebraic correction curvature.",
      "child_relation": "Keep the critical power-law core but replace the sharply saturating subleading suppression by a smooth logarithmic renormalization of the effective amplitude, producing additional slow curvature in chi(L) across decades of L at the upper critical dimension or in marginally irrelevant cases.",
      "affected_inputs": [
        "L"
      ],
      "observable_effect": "Across a broad size window, the child shows a systematic slow drift of the local effective exponent with log L that cannot be matched by the parent's finite sum of algebraic corrections using one shared parameter set when the data exhibit marginal curvature rather than a simple crossover cutoff."
    },
    "diagnostic_groups": [
      {
        "name": "log_size",
        "expression": "log(L)",
        "role": "Tests for marginal finite-size renormalization that varies only logarithmically with system size"
      },
      {
        "name": "inv_log_size",
        "expression": "1/log(L)",
        "role": "Measures the slow-decaying scale that distinguishes logarithmic corrections from ordinary algebraic ones"
      },
      {
        "name": "local_power_core",
        "expression": "L**critical_exponent_ratio",
        "role": "Baseline asymptotic critical growth before marginal modification"
      }
    ],
    "activation_condition": "Observable when sampled sizes span at least roughly one to several decades and the universality class or effective dimensional setting is near a marginal case where logarithmic finite-size corrections are expected; over a narrow L window the effect may be too weak to distinguish from ordinary algebraic corrections.",
    "train_hidden_contrast": "In training, moderate sizes show gentle but persistent excess curvature beyond the parent's algebraic-plus-saturation form; in holdout at larger L, the same mechanism continues as a slow logarithmic drift instead of saturating away, extending the mismatch.",
    "continuation_path": "Recover the parent law in the limit that the logarithmic correction amplitude tends to zero, or over a restricted size window where log factors are nearly constant and can be approximated by refitted amplitudes.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent assumes every visible finite-size correction is algebraic in L, with one subleading contribution further turned off by a finite crossover scale; it omits marginally irrelevant scaling fields that generate logarithmic finite-size renormalization at criticality.",
    "baseline_assumption": "All correction-to-scaling structure at the fixed critical point is representable by ordinary power laws in L, optionally suppressed by a finite crossover denominator.",
    "scientific_mechanism": "A marginal or near-marginal irrelevant field modifies the critical finite-size susceptibility through multiplicative or additive logarithmic corrections, causing a slow scale dependence of the effective amplitude/exponent.",
    "affected_symbols": [
      "L",
      "subleading_correction_amplitude",
      "subleading_correction_exponent",
      "subleading_crossover_size",
      "subleading_saturation_sharpness"
    ],
    "rationale": "Vary L while holding geometry, boundary conditions, microscopic couplings, zero field, and the tuned critical temperature fixed. The parent maps size to susceptibility using a dominant critical power plus algebraic corrections, including a subleading branch that eventually saturates away beyond a crossover size. A realistic next refinement is to relax the assumption that the extra curvature must come from a finite crossover suppression: in marginal cases, the target mapping itself acquires slow logarithmic size dependence. The observable contrast is that the parent predicts correction curvature that can be absorbed into algebraic powers and then dies off with increasing L, whereas the child predicts a continuing log-driven drift of the effective slope over larger sizes. This is scientifically admissible near upper critical dimension or when a marginally irrelevant operator is present. The change affects the scored chi(L) relation directly, not merely an auxiliary trajectory. A single refitted parent parameter set may mimic a short interval, but across admissible broad size ranges it cannot simultaneously reproduce both the early and late slow logarithmic drift if the true correction does not saturate to a pure algebraic form."
  },
