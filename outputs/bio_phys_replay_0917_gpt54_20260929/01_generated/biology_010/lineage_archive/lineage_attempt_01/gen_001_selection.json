{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "q_star depends only on the ratio mu/s through q_star = sqrt(mu/s), so changing mu rescales q_star the same way at every fixed s and changing s rescales q_star the same way at every fixed mu.",
      "child_relation": "Relax complete recessivity so equilibrium depends on both homozygous selection and heterozygote exposure; q_star then depends on mu and s through an mu-by-s interaction set by partial dominance, changing the slope with respect to mu across s and producing crossover from recessive-like to heterozygote-limited scaling.",
      "affected_inputs": [
        "mu",
        "s"
      ],
      "observable_effect": "At weak selection and/or higher mutation, the equilibrium rises less steeply than sqrt(mu/s) because heterozygotes are no longer fully sheltered; the contrast is strongest when mutation pressure is large enough that heterozygotes are common while s is held fixed across sampled conditions."
    },
    "diagnostic_groups": [
      {
        "name": "mu_over_s",
        "expression": "mu/s",
        "role": "parent mutation-selection balance coordinate controlling the recessive equilibrium"
      },
      {
        "name": "sqrt_mu_over_s",
        "expression": "sqrt(mu/s)",
        "role": "parent predicted equilibrium used to detect systematic curvature departures across conditions"
      }
    ],
    "activation_condition": "Observable when the deleterious allele is not exactly completely recessive, so heterozygotes experience nonzero fitness loss; strongest for admissible regimes with q_star not extremely small, equivalently moderate-to-large mu/s within the biologically allowed domain and fixed nonzero s.",
    "train_hidden_contrast": "In training, varying mu at several fixed s values would already show departures from a single square-root law; in holdout, the same mechanism extends to different mu/s levels by shifting from recessive-like scaling at very small q to stronger heterozygote-limited suppression at larger q.",
    "continuation_path": "Recover the parent law in the limit of zero heterozygote effect (dominance coefficient h -> 0).",
    "freedom_change": "add_input",
    "promoted_symbol": null,
    "promotion_reason": "The scientific gap is incomplete recessivity, which requires one new independently sampled static input for heterozygote effect size; existing inputs mu and s cannot distinguish complete from partial recessivity because all heterozygote exposure is otherwise fixed to zero.",
    "gap_statement": "The parent hard-codes perfect masking in heterozygotes, excluding the realistic case that deleterious alleles are only partially recessive and therefore selected before reaching homozygosity.",
    "baseline_assumption": "The deleterious allele is completely recessive.",
    "scientific_mechanism": "Partial dominance causes heterozygotes to suffer some viability reduction, adding direct selection on rare deleterious alleles and altering the deterministic mutation-selection equilibrium.",
    "affected_symbols": [
      "mu",
      "s"
    ],
    "rationale": "The parent response maps inputs to target with one idealized assumption: all selection acts only on aa homozygotes, giving the square-root law q_star = sqrt(mu/s). A realistic next refinement is to relax complete recessivity and allow nonzero heterozygote fitness loss. Vary mu across independently sampled values while holding s fixed at several nonzero levels and compare the equilibrium response. Under the parent, all such curves are constrained to the same square-root form after rescaling by s. Under the child, once heterozygotes are exposed, the q_star-versus-mu slope changes with s because rare-allele removal begins already in heterozygotes, creating a genuine change in the scored target mapping rather than merely an auxiliary process. This contrast is scientifically admissible when the allele is only partially recessive and mutation pressure is high enough that heterozygotes are not vanishingly rare; if heterozygote effect is truly zero or mu/s is extremely small, the child smoothly collapses back toward the parent and the contrast weakens. A single refit of the parent cannot reproduce both the recessive square-root scaling at near-zero heterozygote effect and the altered mu-by-s dependence when heterozygotes are selected, so this is a meaningful increase in target-function complexity."
  },
