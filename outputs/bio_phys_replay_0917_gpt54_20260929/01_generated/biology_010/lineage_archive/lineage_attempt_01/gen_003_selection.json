{
  "plan": {
    "operation": "add_term",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "q_star depends only on mu, s, and h under one-way forward mutation with no return flux, so for fixed s and h it rises monotonically with mu according to a single mutation-selection balance curve.",
      "child_relation": "Introduce reverse mutation from deleterious to normal allele, so q_star depends on the interaction between forward mutation input and return mutation loss; for fixed s and h, increasing the new mutation-rate input reduces q_star and compresses the response to mu, especially when mutation rates are comparable.",
      "affected_inputs": [
        "mu",
        "s",
        "h"
      ],
      "observable_effect": "Across samples with similar mu, s, and h but different reverse-mutation environments, the equilibrium deleterious frequency is lower when return mutation is higher; the parent cannot represent this because it predicts identical q_star for identical mu, s, h regardless of any omitted return-mutation condition."
    },
    "diagnostic_groups": [
      {
        "name": "mut_sel_ratio",
        "expression": "mu/s",
        "role": "baseline forward-mutation versus viability-selection scale controlling the parent equilibrium"
      },
      {
        "name": "dom_load",
        "expression": "h**2 + 4*mu/s",
        "role": "parent discriminant determining curvature of the equilibrium response"
      }
    ],
    "activation_condition": "Observable when reverse mutation is not negligible relative to forward mutation, i.e. on the same order as mu or large enough to alter net allelic flux before viability selection dominates; negligible when reverse mutation is much smaller than mu.",
    "train_hidden_contrast": "Within training, the mechanism appears as systematic downward shifts in q_star at matched mu, s, h when reverse mutation varies across sampled environments; in holdout, the same flux-balance interaction extends to broader relative scales of forward versus reverse mutation.",
    "continuation_path": "Set reverse mutation to zero to recover the parent law exactly.",
    "freedom_change": "add_input",
    "promoted_symbol": null,
    "promotion_reason": "The omitted process is an independently varying mutational environment, not inferable from mu, s, or h alone. Capturing its effect on the scored equilibrium mapping requires one new sampled input for reverse mutation rate.",
    "gap_statement": "The current model assumes mutation is strictly one-way and therefore omits return flux from deleterious to normal alleles.",
    "baseline_assumption": "Back mutation is negligible.",
    "scientific_mechanism": "Backward mutation removes deleterious alleles directly each generation, altering deterministic mutation-selection balance.",
    "affected_symbols": [
      "mu",
      "s",
      "h"
    ],
    "rationale": "A realistic next refinement is to relax the negligible-back-mutation assumption. The parent maps q_star from mu, s, and h alone, so at fixed selection parameters it has one shared response surface for all mutational environments. The child would add reverse mutation as an independent condition, creating a genuine interaction in the target mapping because equilibrium now reflects both viability removal and bidirectional mutational flux. The distinguishing condition is to vary reverse mutation while holding mu, s, and h fixed: the child predicts lower q_star as return mutation rises, whereas the parent with one shared parameterization cannot reproduce any contrast because reverse mutation is absent from its inputs and cannot be absorbed when the same mu, s, h recur under different return-mutation conditions. This effect is scientifically admissible only when reverse mutation is non-negligible on the scale of forward mutation; otherwise the parent remains a good approximation. The continuation path is clear and exact in the zero-back-mutation limit."
  },
