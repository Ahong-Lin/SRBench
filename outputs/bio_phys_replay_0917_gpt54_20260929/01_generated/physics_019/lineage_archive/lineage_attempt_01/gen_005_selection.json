{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "The spin-induced correction is modeled as a term linear in spin_rate and independent of the compactness-controlled relativistic denominator except through simple subtraction from the static part.",
      "child_relation": "Refine the frame-drag contribution so its strength is modulated by compactness, creating a non-separable interaction between spin_rate and G*M/r in the circular-speed mapping.",
      "affected_inputs": [
        "M",
        "r",
        "spin_rate"
      ],
      "observable_effect": "At fixed spin_rate and R_body, the difference between prograde/retrograde spin correction grows disproportionately as r decreases toward the relativistic regime; a single parent coefficient cannot match both weak-field large-r and stronger-field smaller-r spin trends simultaneously."
    },
    "diagnostic_groups": [
      {
        "name": "compactness",
        "expression": "G*M/r",
        "role": "Controls relativistic departure from Newtonian circular-orbit scaling"
      },
      {
        "name": "spin_size",
        "expression": "spin_rate*R_body**2/r**2",
        "role": "Sets the nominal magnitude of the rotational correction at a given radius"
      },
      {
        "name": "spin_compactness_coupling",
        "expression": "spin_rate*R_body**2/r**2/(1 - 3*G*M/r)",
        "role": "Candidate coupled regime where frame dragging is enhanced by strong-field circular-orbit structure"
      }
    ],
    "activation_condition": "Observable when both spin and relativistic compactness are non-negligible: spin_rate != 0 and G*M/r is large enough that weak-field expansion is no longer sufficient, while remaining in the allowed circular-orbit regime with 1 - 3*G*M/r > 0.",
    "train_hidden_contrast": "In training, moderate variation of r already changes compactness and exposes some spin-radius interaction; in holdout, extending to smaller admissible r strengthens the same effect, causing the spin correction to bend with compactness rather than remain a shared linear spin term.",
    "continuation_path": "Recover the parent law in the weak-field limit G*M/r -> 0, where the compactness modulation of the spin term reduces to the parent's effectively constant coefficient form.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model includes frame dragging but treats its contribution as too weakly coupled to the same relativistic compactness that already reshapes the non-spinning circular-orbit law.",
    "baseline_assumption": "The effective spin correction is assumed to be an additive term with fixed radial structure, rather than a compactness-dependent strong-field correction tied to the relativistic orbit geometry.",
    "scientific_mechanism": "Strong-field spin-orbit coupling near a rotating compact body modifies the circular-orbit speed through a compactness-dependent frame-drag factor, not just a radius-only weak-field term.",
    "affected_symbols": [
      "M",
      "r",
      "spin_rate",
      "frame_drag_coeff"
    ],
    "rationale": "A realistic next refinement is to relax the weak-field-style treatment of the existing spin correction, not to add a wholly new process. The parent already has two ingredients: a relativistic compactness denominator in the static attraction and a separate spin term. Its shortcut is a fixed-environment mapping for spin: once frame_drag_coeff is chosen, the spin contribution scales with spin_rate and radius in one shared way across all compactness levels. Vary r while holding M, R_body, and spin_rate fixed, or vary M at fixed r and spin_rate; then compactness changes. In the parent, the spin-induced speed shift remains effectively separable from the main relativistic factor, so one global frame_drag_coeff must fit all compactness conditions. In the child, the spin effect strengthens or curves differently as compactness increases, producing an M-r-spin interaction in the scored target itself. This is observable for admissible circular orbits with positive r and M and with 1 - 3*G*M/r still positive; it is weak in the far field and stronger nearer the compact object. This is a changed target mapping, not merely an auxiliary reinterpretation, because v_orbit as a function of supplied inputs changes shape. Refitting all existing parent parameters cannot generally absorb it across both weak and strong compactness regimes, since the parent only offers one shared spin coefficient multiplying one fixed radial form."
  },
