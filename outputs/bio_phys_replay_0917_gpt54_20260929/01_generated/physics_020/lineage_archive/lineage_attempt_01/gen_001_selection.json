{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With constant gamma, mdot scales as A_t*p0/sqrt(R_specific*T0) times a universal function of r_p with a fixed choke threshold and fixed subcritical-branch shape for all reservoir temperatures.",
      "child_relation": "Release the constant-caloric assumption so the effective isentropic exponent decreases with increasing reservoir temperature, making both the critical pressure ratio and the unchoked mass-flux curve temperature dependent while preserving the same choked/unchoked structure.",
      "affected_inputs": [
        "T0",
        "r_p"
      ],
      "observable_effect": "At fixed p0, A_t, R_specific, and r_p in the near-critical unchoked regime, changing T0 alters mdot by more than the parent's explicit 1/sqrt(T0) prefactor: the branch curvature and choke onset shift, so two temperatures cannot be matched by one shared constant-gamma parent fit."
    },
    "diagnostic_groups": [
      {
        "name": "crit_ratio_const_gamma",
        "expression": "(2/(gamma + 1))**(gamma/(gamma - 1))",
        "role": "Parent's fixed choking threshold in pressure-ratio space"
      },
      {
        "name": "thermal_loading",
        "expression": "1/sqrt(T0)",
        "role": "Parent's only explicit temperature dependence in mass-flux prefactor"
      },
      {
        "name": "near_choke_margin",
        "expression": "r_p - (2/(gamma + 1))**(gamma/(gamma - 1))",
        "role": "Distance from the parent critical-pressure-ratio boundary where temperature-dependent caloric effects are most visible"
      }
    ],
    "activation_condition": "Observable for sufficiently wide reservoir-temperature variation at fixed gas species, especially when r_p is near the choking transition; negligible in narrow T0 ranges where caloric properties are effectively constant.",
    "train_hidden_contrast": "In training, moderate T0 variation already perturbs the near-critical slope relative to the constant-gamma law; in holdout, a broader T0 span amplifies the same mechanism through a larger shift of critical ratio and subcritical curvature.",
    "continuation_path": "Recover the parent when caloric properties are effectively constant over the sampled temperature range, so gamma can be treated as temperature-independent.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current law assumes a calorically perfect gas with fixed gamma, so reservoir temperature only enters through the trivial prefactor and cannot change the shape or threshold of the pressure-ratio response.",
    "baseline_assumption": "The gas has fixed composition and constant caloric properties.",
    "scientific_mechanism": "Temperature-dependent heat-capacity ratio in a thermally perfect gas changes the isentropic expansion relation and hence the mass-flux function and choke condition.",
    "affected_symbols": [
      "T0",
      "r_p",
      "gamma"
    ],
    "rationale": "The parent mapping is a fixed-environment law: once p0, A_t, and R_specific are fixed, all r_p dependence is controlled by one shared constant gamma, and T0 only rescales mdot by 1/sqrt(T0). A realistic next refinement is to relax constant caloric properties while keeping steady, one-dimensional, adiabatic discharge. Vary T0 while holding gas species, p0, A_t, R_specific, and scanning r_p. Then the child predicts not just lower mdot from the prefactor at higher T0, but also a shifted choke threshold and changed unchoked-branch curvature because the effective gamma changes with temperature. This is an actual change in the scored target mapping, not merely an auxiliary variable refinement. The contrast is strongest near the admissible critical region where small changes in gamma noticeably move the transition between pressure-sensitive and choked behavior; deep in the fully choked regime the effect is weaker and may resemble a gain change. A single refitted constant-gamma parent cannot reproduce both temperature-dependent threshold movement and the corresponding subcritical-branch reshaping across multiple T0 conditions, except in the limiting narrow-temperature regime where caloric variation is negligible."
  },
