{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "At fixed C and A, cyclin loss responds instantaneously to the current active regulator fraction through a single saturating degradation term, so dC_dt depends only on present A with no delayed change in effective destruction capacity.",
      "child_relation": "Replace the instantaneous use of A in cyclin removal with a finite-maturation destruction capacity derived from regulator activation, so the same present C and A can map to different dC_dt depending on whether proteolytic capacity has caught up; this introduces a lagged activation-to-degradation phase relation.",
      "affected_inputs": [
        "C",
        "A"
      ],
      "observable_effect": "During rising cyclin/activation phases, degradation turns on later than in the parent, allowing higher cyclin overshoot before rapid loss; during falling phases, degradation capacity can remain elevated temporarily, sustaining stronger removal at comparable A."
    },
    "diagnostic_groups": [
      {
        "name": "deg_flux_parent",
        "expression": "A*C/(K_cyclin_degradation_saturation + C)",
        "role": "Current parent degradation occupancy controlling instantaneous cyclin loss"
      },
      {
        "name": "act_drive",
        "expression": "(C**n_cyclin/(K_cyclin_activation**n_cyclin + C**n_cyclin))*(activation_seed + (1 - activation_seed)*(A**n_regulator/(K_regulator_feedback**n_regulator + A**n_regulator)))*(1 - A)",
        "role": "Cyclin- and feedback-dependent drive that raises regulator activation"
      },
      {
        "name": "cyclin_regime",
        "expression": "C/(K_cyclin_degradation_saturation + C)",
        "role": "Whether cyclin is in the approximately linear or saturated degradation regime"
      }
    ],
    "activation_condition": "Observable when regulator activation changes appreciably over a timescale comparable to downstream proteolytic engagement, especially for cyclin excursions through and above K_cyclin_activation while C is also near or above K_cyclin_degradation_saturation so delayed capacity affects peak loss.",
    "train_hidden_contrast": "In training, the mechanism appears as a modest lag between A rise and effective cyclin removal near pulse onset; in holdout, larger-amplitude or faster pulses amplify the same lag into clearer peak overshoot and delayed decay at comparable observed A.",
    "continuation_path": "Take the maturation timescale to zero so effective degradation capacity instantaneously tracks A, recovering the parent degradation law.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A genuine delay in converting regulator activation into proteolytic destruction capacity cannot be represented by refitting fixed coefficients in an instantaneous two-state mapping; one additional dynamical state is needed to store the lagged capacity.",
    "gap_statement": "The model treats active regulator fraction as if it immediately equals effective cyclin-destruction capacity, omitting finite assembly or engagement time of the degradation machinery after activation.",
    "baseline_assumption": "Regulator activation and cyclin destruction are assumed to be in the same instantaneous phase, with no maturation delay between signaling activity and realized proteolytic capacity.",
    "scientific_mechanism": "Activated degradation regulator often requires downstream complex assembly, substrate recruitment, or processive proteolytic engagement before full cyclin destruction capacity is realized.",
    "affected_symbols": [
      "C",
      "A",
      "k_cyclin_degradation"
    ],
    "rationale": "Vary the observed point along oscillatory trajectories so that comparable current C and A values are encountered on the rising versus falling sides of cyclin pulses, while holding the background conditions and all initial-condition conventions fixed. In the parent, dC_dt at a given C and A is identical regardless of recent history because A directly sets degradation strength. A child with finite maturation of degradation capacity changes the scored target mapping itself: at the same supplied C and A, dC_dt becomes less negative on the upswing before capacity has accumulated and more negative on the downswing after capacity has engaged. This is scientifically admissible when activation is not infinitely fast relative to destruction engagement; if maturation were extremely fast, the effect would collapse back to the parent and may be unresolvable."
  },
