{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "Cyclin removal depends only on the matured destruction capacity D, so at any observed (C,D) pair the degradation term has a unique value independent of whether the system is on the rising or falling side of regulator activation.",
      "child_relation": "Cyclin removal will depend jointly on matured capacity D and the instantaneous active regulator fraction A, so equal (C,D) but different A values along the trajectory produce different dC_dt because mature capacity still requires contemporaneous active engagement for full catalytic throughput.",
      "affected_inputs": [
        "C",
        "D",
        "A"
      ],
      "observable_effect": "At matched cyclin and matured-capacity levels, states with higher A show more negative dC_dt than states with lower A; this creates a hysteretic/phase-dependent separation between approach-to-peak and post-peak portions of a pulse that the parent maps to the same value."
    },
    "diagnostic_groups": [
      {
        "name": "capacity_engagement",
        "expression": "D/(K_degradation_capacity_activation + D)",
        "role": "current level of matured destruction-capacity engagement already used by the parent"
      },
      {
        "name": "active_regulator_drive",
        "expression": "A",
        "role": "instantaneous catalytic activation available from the regulator"
      },
      {
        "name": "matched_capacity_state",
        "expression": "A/(D + 1.0e-12)",
        "role": "whether active regulator is high or low relative to existing matured capacity, indicating phase mismatch not visible in the parent target law"
      }
    ],
    "activation_condition": "Observable when D is intermediate to high and A varies appreciably along the oscillation, especially during activation-relaxation lag where mature capacity persists while A has already declined or is still rising; negligible when A closely tracks D or D remains near zero.",
    "train_hidden_contrast": "Within ordinary oscillatory traces from the stated initial conditions, the same D level is encountered on different phases with different A; training sees modest separation and holdout extends it to stronger pulses where A-D lag is larger.",
    "continuation_path": "Recover the parent law in the limit where active engagement is always saturated or effectively proportional to a constant, so the added A dependence collapses to a fixed factor absorbed into k_cyclin_degradation.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current target law treats matured destruction capacity D as if it alone determines cyclin proteolysis, omitting the scientifically plausible need for ongoing active-regulator engagement during substrate ubiquitination/processive destruction.",
    "baseline_assumption": "Once destruction capacity has matured into D, cyclin degradation is independent of the contemporaneous active regulator fraction A except through A's past effect on D.",
    "scientific_mechanism": "Even after assembly/maturation of destruction machinery, catalytic substrate processing commonly still requires active regulator occupancy or phosphorylation-dependent engagement, so mature capacity and active engagement jointly determine effective cyclin removal.",
    "affected_symbols": [
      "C",
      "D",
      "A",
      "k_cyclin_degradation",
      "K_degradation_capacity_activation"
    ],
    "rationale": "The parent scored mapping from observed states is effectively dC_dt=f(C,D): for fixed C and D, all trajectory points have the same predicted cyclin loss, regardless of whether A is high during regulator activation or low during relaxation. A realistic refinement is to relax that single-phase assumption and let active regulator engagement modulate the already matured destruction machinery. The varied condition is oscillation phase along trajectories that revisit similar C and D values while A differs because A activates faster than D matures and later relaxes while D decays more slowly. Holding C and D fixed, the child predicts stronger degradation when A is higher and weaker degradation when A is lower. This is a genuine target-mapping change, not merely an auxiliary-trajectory change, because A is already an observed supplied state in the solver contract. The contrast is admissible in the existing scenario for intermediate/high activation where A-D lag exists; if oscillations are too small or A and D nearly coincide, the effect may be weak. A single shared refit of the parent parameters cannot reproduce systematic phase splitting at matched (C,D), because its output is single-valued in C and D alone."
  },
