{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target mapping is affine in the observed states: du_dt = -(gravity*wavenumber)*eta - linear_damping_rate*u, so at fixed eta the damping contribution is a single slope in u.",
      "child_relation": "Retain gravity restoration but replace the ideal linear viscous loss with amplitude-dependent damping, so at fixed eta the u-to-du_dt relation bends with |u| or u^2 and dissipation strengthens at larger oscillation speeds.",
      "affected_inputs": [
        "u",
        "eta"
      ],
      "observable_effect": "Large-velocity segments of the same unforced record decay faster than small-velocity segments, producing stronger envelope loss early in a run while weak-motion tails remain closer to linear damping."
    },
    "diagnostic_groups": [
      {
        "name": "restoring_load",
        "expression": "gravity*wavenumber*eta",
        "role": "Hydrostatic restoring acceleration contribution"
      },
      {
        "name": "speed_scale",
        "expression": "Abs(u)",
        "role": "Instantaneous oscillation-speed magnitude controlling nonlinearity of drag"
      },
      {
        "name": "damping_power",
        "expression": "linear_damping_rate*u**2",
        "role": "Baseline quadratic proxy for where linear dissipation becomes insufficient to explain energy loss variation with amplitude"
      }
    ],
    "activation_condition": "Observable when the retained mode reaches moderate velocity amplitudes within the sampled trajectory, so that viscous boundary-layer and form-drag losses are no longer well approximated by a single constant damping rate; it weakens in the small-velocity limit.",
    "train_hidden_contrast": "Within training trajectories, early high-amplitude portions and later low-amplitude portions already probe different |u| ranges; in holdout, larger initial amplitudes extend this same amplitude-dependent damping contrast rather than introducing a new mechanism.",
    "continuation_path": "As the amplitude-dependent correction tends to zero, or in the small-|u| limit, the model recovers the parent linear damping law.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes all viscous dissipation can be represented by one constant linear damping rate, independent of oscillation amplitude.",
    "baseline_assumption": "Linear viscous damping of the standing-wave velocity is valid across the admissible amplitude range.",
    "scientific_mechanism": "Amplitude-dependent hydrodynamic drag or boundary-layer dissipation causing stronger damping at higher depth-averaged velocities while still opposing motion and keeping unforced energy non-increasing.",
    "affected_symbols": [
      "u",
      "eta",
      "linear_damping_rate"
    ],
    "rationale": "A realistic next refinement is to relax the idealized linear-damping assumption rather than add a new process. The parent target relation uses one shared damping slope in u, so if gravity and geometry are held fixed, every observed pair (eta,u) maps to du_dt with the same linear velocity-loss coefficient. In long-channel free-surface oscillations, this is accurate only for sufficiently weak motion; at larger velocity amplitude, viscous and form losses often increase faster than linearly with speed. The scientifically admissible contrast is reached under the existing initial-condition protocol because the same trajectory naturally passes from larger |u| early to smaller |u| later. The child therefore changes the scored mapping itself: at fixed eta, du_dt versus u gains curvature, with stronger negative damping for larger |u| and near-parent behavior close to rest. A single refitted parent parameter cannot reproduce both the faster early decay and the weaker late-time damping using one common slope across those conditions. This refinement preserves the resting state, boundedness, and monotone energy loss when the added damping remains sign-opposing."
  },
