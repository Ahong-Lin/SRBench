{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The delayed support force depends on the internal deformation z through a memoryless odd polynomial spring law, so at fixed z and parameters the target mapping dv_dt(z,v) has a single cubic-amplitude elastic curvature independent of how rapidly the deformation is being updated.",
      "child_relation": "Keep the same delayed elastic branch but relax the assumption that the support relaxation rate is constant: make relaxation progressively strain-dependent so the effective restoring contribution to dv_dt changes with both deformation magnitude and relaxation state, producing amplitude-dependent hysteretic curvature in the target mapping through z dynamics.",
      "affected_inputs": [
        "x",
        "z",
        "v",
        "relaxation_time"
      ],
      "observable_effect": "Across trajectories with the same initial displacement scale but different attained deformation amplitudes, the acceleration-versus-z loop changes shape: larger excursions show a different lag-induced restoring curvature and phase delay than small excursions, not reproducible by one parent parameter set with fixed relaxation_time."
    },
    "diagnostic_groups": [
      {
        "name": "elastic_load",
        "expression": "spring_constant*(1 + cubic_stiffness_coefficient*z**2)*z/mass",
        "role": "instantaneous delayed restoring acceleration magnitude from the parent elastic branch"
      },
      {
        "name": "relaxation_mismatch",
        "expression": "x - z",
        "role": "driving mismatch for internal support relaxation that controls hysteretic lag"
      },
      {
        "name": "drag_level",
        "expression": "(damping_coefficient*Abs(v) + nonlinear_drag_coefficient*v**2)/mass",
        "role": "dissipative strength scale relative to inertial acceleration"
      }
    ],
    "activation_condition": "Observable when |z| is large enough that support microstructural relaxation plausibly depends on strain level, while relaxation_time remains comparable to the oscillation timescale so lag is neither negligible nor fully frozen.",
    "train_hidden_contrast": "In training, moderate amplitudes already reveal some amplitude dependence of lag; in holdout, larger but still admissible excursions strengthen the same deformation-dependent relaxation effect rather than introducing a different mechanism.",
    "continuation_path": "Recover the parent law in the limit where the relaxation rate is deformation-independent, e.g. the coefficient of strain dependence tends to zero.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A realistic strain-dependent relaxation law is often implemented through an internal configurational state controlling support conditioning or anelastic saturation; existing x, v, and z do not separately encode this evolving internal phase, so one additional state is the natural minimal freedom if the refinement is written mechanistically rather than as an ad hoc coefficient tweak.",
    "gap_statement": "The current model assumes a single constant relaxation timescale for the support, so hysteretic lag has one fixed phase character across amplitudes.",
    "baseline_assumption": "The support relaxation toward displacement occurs with a constant linear timescale independent of deformation history and strain level.",
    "scientific_mechanism": "Passive amplitude-dependent anelastic relaxation or conditioning of the support, causing the internal load-transfer kinetics to change with deformation state while remaining dissipative and sign-symmetric.",
    "affected_symbols": [
      "x",
      "z",
      "relaxation_time"
    ],
    "rationale": "The parent already includes delayed elasticity through z, but its scored target mapping uses only one fixed relaxation phase set by (x-z)/relaxation_time. Vary deformation amplitude through the existing initial-condition protocol while holding mass and dissipation parameters fixed. Then compare small- and larger-excursion trajectories when relaxation_time is of the same order as the oscillation period. In the parent, one shared parameter set can change overall lag strength but cannot make the acceleration-versus-z relationship exhibit weak hysteresis at small amplitude and stronger or differently curved lag at larger amplitude beyond what the existing cubic elastic term alone produces, because the lag kinetics remain amplitude-blind. A child with strain-dependent support conditioning changes the target mapping itself, not only an auxiliary trajectory: dv_dt changes because the restoring load delivered through z now depends on an evolving deformation-sensitive relaxation phase. This is scientifically admissible for viscoelastic supports, preserves continuity and odd symmetry under simultaneous sign reversal, and reduces back to the parent when the conditioning effect is removed. Limitation: if all observed motions stay in a very small-strain regime or relaxation is either much faster or much slower than oscillation, the contrast may be too weak to identify."
  },
