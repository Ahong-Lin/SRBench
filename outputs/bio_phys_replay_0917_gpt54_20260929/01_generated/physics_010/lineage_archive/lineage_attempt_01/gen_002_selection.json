{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The resistive contribution to acceleration is a single linear gain of velocity, -(damping_coefficient/mass)*v, so at fixed x the target depends affinely on v with constant slope independent of speed.",
      "child_relation": "Replace the idealized linear resistance with amplitude-dependent drag that remains odd in v but grows more strongly at larger |v|, so at fixed x the target-versus-v curve bends and its effective damping slope increases with speed.",
      "affected_inputs": [
        "v",
        "damping_coefficient"
      ],
      "observable_effect": "Across trajectories started with different initial speeds while mass, spring_constant, and cubic_stiffness_coefficient are held fixed, large-|v| segments decay faster than a single linear damping law predicts, while near v≈0 the response approaches the parent law."
    },
    "diagnostic_groups": [
      {
        "name": "restoring_load",
        "expression": "(spring_constant*(1 + cubic_stiffness_coefficient*x**2)*x)/mass",
        "role": "Elastic contribution separated from resistance"
      },
      {
        "name": "speed_scale",
        "expression": "Abs(v)",
        "role": "Regime indicator for whether resistance remains approximately linear or enters stronger speed dependence"
      },
      {
        "name": "linear_damping_load",
        "expression": "(damping_coefficient*v)/mass",
        "role": "Parent resistive contribution used as the low-speed reference"
      }
    ],
    "activation_condition": "Observable when the experiment includes a spread of velocity magnitudes such that inertial or elastic motion produces both small-|v| intervals and finite-speed intervals where additional drag curvature is not negligible; near |v|≈0 the child should reduce to the parent within measurement resolution.",
    "train_hidden_contrast": "In training, moderate speeds already show slight excess damping relative to the linear law; in holdout, larger speeds extend the same monotone curvature so the mismatch of any single refitted linear damping coefficient becomes clearer.",
    "continuation_path": "Recover the parent law in the low-speed limit or by setting the nonlinear drag strength to zero.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model treats resistance as exactly proportional to velocity over the full accessible speed range, omitting the common finite-speed departure from Stokes-like drag.",
    "baseline_assumption": "The resistance is smooth and depends only on instantaneous velocity.",
    "scientific_mechanism": "Velocity-dependent resistance remains dissipative and odd under velocity reversal but acquires nonlinear speed dependence from fluid/air drag or internal friction beyond the strictly linear regime.",
    "affected_symbols": [
      "v",
      "damping_coefficient",
      "mass"
    ],
    "rationale": "A realistic next refinement is to relax the parent's full-range linear-damping assumption while keeping the same states and symmetry constraints. The parent target mapping from observed states to dv_dt is the sum of the existing elastic term and a resistive term with one fixed slope in v. Varying initial conditions already changes the visited velocity range under the current observation protocol, so this mechanism can be activated without adding inputs or hidden states. Hold mass, spring_constant, damping_coefficient, and cubic_stiffness_coefficient fixed, and compare portions of trajectories with small versus larger |v|: the parent predicts the same incremental damping per unit velocity everywhere, whereas the child predicts stronger deceleration at larger speeds and near-parent behavior close to rest. This is a genuine target-mapping change, not merely an auxiliary-trajectory change, because dv_dt at the same x but different |v| departs from an affine dependence on v. The refinement is scientifically admissible provided the explored speed range is large enough that nonlinear drag is measurable but not so extreme that other omitted effects dominate. If all observed speeds are very small, the contrast may be weak and the parent remains an adequate approximation."
  },
