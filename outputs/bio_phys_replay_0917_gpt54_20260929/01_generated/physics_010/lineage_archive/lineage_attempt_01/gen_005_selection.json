{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The restoring contribution to dv_dt is odd in z with a fixed cubic stiffening factor, so after conditioning states are fixed the elastic slope-versus-deformation relation is determined by one shared monotone cubic law.",
      "child_relation": "Replace the purely cubic amplitude dependence of the restoring law with a saturating odd nonlinearity in deformation, so the incremental restoring slope initially follows the parent-like small-strain law but bends over at larger |z| instead of growing indefinitely.",
      "affected_inputs": [
        "z"
      ],
      "observable_effect": "Across trajectories that reach small versus moderate-to-large internal deformation |z|, the child predicts weaker-than-cubic growth of peak restoring acceleration at large amplitude, giving reduced hardening of turning-point acceleration compared with the parent."
    },
    "diagnostic_groups": [
      {
        "name": "elastic_load",
        "expression": "spring_constant*z",
        "role": "baseline linear restoring scale"
      },
      {
        "name": "duffing_scale",
        "expression": "cubic_stiffness_coefficient*z**2",
        "role": "parent amplitude-dependent stiffening measure"
      },
      {
        "name": "anelastic_rate",
        "expression": "((1 + conditioning_strain_coefficient*c)/relaxation_time)*(x - z)",
        "role": "internal lag regime controlling which deformation levels are sampled"
      }
    ],
    "activation_condition": "Visible when trajectories explore a regime with |cubic_stiffness_coefficient*z**2| not small compared with 1, so the parent's cubic hardening would materially change acceleration; weakly visible in the small-deformation limit.",
    "train_hidden_contrast": "In training, modest amplitudes show only slight deviation from linear stiffness; in holdout, larger admissible amplitudes extend the same trend and reveal that restoring acceleration grows sub-cubically rather than continuing the parent's fixed cubic hardening.",
    "continuation_path": "Recover the parent by taking the saturation scale to infinity or, equivalently, restricting to sufficiently small |z| where the refined restoring law has the same leading linear-plus-cubic expansion.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the finite-amplitude support nonlinearity is well represented over the full admissible deformation range by one polynomial cubic correction with no saturation of incremental stiffness.",
    "baseline_assumption": "The support response is linear over the full displacement range.",
    "scientific_mechanism": "Geometric/material stiffening that is Duffing-like at moderate strain but softens relative to a pure cubic extrapolation as fibers, linkage geometry, or local compliance redistribution approach a finite reconfiguration range while remaining passive and odd under sign reversal.",
    "affected_symbols": [
      "z",
      "spring_constant",
      "cubic_stiffness_coefficient"
    ],
    "rationale": "A realistic next refinement is to relax the parent's fixed cubic hardening assumption rather than add a new process. The parent target mapping from observed states to acceleration contains a single deformation gain curve: for fixed v, c, and x through z, dv_dt depends on z through one odd polynomial restoring law whose curvature is locked by one shared cubic coefficient. Varying initial displacement while holding parameters fixed changes the explored |z| range, but the parent necessarily predicts that peak restoring acceleration continues to steepen with z according to that same cubic trend. A child with a saturating odd stiffness law changes the target mapping itself, not only auxiliary trajectories, because dv_dt at the same supplied z and v differs systematically: near z=0 it matches the parent asymptotically, while at larger |z| its slope and curvature bend over. This is observable when admissible motions drive the internal deformation into moderate strain, especially near turning points where v is small and the elastic term dominates acceleration. One shared refit of the parent parameters cannot generally reproduce both the small-amplitude near-Duffing behavior and the reduced large-amplitude hardening, because increasing or decreasing the cubic coefficient changes curvature globally rather than producing the child’s crossover from cubic-like growth to saturation. Limitation: if all sampled trajectories stay in the infinitesimal-strain regime, the refinement is practically unidentifiable and the parent is recovered."
  },
