{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With S varied and k_cat, E_total, and K_M held fixed, v0 is a rectangular hyperbola with a single half-saturation scale K_M and fixed low-S slope k_cat*E_total/K_M.",
      "child_relation": "Relax the assumption that all active sites bind and turn over substrate independently with one shared affinity scale by allowing mild substrate inhibition from a second, nonproductive substrate interaction at higher S, so the S-to-v0 map bends away from the parent hyperbola after the initial rise.",
      "affected_inputs": [
        "S"
      ],
      "observable_effect": "Across a substrate sweep at fixed enzyme and buffer conditions, the child agrees with the parent at low-to-moderate S but shows reduced approach to saturation, or a broad peak followed by flattening/decline at higher S, which one Michaelis-Menten curve with one shared parameter set cannot reproduce."
    },
    "diagnostic_groups": [
      {
        "name": "lowS_ratio",
        "expression": "S/K_M",
        "role": "baseline occupancy regime where parent and child nearly coincide when substrate inhibition is weak"
      },
      {
        "name": "highS_load",
        "expression": "S",
        "role": "experimental substrate range over which an added inhibitory substrate interaction could become visible"
      }
    ],
    "activation_condition": "Observable when substrate is extended into a high-concentration regime where an additional nonproductive substrate-binding mode becomes appreciable relative to catalytic binding; practically, this is at S comparable to or above the inhibitory binding scale, while low-S measurements remain in the Michaelis-like regime.",
    "train_hidden_contrast": "The same substrate sweep mechanism is present throughout: training may mostly show the usual monotone rise and early saturation, while holdout extending to higher S reveals extra downward curvature or a peak from the same high-S inhibitory interaction.",
    "continuation_path": "In the limit of vanishing inhibitory interaction strength, or when all sampled S stay far below the inhibitory binding scale, the model reduces to the parent Michaelis-Menten law.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent assumes substrate only forms the productive Michaelis complex; it omits the realistic possibility that excess substrate can also occupy a nonproductive inhibitory site or dead-end complex, altering the measured v0(S) mapping at high substrate.",
    "baseline_assumption": "All active sites are equivalent and act independently with a single productive substrate-binding mode and no substrate-dependent self-inhibition.",
    "scientific_mechanism": "Substrate inhibition via additional nonproductive substrate binding at high substrate concentration, reducing the fraction of enzyme in the catalytically competent complex during initial-rate measurements.",
    "affected_symbols": [
      "S",
      "K_M",
      "k_cat",
      "E_total"
    ],
    "rationale": "Varied condition: initial substrate concentration S is swept over a wide range. Held fixed: E_total and the buffer environment, with negligible product accumulation as in the parent setup. Parent response relationship: a monotone rectangular hyperbola with one fixed threshold scale K_M and no extra high-S curvature beyond saturation. Child response relationship: the same low-S rise is retained, but at sufficiently high S an extra substrate-dependent nonproductive occupancy reduces productive turnover, producing stronger downward curvature than the parent and potentially a broad maximum. This changes the scored target mapping v0(S), not merely an auxiliary trajectory. The contrast is scientifically admissible for enzymes known to exhibit substrate inhibition when substrate reaches concentrations comparable to an inhibitory binding constant; if experiments never access that regime, the refinement may be practically unidentifiable and the parent remains adequate there. A single refit of the parent parameters cannot simultaneously match the low-S slope and the high-S suppression/peak because Michaelis-Menten is strictly monotone increasing to a plateau for all positive parameters and lacks the extra curvature needed at high substrate."
  },
