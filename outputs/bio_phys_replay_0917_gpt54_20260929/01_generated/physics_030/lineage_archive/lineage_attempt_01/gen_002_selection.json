{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The hot-body cooling rate is an instantaneous odd-in-difference function of the current temperature contrast only, dT_h_dt = -G(|T_h-T_c|)(T_h-T_c)/heat_capacity_h, with one shared conductance law throughout the entire relaxation.",
      "child_relation": "Retain isolation and two-body exchange but allow the effective contact conductance itself to relax toward its contrast-dependent value with finite response time, so the target depends on both current contrast and a lagged contact state. The same instantaneous temperature difference can then produce different dT_h_dt values at early versus late times.",
      "affected_inputs": [
        "T_h",
        "T_c",
        "contact_conductance",
        "conductance_contrast_coeff"
      ],
      "observable_effect": "For trajectories with the same instantaneous temperature difference magnitude reached at different stages of the run, the child permits different cooling rates because the contact has not yet fully adjusted after large initial contrasts; the parent predicts a single rate for each current contrast."
    },
    "diagnostic_groups": [
      {
        "name": "deltaT",
        "expression": "T_h - T_c",
        "role": "Instantaneous driving temperature difference across the contact"
      },
      {
        "name": "abs_deltaT",
        "expression": "Abs(T_h - T_c)",
        "role": "Magnitude of thermal contrast controlling conductance strengthening"
      },
      {
        "name": "equilibrium_weighted_temp",
        "expression": "(heat_capacity_h*T_h + heat_capacity_c*T_c)/(heat_capacity_h + heat_capacity_c)",
        "role": "Conserved mean temperature under isolation, useful to separate allowed trajectories from environmental leakage"
      }
    ],
    "activation_condition": "Observable when the contact property adjusts on a timescale not negligible compared with the thermal equilibration timescale, especially after a large initial |T_h-T_c| so that the contrast-dependent preferred conductance changes appreciably during the run.",
    "train_hidden_contrast": "Within training trajectories, large early temperature contrasts followed by smaller later contrasts expose stronger transient lag; in holdout, the same mechanism persists as a mismatch between early-time and late-time cooling rates at comparable instantaneous |T_h-T_c| values.",
    "continuation_path": "Recover the parent by taking the contact-adjustment time to zero, so the conductance state instantaneously equals contact_conductance*(1 + conductance_contrast_coeff*Abs(T_h - T_c)).",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A finite response delay cannot be represented with only the current temperatures because the target would remain a memoryless function of instantaneous contrast. One additional state is needed to encode the lagged contact condition while preserving the existing temperatures and isolation constraint.",
    "gap_statement": "The current model assumes the contact conductance responds instantaneously to the current temperature difference, excluding finite thermal/mechanical adjustment of the interface that creates hysteresis in the cooling-rate-versus-contrast relation during one relaxation run.",
    "baseline_assumption": "The thermal contact conductance is constant and has no response delay.",
    "scientific_mechanism": "Finite-time relaxation of the interfacial conductance toward its contrast-dependent value, representing delayed establishment of the effective thermal contact.",
    "affected_symbols": [
      "T_h",
      "T_c",
      "contact_conductance",
      "conductance_contrast_coeff"
    ],
    "rationale": "A realistic next refinement is to relax the parent's memoryless contact law rather than adding an unrelated heat-loss path. The parent target mapping has a single-phase shortcut: once T_h and T_c are known, dT_h_dt is fixed, so all points with the same instantaneous temperature difference collapse to one cooling rate regardless of whether they occur immediately after contact or near equilibrium. Holding heat capacities fixed and preserving isolation, vary the stage of the trajectory while examining repeated or comparable values of |T_h-T_c| during relaxation. In the child, a lagged contact state makes the early-time slope shallower or otherwise offset relative to the later-time slope at the same instantaneous contrast because the interface conductance has not fully caught up to the large initial drive. This is a true change in the scored target mapping, not merely an auxiliary-trajectory modification, because dT_h_dt at given observed T_h and T_c is no longer unique without the added state. The effect is admissible when interfacial adjustment is not much faster than bulk thermal equilibration and when the contrast dependence of the preferred conductance is large enough to matter over the sampled temperature range. If the adjustment is effectively instantaneous, the parent is recovered exactly; if it is extremely slow or the contrast sensitivity is tiny, the refinement may be weak."
  },
