{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target maps the observed state pair (T_h, T_c) and conductance state g_contact to dT_h_dt through a single interfacial heat-flow pathway proportional to (T_h - T_c), with all transferred energy immediately and uniformly mixed into each body.",
      "child_relation": "Retain the same contrast-driven heat-flow pathway but relax the assumption of instantaneous internal equilibration in the hotter body by introducing a finite internal thermalization state that buffers incoming/outgoing heat before the bulk T_h responds, so the cooling rate depends not only on the present contrast but also on the internal lag state.",
      "affected_inputs": [
        "T_h",
        "T_c",
        "g_contact"
      ],
      "observable_effect": "For runs with similar instantaneous (T_h - T_c) and similar g_contact during the transient, the hotter-body cooling rate can be temporarily smaller in magnitude early and then larger later than the parent predicts because some extracted interfacial heat is first supplied from a hotter near-contact region before the bulk temperature fully follows."
    },
    "diagnostic_groups": [
      {
        "name": "delta_T",
        "expression": "T_h - T_c",
        "role": "Driving temperature contrast across the contact"
      },
      {
        "name": "C_h_eff",
        "expression": "heat_capacity_h*(1 + hot_capacity_temp_coeff*T_h/(hot_capacity_temp_scale + T_h))",
        "role": "Current effective bulk heat capacity of the initially hotter body"
      },
      {
        "name": "q_contact_over_Ch",
        "expression": "g_contact*(T_h - T_c)/(heat_capacity_h*(1 + hot_capacity_temp_coeff*T_h/(hot_capacity_temp_scale + T_h)))",
        "role": "Parent bulk cooling-rate scale from the contact flux"
      }
    ],
    "activation_condition": "Most visible when the hotter body internally equilibrates on a timescale comparable to or slower than the contact-adjustment and bulk cooling timescales, so an internal temperature lag can persist during the observed transient; weak when internal equilibration is much faster than heat exchange.",
    "train_hidden_contrast": "Within training, the same mechanism appears as early-time suppression of |dT_h_dt| followed by mid-transient catch-up at moderate to large temperature contrast; in holdout with stronger contrast or faster contact transfer, the same lag produces more pronounced curvature changes in the T_h trajectory and thus in the target mapping.",
    "continuation_path": "Recover the parent law in the limit of vanishing internal equilibration time or vanishing internal temperature split in the hotter body, where the added internal state remains slaved to T_h and the bulk stays effectively uniform.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A finite internal thermalization lag is a dynamical memory effect and cannot be represented by refitting existing static parameters or the existing conductance state alone; it requires one additional state to store the hotter body's internal nonequilibrium.",
    "gap_statement": "The current model still assumes the initially hotter body remains perfectly lumped internally even while allowing dynamic contact conductance and temperature-dependent heat capacity.",
    "baseline_assumption": "Each body remains spatially uniform in temperature.",
    "scientific_mechanism": "Finite internal thermal resistance within the initially hotter body creates a near-contact subregion that can cool faster than the bulk, introducing transient buffering between interfacial heat extraction and the observed bulk temperature response.",
    "affected_symbols": [
      "T_h",
      "T_c",
      "g_contact",
      "heat_capacity_h",
      "hot_capacity_temp_coeff",
      "hot_capacity_temp_scale"
    ],
    "rationale": "A realistic next refinement is to relax the hotter body's perfect internal mixing assumption while preserving isolation and heat-flow direction. The parent target relation is effectively single-phase: once T_h, T_c, and g_contact are known, the hotter-body cooling rate is fixed by one instantaneous bulk balance. Vary the ratio of internal equilibration time in the hotter body to the contact-driven cooling time, while holding the existing heat capacities, conductance law, and initial temperatures fixed. Under admissible conditions where internal thermalization is not much faster than the experiment, the child predicts a different dT_h_dt-versus-(T_h, T_c, g_contact) curvature: early in the run the observed bulk T_h cools more slowly than the parent because the contact mainly drains a hotter near-interface region, and later the bulk catches up as that internal gradient relaxes. A single refit of existing parent parameters cannot reproduce this transient phase-lag pattern across conditions, because changing heat capacity or conductance only rescales or smoothly retimes the same one-phase mapping rather than introducing state-dependent memory at fixed observed T_h, T_c, and g_contact. The effect is scientifically admissible only when internal gradients remain moderate so both absolute temperatures stay nonnegative and bounded, and it disappears in the fast-internal-equilibration limit, which cleanly recovers the parent."
  },
