{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target cooling rate is a linear function of the instantaneous temperature difference, dT_h_dt = -(contact_conductance/heat_capacity_h)*(T_h - T_c), with one fixed proportional gain for the entire trajectory.",
      "child_relation": "Retain heat flow through the same contact but relax the constant-conductance assumption so the effective transfer strength varies with the current inter-body temperature contrast, making dT_h_dt a nonlinear function of (T_h - T_c) even at fixed heat_capacity_h.",
      "affected_inputs": [
        "T_h",
        "T_c",
        "contact_conductance"
      ],
      "observable_effect": "Across runs or time segments with small versus large temperature differences, the cooling-rate-versus-temperature-difference curve is no longer a single straight line: the initial hot-stage slope differs from the near-equilibrium slope, producing trajectory curvature that one constant-gain parent law cannot match with one shared parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "deltaT",
        "expression": "T_h - T_c",
        "role": "instantaneous thermal driving difference across the contact"
      },
      {
        "name": "meanT",
        "expression": "(T_h + T_c)/2",
        "role": "bulk temperature level, useful to separate contrast-driven from absolute-temperature effects"
      },
      {
        "name": "energy_balance_check",
        "expression": "heat_capacity_h*T_h + heat_capacity_c*T_c",
        "role": "conserved total internal energy under isolated two-body exchange"
      }
    ],
    "activation_condition": "Observable when the admissible experiment spans a nontrivial range of temperature differences so that the contact physics is sampled both far from and near equilibrium; weak or absent if |T_h - T_c| stays in a narrow band where conductance is effectively constant.",
    "train_hidden_contrast": "In training, modest curvature appears as systematic deviation from a straight cooling-rate-versus-deltaT relation; in holdout with larger initial temperature contrast, the same mechanism strengthens that curvature rather than introducing a different process.",
    "continuation_path": "Recover the parent law in the limit where the effective conductance becomes independent of temperature difference over the sampled range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model idealizes the thermal contact as having a constant conductance, even though real interfaces often change effective conductance with the instantaneous temperature difference because contact microphysics and interstitial transport are not perfectly linear over the full approach to equilibrium.",
    "baseline_assumption": "The thermal contact conductance is constant and has no response delay.",
    "scientific_mechanism": "Temperature-difference-dependent thermal contact conductance, causing nonlinear heat-transfer strength across the interface while preserving isolation and energy conservation.",
    "affected_symbols": [
      "T_h",
      "T_c",
      "contact_conductance",
      "heat_capacity_h",
      "heat_capacity_c"
    ],
    "rationale": "A natural next refinement is to keep the same two-body isolated exchange mechanism but replace the constant contact-gain assumption with a contrast-dependent one. Vary the instantaneous temperature difference along the observed trajectory while holding the body heat capacities fixed and the system isolated. In the parent, dT_h_dt depends on T_h and T_c only through a single constant multiple of deltaT, so a plot of cooling rate against deltaT is forced to be linear with one slope for the entire experiment. In the child, that slope changes with deltaT, so early-time large-contrast cooling and late-time near-equilibrium cooling cannot both be matched by one shared parent parameter set if the conductance changes appreciably across that range. This is a genuine target-mapping change, not merely an auxiliary-state modification, because the scored derivative of T_h itself changes as a function of the observed states. The effect is scientifically admissible provided the sampled temperature contrast is broad enough for contact nonlinearity to activate; if the experiment stays close to equilibrium, the parent may remain an adequate approximation."
  },
