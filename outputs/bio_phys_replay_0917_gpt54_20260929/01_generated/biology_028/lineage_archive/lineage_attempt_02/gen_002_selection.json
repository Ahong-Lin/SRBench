{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The clearance loss from C is a single Michaelis-like function of I_late, so dC_dt changes monotonically with one fixed activation scale late_half_saturation at all C levels.",
      "child_relation": "Make clearance activation depend jointly on I_late and current contagious occupancy C, so the effective activation of loss from C bends differently at low versus high C rather than following one shared I_late threshold curve.",
      "affected_inputs": [
        "C",
        "I_late",
        "late_half_saturation"
      ],
      "observable_effect": "Across trajectories with similar I_late but different C, the decline in dC_dt from the same latent inflow can begin earlier and more steeply at higher C; the parent cannot create this C-dependent bending because its loss activation is controlled only by I_late."
    },
    "diagnostic_groups": [
      {
        "name": "late_clearance_activation",
        "expression": "I_late/(late_half_saturation + I_late)",
        "role": "Parent later-stage-triggered activation fraction for clearance from the contagious pool"
      },
      {
        "name": "contagious_burden_ratio",
        "expression": "C/(C + late_half_saturation)",
        "role": "Dimensionless measure of whether current contagious burden is large enough to modify effective removal pressure"
      },
      {
        "name": "stage_balance",
        "expression": "stage_progression_rate*C/(clearance_rate*(I_late + 1))",
        "role": "Approximate indicator of whether buildup into the late stage is fast enough for delayed versus accelerated depletion regimes"
      }
    ],
    "activation_condition": "Observable when C reaches the same order as the saturation scale while I_late is intermediate rather than negligible, so neither pure inflow dominance nor fully saturated late-stage clearance masks the joint effect; practically C ~ late_half_saturation and 0 < I_late < a few times late_half_saturation during the cohort peak/decline transition.",
    "train_hidden_contrast": "In training, the mechanism appears as different onset curvature of the C peak and early decline as trajectories span low and moderate contagious burdens; in holdout with larger stage occupancy the same dependence extends to stronger acceleration of decline at high C for comparable I_late, rather than merely rescaling the whole loss term.",
    "continuation_path": "Recover the parent law when the additional C-dependence is turned off or in the low-burden regime C << the new modulation scale, leaving clearance activation effectively dependent only on I_late.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes that activation of clearance from the observed contagious pool depends only on later-stage occupancy, ignoring burden-dependent removal pressure from the current contagious pool itself once many individuals are simultaneously symptomatic, isolated, or exhausted.",
    "baseline_assumption": "The per-capita clearance hazard from C has one fixed saturating dependence on I_late and is otherwise independent of the current contagious occupancy C.",
    "scientific_mechanism": "Burden-dependent clearance activation: as the contagious pool becomes large, clinical recognition, self-isolation, and symptom-driven withdrawal can increase effective departure from C before the later stage alone would predict.",
    "affected_symbols": [
      "C",
      "I_late",
      "late_half_saturation",
      "clearance_rate"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-threshold assumption for clearance activation. Hold fixed progression_rate, stage_progression_rate, clearance_rate, initial conditions, and the no-new-infections cohort setting, and compare times or parameter settings that produce similar I_late but different C during the rise and near-peak phases. In the parent, dC_dt = progression_rate*L - clearance_rate*C*f(I_late), so for fixed L and I_late the slope with respect to C is just a linear loss with one activation fraction f(I_late); any curvature in the transition from growth to decline is driven only by how I_late evolves. A child in which the effective activation also depends on C changes the scored target mapping itself, because even if the same observed L, C, and I_late are supplied, dC_dt now differs at equal I_late across different C values. This is scientifically admissible when contagious burden is large enough that departure processes from C accelerate before I_late fully accumulates. The contrast is observable under the stated initial-condition protocol because C starts at zero and naturally grows into a regime where C and I_late are both nonzero; no unsampled intervention is required. A single refit of the parent parameters cannot reproduce this cross-condition contrast if trajectories contain matched I_late but different C, because the parent uses one shared I_late activation curve for all C levels."
  },
