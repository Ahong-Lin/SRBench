{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The inflow from latency to the observed contagious stage is linear in L with a constant per-capita progression_rate, so for fixed L the target mapping contributes a straight proportional arrival term independent of current contagious burden.",
      "child_relation": "Release the assumption of memoryless latent exit by allowing progression competence to mature within latency, so the effective arrival hazard into C increases over time spent latent; the mapping from latent occupancy to dC_dt becomes history-dependent through an internal latent-phase variable rather than a single linear gain on L.",
      "affected_inputs": [
        "L",
        "C",
        "I_late",
        "progression_rate"
      ],
      "observable_effect": "Compared at fixed initial latent burden and fixed clearance parameters, the child produces a more delayed takeoff and more concentrated rise of C, with weaker early inflow and stronger mid-course inflow than any single constant progression_rate parent can match simultaneously."
    },
    "diagnostic_groups": [
      {
        "name": "late_activation",
        "expression": "I_late/(late_half_saturation + I_late)",
        "role": "Current strength of late-stage-triggered clearance activation"
      },
      {
        "name": "clearance_modulation",
        "expression": "(late_half_saturation + C)/(late_half_saturation + 2*C)",
        "role": "Burden-dependent moderation of observed-stage clearance"
      },
      {
        "name": "latent_to_contagious_flux_parent",
        "expression": "progression_rate*L",
        "role": "Parent's constant-hazard arrival flux from latent to contagious"
      }
    ],
    "activation_condition": "Visible when observation begins with a substantial latent cohort and negligible initial C and I_late, so latent members have time to age before most departures occur; strongest when the latent progression timescale is not much faster than the 0 to 30 observation window.",
    "train_hidden_contrast": "In training, the same mechanism appears as a delayed initial rise followed by a sharper mid-interval increase in C; in holdout, this extends to different progression-rate regimes where the timing and sharpness of the C peak shift together, not just its overall scale.",
    "continuation_path": "In the limit where latent-stage maturation is effectively instantaneous or its substage progression collapses to a single exponential hazard, the child reduces back to the parent's constant progression_rate*L arrival law.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A memoryless ODE state L cannot encode time-since-entry effects by parameter refitting alone; one additional latent substage is the minimal state needed to represent latent-phase maturation while preserving the existing tracked states.",
    "gap_statement": "The current model assumes all latent individuals are equally ready to become contagious at every instant, omitting within-latent-stage maturation that can delay and sharpen entry into the contagious pool.",
    "baseline_assumption": "Progression from latency to contagiousness follows a single constant hazard acting uniformly across all latent individuals.",
    "scientific_mechanism": "Stage-structured latency: newly infected latent individuals first occupy an earlier latent substage and only later become eligible to enter the observed contagious stage, producing a non-exponential latent dwell-time distribution.",
    "affected_symbols": [
      "L",
      "C",
      "progression_rate"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-phase latent progression assumption. Under the current initial-condition protocol, all 500 individuals start in L and none in C or I_late, so the target dC_dt is initially driven entirely by progression_rate*L. That creates a fixed proportional mapping from L to C inflow with no latent-age effect. Scientifically, incubation and presymptomatic development are often not memoryless; individuals may require physiological maturation before becoming observably contagious. Adding one latent substage changes the scored target mapping itself, not just auxiliary trajectories, because the arrival term into C is no longer a constant-gain function of L. The observable contrast is that, holding clearance_rate, stage_progression_rate, and late_half_saturation fixed, the child can show slower early growth of C and a steeper later rise and shifted peak once latent maturation accumulates, whereas the parent with one shared refitted progression_rate can only trade off early versus later inflow uniformly. This contrast is admissible and testable within the given experiment because the cohort starts entirely latent and is observed over finite time, so latent-aging effects directly shape the measured C trajectory before clearance dominates. A parent refit may approximate one part of the curve but cannot simultaneously reproduce both delayed onset and concentrated mid-course inflow across such conditions with a single constant latent-exit hazard."
  },
