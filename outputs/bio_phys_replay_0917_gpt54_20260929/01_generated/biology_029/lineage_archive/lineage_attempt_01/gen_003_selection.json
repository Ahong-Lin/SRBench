{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "For fixed c0, p_trigger, and rho, the active-regime suppression grows monotonically with prevalence excess through a single saturation shape set entirely by the normalized excess (p-p_trigger)/p_trigger, so the post-trigger contact-rate decline has one shared curvature pattern across thresholds.",
      "child_relation": "Keep the same trigger-centered activation but replace the normalized excess scale with a threshold-dependent normalization so that the steepness and saturation distance above threshold depend on the trigger level itself; low-trigger policies can tighten more abruptly after crossing than high-trigger policies, or vice versa, even at the same normalized excess.",
      "affected_inputs": [
        "p",
        "p_trigger",
        "rho",
        "c0"
      ],
      "observable_effect": "Holding c0 and rho fixed, compare two policies with different p_trigger. As p rises above each trigger, the parent predicts the same suppression trajectory when plotted against (p-p_trigger)/p_trigger, whereas the child predicts different post-trigger curvature or approach-to-saturation across those trigger values."
    },
    "diagnostic_groups": [
      {
        "name": "x_rel",
        "expression": "(p - p_trigger)/p_trigger",
        "role": "parent’s relative prevalence excess above the trigger"
      },
      {
        "name": "x_abs",
        "expression": "p - p_trigger",
        "role": "absolute prevalence excess that can govern administrative tightening distance"
      },
      {
        "name": "inv_trigger",
        "expression": "1/p_trigger",
        "role": "how strongly a given absolute excess is amplified when the trigger is low"
      }
    ],
    "activation_condition": "Observable when p is at or moderately above p_trigger and the sampled p_trigger values span a nontrivial range, so that equal relative excess does not imply equal absolute excess across conditions.",
    "train_hidden_contrast": "In training, varying p at fixed p_trigger reveals the active-regime bend; in holdout, the same mechanism is exposed by comparing that bend across different p_trigger values at similar relative excess levels.",
    "continuation_path": "Recover the parent law in the limit where the threshold-dependent rescaling reduces to the current normalized excess by p_trigger, i.e. no extra trigger dependence in the active-regime growth scale.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent assumes that once control activates, the post-trigger tightening shape depends only on relative excess prevalence and not on the absolute trigger level itself.",
    "baseline_assumption": "A single normalized prevalence-excess scale ((p-p_trigger)/p_trigger) fully determines active-regime suppression curvature for all trigger settings.",
    "scientific_mechanism": "Administrative response and behavioral escalation often depend on both crossing the trigger and how far prevalence exceeds it in absolute terms, making low-threshold and high-threshold policies differ in how quickly suppression deepens after activation.",
    "affected_symbols": [
      "p",
      "p_trigger",
      "rho",
      "c0"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single shared active-regime shape across all trigger settings. Vary p and p_trigger while holding c0 and rho fixed. In the parent, any two cases with the same relative excess (p-p_trigger)/p_trigger produce the same suppression fraction because p_trigger only enters through that normalization and threshold gate. Scientifically, this is restrictive: when the trigger is very low, a small absolute rise above it may already correspond to substantial alarm or enforcement intensity, whereas a higher trigger may require a larger absolute excess before contacts are pushed much closer to the maximum suppression. The child therefore changes the target mapping itself, not merely an auxiliary interpretation, by making the active-regime slope/curvature above threshold depend on p_trigger. This contrast is admissible when sampled trigger values vary and prevalence reaches above-threshold conditions; it is weak if all data lie far below threshold or if p_trigger is nearly constant. A single refit of the parent cannot reproduce different post-trigger curvature across p_trigger at matched relative excess, because its normalized-excess form enforces one universal active-regime profile."
  },
