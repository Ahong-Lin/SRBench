{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "With a fixed inactivation parameter, the target mapping dA_dt(A,C)=k_cleave*C-k_inactivation*A/(1+inactivation_capacity*A) gives one shared time-independent loss law, so for matched A and C the net accumulation rate is the same regardless of prior activation history.",
      "child_relation": "Let the inactivation capacity relax over time through progressive exhaustion of a finite inhibitory/protective environment, so the loss term felt at a given A changes with assay history; early and late times with similar A and C can then have different dA_dt because effective inactivation protection has decayed.",
      "affected_inputs": [
        "A",
        "C",
        "inactivation_capacity",
        "t"
      ],
      "observable_effect": "Across runs or time windows with the same initial Z and A seed but different elapsed activation progress, net active accumulation turns over earlier and declines more sharply than the parent predicts; the same A and C can correspond to lower dA_dt later in the trajectory."
    },
    "diagnostic_groups": [
      {
        "name": "free_inactivation_flux",
        "expression": "k_inactivation*A/(1 + inactivation_capacity*A)",
        "role": "Current parent loss law acting on free active protease"
      },
      {
        "name": "gross_activation_flux",
        "expression": "k_cleave*C",
        "role": "Complex-mediated source term for active protease"
      },
      {
        "name": "net_balance_indicator",
        "expression": "k_cleave*C - k_inactivation*A/(1 + inactivation_capacity*A)",
        "role": "Parent instantaneous target mapping to compare against history-dependent deviations"
      }
    ],
    "activation_condition": "Observable when activation proceeds long enough that accumulated active protease substantially perturbs the protective/inhibitory capacity over the assay window, i.e. A reaches the reciprocal scale set by inactivation_capacity and remains appreciable for sustained times rather than only brief low-A transients.",
    "train_hidden_contrast": "In training, moderate activation already shows mild early protection followed by stronger late loss; in holdout, higher precursor excess or longer observation accentuates the same history dependence, shifting the turnover time without changing the basic autocatalytic onset.",
    "continuation_path": "Recover the parent by taking the protective/inhibitory environment to remain effectively constant over the observation window, so any new state controlling inactivation capacity stays fixed at its initial value or its depletion rate tends to zero.",
    "freedom_change": "parameter_to_state",
    "promoted_symbol": "inactivation_capacity",
    "promotion_reason": "A history-dependent inactivation law cannot be represented with the existing fixed parameter because the target must depend on assay progress beyond instantaneous A and C; promoting the capacity parameter to a dynamic state is the minimal way to encode depletion of finite protection without adding an unrelated input.",
    "gap_statement": "The current model treats saturation of active-protease inactivation as a fixed property of the preparation, ignoring that finite inhibitor or protective capacity can be consumed during ongoing activation.",
    "baseline_assumption": "The parent assumes inactivation_capacity is constant in time and unaffected by cumulative exposure to active protease.",
    "scientific_mechanism": "Progressive depletion of a finite inhibitor/chaperone/protective buffering capacity makes free active protease inactivation less saturated later in the run, increasing effective loss at the same active concentration.",
    "affected_symbols": [
      "A",
      "C",
      "inactivation_capacity",
      "k_inactivation"
    ],
    "rationale": "A realistic next refinement is to relax the fixed-environment assumption behind the saturating inactivation term. In the parent, holding k_inactivation and inactivation_capacity fixed means dA_dt is fully determined by the instantaneous pair (A,C): source rises with C and loss follows one fixed saturating curve in A. Varying elapsed assay progress while holding initial Z, seed A, and all kinetic constants fixed therefore cannot change the dA_dt-versus-(A,C) mapping. In many zymogen preparations, however, apparent protection against active-protease loss reflects a finite inhibitor or stabilizing capacity that is consumed as activation proceeds. Then later in the same run, or in otherwise identical runs that spend longer at appreciable A, the effective loss term is larger than early on even at similar A and C. This changes the scored target mapping itself, not merely auxiliary trajectories, because dA_dt at given observed A and C depends on the depleted protection state. The contrast is admissible when activation is strong enough for cumulative active exposure to matter; if A stays very small or observations end early, the child collapses back near the parent and the effect may be weak. A single refitted parent parameter set cannot reproduce both early protected growth and later enhanced decline across such conditions because its inactivation curve is time-invariant once A is specified."
  },
