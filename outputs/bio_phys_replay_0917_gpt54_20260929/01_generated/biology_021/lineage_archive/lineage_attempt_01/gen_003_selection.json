{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "With fixed k_activation and saturation_capacity, the activation term is an instantaneous saturating function of A and Z, so once A and Z are known the target dA_dt has no memory of prior exposure and the rise of A is governed by a single autocatalytic phase opposed by inactivation.",
      "child_relation": "Introduce a transient reversible enzyme-zymogen complex as an additional occupied catalytic phase so net activation depends on how much active protease is free versus temporarily sequestered in processing precursor; the target then reflects a lagged transition from binding-limited occupancy growth to product-forming turnover rather than a single instantaneous phase.",
      "affected_inputs": [
        "A",
        "Z"
      ],
      "observable_effect": "At fixed initial A and varying initial Z, the child can show an early-time reduction in dA_dt despite larger Z because active protease is transiently tied up in complex, followed later by stronger activation as turnover releases product; the parent predicts only an immediate monotone increase of activation flux with Z up to its saturation law."
    },
    "diagnostic_groups": [
      {
        "name": "free_fraction_proxy",
        "expression": "A/(A + Z + 1.0e-12)",
        "role": "Crude occupancy indicator for whether active protease is likely mostly free or mostly engaged with abundant precursor"
      },
      {
        "name": "encounter_load",
        "expression": "A*Z",
        "role": "Mass-action contact scale driving both parent activation and the proposed transient sequestration regime"
      },
      {
        "name": "precursor_excess",
        "expression": "Z/(A + 1.0e-12)",
        "role": "Regime marker for strong enzyme sequestration when precursor greatly exceeds active seed"
      }
    ],
    "activation_condition": "Most visible when precursor is initially in large excess over the active seed so precursor_excess is high and binding/processing is not infinitely fast relative to turnover; then a non-negligible fraction of A can be temporarily complexed during the observed window.",
    "train_hidden_contrast": "Across trajectories with the same A(0) but different Z(0), both train and holdout retain the same early occupancy mechanism; holdout extends to stronger precursor excess where the delayed release from sequestration becomes more obvious.",
    "continuation_path": "Fast-complex limit or negligible complex occupancy recovers the parent law, where binding-adjustment is effectively instantaneous and the activation flux collapses back to a direct saturating function of A and Z.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "Transient catalytic sequestration is a dynamic occupancy variable, not recoverable from the current states alone without adding memory. A new state is needed to distinguish free active protease from total active-form material during processing.",
    "gap_statement": "The current model treats catalytic saturation as an algebraic correction to flux and assumes active protease remains instantaneously available for further autocatalysis, omitting transient sequestration in an enzyme-zymogen processing complex.",
    "baseline_assumption": "Relax the assumption that catalytic contact leads to immediate effective turnover with no dynamic occupancy memory; instead allow active protease to spend finite time in a bound processing state before releasing product.",
    "scientific_mechanism": "Reversible formation of a transient active-protease–zymogen complex followed by cleavage and release of active product creates a processing delay and temporary loss of free catalyst.",
    "affected_symbols": [
      "A",
      "Z",
      "k_activation",
      "saturation_capacity"
    ],
    "rationale": "A realistic next refinement is to replace the parent's memoryless saturation with explicit transient occupancy. The parent target mapping is effectively single-phase: for any observed A and Z, dA_dt is computed from one direct saturating activation term minus one inactivation term. Vary initial zymogen concentration Z(0) while holding the active seed A(0), mixing conditions, and inactivation setting fixed. Under admissible conditions with Z(0) much larger than A(0), real protease can become transiently sequestered in processing complexes, so the free catalyst available for further autocatalysis is reduced early even though total substrate is abundant. This changes the target mapping itself, not just an auxiliary trajectory, because dA_dt for the same total A and Z can differ depending on occupancy history unless that occupancy is represented. Observable contrast: the child can show a slower early rise or delayed acceleration at high precursor excess, whereas the parent with one shared parameter set predicts an immediate monotone activation increase with larger Z through k_activation*A*Z/(1+saturation_capacity*A*Z). This is scientifically admissible in a well-mixed closed assay when binding and cleavage times are not negligible compared with the observation window. Limitation: if complex formation and turnover are both effectively instantaneous, the added state collapses to quasi-steady occupancy and the parent law is recovered."
  },
