{
  "plan": {
    "operation": "add_term",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With fixed resistance and capacitance, dV_C_dt depends only linearly on the voltage gap source_voltage - V_C, so all charging traces are single-exponential with one shared time constant.",
      "child_relation": "Add capacitor leakage as an extra discharge path proportional to V_C, so dV_C_dt depends on both the charging gap and the present capacitor voltage through a second linear channel; the effective approach rate and final saturation both change.",
      "affected_inputs": [
        "V_C",
        "source_voltage",
        "resistance",
        "capacitance"
      ],
      "observable_effect": "Compared across experiments with different source_voltage but the same component values, the leaked capacitor saturates below source_voltage and shows a different late-time curvature than the ideal single-exponential parent."
    },
    "diagnostic_groups": [
      {
        "name": "drive_gap",
        "expression": "source_voltage - V_C",
        "role": "instantaneous charging drive from the source through the resistor"
      },
      {
        "name": "stored_voltage",
        "expression": "V_C",
        "role": "state that would feed a leakage discharge branch"
      },
      {
        "name": "parent_rate",
        "expression": "(source_voltage - V_C)/(resistance*capacitance)",
        "role": "ideal RC charging slope used by the parent model"
      }
    ],
    "activation_condition": "Observable when the capacitor has a finite leakage path on time scales comparable to the charging experiment, i.e. the leakage time constant is not much longer than resistance*capacitance and measurements extend into mid-to-late charging.",
    "train_hidden_contrast": "In training, leakage appears as slightly reduced late-time slope and sub-source saturation; in holdout with broader observation windows or larger source_voltage, the same mechanism more clearly reveals the lowered asymptote and altered curvature.",
    "continuation_path": "Recover the parent law in the limit of vanishing leakage conductance, equivalently infinite leakage resistance.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model omits capacitor leakage, treating the capacitor as perfectly insulating so no stored charge can drain except through the intended charging branch.",
    "baseline_assumption": "There is no leakage path across the capacitor.",
    "scientific_mechanism": "A real capacitor can have a finite parallel leakage path through dielectric imperfections, producing a discharge current proportional to its own voltage during charging.",
    "affected_symbols": [
      "V_C",
      "source_voltage",
      "resistance",
      "capacitance"
    ],
    "rationale": "A realistic next refinement is to add leakage across the capacitor. The parent target mapping is a fixed-environment single-time-constant law: for fixed resistance and capacitance, changing source_voltage only rescales the same exponential approach, and the final voltage always equals source_voltage. Under the child mechanism, holding resistance and capacitance fixed while varying source_voltage still gives monotone charging, but the target slope depends on both source_voltage - V_C and V_C because leakage opposes charge accumulation. The concrete contrast is that late in the trajectory the parent predicts approach to source_voltage with a single shared asymptote ratio V_C/source_voltage -> 1, whereas the child predicts approach to a lower steady value set by the balance of resistor current and leakage current. A single refit of the parent parameters cannot reproduce both the early-time charging rate and the reduced steady-state fraction across observation windows when leakage is appreciable, because the parent ties transient rate and asymptote through one ideal RC branch. This effect is admissible when leakage is not negligible over the sampled time range; if leakage is extremely weak or data stop very early, the refinement becomes hard to identify, which should be stated rather than exaggerated."
  },
