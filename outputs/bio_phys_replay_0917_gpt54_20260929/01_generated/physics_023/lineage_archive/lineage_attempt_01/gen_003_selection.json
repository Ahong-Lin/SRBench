{
  "plan": {
    "operation": "add_term",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "The parent maps capacitor voltage to its derivative through a single monotone RC charging phase with voltage-dependent capacitance and leakage, so the charging rate decreases smoothly from its initial value without an additional transient stage.",
      "child_relation": "Add a parasitic series inductive current state so the target derivative depends on both capacitor voltage and circuit current, creating an initial current-ramp phase before the usual RC-like approach. The mapping from observed V_C to dV_C_dt is no longer single-valued in time because the same V_C can occur with different current histories during startup.",
      "affected_inputs": [
        "V_C",
        "t"
      ],
      "observable_effect": "At fixed source_voltage, resistance, and capacitance, the child predicts delayed initial rise of V_C and possible inflection in the early-time trajectory, whereas the parent always starts with its maximal charging slope at t=0 and then relaxes monotonically."
    },
    "diagnostic_groups": [
      {
        "name": "drive_gap",
        "expression": "source_voltage - V_C",
        "role": "Instantaneous voltage still available to drive charging"
      },
      {
        "name": "cap_scale",
        "expression": "capacitance*(1 + capacitance_voltage_nonlinearity*tanh(Abs(V_C)/capacitance_voltage_scale))",
        "role": "Effective differential capacitance setting how current converts to dV_C_dt"
      },
      {
        "name": "leak_factor",
        "expression": "tanh(Abs(V_C)/leakage_voltage_scale)",
        "role": "Finite-voltage activation of dielectric leakage"
      }
    ],
    "activation_condition": "Observable when the parasitic inductive timescale is not negligible relative to the RC charging timescale, i.e. during early-time measurements with fast sampling after connection and physically plausible wiring or lead inductance.",
    "train_hidden_contrast": "In training, the mechanism appears as rounded or delayed startup relative to the later charging tail; in holdout with different resistance or capacitance but similar non-negligible inductive timescale, the same startup phase persists and shifts systematically rather than being absorbed into one global RC constant.",
    "continuation_path": "Recover the parent law in the limit of vanishing parasitic inductance or after the fast current transient has relaxed so circuit current becomes quasi-instantaneously slaved to source_voltage - V_C.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "Inductance introduces dynamical memory through current inertia; this cannot be represented by a purely algebraic modification of the existing V_C-only right-hand side because the same V_C can correspond to different charging currents during startup.",
    "gap_statement": "The current model omits parasitic inductance of leads and connections, which can produce a finite current build-up time immediately after the source is connected.",
    "baseline_assumption": "Parasitic inductance is negligible, so charging current responds instantaneously to the voltage difference across the resistor-capacitor path.",
    "scientific_mechanism": "Series parasitic inductance stores magnetic energy and limits the rate of change of charging current, introducing an additional fast transient phase before the capacitor follows the slower resistive-capacitive evolution.",
    "affected_symbols": [
      "V_C",
      "source_voltage",
      "resistance",
      "capacitance",
      "capacitance_voltage_nonlinearity",
      "capacitance_voltage_scale",
      "leak_conductance",
      "leakage_voltage_scale"
    ],
    "rationale": "A realistic next refinement is to release the neglected parasitic inductance as a new current-like state. The parent target mapping has a single-phase shortcut: for any admissible experiment starting from V_C=0 with fixed source_voltage, resistance, capacitance, and leakage parameters, dV_C_dt is determined solely by V_C and therefore begins at its largest positive value at connection and then decreases as V_C rises. If we vary the observation regime by comparing slower sampling windows, where the parent is adequate, against fast early-time windows after the switch closes while holding component values fixed, a circuit with non-negligible lead inductance shows a different response: the charging current cannot jump instantly, so dV_C_dt starts near zero, rises over a short inductive timescale, and only then transitions toward the RC-controlled decay. This is a genuine change in the scored target mapping, not merely an auxiliary trajectory change, because the derivative of V_C at the same observed V_C depends on the hidden current state during the startup transient. A single refitted parent parameter set cannot reproduce both the delayed initial slope and the later charging tail across those conditions, since lowering the parent's effective RC rate to match the startup delay would also slow the entire later trajectory, while fitting the later tail forces an unrealistically large initial slope. The effect is scientifically admissible when measurement bandwidth resolves times comparable to the inductive transient and becomes weak when inductance is negligible or observations begin only after current has equilibrated."
  },
