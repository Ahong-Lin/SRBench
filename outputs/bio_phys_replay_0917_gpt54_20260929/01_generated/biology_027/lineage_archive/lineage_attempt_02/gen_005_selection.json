{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "For fixed total population and fixed contact-availability state C, the infection gain term depends on susceptible fraction through one fixed nonlinear accessibility factor, so dI_dt decreases with outbreak progress in a single smooth way determined by S, I, R and one shared alpha_sus.",
      "child_relation": "Keep the same state variables but relax the assumption that the accessibility loss is tied to one fixed curvature over the whole outbreak; instead let susceptibility accessibility harden more sharply once removed fraction is substantial, so the dependence of dI_dt on susceptible fraction bends more strongly at later outbreak progress than at early progress even when C is similar.",
      "affected_inputs": [
        "S",
        "I",
        "R",
        "C",
        "alpha_sus"
      ],
      "observable_effect": "Across trajectories with similar C and infectious prevalence but different removed fraction, later-stage outbreaks show a steeper-than-parent drop in infectious growth as susceptible fraction falls; the parent's one-shape accessibility term cannot match both the milder early curvature and stronger late curvature with one shared parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "sus_frac",
        "expression": "S/(S + I + R)",
        "role": "Remaining susceptible share controlling depletion and accessibility"
      },
      {
        "name": "rem_frac",
        "expression": "R/(S + I + R)",
        "role": "Cumulative outbreak progress and population removal burden"
      },
      {
        "name": "force_parent",
        "expression": "beta*C*S*I/((S + I + R)*(1 + alpha_sus*(1 - S/(S + I + R))))",
        "role": "Parent effective infection production entering dI_dt"
      }
    ],
    "activation_condition": "Observable when removed fraction is no longer negligible, roughly after the outbreak has progressed enough that R/(S+I+R) is moderate while susceptibles remain present; then residual susceptibles are plausibly more screened or harder to reach than the parent's fixed accessibility curvature allows.",
    "train_hidden_contrast": "In training, the mechanism appears as mild departure from proportional susceptible accessibility once depletion begins; in holdout, the same mechanism extends to stronger late-stage bending of dI_dt versus susceptible fraction at larger removed fraction, without introducing a new external driver.",
    "continuation_path": "Recover the parent law in the limit where the added outbreak-progress dependence of susceptibility accessibility vanishes, so accessibility curvature is again governed by one constant alpha_sus.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model already includes nonlinear susceptible accessibility, but it assumes one fixed curvature for how the remaining susceptible pool becomes harder to infect throughout the entire outbreak.",
    "baseline_assumption": "The loss of effective susceptible accessibility has a time-invariant, outbreak-stage-invariant shape controlled by a single constant alpha_sus.",
    "scientific_mechanism": "Progressive compositional hardening of the residual susceptible pool: as more individuals move into removed status, the remaining susceptibles are increasingly drawn from lower-contact or better-shielded subgroups, causing susceptibility accessibility to deteriorate faster at later outbreak stages than a single fixed accessibility curve predicts.",
    "affected_symbols": [
      "S",
      "I",
      "R",
      "C",
      "alpha_sus"
    ],
    "rationale": "A realistic next refinement is to change the assumption behind the existing susceptible-accessibility correction rather than add a wholly new process. The parent target mapping already weakens transmission through C and through a fixed nonlinear function of susceptible fraction, but this treats accessibility hardening as single-phase. Vary outbreak stage through R/(S+I+R) while holding the observed states S, I and C in comparable ranges: the parent implies that once these quantities are fixed, the shape of dI_dt versus susceptible fraction is fully determined by one constant accessibility curvature. The child would instead allow late-stage outbreaks with larger removed burden to exhibit stronger curvature in that same mapping, reflecting that the residual susceptible population has become selectively harder to reach beyond what the parent's single shared alpha_sus can encode. This is a changed target mapping, not merely an auxiliary-state change, because it directly alters the infection production term in dI_dt. The effect is admissible in the closed-population outbreak protocol because R grows endogenously from the given initial conditions, so the contrast can be observed along the actual trajectory without new interventions. Limitation: if observations remain confined to the very early phase where R is near zero and susceptible depletion is tiny, the refinement will be weakly identifiable."
  },
