{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "For fixed total population and contact-availability state, the infectious growth term is effectively proportional to S*I and the added suppression from removed individuals scales linearly with R, so dI_dt changes with outbreak progress through a single smooth depletion phase.",
      "child_relation": "Replace the linear removed-person suppression assumption with a saturating dependence on removed burden, so early accumulation of R bends dI_dt downward strongly but additional R has diminishing marginal effect at larger removed fractions.",
      "affected_inputs": [
        "S",
        "I",
        "R",
        "C",
        "kappa"
      ],
      "observable_effect": "Across trajectories with similar S and I but different intermediate versus late removed fractions, the child predicts stronger early curvature in infectious decline and weaker extra suppression once R is already large; the parent enforces the same marginal R effect everywhere."
    },
    "diagnostic_groups": [
      {
        "name": "removed_fraction",
        "expression": "R/(S + I + R)",
        "role": "Cumulative outbreak progress carried by the removed class"
      },
      {
        "name": "transmission_pressure",
        "expression": "C*S*I/(S + I + R)",
        "role": "Current contact-mediated infection pressure"
      },
      {
        "name": "reachability_loss",
        "expression": "R*S*I/(S + I + R)**2",
        "role": "Parent linear removed-mediated suppression channel"
      }
    ],
    "activation_condition": "Observable when the removed fraction spans low-to-moderate values during the same closed-outbreak trajectory, especially once R/(S+I+R) is no longer negligible but before susceptibles are exhausted.",
    "train_hidden_contrast": "The same epidemic trajectory can contain an early regime with rapidly increasing suppression as R first accumulates and a later regime where further R accumulation yields diminishing extra effect; this extends naturally into holdout trajectories with larger final attack size.",
    "continuation_path": "In the weak-saturation limit the refined suppression reduces to the parent's approximately linear dependence on removed fraction over the observed range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes that removed-induced depression of infectious growth increases linearly with removed burden at all outbreak stages, despite behavioral caution or loss of high-connectivity pathways plausibly saturating once much of the responsive/contact-rich subpopulation has already been affected.",
    "baseline_assumption": "The removed-mediated suppression term is proportional to R*S*I/(S + I + R)^2 with a constant marginal effect per additional removed individual.",
    "scientific_mechanism": "Saturating behavioral/contact-network shielding: the first accumulated removed individuals disproportionately eliminate high-risk contacts or trigger caution, while later removed individuals add less further suppression because the reachable risky contact structure is already partly exhausted.",
    "affected_symbols": [
      "S",
      "I",
      "R",
      "C",
      "kappa"
    ],
    "rationale": "A realistic next refinement is to relax the parent's linear-in-R suppression law rather than add a wholly new process. Vary outbreak progress through the observed trajectory so that removed fraction changes, while holding the same closed-population setting, state definitions, and homogeneous-mixing baseline otherwise. In the parent, the contribution of the extra suppression channel to dI_dt has one fixed marginal sensitivity to R after accounting for the algebraic prefactors from S and I. In the child, that marginal sensitivity should be larger when R is still small and smaller when R is already substantial, producing a measurable curvature change in the mapping from observed states to dI_dt. This is a target-mapping change, not merely an auxiliary-state change, because dI_dt itself would respond differently to the same supplied S,I,R,C values. The effect is admissible whenever trajectories traverse a nontrivial range of removed fractions; it may be weak if R stays tiny throughout observation. A single refit of the parent cannot reproduce both an initially steep and later flattened dependence on removed burden across those conditions, because its suppression channel is tied to one linear form in R."
  },
