{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The infectious growth term is bilinear in S and I with one constant transmission gain beta, so for fixed total population the target mapping dI_dt versus S*I/(S+I+R) is a straight line shifted by -gamma*I.",
      "child_relation": "Replace the constant transmission gain by a depletion-sensitive effective transmission that decreases with cumulative outbreak progress, so dI_dt bends downward relative to the parent as R accumulates even at similar instantaneous S and I.",
      "affected_inputs": [
        "S",
        "I",
        "R",
        "beta"
      ],
      "observable_effect": "Across outbreak trajectories with similar current S and I but different removed fraction R/(S+I+R), the child predicts lower dI_dt later in the outbreak; the parent with one shared beta and gamma cannot create this extra R-dependent attenuation."
    },
    "diagnostic_groups": [
      {
        "name": "force_of_infection",
        "expression": "S*I/(S + I + R)",
        "role": "Parent transmission opportunity term under homogeneous mixing"
      },
      {
        "name": "removed_fraction",
        "expression": "R/(S + I + R)",
        "role": "Cumulative outbreak progress and proxy for behavior/contact depletion not represented in the parent"
      },
      {
        "name": "infectious_balance",
        "expression": "beta*S*I/(S + I + R) - gamma*I",
        "role": "Current parent target mapping for infectious growth"
      }
    ],
    "activation_condition": "Observable when the removed fraction is no longer negligible, so cumulative outbreak progress is substantial while I remains positive; the contrast is weak near outbreak start when R/(S+I+R)≈0.",
    "train_hidden_contrast": "In training, early-to-mid outbreak data can already show that equal transmission opportunity S*I/N does not imply equal dI_dt once R has grown. In holdout, this extends to later epidemic stages where the extra downward curvature with increasing R becomes stronger.",
    "continuation_path": "Recover the parent law in the limit of zero depletion-sensitivity, equivalently when the effective transmission no longer depends on R or when R/(S+I+R) stays near zero over the observed window.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A cumulative contact-availability or behavioral-response memory cannot be reconstructed uniquely from the instantaneous S, I, and R values with the parent’s fixed-rate assumption if we want a dynamical relaxation or lagged attenuation rather than a purely algebraic coefficient tweak. One added state is the minimal way to represent this progressive transmission reduction while preserving closed-population mass balance.",
    "gap_statement": "The parent assumes transmission efficiency stays constant throughout the outbreak, omitting progressive reduction in effective contacts as awareness, self-isolation, or network depletion builds with outbreak history.",
    "baseline_assumption": "Transmission and removal rates are constant over time.",
    "scientific_mechanism": "As the outbreak accumulates removed individuals, effective infectious contacts decline due to endogenous behavioral caution or depletion of high-contact transmission pathways, causing transmission to weaken beyond simple susceptible depletion.",
    "affected_symbols": [
      "S",
      "I",
      "R",
      "beta"
    ],
    "rationale": "A realistic next refinement is to relax the constant-transmission assumption while keeping the closed SIR structure. The parent target mapping uses a single constant beta multiplying S*I/N, so once I is fixed the change in dI_dt with S is governed by one shared slope and cannot show additional late-epidemic bending except through the decline of S itself. The child should introduce outbreak-progress-dependent attenuation of transmission, most naturally via one added state representing contact availability or precaution level that evolves during the outbreak and feeds back on beta. The varied condition is cumulative outbreak progress, quantified by increasing R/N along the observed trajectory, while holding fixed comparable instantaneous S and I values or comparable S*I/N levels. Under those conditions the child predicts a lower dI_dt later in the outbreak because transmission has been additionally damped by accumulated outbreak history; the parent with one refitted beta and gamma cannot reproduce that same history-dependent reduction across all such conditions using a single parameter set. This is scientifically admissible when the outbreak is large enough that behavioral adaptation or contact-structure depletion can emerge, and limited when R remains very small so the refinement is practically unobservable."
  },
