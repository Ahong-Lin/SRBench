{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target maps N_c, N_n, and A to dN_n_dt with a fixed export half-saturation scale K_export_sat * A, so increasing A proportionally relieves export saturation regardless of cytoplasmic load history.",
      "child_relation": "Retain the same states but relax the assumption that export saturation depends only on available sites A; instead, occupied import machinery also crowds shared pore usage so the effective export saturation scale decreases nonlinearly as A falls, creating stronger bending of dN_n_dt versus N_n at low A than the parent allows.",
      "affected_inputs": [
        "N_n",
        "A"
      ],
      "observable_effect": "At matched N_n and similar total pool, conditions that drive A lower produce an earlier rollover and stronger suppression of export-dominated negative dN_n_dt than the parent with one fixed export-saturation form can reproduce."
    },
    "diagnostic_groups": [
      {
        "name": "total_pool",
        "expression": "N_c + N_n",
        "role": "Conserved intracellular transcription-factor pool"
      },
      {
        "name": "export_load_ratio",
        "expression": "N_n / (K_export_sat * A)",
        "role": "Parent export saturation coordinate"
      },
      {
        "name": "site_occupancy",
        "expression": "1 - A",
        "role": "Fraction of import-competent shared transport capacity currently unavailable"
      }
    ],
    "activation_condition": "Observable when A is appreciably below 1 due to cargo engagement, so shared pore occupancy is non-negligible and nuclear cargo is large enough that export is near saturation; weak when A≈1 or N_n<<K_export_sat*A.",
    "train_hidden_contrast": "In training, moderate reductions in A already flatten the export branch; in holdout, stronger occupancy extends this into a sharper curvature change with N_n that is not captured by merely refitting one global K_export_sat.",
    "continuation_path": "Recover the parent law in the limit where occupied sites do not further hinder export saturation beyond the existing A factor, e.g. negligible shared-crowding effect or A remaining near 1 throughout.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model treats export saturation as depending on nuclear cargo and a linear availability factor only, even though the same occupied pore/carrier traffic that lowers A can also crowd export translocation efficiency more strongly than linear capacity loss.",
    "baseline_assumption": "Import and export capacities remain constant during the experiment, apart from the already modeled linear modulation by A in the flux prefactor and export half-saturation scale.",
    "scientific_mechanism": "Shared pore/carrier crowding makes export throughput become more sharply saturation-limited when import-site availability is depleted, yielding occupancy-dependent export curvature rather than a fixed Michaelis form.",
    "affected_symbols": [
      "N_n",
      "A",
      "K_export_sat"
    ],
    "rationale": "A realistic next refinement is to relax the parent's fixed-environment export law, not to add a wholly new conserved-mass process. Vary cytoplasmic loading conditions that change A through the existing A dynamics while holding total pool N_c+N_n and the same single parameter set fixed across conditions. In the parent, once A is known, export has one fixed saturation shape in N_n with half-scale K_export_sat*A. In the child, the slope of the export branch near moderate-to-high N_n changes more strongly as A decreases, because occupied shared transport capacity reduces effective export saturation more than linearly. This changes the scored target mapping directly, not just auxiliary trajectories, since dN_n_dt at the same observed N_n and A-regime shows stronger curvature and earlier export rollover. The effect is admissible when cargo engagement makes A substantially below unity; if A stays near 1, the refinement collapses back toward the parent and may be hard to distinguish."
  },
