{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed intrinsic_growth_rate and carrying_capacity, the target dN_dt depends on crowding history through an additive sum of an instantaneous nonlinear crowding term and a linearly subtractive accumulated damage term, so the marginal effect of additional accumulated_crowding_damage on growth suppression is constant regardless of current crowding_pressure.",
      "child_relation": "Make accumulated crowding damage act synergistically with current crowding so that damage suppresses growth more strongly when crowding_pressure is already high, changing the curvature of dN_dt across the joint crowding-history coordinates rather than only adding a fixed linear penalty.",
      "affected_inputs": [
        "crowding_pressure",
        "accumulated_crowding_damage",
        "carrying_capacity"
      ],
      "observable_effect": "For the same accumulated_crowding_damage, growth declines more sharply at high crowding_pressure than at moderate crowding_pressure; equivalently, trajectories with similar damage but different current crowding show a stronger-than-additive separation in dN_dt."
    },
    "diagnostic_groups": [
      {
        "name": "instantaneous_load",
        "expression": "crowding_pressure/carrying_capacity",
        "role": "Current normalized effective crowding intensity"
      },
      {
        "name": "memory_load",
        "expression": "accumulated_crowding_damage/carrying_capacity",
        "role": "Normalized delayed burden from sustained crowding"
      },
      {
        "name": "joint_crowding_burden",
        "expression": "crowding_pressure*accumulated_crowding_damage/carrying_capacity**2",
        "role": "Candidate coordinate for synergistic suppression by simultaneous present crowding and accumulated damage"
      }
    ],
    "activation_condition": "Observable when both crowding_pressure/carrying_capacity and accumulated_crowding_damage/carrying_capacity are non-negligible, especially after sustained high abundance followed by partial relaxation, so that current crowding and delayed damage coexist at moderate-to-high levels.",
    "train_hidden_contrast": "In training, delayed density dependence already creates periods where crowding_pressure and accumulated_crowding_damage vary somewhat independently along trajectories; in holdout, longer or stronger overshoot episodes enlarge the region where both are elevated, revealing the stronger curvature of the target mapping.",
    "continuation_path": "Recover the parent law in the limit of zero crowding-damage interaction strength, so delayed damage remains purely additive and independent of current crowding intensity.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes accumulated damage depresses growth by a fixed additive amount regardless of how intense present crowding currently is, omitting plausible synergy between ongoing crowding stress and previously accumulated habitat or physiological damage.",
    "baseline_assumption": "Accumulated crowding damage enters the growth law as a linearly additive, crowding-independent penalty.",
    "scientific_mechanism": "Habitat fouling, waste, or chronic physiological stress often lowers tolerance to current crowding, so the same residual damage causes a larger reduction in net growth when individuals are simultaneously experiencing high present crowding.",
    "affected_symbols": [
      "crowding_pressure",
      "accumulated_crowding_damage",
      "carrying_capacity"
    ],
    "rationale": "A realistic next refinement is to relax the parent's additive-separable treatment of current crowding and delayed damage in the target equation. The parent already allows history dependence through crowding_pressure and accumulated_crowding_damage, but once those states are given, dN_dt is still the sum of one function of crowding_pressure and one linear function of accumulated_crowding_damage. Vary crowding history so that trajectories reach similar accumulated_crowding_damage but different current crowding_pressure, while holding intrinsic_growth_rate, carrying_capacity, and the adjustment and damage rates fixed. In the parent, the vertical effect of changing accumulated_crowding_damage is the same at all current crowding levels. In the child, that slope becomes steeper at higher crowding_pressure because delayed damage and current crowding jointly intensify suppression. This is scientifically admissible when sustained crowding has built nontrivial damage and the system has not fully relaxed, which is reachable under the existing initial-condition contract via overshoot or prolonged high abundance. This changes the scored target mapping itself, not merely auxiliary trajectories, because dN_dt as a function of observed states gains a joint-curvature term. A single refit of existing parent parameters cannot reproduce this contrast across such conditions: changing the exponent alters only the shape versus crowding_pressure, and changing damage coefficients rescales only the additive damage burden, but neither makes the effect of accumulated damage depend on current crowding_pressure."
  },
