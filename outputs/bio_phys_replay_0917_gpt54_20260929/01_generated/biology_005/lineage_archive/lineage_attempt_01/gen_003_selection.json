{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed intrinsic_growth_rate and carrying_capacity, dN_dt depends on N only through a single suppressive phase variable crowding_pressure with one common power-law shape 1-(crowding_pressure/carrying_capacity)^crowding_nonlinearity_exponent, so the decline of growth with accumulated crowding has one fixed curvature over time.",
      "child_relation": "Retain delayed crowding but relax the assumption that all effective crowding impacts growth immediately. Split recent crowding from accumulated physiological/environmental damage so the mapping from observed N to dN_dt becomes initially less suppressed after a rise in N, then more sharply suppressed once accumulated damage builds, creating two-phase curvature in density feedback.",
      "affected_inputs": [
        "N",
        "crowding_pressure"
      ],
      "observable_effect": "Under the same initial conditions but different crowding_adjustment_rate regimes, the child can show weak early suppression followed by delayed steep decline in dN_dt at similar N, whereas the parent only provides one smoothly varying suppression shape tied directly to crowding_pressure."
    },
    "diagnostic_groups": [
      {
        "name": "effective_crowding_ratio",
        "expression": "crowding_pressure/carrying_capacity",
        "role": "Current normalized delayed density load setting immediate suppression in the parent"
      },
      {
        "name": "instant_per_capita_growth",
        "expression": "intrinsic_growth_rate*(1 - (crowding_pressure/carrying_capacity)**crowding_nonlinearity_exponent)",
        "role": "Parent per-capita growth map from delayed crowding to population change"
      },
      {
        "name": "crowding_lag_flux",
        "expression": "crowding_adjustment_rate*(N - crowding_pressure)",
        "role": "Rate at which recent abundance history is still increasing effective crowding, identifying regimes where additional delayed harm can accumulate"
      }
    ],
    "activation_condition": "Observable when abundance changes on a timescale comparable to or faster than 1/crowding_adjustment_rate, so recent increases in N create nonzero crowding_lag_flux and delayed cumulative crowding effects can separate from immediate crowding_pressure.",
    "train_hidden_contrast": "In training, moderate lag already reveals history dependence at the same N through crowding_pressure; in holdout, stronger mismatch between fast abundance change and slower crowding adjustment exposes an additional late-stage steepening of suppression that a single-phase parent map cannot match with one shared parameter set.",
    "continuation_path": "Recover the parent law when the added accumulated-harm effect is removed or relaxes infinitely fast so only crowding_pressure determines suppression.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "Existing states N and crowding_pressure encode current abundance and a single delayed crowding phase, but they cannot represent a second slower memory of cumulative density stress needed to alter the target mapping itself rather than only auxiliary trajectories.",
    "gap_statement": "The current model assumes all density dependence acts through one delayed crowding variable with an instantaneous effect on growth, omitting slower accumulation of crowding-induced damage or resource depletion that can persist beyond recent crowding levels.",
    "baseline_assumption": "Crowding acts through a single effective pressure whose current value alone determines growth suppression once delay in crowding formation is accounted for.",
    "scientific_mechanism": "Accumulated crowding can generate a slower damage or depletion burden—such as waste buildup, habitat fouling, or physiological stress—that integrates recent high density and deepens growth suppression after sustained crowding.",
    "affected_symbols": [
      "N",
      "crowding_pressure",
      "crowding_adjustment_rate",
      "carrying_capacity",
      "crowding_nonlinearity_exponent"
    ],
    "rationale": "A realistic next refinement is to relax the single-phase density-feedback assumption rather than add an unrelated term. The parent already captures delayed crowding formation, but once crowding_pressure is known, dN_dt follows one fixed suppressive curve. Varying conditions here means comparing trajectories where abundance rises or overshoots at different speeds relative to the fixed crowding adjustment timescale, while holding intrinsic_growth_rate, carrying_capacity, and the initial conditions fixed as specified. In the parent, any two times with the same crowding_pressure produce the same per-capita suppression regardless of whether high density has been brief or prolonged. In a child with an additional slow accumulated-harm state, prolonged high crowding would cause stronger suppression than brief high crowding even at similar N and similar immediate crowding_pressure. This is an observable change in the scored target mapping dN_dt, not merely a change in an auxiliary trajectory, because the new memory variable would directly modify growth. The contrast is admissible in the benchmark because the existing initial conditions allow transient overshoot when crowding_adjustment_rate is finite, creating intervals where recent abundance history differs despite comparable current N. A single refit of the parent parameters cannot reproduce both the mild early suppression and the later extra steep suppression across those regimes, because its response to crowding_pressure has one fixed curvature and no separate cumulative memory channel."
  },
