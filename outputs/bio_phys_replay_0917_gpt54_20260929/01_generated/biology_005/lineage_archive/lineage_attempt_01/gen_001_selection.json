{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "The instantaneous growth rate depends only on current abundance N through an immediate logistic crowding term, so for any observed N the slope dN_dt is single-valued and identical regardless of whether the population is rising toward or relaxing from high density.",
      "child_relation": "Crowding is mediated by a dynamically adjusting population-pressure state, so dN_dt at the same observed N can differ depending on recent abundance history; the target mapping gains lagged density dependence and transient overshoot/undershoot relative to the logistic curve.",
      "affected_inputs": [
        "N"
      ],
      "observable_effect": "Along a time series starting below carrying capacity, the population can continue growing after crossing the long-run equilibrium and then decline, creating different dN_dt values at the same N on ascent versus descent."
    },
    "diagnostic_groups": [
      {
        "name": "crowding_ratio",
        "expression": "N/carrying_capacity",
        "role": "Current abundance relative to the nominal equilibrium scale where direct logistic crowding would cancel low-density growth"
      },
      {
        "name": "logistic_drive",
        "expression": "intrinsic_growth_rate*N*(1 - N/carrying_capacity)",
        "role": "Parent model's instantaneous net growth prediction used as the no-delay reference"
      }
    ],
    "activation_condition": "Observable when crowding feedback adjusts on a timescale not negligible relative to population growth, so populations can change substantially before density dependence fully manifests; strongest for moderate to fast intrinsic growth from the given nonzero initial condition.",
    "train_hidden_contrast": "In training, early trajectories show near-exponential rise followed by delayed braking; in holdout, the same lag mechanism extends to later times as overshoot and return, still evaluated from the supplied N trajectory.",
    "continuation_path": "Recover the parent law in the limit of infinitely fast crowding adjustment, where the crowding state tracks N instantaneously and delayed density dependence vanishes.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A genuine delay in density dependence cannot be represented with only the current state N and fixed parameters, because the target dN_dt must then remain a single-valued function of N. One additional state is needed to store recent crowding history and alter the scored mapping for N.",
    "gap_statement": "The logistic law assumes crowding reduces net growth immediately as abundance changes, omitting delayed responses such as resource depletion, waste accumulation, or maturation of competitive effects.",
    "baseline_assumption": "Crowding acts without a time delay.",
    "scientific_mechanism": "Finite adjustment of effective crowding pressure causes delayed density dependence, allowing transient overshoot and history-dependent growth at the same abundance.",
    "affected_symbols": [
      "N",
      "intrinsic_growth_rate",
      "carrying_capacity"
    ],
    "rationale": "A realistic next refinement is to relax the parent's instantaneous-crowding assumption. Hold intrinsic demographic conditions fixed and vary time along trajectories generated from the stated initial abundance. In the parent, dN_dt is determined solely by current N, giving one logistic slope for each abundance and a peak at N = carrying_capacity/2 with no hysteresis. In the child, an added effective-crowding state would lag behind N, so when the population first rises into the carrying-capacity range the inhibitory feedback is weaker than the parent predicts, whereas after overshoot the accumulated crowding makes decline stronger than the parent predicts at the same N. This is a changed target mapping, not merely auxiliary dynamics, because the scored derivative of N becomes history-dependent conditional on observed N alone. A single refitted parent parameter set cannot reproduce both the continued positive growth just above equilibrium on ascent and the negative growth at the same abundance on descent, since its mapping from N to dN_dt is single-valued. The effect is scientifically admissible when density feedback develops over non-negligible time relative to growth; if adjustment is effectively instantaneous, the refinement collapses back to the parent."
  },
