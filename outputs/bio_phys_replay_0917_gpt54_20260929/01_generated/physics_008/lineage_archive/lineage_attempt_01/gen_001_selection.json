{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "branch_crossover",
      "parent_relation": "With fixed disorder and carrier concentration, conductivity follows a single Mott variable-range-hopping law: log(sigma) is proportional to -(T0/T)^(1/(spatial_dimension+1)) over the full sampled temperature range.",
      "child_relation": "Retain phonon-assisted hopping but relax the assumption of a constant localized-state density near the chemical potential, allowing a Coulomb-gap regime so the temperature dependence crosses over from Mott VRH at higher T to a steeper Efros-Shklovskii-type hopping law at lower T.",
      "affected_inputs": [
        "T"
      ],
      "observable_effect": "As T is lowered at fixed sample properties, the slope on a log(sigma) versus inverse-temperature scale steepens below a crossover range; a single shared Mott parameter set cannot match both the warmer weak-curvature segment and the colder stronger suppression."
    },
    "diagnostic_groups": [
      {
        "name": "mott_coord",
        "expression": "(T0/T)**(1/(spatial_dimension + 1))",
        "role": "Parent Mott hopping exponent coordinate controlling the baseline stretched-exponential suppression"
      },
      {
        "name": "inv_sqrt_T0",
        "expression": "sqrt(T0/T)",
        "role": "Natural low-temperature Coulomb-gap hopping coordinate for checking crossover in semilog conductivity plots"
      }
    ],
    "activation_condition": "Observable when interactions open a soft Coulomb gap in the single-particle density of states and the sampled temperatures extend below the crossover scale where the Coulomb-gap-controlled hops dominate, while the electric field remains in linear response.",
    "train_hidden_contrast": "In training, modest cooling already shows extra downward bending relative to one Mott law; in holdout at still lower T, the same mechanism extends to a clearer crossover toward the steeper low-temperature branch rather than merely rescaling sigma0 or T0.",
    "continuation_path": "Recover the parent law when Coulomb interactions are negligible or the entire temperature window lies above the crossover so only the Mott regime is sampled.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes an approximately constant localized-state density near the chemical potential across all temperatures, omitting the interaction-induced soft gap that changes the hopping exponent at low temperature.",
    "baseline_assumption": "The localized-state density near the chemical potential is approximately constant.",
    "scientific_mechanism": "Electron-electron interactions deplete states near the chemical potential, producing a Coulomb gap and a crossover from Mott variable-range hopping to Efros-Shklovskii hopping on cooling.",
    "affected_symbols": [
      "T",
      "T0",
      "spatial_dimension"
    ],
    "rationale": "Parent response: with T varied and disorder strength, carrier concentration, geometry, and low-field conditions held fixed, sigma decreases monotonically according to one stretched exponential with a single exponent 1/(spatial_dimension+1). Scientific gap: in disordered insulators at sufficiently low T, Coulomb interactions can invalidate the constant-density-of-states assumption and change the target mapping itself, not just an auxiliary quantity. Child contrast: across a temperature sweep that spans above and below the interaction crossover, the warmer portion remains approximately Mott-like, while the colder portion shows stronger suppression with a different effective exponent structure. This is an observable curvature/branch change in the measured sigma(T) mapping. A single refitted parent parameter pair (sigma0,T0) with fixed spatial_dimension cannot reproduce both segments across the same shared temperature range because it preserves one exponent family and therefore one semilog curvature class. The refinement is admissible when the Coulomb gap is appreciable and the sampled temperatures are low enough to probe it; if all sampled temperatures are too high, the parent remains an adequate limit."
  },
