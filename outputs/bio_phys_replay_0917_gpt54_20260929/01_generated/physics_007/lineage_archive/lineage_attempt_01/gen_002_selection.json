{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "For fixed eta, Omega is set by a single modulation of the nearest-neighbor acoustic form through sin(kappa/2)^2, so eta changes the dispersion with one shared shape across the zone.",
      "child_relation": "Retain the acoustic and periodic structure but relax the assumption that the environment-induced further-neighbor effect enters only as a quadratic-in-sin(kappa/2) correction; allow a higher-order zone-shape dependence so eta changes curvature weakly near kappa=0 but more strongly toward mid-zone and the zone boundary.",
      "affected_inputs": [
        "kappa",
        "eta"
      ],
      "observable_effect": "At the same small-kappa slope, the child can produce a different degree of flattening or sharpening near intermediate kappa and near the zone edge as eta varies, whereas the parent ties those curvatures together with one fixed shape."
    },
    "diagnostic_groups": [
      {
        "name": "long_wave",
        "expression": "Abs(kappa)",
        "role": "acoustic small-wavevector regime where the linear sound-speed limit is tested"
      },
      {
        "name": "mid_zone",
        "expression": "sin(kappa/2)**2",
        "role": "dimensionless zone-position coordinate controlling departure from the long-wavelength limit"
      },
      {
        "name": "edge_proximity",
        "expression": "1 - sin(kappa/2)**2",
        "role": "distance from the zone boundary, useful for identifying turnover behavior"
      }
    ],
    "activation_condition": "Visible when eta is appreciable in magnitude and data include both long-wavelength and intermediate-to-edge wavevectors, e.g. sin(kappa/2)^2 not confined near 0; if measurements are only very close to kappa=0 the refinement is weakly identifiable.",
    "train_hidden_contrast": "In training, the same eta may already alter curvature away from the acoustic limit; in holdout extending closer to the zone boundary, the refined shape gives a stronger contrast because the new higher-order kappa dependence separates mid-zone and edge behavior that the parent locks together.",
    "continuation_path": "Recover the parent when the added higher-order shape contribution is set to zero, or in the long-wavelength limit kappa -> 0 where both forms reduce to the same acoustic scaling to leading order.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the environment-controlled beyond-nearest-neighbor effect has a single fixed kappa-shape proportional to sin(kappa/2)^2 inside the square root, which is an overly restrictive representation of how lattice-periodic nonlocal coupling modifies dispersion across the Brillouin zone.",
    "baseline_assumption": "Environment-induced effective further-neighbor coupling modifies the dispersion through only one lowest-order periodic shape factor.",
    "scientific_mechanism": "A more realistic harmonic nonlocal interaction projects onto the lattice dispersion with additional periodic wavevector dependence, changing zone-scale curvature without breaking the acoustic zero, even symmetry, or reciprocal-space periodicity.",
    "affected_symbols": [
      "kappa",
      "eta"
    ],
    "rationale": "Vary kappa across the first zone and compare multiple eta values while holding lattice spacing, mass normalization, and nearest-neighbor reference fixed. The parent mapping uses one shared eta-controlled shape, so after one global refit it cannot independently adjust the small-kappa behavior and the amount of flattening or steepening at intermediate and near-boundary kappa across those eta conditions. The proposed refinement changes the target mapping itself, not merely an auxiliary quantity, by altering how eta couples to wavevector-dependent curvature. This effect is scientifically admissible when the environment genuinely induces nonlocal harmonic forces and measurements span enough of the zone to see deviations from the lowest-order shape. Limitation: if all observed kappa remain in the strict long-wavelength regime, the parent may effectively absorb the refinement and the contrast becomes unresolvable."
  },
