{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed A, the adult gain from juveniles is a monotone saturating decrease with J because maturation is proportional to J divided by two crowding factors, so the per-juvenile transition hazard has no low-density penalty and no interior optimum in J.",
      "child_relation": "Release the assumption of fixed per-capita maturation by making maturation success hump-shaped in juvenile abundance: low J gives reduced maturation because conspecific facilitation or mate/finding/settlement limitation is weak, intermediate J maximizes adult recruitment, and high J still suppresses maturation through crowding.",
      "affected_inputs": [
        "J",
        "A",
        "maturation_rate",
        "carrying_capacity"
      ],
      "observable_effect": "Across trajectories that pass through low, intermediate, and high juvenile abundance while adult abundance is held similar, dA_dt versus J changes from a purely saturating/decreasing gain contribution to a unimodal contribution with weaker slope near J≈0 and a peak at intermediate J."
    },
    "diagnostic_groups": [
      {
        "name": "juvenile_to_capacity",
        "expression": "J/carrying_capacity",
        "role": "Juvenile crowding scale controlling whether facilitation-limited low density or interference-limited high density should dominate maturation"
      },
      {
        "name": "adult_to_capacity",
        "expression": "A/carrying_capacity",
        "role": "Adult occupancy scale modulating the existing crowding burden on juvenile maturation"
      },
      {
        "name": "maturation_flux_parent",
        "expression": "maturation_rate*J/((1 + (J + A)/carrying_capacity)*(1 + J/carrying_capacity))",
        "role": "Parent juvenile-to-adult transfer term whose shape in J is being refined"
      }
    ],
    "activation_condition": "Observable when trajectories visit J from well below carrying_capacity to order carrying_capacity, with A not changing so strongly that mortality terms dominate the contrast; especially visible for J/carrying_capacity from small positive values up to O(1).",
    "train_hidden_contrast": "In training, moderate and high juvenile densities already reveal density suppression of maturation; in holdout or extended trajectories that also include sparse juvenile phases, the child predicts a shallower or even initially increasing maturation efficiency with J before the crowding decline, extending the same mechanism across a wider J range.",
    "continuation_path": "In the limit that low-density facilitation vanishes, the refined maturation function reduces to the parent's fixed per-capita maturation law.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes juveniles mature with maximal per-capita efficiency as J approaches zero, omitting plausible low-density developmental or settlement failure that makes maturation inefficient when juveniles are too sparse.",
    "baseline_assumption": "Maturation occurs continuously at a fixed per-capita rate.",
    "scientific_mechanism": "Positive density dependence in juvenile maturation at low abundance, such as cooperative settlement, reduced Allee-type failure during development, or social facilitation, combined with the already present negative density dependence at higher abundance.",
    "affected_symbols": [
      "J",
      "A",
      "maturation_rate",
      "carrying_capacity"
    ],
    "rationale": "A realistic next refinement is to relax the fixed-per-capita maturation assumption rather than add a new demographic compartment. In the parent target mapping, with A held fixed, the maturation contribution to dA_dt is determined by a single-phase crowding law: as J varies, adult gain rises approximately linearly near zero and then bends downward only because of suppression, so there is no low-density maturation deficit. The child instead makes the J-to-dA_dt contribution non-monotone in efficiency: sparse juveniles mature less effectively, intermediate juvenile abundance produces the strongest adult recruitment, and high juvenile abundance again lowers transfer because of crowding. This is scientifically admissible in systems where successful development or settlement requires conspecific presence but becomes crowded at higher density. The contrast is observable under the actual ODE contract because trajectories from the given initial conditions can pass through lower J as juveniles are depleted and through moderate or high J early in time; comparing times with similar A but different J reveals changed curvature in the target mapping itself, not merely in an auxiliary state. A single refit of existing parent parameters cannot reproduce both weak low-J maturation and strong intermediate-J maturation while preserving high-J suppression, because the parent's maturation term has only one phase in J and cannot create an interior optimum or low-density penalty without changing functional form. The limitation is that if all observed trajectories remain confined to either only very high J or only a narrow J band, the new effect may be weakly identifiable."
  },
