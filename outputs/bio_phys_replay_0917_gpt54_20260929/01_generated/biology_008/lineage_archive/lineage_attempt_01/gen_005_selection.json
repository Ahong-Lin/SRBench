{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "The adult gain from juveniles is an instantaneous function of the current juvenile and adult abundances only, so for the same present J and A the maturation contribution to dA_dt is identical regardless of recent crowding history.",
      "child_relation": "The maturation contribution depends on current J and A and on a slowly varying developmental condition state that carries recent juvenile crowding history, so the same present J and A can yield different dA_dt depending on whether juveniles recently experienced prolonged crowding.",
      "affected_inputs": [
        "J",
        "A"
      ],
      "observable_effect": "After a sustained high-density juvenile episode followed by partial relaxation to the same present J and A, adult gain remains temporarily depressed relative to a trajectory that reached the same J and A without prior crowding; the parent cannot distinguish these histories."
    },
    "diagnostic_groups": [
      {
        "name": "current_maturation_flux",
        "expression": "maturation_rate*J*(J/(J + carrying_capacity))/((1 + (J + A)/carrying_capacity)*(1 + J/carrying_capacity))",
        "role": "parent instantaneous juvenile-to-adult transfer rate"
      },
      {
        "name": "total_density_ratio",
        "expression": "(J + A)/carrying_capacity",
        "role": "current crowding level affecting maturation in the parent"
      },
      {
        "name": "juvenile_density_ratio",
        "expression": "J/carrying_capacity",
        "role": "current juvenile developmental load in the parent"
      }
    ],
    "activation_condition": "Observable when juvenile crowding remains elevated for a nontrivial interval relative to maturation time, then J and/or A relax enough that two trajectories can revisit similar present J and A while differing in recent crowding history; weak when crowding is always low or developmental recovery is effectively instantaneous.",
    "train_hidden_contrast": "In training, current crowding already modulates maturation; in holdout, the same crowding mechanism persists but with delayed recovery, extending the effect into transient hysteresis-like differences at matched present J and A.",
    "continuation_path": "Recover the parent when the developmental-condition state relaxes infinitely fast or its effect on maturation vanishes, making maturation depend only on current J and A.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "Existing states J and A encode only current abundances. A memory effect from cumulative developmental stress cannot be represented without one additional dynamical state that stores recent juvenile crowding exposure.",
    "gap_statement": "The current model assumes juvenile maturation responds instantaneously to present density, omitting developmental carryover from prior crowding that can temporarily suppress later maturation even after densities decline.",
    "baseline_assumption": "Maturation occurs continuously at a fixed per-capita rate determined only by the current state, with no developmental memory or recovery lag.",
    "scientific_mechanism": "Crowding-induced developmental stress or condition deficit in juveniles accumulates under high juvenile density and relaxes gradually, reducing subsequent maturation success for a time.",
    "affected_symbols": [
      "J",
      "A",
      "carrying_capacity",
      "maturation_rate"
    ],
    "rationale": "A realistic next refinement is to relax the memoryless maturation assumption. In the parent, varying recent juvenile crowding history while holding the presently observed J and A fixed leaves dA_dt unchanged because the maturation term is a single-phase instantaneous response. In the child, recent history changes adult production through a lagged developmental-condition state, so the slope of dA_dt with respect to present J is history-dependent. Concretely, compare two admissible trajectories from the same initial-condition protocol: one experiences prolonged J/carrying_capacity greater than order 1 before relaxing, and another reaches similar present J and A with less prior crowding. The child predicts lower current maturation, hence lower dA_dt, in the formerly crowded trajectory. A single refit of existing parent parameters cannot reproduce this contrast across both conditions because its target mapping is a unique function of current J and A only. This change directly alters the scored A equation rather than only auxiliary trajectories. Limitation: the contrast is weak if observations never revisit similar J and A after differing crowding histories or if recovery is much faster than observation resolution."
  },
