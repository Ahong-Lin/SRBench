{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "Adult gain from juveniles is proportional to J with one shared crowding denominator, so at fixed A the dependence of dA_dt on J rises monotonically with a single saturating shape and no loss of transition efficiency at very high juvenile density beyond that shared factor.",
      "child_relation": "Successful maturation remains increasing at low J but acquires extra self-limitation from juvenile crowding during the transition, so at fixed A the adult gain bends down more strongly at high J and can approach a lower asymptote than the parent predicts.",
      "affected_inputs": [
        "J",
        "A",
        "maturation_rate",
        "carrying_capacity"
      ],
      "observable_effect": "Across trajectories that visit similar adult abundance A but different juvenile loads J, the child predicts weaker-than-parent increases in dA_dt when J becomes large relative to carrying_capacity, while matching the parent closely at low J."
    },
    "diagnostic_groups": [
      {
        "name": "total_crowding",
        "expression": "(J + A)/carrying_capacity",
        "role": "Shared baseline density load already controlling recruitment and maturation suppression"
      },
      {
        "name": "juvenile_load",
        "expression": "J/carrying_capacity",
        "role": "Stage-specific juvenile congestion scale where extra transition inefficiency would appear"
      },
      {
        "name": "adult_gain_parent",
        "expression": "maturation_rate*J/(1 + (J + A)/carrying_capacity)",
        "role": "Parent adult inflow term whose J-shape is being refined"
      }
    ],
    "activation_condition": "Observable when trajectories enter moderate to high juvenile congestion, especially J/carrying_capacity not small and comparisons are made at similar A so the extra J-specific curvature is not masked by adult variation.",
    "train_hidden_contrast": "In training, modest juvenile crowding already causes the child adult inflow to flatten faster with J than the parent. In holdout, this same mechanism extends to stronger juvenile surpluses where the parent overpredicts adult gain because it has only one shared crowding phase.",
    "continuation_path": "Recover the parent by taking the added juvenile-specific transition-crowding effect to zero, so maturation returns to the current shared denominator form.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes all density effects on maturation are captured by one shared total-crowding factor, omitting additional loss of successful juvenile transition caused specifically by congestion among juveniles competing for maturation opportunities or developmental resources.",
    "baseline_assumption": "Maturation occurs continuously at a fixed per-capita rate modified only by the same total crowding term that also appears elsewhere.",
    "scientific_mechanism": "Juvenile-specific interference during development or settlement reduces the fraction of juveniles that successfully mature when juvenile abundance is high, beyond the baseline total-density suppression.",
    "affected_symbols": [
      "J",
      "A",
      "maturation_rate",
      "carrying_capacity"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-phase crowding assumption for maturation. The parent target mapping from observed states to dA_dt is adult gain minus adult losses, with gain determined by J through one shared denominator based only on J+A. Holding A fixed and varying J, this gives one saturating response shape. A biologically plausible child keeps the same stage structure but lets high juvenile density further depress successful maturation, changing the J-to-dA_dt curvature rather than merely altering auxiliary juvenile dynamics. This is observable whenever the solver samples states with comparable A but different J, which can occur under the stated initial conditions as juveniles are produced and depleted over time. The contrast is that at low juvenile load the child nearly matches the parent, while at higher J/carrying_capacity the adult inflow rises more slowly than any simple rescaling of maturation_rate would allow across all J. A single refit of the parent parameters cannot reproduce both low-J agreement and stronger high-J flattening if the same A range is visited, because the parent has only one shared crowding shape for maturation. This refinement needs no new state: the omitted mechanism depends on already observed juvenile abundance."
  },
