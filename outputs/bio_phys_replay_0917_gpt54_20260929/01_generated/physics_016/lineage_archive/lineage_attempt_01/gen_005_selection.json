{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The width-rate mapping uses a single instantaneous phase-curvature coordinate b, with shape_mode only modifying the gain algebraically; for fixed sigma and b the target changes smoothly and essentially single-phase with shape_mode.",
      "child_relation": "Replace the instantaneous closure by one with delayed internal stress relaxation, so the same sigma and b can produce different dsigma_dt depending on a lagged deformation memory generated during prior focusing. This creates history-dependent curvature in the mapping through an additional internal mode that stores unresolved shape stress.",
      "affected_inputs": [
        "sigma",
        "b",
        "shape_mode"
      ],
      "observable_effect": "Packets that reach the same current sigma and b after weak versus strong prior convergence show different instantaneous width-growth rates: after strong focusing the rebound is delayed or softened because residual internal deformation stress has not yet relaxed, whereas the parent predicts the same dsigma_dt once current states match."
    },
    "diagnostic_groups": [
      {
        "name": "focus_ratio",
        "expression": "Abs(b)/sigma",
        "role": "strength of converging or expanding phase curvature relative to current packet size"
      },
      {
        "name": "deformation_load",
        "expression": "Abs(shape_mode)/sigma**2",
        "role": "dimensionless non-Gaussian deformation intensity in the narrow-packet regime"
      },
      {
        "name": "stress_coupling",
        "expression": "Abs(b*shape_mode)/sigma**3",
        "role": "regime where curvature-driven deformation and narrow-width amplification jointly activate closure errors"
      }
    ],
    "activation_condition": "Most visible when sigma is small and focusing is appreciable, e.g. deformation_load not negligible and focus_ratio moderate to large, so unresolved higher-moment stress cannot relax instantaneously compared with width evolution.",
    "train_hidden_contrast": "Within training, episodes with similar current sigma and b but different earlier focusing histories already induce different subsequent rebound sharpness; in holdout, stronger focusing extends this same hysteretic contrast rather than introducing a new mechanism.",
    "continuation_path": "Fast-relaxation or zero-memory limit of the added internal stress mode recovers the parent instantaneous closure.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "Existing states encode only instantaneous width, curvature, and one deformation amplitude. A relaxation-based closure error is history dependent, so it cannot be represented by refitting an algebraic function of the current states alone; one additional state is needed to store lagged internal stress.",
    "gap_statement": "The current model assumes the non-Gaussian correction to dsigma_dt is an instantaneous algebraic function of sigma, b, and shape_mode, omitting finite-time relaxation of higher-moment kinetic stress generated during strong focusing.",
    "baseline_assumption": "The packet remains in a single Gaussian-shaped trial family.",
    "scientific_mechanism": "Finite-rate relaxation of unresolved higher-order shape stress during free dispersive evolution, producing memory in how prior convergence modifies the present width-growth rate.",
    "affected_symbols": [
      "sigma",
      "b",
      "shape_mode"
    ],
    "rationale": "A realistic next refinement is to relax the instantaneous-closure assumption already used for non-Gaussian deformation. In the parent, once sigma, b, and shape_mode are specified, dsigma_dt is fixed; prior trajectory information is discarded. That is a single-phase shortcut in the target mapping. Under free quantum propagation with strong temporary focusing, however, unresolved higher moments can remain excited for a finite time, so the effective kinetic-stress projection onto the width mode lags behind the visible deformation coordinate. Vary the initial convergence strength through b and the resulting minimum sigma, while holding particle_mass and hbar fixed and comparing times where the observed sigma and b are similar. The child predicts a different instantaneous rebound slope depending on whether those states were reached after stronger or weaker prior compression, whereas the parent with one shared parameter set cannot, because its target mapping is memoryless in the supplied states. This is scientifically admissible in the narrow-packet regime where deformation is non-negligible; it vanishes in weak-focusing or rapid-relaxation limits, recovering the parent law. The claimed complexity is a changed target mapping, not merely altered hidden trajectories, because the added memory state would directly modify dsigma_dt under matched visible states."
  },
