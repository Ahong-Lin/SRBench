{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The wake-softened restoring term scales as sin(theta) divided by a wake-only factor, so at fixed wake_intensity the ratio of restoring acceleration to sin(theta) is independent of deflection amplitude.",
      "child_relation": "Make the wake-induced restoring softening itself amplitude dependent, so the effective reduction grows with both wake_intensity and deflection magnitude; at fixed wake_intensity, larger |theta| experiences disproportionately more restoring weakening than smaller |theta|.",
      "affected_inputs": [
        "theta",
        "wake_intensity"
      ],
      "observable_effect": "Holding wake_intensity and omega near the same values across samples, the child predicts a smaller-magnitude restoring contribution at larger |theta| than the parent's single wake gain allows, producing extra flattening of the acceleration-versus-theta curve at large deflection."
    },
    "diagnostic_groups": [
      {
        "name": "grav_scale",
        "expression": "mass * gravity * center_of_mass_distance / moment_of_inertia",
        "role": "baseline gravitational angular-acceleration scale"
      },
      {
        "name": "wake_excess",
        "expression": "Max(wake_intensity - 1, 0)",
        "role": "amount of motion-induced wake above ambient that can activate aerodynamic softening"
      },
      {
        "name": "deflection_strength",
        "expression": "1 - cos(theta)",
        "role": "bounded measure of angular excursion size that is even in theta and zero at small deflection"
      }
    ],
    "activation_condition": "Observable when wake_intensity exceeds ambient by order-unity or modestly above and trajectories reach moderate to large deflections, so 1 - cos(theta) is non-negligible while remaining below full-rotation energy.",
    "train_hidden_contrast": "Within training, moderate versus larger deflection segments at similar wake_intensity already reveal extra flattening of restoring acceleration; in holdout, the same interaction extends to stronger wake episodes without changing sign symmetry or periodicity.",
    "continuation_path": "Recover the parent law when the amplitude-dependent softening coefficient tends to zero, or in the small-angle limit theta -> 0 where 1 - cos(theta) vanishes to leading order.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes wake-induced restoring softening is controlled only by wake_intensity and not by deflection amplitude, imposing one shared wake gain across small- and large-angle motion.",
    "baseline_assumption": "The aerodynamic-stiffness correction multiplies the restoring torque through a denominator depending only on Max(wake_intensity - 1, 0), independent of angular excursion magnitude.",
    "scientific_mechanism": "At larger deflections the body presents a different effective incidence to the surrounding separated flow, so the same wake state produces a stronger normal-force-induced reduction of restoring torque than near the bottom position.",
    "affected_symbols": [
      "theta",
      "wake_intensity",
      "aerodynamic_stiffness_gain"
    ],
    "rationale": "A realistic next refinement is to relax the parent's wake-softening law rather than add a wholly new process. The parent already includes a wake-dependent restoring correction, but it uses a single gain on wake_excess for all deflections. Varying theta along trajectories while holding the same parameter set and comparing intervals with similar wake_intensity and omega, the parent predicts that restoring acceleration normalized by sin(theta) depends only on wake_intensity. The child would instead introduce an interaction between theta and wake_intensity, so large-excursion states show additional restoring softening beyond what the same wake level causes near small excursion. This is scientifically admissible because aerodynamic normal-force effects generally depend on orientation relative to the flow and therefore need not remain proportional to a wake-only scalar. The effect is observable only when both wake_excess and deflection are appreciable; near small angles or wake_intensity near 1 the refinement collapses toward the parent and may be hard to distinguish. A single refit of the parent gain cannot reproduce both weak softening at small |theta| and stronger softening at large |theta| under the same wake_intensity because its mapping is separable in sin(theta) times a wake-only factor."
  },
