{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed selection_coefficient, dp_dt increases approximately linearly with p at low favored-allele frequency and is attenuated only by the accumulated occupancy term through a first-order factor 1/(1 + attenuation_occupancy/attenuation_capacity).",
      "child_relation": "Keep the same states but relax the assumption that attenuation is first-order: realized selection falls with a steeper saturating dependence on attenuation_occupancy, so the p-to-dp_dt mapping bends downward more strongly once occupancy becomes comparable to attenuation_capacity.",
      "affected_inputs": [
        "p",
        "attenuation_occupancy",
        "attenuation_capacity"
      ],
      "observable_effect": "Across trajectories or times with matched p and selection_coefficient but different attenuation_occupancy, the decline in dp_dt with occupancy is weak-to-moderate in the parent and sharply compressed after occupancy approaches capacity in the child."
    },
    "diagnostic_groups": [
      {
        "name": "occupancy_load",
        "expression": "attenuation_occupancy/attenuation_capacity",
        "role": "Dimensionless attenuation burden controlling realized selection suppression"
      },
      {
        "name": "logistic_drive",
        "expression": "p*(1 - p)",
        "role": "Baseline allele-frequency opportunity for deterministic viability-driven change"
      },
      {
        "name": "effective_drive_parent",
        "expression": "selection_coefficient*p*(1 - p)/(1 + attenuation_occupancy/attenuation_capacity)",
        "role": "Parent target mapping from current states to allele-frequency change"
      }
    ],
    "activation_condition": "Observable when attenuation_occupancy is driven into the same order as or above attenuation_capacity by sustained occupancy buildup, while p remains in the interior (not near 0 or 1) so logistic limitation does not dominate.",
    "train_hidden_contrast": "In training, modest occupancy already causes some attenuation; in holdout, larger occupancy_load reveals the stronger downward bending of dp_dt that a first-order attenuation law cannot match with one shared parameter set across both low- and high-load regimes.",
    "continuation_path": "Recover the parent law in the limit where the generalized attenuation nonlinearity reduces to first-order attenuation, or whenever occupancy_load << 1 so both laws agree to leading order.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes attenuation of the viability advantage is a simple first-order hyperbolic function of occupancy, which can be too weak when self-limiting ecological or physiological crowding compounds at high favored-carrier occupancy.",
    "baseline_assumption": "Occupancy attenuates realized selection through a single linear loading term in the denominator.",
    "scientific_mechanism": "Compounding crowding or saturation among favored carriers causes superlinear loss of realized viability benefit once occupancy accumulates, without changing the sign of selection or adding new evolutionary forces.",
    "affected_symbols": [
      "p",
      "attenuation_occupancy",
      "attenuation_capacity",
      "selection_coefficient"
    ],
    "rationale": "A realistic next refinement is to change the mathematical form of the already present attenuation process rather than add a new process. The parent target mapping has a single-gain shortcut: for fixed selection_coefficient, p, and attenuation_capacity, dp_dt depends on attenuation_occupancy through one first-order denominator, so the occupancy effect has a fixed curvature. Vary attenuation_occupancy through its existing dynamics by comparing early versus later times, or parameter settings with different occupancy_buildup_rate and occupancy_relaxation_rate, while holding the rest of the model form fixed. Under admissible conditions where attenuation_occupancy/attenuation_capacity reaches order 1 or larger and p stays away from the boundaries, the child would predict stronger compression of dp_dt at high occupancy than the parent. This changes the scored target mapping directly because dp_dt as a function of observed states p, selection_coefficient, and attenuation_occupancy acquires different curvature, not merely different hidden auxiliary trajectories. The effect is scientifically limited if occupancy stays far below capacity throughout observation; then the parent and child are practically indistinguishable to first order."
  },
