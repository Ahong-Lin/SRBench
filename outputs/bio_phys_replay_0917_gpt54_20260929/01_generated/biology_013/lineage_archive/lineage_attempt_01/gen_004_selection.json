{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "asymptotic_change",
      "parent_relation": "The thermoregulatory feedback term scales approximately linearly with the lagged effector state times core-temperature error, so once recruitment is near its tanh limit the corrective heat-loss/heating strength still grows in proportion to |T_c-core_temperature_set_point|.",
      "child_relation": "Replace the linear temperature-error dependence inside the thermoregulatory heat-loss term by a saturating dependence on core-temperature error, so corrective power increases near the set point but approaches a finite asymptote at larger deviations even when effector_recruitment_state is high.",
      "affected_inputs": [
        "T_c",
        "effector_recruitment_state",
        "core_temperature_set_point",
        "feedback_recruitment_temperature_scale",
        "thermoregulatory_feedback_gain"
      ],
      "observable_effect": "Across mild versus somewhat larger admissible core-temperature deviations under the same fixed ambient conditions, the child predicts weaker-than-linear additional cooling/heating at larger |T_c-core_temperature_set_point|, giving slower tail recovery than the parent after matching near-set-point slope."
    },
    "diagnostic_groups": [
      {
        "name": "core_error",
        "expression": "T_c - core_temperature_set_point",
        "role": "Signed thermal deviation driving thermoregulatory correction"
      },
      {
        "name": "normalized_error",
        "expression": "(T_c - core_temperature_set_point)/feedback_recruitment_temperature_scale",
        "role": "Dimensionless distance from the feedback transition scale"
      },
      {
        "name": "feedback_drive_proxy",
        "expression": "effector_recruitment_state*(T_c - core_temperature_set_point)",
        "role": "Parent effective corrective drive entering the target mapping"
      }
    ],
    "activation_condition": "Observable when initial perturbations or transient deviations reach order one or larger in normalized_error while remaining in the mild thermoregulation regime; near the set point the child reduces to the parent-like local slope and the contrast is weak.",
    "train_hidden_contrast": "In training on small perturbations both models can look similar because the saturating error law is locally linear. In holdout with somewhat larger but still physiologically admissible deviations at the same ambient temperature and activity, the child shows compressed corrective power and a flatter recovery tail.",
    "continuation_path": "Recover the parent law in the limit where the new saturation scale for error-dependent thermoregulatory heat transfer becomes large compared with |T_c-core_temperature_set_point| over the observed domain.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model lets corrective thermoregulatory heat flow keep increasing proportionally with core-temperature error even after effector recruitment has already saturated, omitting finite actuator capacity in the delivered thermal correction.",
    "baseline_assumption": "Thermoregulatory effectors respond without delay and do not saturate in the baseline range.",
    "scientific_mechanism": "Autonomic and vascular/sudomotor effectors have finite heat-transfer and metabolic adjustment capacity, so recruited effectors cannot generate indefinitely increasing corrective heat flux as core-temperature error grows.",
    "affected_symbols": [
      "T_c",
      "effector_recruitment_state",
      "thermoregulatory_feedback_gain",
      "core_temperature_set_point",
      "feedback_recruitment_temperature_scale"
    ],
    "rationale": "A realistic next refinement is to relax the parent's effectively unbounded corrective-gain assumption in the target equation itself, not merely in an auxiliary state. The parent already includes delayed and saturating recruitment through effector_recruitment_state, but once that state is near plus or minus one, the scored mapping dT_c_dt still contains a single shared linear factor in T_c-core_temperature_set_point. Thus at fixed ambient_temperature, basal_heat_production, environmental_heat_transfer_coefficient, heat-capacity term, and effector lag parameters, the parent predicts that stronger thermal deviations always produce proportionally stronger corrective heat flux. The child instead makes the thermoregulatory heat-transfer contribution saturate with temperature error magnitude, creating an asymptotic change in the T_c to dT_c_dt mapping. The distinguishing condition is to compare trajectories started with small versus moderately larger core-temperature perturbations, while holding ambient conditions and activity fixed and using one shared parameter set. Near the set point both models can match because the saturating law is locally linear, but at larger admissible |T_c-core_temperature_set_point| the child predicts a compressed corrective term and therefore less steep additional cooling for hyperthermia or heating for hypothermia than the parent. This is observable directly in dT_c_dt versus T_c, so it changes the target mapping rather than only the hidden effector trajectory. No new state is necessary because the omitted effect is a static nonlinearity in already modeled thermoregulatory output, not a new memory process. The limitation is that if all observed perturbations remain very small relative to the saturation scale, the refinement may be practically unidentifiable and the parent could approximate it well."
  },
