{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With fixed effective_heat_capacity, the same net heat flux always produces a temperature-rate change with constant conversion factor, so dT_c_dt is affine in net heat flux apart from the existing feedback nonlinearity.",
      "child_relation": "Make effective thermal storage depend on core temperature so the same net heat flux yields different dT_c_dt at different T_c, changing the local slope and curvature of the T_c-to-dT_c_dt map even when ambient conditions and activity are fixed.",
      "affected_inputs": [
        "T_c",
        "effective_heat_capacity"
      ],
      "observable_effect": "For comparable positive and negative thermal deviations around the set point, recovery becomes asymmetric in speed: regions with larger effective heat capacity show slower temperature-rate response to the same restoring heat flux magnitude."
    },
    "diagnostic_groups": [
      {
        "name": "thermal_error",
        "expression": "T_c - core_temperature_set_point",
        "role": "Distance from the thermoregulatory operating point"
      },
      {
        "name": "net_heat_flux_parent",
        "expression": "basal_heat_production - environmental_heat_transfer_coefficient*(T_c - ambient_temperature) - thermoregulatory_feedback_gain*tanh((T_c - core_temperature_set_point)/feedback_recruitment_temperature_scale)*(T_c - core_temperature_set_point)",
        "role": "Parent net heat storage flux before division by heat capacity"
      },
      {
        "name": "ambient_core_gradient",
        "expression": "T_c - ambient_temperature",
        "role": "Environmental cooling or warming drive"
      }
    ],
    "activation_condition": "Observable when admissible core-temperature excursions are large enough that temperature-dependent tissue heat storage is not negligible relative to the baseline effective_heat_capacity variation scale, while remaining in mild physiological ranges with positive total heat capacity.",
    "train_hidden_contrast": "In training, small perturbations near set point can still look close to the parent law; in holdout with somewhat larger but still physiological excursions, the altered temperature-rate curvature appears as systematically slower or faster relaxation than any one constant-capacity fit predicts.",
    "continuation_path": "Recover the parent by taking the temperature dependence of effective heat capacity to zero, giving a constant effective_heat_capacity.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes a constant conversion from net heat flux to core-temperature rate, omitting plausible temperature dependence of effective body heat storage over the perturbation range.",
    "baseline_assumption": "Effective heat capacity is constant over the modeled range.",
    "scientific_mechanism": "Temperature-dependent effective heat capacity from changing partition of stored heat among tissues and body water over mild thermal deviations.",
    "affected_symbols": [
      "T_c",
      "effective_heat_capacity",
      "core_temperature_set_point"
    ],
    "rationale": "The parent already contains restoring heat production/loss terms, but it enforces a single flux-to-temperature-rate gain through constant effective_heat_capacity. A realistic next refinement is to relax that assumption rather than add a new process. Vary the initial core-temperature perturbation amplitude while holding ambient_temperature, basal_heat_production, environmental_heat_transfer_coefficient, and thermoregulatory_feedback_gain fixed. In the parent, after accounting for the existing feedback nonlinearity, the same net restoring heat flux implies the same temperature-rate conversion everywhere because storage capacity is fixed. In the child, storage capacity changes with T_c, so the slope of dT_c_dt versus net heat flux depends on temperature, producing an observable curvature/asymmetry in relaxation across larger deviations. A single refit of the parent's existing parameters cannot generally match both near-set-point and farther-from-set-point recovery speeds when the discrepancy comes from denominator variation rather than only numerator feedback strength. This is scientifically admissible for mild physiology if the capacity modulation remains positive and moderate; if perturbations are extremely small, the effect collapses toward the parent and may be hard to identify."
  },
