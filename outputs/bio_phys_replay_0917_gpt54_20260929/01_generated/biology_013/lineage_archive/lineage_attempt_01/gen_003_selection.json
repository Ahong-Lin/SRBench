{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "The thermoregulatory correction is an instantaneous static function of the current core-temperature error, so for any observed T_c the target dT_c_dt is uniquely determined with no dependence on recent thermal history.",
      "child_relation": "The corrective thermoeffector drive is generated by a first-order lagged internal state that tracks core-temperature error, so the same observed T_c can yield different dT_c_dt depending on whether the system is early or late in recovery after the perturbation.",
      "affected_inputs": [
        "T_c",
        "t",
        "thermoregulatory_feedback_gain",
        "core_temperature_set_point",
        "feedback_recruitment_temperature_scale"
      ],
      "observable_effect": "After a step-like thermal perturbation, early-time relaxation is weaker than the parent predicts and later-time relaxation strengthens at similar T_c, creating hysteresis in the dT_c_dt versus T_c relationship."
    },
    "diagnostic_groups": [
      {
        "name": "temp_error",
        "expression": "T_c - core_temperature_set_point",
        "role": "signed deviation from thermoregulatory set point that recruits corrective responses"
      },
      {
        "name": "normalized_error",
        "expression": "(T_c - core_temperature_set_point)/feedback_recruitment_temperature_scale",
        "role": "dimensionless recruitment coordinate setting the nonlinear feedback regime"
      },
      {
        "name": "passive_loss",
        "expression": "environmental_heat_transfer_coefficient*(T_c - ambient_temperature)",
        "role": "temperature-driven environmental heat exchange already present in the parent"
      }
    ],
    "activation_condition": "Observable when the perturbation is fast relative to thermoeffector adjustment, so the recovery timescale includes an initial interval where effector recruitment has not yet reached its quasi-steady level; strongest for moderate deviations with |T_c-core_temperature_set_point| on the order of feedback_recruitment_temperature_scale or larger.",
    "train_hidden_contrast": "In training, mild perturbations may show only modest early-time flattening; in holdout with somewhat larger but still admissible excursions, the same lag produces a clearer delayed correction at similar T_c values, extending the same history-dependent mechanism rather than introducing a new branch.",
    "continuation_path": "Recover the parent law in the limit of vanishing effector adjustment time constant, where the added state rapidly equilibrates to the parent's static recruitment function of T_c.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A genuine response delay cannot be represented by refitting static gains in a one-state autonomous mapping because the target must then remain a single-valued function of T_c alone; an added state is needed to encode recent recruitment history.",
    "gap_statement": "The model omits finite thermoeffector activation dynamics, treating heat-loss/heating feedback as immediate rather than gradually recruited after a temperature error appears.",
    "baseline_assumption": "Thermoregulatory effectors respond without delay and do not saturate in the baseline range.",
    "scientific_mechanism": "First-order lag in autonomic/vascular/sudomotor thermoeffector recruitment causing delayed negative feedback relative to core-temperature deviation.",
    "affected_symbols": [
      "T_c",
      "thermoregulatory_feedback_gain",
      "core_temperature_set_point",
      "feedback_recruitment_temperature_scale"
    ],
    "rationale": "The parent maps current core temperature directly to dT_c_dt through passive exchange plus an instantaneous nonlinear feedback term, so at fixed ambient_temperature and unchanged parameters there is one recovery slope for each T_c. A realistic next refinement is to relax only the no-delay assumption by introducing a thermoeffector recruitment state that approaches the parent's tanh-based drive over time. Then, under the same fixed ambient conditions and preserved initial T_c contract, trajectories observed soon after a perturbation have weaker corrective feedback than trajectories later in recovery even at similar T_c. This changes the scored target mapping itself, not merely an auxiliary trajectory, because dT_c_dt is no longer determined by T_c alone. The contrast is admissible in the stated experiment whenever the perturbation is small-to-moderate but sufficiently rapid that core temperature changes before full effector recruitment occurs. A single refitted parameter set of the parent cannot reproduce both the initially shallow and later steeper relaxation at the same T_c, because its one-state autonomous form forbids history dependence."
  },
  "operation": "change_assumption",
