{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "threshold_surface",
      "parent_relation": "The parent uses one shared CO2-dependent oxygen half-activation shift for both peripheral hypoxic drive and hypoxia-induced potentiation of CO2 responsiveness, so varying P_CO2 only translates both hypoxic effects together along the same P_O2 threshold axis.",
      "child_relation": "Allow the oxygen threshold governing hypoxia-induced potentiation of CO2 responsiveness to differ from the oxygen threshold governing direct peripheral hypoxic drive, creating two distinct CO2-dependent hypoxic recruitment surfaces within the same static clamp experiment.",
      "affected_inputs": [
        "P_CO2",
        "P_O2"
      ],
      "observable_effect": "At matched P_CO2, ventilation can begin to show amplified CO2 sensitivity at milder hypoxia while the direct hypoxic ventilatory increment remains small, or conversely require deeper hypoxia before CO2 potentiation appears; this changes the shape of V_E versus P_O2 across several fixed P_CO2 levels."
    },
    "diagnostic_groups": [
      {
        "name": "x_CO2",
        "expression": "P_CO2/P_CO2_ref",
        "role": "nondimensional hypercapnic clamp level controlling central chemoreceptor stimulation"
      },
      {
        "name": "H_parent",
        "expression": "1 - (1 - 1/(1 + exp((P_O2 - (P_O2_half + Delta_P_O2_half_CO2*(P_CO2/P_CO2_ref - 1)))/S_O2)))**alpha_hypoxia",
        "role": "current shared hypoxic recruitment used simultaneously for direct peripheral drive and CO2 potentiation"
      },
      {
        "name": "CO2_branch",
        "expression": "G_CO2*(P_CO2/P_CO2_ref)/(1 + K_CO2_compression*(P_CO2/P_CO2_ref - 1))",
        "role": "central hypercapnic drive before hypoxic potentiation and downstream motor saturation"
      }
    ],
    "activation_condition": "Most visible when P_O2 is in the moderate-to-severe hypoxic transition region around the current half-activation scale and P_CO2 is varied above and below P_CO2_ref; at very high P_O2 both parent and child collapse toward weak hypoxic effects, and at extreme motor saturation differences are compressed.",
    "train_hidden_contrast": "In training, the mechanism appears as different P_O2 onsets for rising hypoxic baseline drive versus rising hypercapnic amplification across fixed-P_CO2 slices; in holdout, the same mismatch persists at intermediate P_CO2 values rather than being representable by one shared translated sigmoid.",
    "continuation_path": "Recover the parent by making the potentiation threshold identical to the direct hypoxic-drive threshold, i.e. setting the added threshold offset or released threshold difference to zero.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes that the same oxygen recruitment curve controls both direct peripheral hypoxic drive and hypoxia-dependent amplification of CO2 sensitivity, which is a restrictive idealization of carotid-body transduction.",
    "baseline_assumption": "A single shared hypoxic threshold surface in (P_O2,P_CO2) space governs all peripheral-hypoxia effects on ventilation.",
    "scientific_mechanism": "Distinct peripheral transduction pathways can make hypoxia start to potentiate hypercapnic responsiveness at a different oxygen level than the level producing substantial direct hypoxic drive, even under steady arterial gas clamps.",
    "affected_symbols": [
      "P_O2",
      "P_CO2",
      "P_O2_half",
      "Delta_P_O2_half_CO2",
      "K_CO2_hypoxia",
      "G_hypoxia"
    ],
    "rationale": "Vary P_O2 while holding P_CO2 fixed, then compare several fixed P_CO2 slices. In the parent, once all parameters are globally refit, the onset of direct hypoxic ventilation and the onset of hypoxic amplification of the CO2 branch must remain locked because both are driven by the same H_parent(P_O2,P_CO2). A child with separate hypoxic thresholds for these two pathways can produce a concrete contrast: at moderate hypoxia, V_E may show little direct hypoxic rise yet already exhibit stronger dependence on P_CO2, or the reverse. This is an observable change in the scored static mapping V_E(P_CO2,P_O2), not merely an auxiliary reinterpretation. The contrast is admissible in the sampled steady-clamp setting, especially when motor saturation is incomplete and P_O2 lies near the hypoxic transition range set by S_O2. A single parent parameter set cannot generally reproduce two different hypoxic onset locations for these two effects across the same collection of P_CO2 clamps, because moving the shared threshold to fit one branch necessarily moves the other with it."
  },
