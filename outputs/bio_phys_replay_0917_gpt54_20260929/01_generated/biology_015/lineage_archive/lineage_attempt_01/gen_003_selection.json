{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The parent uses one logistic hypoxic activation with a single CO2-shifted half-activation and fixed steepness, so at any fixed P_CO2 the P_O2-to-ventilation relation has one characteristic shoulder and nearly symmetric curvature after motor saturation is factored in.",
      "child_relation": "Refine the hypoxic chemoreceptor recruitment from a single-threshold sigmoid to a heterogeneous recruitment shape with broader low-activation onset and sharper late rise, while retaining CO2-dependent displacement; this changes the curvature of V_E versus P_O2 at fixed P_CO2 without introducing new inputs.",
      "affected_inputs": [
        "P_O2",
        "P_CO2"
      ],
      "observable_effect": "At fixed moderate-to-high P_CO2, ventilation can increase only mildly over moderate hypoxia yet accelerate more strongly in severe hypoxia than the parent's single-sigmoid family allows, even after refitting one shared parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "c",
        "expression": "P_CO2/P_CO2_ref",
        "role": "Nondimensional hypercapnic level controlling central drive and hypoxic sensitization"
      },
      {
        "name": "po2_shift",
        "expression": "P_O2 - (P_O2_half + Delta_P_O2_half_CO2*(P_CO2/P_CO2_ref - 1))",
        "role": "Oxygen tension relative to the CO2-shifted peripheral recruitment midpoint"
      },
      {
        "name": "h_parent",
        "expression": "1/(1 + exp((P_O2 - (P_O2_half + Delta_P_O2_half_CO2*(P_CO2/P_CO2_ref - 1)))/S_O2))",
        "role": "Parent single-threshold hypoxic activation coordinate already shaping both direct hypoxic drive and CO2 potentiation"
      }
    ],
    "activation_condition": "Observable when P_O2 is swept from near-normoxic into clearly hypoxic values while P_CO2 is held fixed, especially where hypoxic activation is appreciable but respiratory output is not yet completely saturated; the contrast is strongest for moderate to high c and po2_shift spanning several S_O2.",
    "train_hidden_contrast": "Within typical training ranges, the refined law appears as a broader shoulder in moderate hypoxia and a steeper rise in severe hypoxia at fixed P_CO2; in holdout it extends to stronger curvature differences under more extreme hypoxia or hypercapnia, using the same heterogeneous recruitment mechanism rather than a new branch.",
    "continuation_path": "Recover the parent when the added heterogeneity parameter tends to the limit that collapses the broadened recruitment shape back to the single logistic activation.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes all peripheral hypoxic chemoreceptor influence is recruited through one effective oxygen threshold and one fixed slope, which is an idealization of distributed carotid-body fiber sensitivities.",
    "baseline_assumption": "Replace the single homogeneous sigmoid assumption for hypoxic chemoreceptor activation with a heterogeneous steady recruitment shape under the same steady gas-clamp conditions.",
    "scientific_mechanism": "Peripheral chemoreceptor populations have distributed oxygen sensitivities, so aggregate hypoxic drive and hypoxia-induced CO2 potentiation can show asymmetric onset and severe-hypoxia acceleration not captured by one logistic threshold.",
    "affected_symbols": [
      "P_O2",
      "P_CO2",
      "P_O2_half",
      "S_O2",
      "G_hypoxia",
      "K_CO2_hypoxia"
    ],
    "rationale": "Parent response relationship: with P_CO2 fixed, V_E rises as P_O2 falls through one CO2-shifted sigmoid activation embedded in the drive, then saturates through the motor Hill nonlinearity. Changed target mapping: the child keeps the same measured inputs and steady output but changes the P_O2-to-V_E curvature by allowing heterogeneous peripheral recruitment, so moderate hypoxia and severe hypoxia need not lie on one shared logistic shoulder. Concrete distinguishing condition: vary P_O2 across the hypoxic range at two fixed P_CO2 clamps, one near reference and one elevated; hold all other conditions fixed. The child can produce a flatter response around moderate hypoxia together with a sharper late increase in severe hypoxia, and this curvature difference can itself become more evident at elevated P_CO2 because the same hypoxic activation also modulates effective CO2 gain. A single parent parameter set cannot generally match both the early and late hypoxic slopes across those clamps, because changing S_O2 or P_O2_half shifts one common sigmoid family rather than creating distributed-threshold curvature. This is a change in the scored static mapping V_E(P_CO2,P_O2), not merely an auxiliary interpretation. Limitation: if all sampled P_O2 values lie far from the activation region or ventilation is already fully saturated at V_E_max, the refinement is weakly identifiable."
  },
