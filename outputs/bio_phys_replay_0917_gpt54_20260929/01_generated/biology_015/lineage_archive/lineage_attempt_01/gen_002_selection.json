{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "threshold_surface",
      "parent_relation": "The hypoxic contribution and hypoxic potentiation of CO2 sensitivity share one fixed oxygen half-activation P_O2_half, so changing P_CO2 only rescales drive amplitude without shifting the apparent oxygen threshold of the ventilatory rise.",
      "child_relation": "Allow the oxygen half-activation governing peripheral chemoreflex recruitment to depend on P_CO2, so hypercapnia shifts the oxygen-response curve left or right and changes where hypoxic amplification becomes prominent, not just how large it becomes.",
      "affected_inputs": [
        "P_O2",
        "P_CO2"
      ],
      "observable_effect": "When comparing V_E versus P_O2 curves at low versus high fixed P_CO2, the child can show a CO2-dependent displacement of the hypoxic knee in addition to gain change; the parent can only change slope/amplitude around one common oxygen threshold."
    },
    "diagnostic_groups": [
      {
        "name": "hypoxic_sigmoid",
        "expression": "1/(1 + exp((P_O2 - P_O2_half)/S_O2))",
        "role": "Current oxygen-dependent chemoreceptor activation level with a fixed half-activation point"
      },
      {
        "name": "co2_nd",
        "expression": "P_CO2/P_CO2_ref",
        "role": "Nondimensional hypercapnic level used to compare oxygen-response curves across fixed CO2 clamps"
      },
      {
        "name": "co2_hypoxia_synergy",
        "expression": "(P_CO2/P_CO2_ref)/(1 + exp((P_O2 - P_O2_half)/S_O2))",
        "role": "Region where combined hypercapnia and hypoxia expose whether CO2 changes only gain or also the oxygen threshold"
      }
    ],
    "activation_condition": "Observable when P_O2 is sampled through the transition region around P_O2_half over at least two distinct fixed P_CO2 clamps spanning normocapnia to moderate hypercapnia; the effect is weak if measurements stay far above or far below the hypoxic knee.",
    "train_hidden_contrast": "In training, varying P_CO2 changes overall ventilatory gain under hypoxia; in holdout, the same mechanism predicts that the P_O2 value where ventilation begins to rise sharply also shifts with P_CO2, especially in the moderate hypoxic range where the sigmoid is neither saturated nor negligible.",
    "continuation_path": "Recover the parent by setting the CO2 dependence of the oxygen half-activation to zero, restoring a single shared P_O2_half for all CO2 clamps.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes a fixed oxygen threshold for peripheral chemoreceptor activation and for hypoxic amplification across all arterial CO2 levels, whereas carotid-body sensitivity is known to be reset by hypercapnia as well as amplified in gain.",
    "baseline_assumption": "The exact parent assumption to relax is that P_O2_half is constant and independent of P_CO2 in the hypoxic activation sigmoid.",
    "scientific_mechanism": "Hypercapnia shifts the effective oxygen setpoint of peripheral chemoreceptor recruitment, causing CO2-dependent displacement of the hypoxic ventilatory response curve under steady clamps.",
    "affected_symbols": [
      "P_O2",
      "P_CO2",
      "P_O2_half",
      "S_O2",
      "G_hypoxia",
      "K_CO2_hypoxia"
    ],
    "rationale": "Parent response: at fixed P_O2, ventilation increases with P_CO2 and hypoxia multiplicatively amplifies the CO2 term, but every V_E-versus-P_O2 curve bends around one shared oxygen threshold set by P_O2_half. Proposed child change: make the hypoxic sigmoid's half-activation CO2-dependent, so increasing P_CO2 can move the oxygen threshold at which peripheral drive and CO2 potentiation turn on. Distinguishing condition: vary P_O2 across the mid-sigmoid region while holding all parameters fixed and compare low versus high P_CO2 clamps. The child can produce both a threshold shift and gain change; the parent with one shared parameter set can only alter amplitude/slope around the same threshold because refitting G_hypoxia, K_CO2_hypoxia, S_O2, or n_motor cannot assign different P_O2 knees to different P_CO2 values simultaneously. This is a direct change in the scored static mapping V_E(P_CO2,P_O2), not merely an auxiliary reformulation. The effect is scientifically admissible in moderate hypoxia and moderate hypercapnia; if data include only severe hypoxia or normoxia, threshold motion would be hard to identify, so the refinement should be viewed as a hypothesis about sampled regimes rather than guaranteed observability everywhere."
  },
