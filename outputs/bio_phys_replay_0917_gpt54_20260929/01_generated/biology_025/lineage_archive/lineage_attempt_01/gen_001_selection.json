{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "separable_product",
    "response_change": {
      "type": "asymptotic_change",
      "parent_relation": "v_inc increases linearly and separably as k_on*G*E, so at fixed E the slope with respect to G is constant and at fixed G the slope with respect to E is constant.",
      "child_relation": "retain dependence on both G and E but relax the idealized unlimited-access assumption so the increase with exposed ends becomes sublinear and approaches an end-crowding/accessibility-limited asymptote at high E while remaining approximately linear at low E.",
      "affected_inputs": [
        "G",
        "E"
      ],
      "observable_effect": "When G is held fixed and E is varied from sparse to crowded end densities, incorporation first rises nearly proportionally to E and then shows diminishing returns; the parent predicts no such bend because one global k_on gives the same linear slope at all E."
    },
    "diagnostic_groups": [
      {
        "name": "monomer_load",
        "expression": "G",
        "role": "available polymerization-competent monomer level"
      },
      {
        "name": "end_load",
        "expression": "E",
        "role": "density of exposed polymerizing ends that may compete for access or shared local supply"
      },
      {
        "name": "collision_mass",
        "expression": "G*E",
        "role": "parent bilinear encounter predictor used as low-density reference"
      }
    ],
    "activation_condition": "Observable when exposed-end abundance is high enough that nearby ends are no longer effectively independent on the measurement timescale, while G remains in a regime where monomer is available and depletion is still negligible during the immediate assay.",
    "train_hidden_contrast": "In training, low-to-moderate E can appear close to bilinear; in holdout extended to higher E at fixed G, the same mechanism yields diminishing returns in v_inc versus E rather than continued proportional growth.",
    "continuation_path": "Recover the parent law in the dilute-end limit where end competition/crowding is negligible, so each end behaves independently and accessibility per end is effectively constant.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes every counted filament end contributes an identical, E-independent addition capacity even when end density becomes large enough for ends to compete for local monomer access or sterically interfere.",
    "baseline_assumption": "All counted filament ends are equally accessible and polymerization competent, independent of total exposed-end abundance.",
    "scientific_mechanism": "Finite accessibility or local competition among nearby polymerizing ends causes per-end incorporation efficiency to fall as E increases, producing saturating dependence on E without violating the requirement that both G and E are needed.",
    "affected_symbols": [
      "G",
      "E",
      "k_on"
    ],
    "rationale": "Parent response: with G varied at fixed E, v_inc is a straight line through the origin with slope k_on*E; with E varied at fixed G, it is a straight line through the origin with slope k_on*G. A realistic next refinement is to relax independent-end accessibility: at low E, separated ends act independently and the parent law is recovered, but at sufficiently high E, ends share finite local access volume or hinder one another, so additional ends contribute less than proportionally. Distinguishing condition: hold G fixed and increase E across a range spanning sparse to crowded exposed ends; the child predicts monotone but bending, eventually saturating v_inc(E), whereas the parent with one shared parameter set remains exactly linear in E over all such conditions. This changes the scored static mapping itself, not merely hidden trajectories. The effect is scientifically admissible only when end density is high enough for competition/crowding yet the assay remains immediate enough that monomer depletion and remodeling remain negligible."
  },
