{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "The parent is bilinear in monomer concentration with an end-crowding correction that depends only on E: v_inc = k_on*G*E/(1 + E/E_crowd), so at any fixed E the slope with respect to G is proportional to E/(1+E/E_crowd) and does not itself bend with G.",
      "child_relation": "Relax the assumption that end crowding is independent of monomer abundance by allowing the crowding/access limitation to strengthen when both G and E are high, so the effective response to increasing G becomes progressively flatter at large E instead of remaining exactly linear in G.",
      "affected_inputs": [
        "G",
        "E"
      ],
      "observable_effect": "When E is varied while G is swept, low-E curves remain nearly linear in G but high-E curves show sublinear growth; equivalently, the apparent half-saturation/end-sharing scale shifts with G, creating a G-by-E interaction absent from the parent."
    },
    "diagnostic_groups": [
      {
        "name": "end_load",
        "expression": "E/E_crowd",
        "role": "baseline exposed-end crowding level in the parent law"
      },
      {
        "name": "encounter_flux_scale",
        "expression": "k_on*G*E",
        "role": "dilute-limit monomer-end encounter drive before accessibility losses"
      }
    ],
    "activation_condition": "Observable when exposed-end density is already in the crowding regime E comparable to or larger than E_crowd and monomer supply is high enough that transport/shared-access limitations at clustered ends are no longer negligible; weak or absent at low E or low G.",
    "train_hidden_contrast": "Within training, the mechanism appears as stronger-than-parent flattening of v_inc versus E at larger G; in holdout it extends to the prediction that v_inc versus G is nearly linear at sparse ends but increasingly sublinear at crowded ends using one shared parameter set.",
    "continuation_path": "In the limit that monomer-dependent accessibility effects vanish, the added G-dependent modulation tends to zero and the parent crowding law is recovered exactly.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes that the only departure from dilute second-order addition is an end-density penalty fixed solely by E, ignoring that competition for monomer access near many nearby ends can intensify when monomer-driven incorporation demand itself is large.",
    "baseline_assumption": "Per-end efficiency loss from crowding depends only on exposed-end concentration and is independent of monomer concentration.",
    "scientific_mechanism": "At high densities of active filament ends, local depletion/shared diffusion access near end-rich regions makes crowding effectively depend on the joint demand from both monomers and ends, not on E alone.",
    "affected_symbols": [
      "G",
      "E",
      "E_crowd",
      "k_on"
    ],
    "rationale": "Vary G over a broad admissible range at two or more fixed E values, one with E much less than E_crowd and one with E on the order of or above E_crowd. The parent predicts exactly linear dependence on G at every fixed E, differing only by a constant prefactor set by E/(1+E/E_crowd). A scientifically reasonable refinement is that in crowded end fields, increasing G raises simultaneous incorporation demand and worsens shared-access limitations, so the G-response bends downward only when E is high. This changes the scored input-output mapping itself, not just hidden trajectories, because v_inc(G,E) gains a genuine cross-dependence. A single refit of the parent parameters cannot reproduce both near-linear low-E G sweeps and sublinear high-E G sweeps across the same dataset, since the parent has no mechanism for E-dependent curvature in G. The effect should not be claimed outside the regime of appreciable end crowding; under sparse ends or low monomer supply the parent remains an adequate approximation."
  },
