{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed ionic_strength, the competent-state occupancy is the product of two independent Henderson-Hasselbalch factors, so log10(k_app) has a single symmetric bell-like pH window determined only by two effective pKa values, with any intrinsic competent-state pH effect entering only as a local linear tilt around the window center.",
      "child_relation": "Retain the same two-group occupancy logic but relax the idealized assumption that each protonation step is perfectly noncooperative. Model one or both acid-base transitions with an effective Hill-type steepness, allowing the pH window flanks to become sharper or broader than the parent predicts while preserving a single activity window.",
      "affected_inputs": [
        "pH",
        "ionic_strength"
      ],
      "observable_effect": "Across pH scans at different fixed ionic_strength values, the rise and fall of activity around the window can show systematically altered flank steepness and peak sharpness that cannot be matched by merely shifting the pKa values or applying one shared turnover tilt."
    },
    "diagnostic_groups": [
      {
        "name": "pKaP_eff",
        "expression": "pKa_protonated_group + ionic_strength*ionic_strength_sensitivity_protonated_group/(ionic_strength + ionic_strength_half_saturation)",
        "role": "ionic-strength-shifted effective pKa of the group that must stay protonated"
      },
      {
        "name": "pKaD_eff",
        "expression": "pKa_deprotonated_group + ionic_strength*ionic_strength_sensitivity_deprotonated_group/(ionic_strength + ionic_strength_half_saturation)",
        "role": "ionic-strength-shifted effective pKa of the group that must be deprotonated"
      },
      {
        "name": "center_offset",
        "expression": "pH - (pKa_protonated_group + ionic_strength*ionic_strength_sensitivity_protonated_group/(ionic_strength + ionic_strength_half_saturation) + pKa_deprotonated_group + ionic_strength*ionic_strength_sensitivity_deprotonated_group/(ionic_strength + ionic_strength_half_saturation))/2",
        "role": "pH displacement from the ionic-strength-dependent center of the catalytic window"
      },
      {
        "name": "window_width_proxy",
        "expression": "pKa_protonated_group + ionic_strength*ionic_strength_sensitivity_protonated_group/(ionic_strength + ionic_strength_half_saturation) - pKa_deprotonated_group - ionic_strength*ionic_strength_sensitivity_deprotonated_group/(ionic_strength + ionic_strength_half_saturation)",
        "role": "separation between the two effective pKa values that sets the baseline window width"
      }
    ],
    "activation_condition": "Observable when pH is sampled sufficiently across both acidic and basic flanks of the activity window, especially when ionic_strength is high enough for local electrostatic restructuring to matter but still within the non-denaturing buffered regime; the effect is strongest when deviations from ideal unit-slope protonation curves exceed experimental noise.",
    "train_hidden_contrast": "In training, modest deviations appear as slightly too-sharp or too-broad shoulders near the peak; in holdout, the same nonideal steepness yields clearer mismatch on farther flanks or at ionic_strength values where electrostatic coupling strengthens the apparent cooperativity.",
    "continuation_path": "Recover the parent law when the effective protonation steepness returns to the ideal independent value of 1 for the relaxed transition(s), or when data are restricted to a narrow pH region near the peak where altered flank steepness is weakly expressed.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes each required protonation equilibrium follows an ideal independent Henderson-Hasselbalch transition with fixed unit steepness, which can be too restrictive for active sites where nearby charges and solvent reorganization broaden or sharpen the pH response.",
    "baseline_assumption": "Protonation equilibrates before activity is measured, and each catalytic ionization is represented by an ideal two-state unit-slope titration curve.",
    "scientific_mechanism": "Apparent nonideal protonation steepness from local electrostatic coupling, microstate heterogeneity, or rapid unresolved conformational averaging can make the occupancy of the catalytically competent protonation pattern vary with pH more sharply or more gradually than the ideal independent form.",
    "affected_symbols": [
      "pH",
      "ionic_strength",
      "pKa_protonated_group",
      "pKa_deprotonated_group",
      "ionic_strength_sensitivity_protonated_group",
      "ionic_strength_sensitivity_deprotonated_group",
      "ionic_strength_half_saturation"
    ],
    "rationale": "The parent already includes ionic-strength-dependent pKa shifts and an ionic-strength-activated intrinsic-turnover tilt, so a natural remaining gap is not another omitted process but the idealized shape of the protonation transitions themselves. Vary pH while holding ionic_strength fixed for each scan, then compare scans across ionic_strength. The parent can move the peak and alter overall height or local skew through the turnover factor, but with one shared parameter set it still enforces unit-slope occupancy flanks on both sides of the activity window. A child that allows nonideal steepness changes the target mapping itself: the acidic and/or basic shoulders gain different curvature and peak sharpness even after refitting all existing parent parameters. This is scientifically admissible in equilibrated, non-denaturing buffered measurements because local electrostatic coupling and unresolved microheterogeneity can distort apparent titration steepness without violating static equilibrium assumptions. The contrast is observable only when pH coverage includes the flanks; if measurements are confined near the peak, the refinement may be weakly identifiable."
  },
