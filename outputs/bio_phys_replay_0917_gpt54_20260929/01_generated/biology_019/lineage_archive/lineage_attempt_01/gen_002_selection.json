{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The parent makes each catalytic group's effective pKa shift linearly with ionic_strength, so the log-activity profile versus pH is the same two-ionization bell shape whose center and width vary only affinely with ionic_strength.",
      "child_relation": "Replace the linear ionic-strength dependence of effective pKa with a nonlinear screening dependence, so increasing ionic_strength causes diminishing pKa shifts and therefore a non-affine change in the pH-activity window position and width.",
      "affected_inputs": [
        "ionic_strength",
        "pH"
      ],
      "observable_effect": "Across low to moderate versus high ionic_strength, the activity peak shifts rapidly at first and then saturates; one shared parent parameter set with linear pKa shifts cannot match both the early sensitivity and the later flattening of the pH-optimum movement."
    },
    "diagnostic_groups": [
      {
        "name": "acid_load_prot",
        "expression": "10**(pH - (pKa_protonated_group + ionic_strength_sensitivity_protonated_group*ionic_strength))",
        "role": "Parent protonated-required group's deprotonation loading factor"
      },
      {
        "name": "acid_load_deprot",
        "expression": "10**((pKa_deprotonated_group + ionic_strength_sensitivity_deprotonated_group*ionic_strength) - pH)",
        "role": "Parent deprotonated-required group's protonation loading factor"
      },
      {
        "name": "I_regime",
        "expression": "ionic_strength",
        "role": "Screening regime coordinate that determines whether ionic-strength effects are near-linear or already saturating"
      }
    ],
    "activation_condition": "Observable when ionic_strength spans a broad enough range that electrostatic screening is weakly linear near ionic_strength≈0 but begins to saturate at moderate to high ionic_strength within the admissible 0 to 1 range; pH must be sampled around the activity peak so peak motion and width changes are visible.",
    "train_hidden_contrast": "The same enzyme can show approximately linear peak shifts over a narrow training range of ionic_strength, while holdout conditions extending to higher ionic_strength reveal saturation of those shifts from the same screening mechanism.",
    "continuation_path": "In the limit where the nonlinear screening function is expanded over a very small ionic_strength range, the child reduces to the parent's linear pKa-shift law.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes ionic_strength changes each catalytic pKa by a strictly linear amount across the full assay range, omitting the physically common saturation of electrostatic screening effects.",
    "baseline_assumption": "Relax the assumption that ionic-strength sensitivity of each ionizable group's effective pKa is linear over the sampled ionic-strength range.",
    "scientific_mechanism": "Electrostatic screening in buffered solution often produces diminishing additional pKa shifts as ionic_strength rises, because the local interaction energy is progressively screened rather than indefinitely changing in direct proportion to ionic strength.",
    "affected_symbols": [
      "ionic_strength",
      "pKa_protonated_group",
      "pKa_deprotonated_group",
      "ionic_strength_sensitivity_protonated_group",
      "ionic_strength_sensitivity_deprotonated_group"
    ],
    "rationale": "Parent response: at fixed saturating substrate and equilibrated enzyme, k_app is the competent-state turnover multiplied by a two-group occupancy fraction, with ionic_strength only translating the two effective pKas linearly. This creates a bell-shaped pH-response whose optimum and width move affinely with ionic_strength. Scientific gap: real salt screening typically has strongest incremental effect at low ionic_strength and weaker incremental effect after partial screening is already achieved. Child change: keep the same equilibrated protonation logic, but replace the linear ionic_strength-to-pKa mapping by a saturating nonlinear one. Varied conditions are pH and ionic_strength; k_cat_competent and the enzyme's underlying ionization architecture are held fixed. Concrete contrast: if assays include ionic_strength from near 0 up to moderate/high values, the child predicts that the pH optimum and flank steepness change quickly at low ionic_strength and then flatten, whereas the parent forces the same shift per unit ionic_strength everywhere. A single refit of the parent can approximate either the low-ionic-strength slope or the high-ionic-strength flattening, but not both simultaneously across those conditions. This changes the scored target mapping itself, not merely an auxiliary latent quantity. Limitation: if ionic_strength varies only over a very narrow interval, the parent may be an adequate local approximation and the contrast may be weak."
  },
