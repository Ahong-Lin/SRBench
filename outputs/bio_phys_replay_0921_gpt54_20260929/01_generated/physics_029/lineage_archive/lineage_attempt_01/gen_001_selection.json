{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed mu, L, and R, the parent predicts a strictly linear proportionality delta_p ∝ Q with one shared slope 8*mu*L/(pi*R**4).",
      "child_relation": "Relax the fully developed creeping-flow assumption to include the laminar inertial correction for finite Reynolds number in a straight tube, so the delta_p-versus-Q mapping gains upward curvature through a Q-dependent friction response rather than a single constant slope.",
      "affected_inputs": [
        "Q",
        "mu",
        "R",
        "L"
      ],
      "observable_effect": "When Q is increased at fixed mu, R, and L, the effective resistance delta_p/Q rises with Q instead of remaining constant; equivalently, two experiments at different Q ranges cannot be matched by one common linear slope."
    },
    "diagnostic_groups": [
      {
        "name": "conductance_scale",
        "expression": "8*mu*L/(pi*R**4)",
        "role": "baseline Poiseuille hydraulic resistance scale"
      },
      {
        "name": "wall_shear_rate_scale",
        "expression": "Q/R**3",
        "role": "flow-rate-controlled shear/intensity coordinate that tracks departure from the strict linear-response regime"
      }
    ],
    "activation_condition": "Observable when the flow remains laminar and steady but is no longer in the asymptotically negligible-inertia limit; practically, at moderate Reynolds number in a long straight tube where entrance effects remain small compared with the total length.",
    "train_hidden_contrast": "Within lower-Q training data the law is near-linear and close to Poiseuille, while extension to higher but still laminar Q reveals a systematic increase in slope that the parent cannot capture with one shared coefficient set.",
    "continuation_path": "In the low-Reynolds-number limit, equivalently as Q becomes small relative to viscous scale at fixed mu and R, the inertial correction vanishes and the parent Poiseuille law is recovered.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model treats axial momentum loss as purely viscous, imposing a constant hydraulic resistance independent of flow intensity.",
    "baseline_assumption": "The flow is steady, laminar, and fully developed in the strict viscous-dominated Poiseuille limit, so inertia does not modify the pressure-drop/flow-rate relation.",
    "scientific_mechanism": "Finite but still laminar convective inertia alters the effective laminar friction relation, producing a pressure drop that grows faster than linearly with volumetric flow rate even without turbulence or compressibility.",
    "affected_symbols": [
      "Q",
      "mu",
      "R",
      "L"
    ],
    "rationale": "The parent response relationship is a single-gain mapping: with mu, L, and R held fixed, varying Q changes delta_p only through a constant slope. A realistic next refinement is to relax the idealization that inertia is negligible everywhere in the admissible experiment. In long straight circular tubes, one can remain in steady laminar flow yet observe a finite-Reynolds-number correction to hydraulic resistance. The child therefore changes the target mapping itself, not merely an auxiliary trajectory: at fixed geometry and viscosity, delta_p(Q) becomes upward-curved so that delta_p/Q increases with Q. This contrast is observable by comparing low-Q and moderate-Q subsets under the same mu, L, and R; one shared refitted parent slope cannot fit both if the effective resistance rises with Q. The admissible regime is moderate laminar flow with negligible entrance contribution to the total drop and no turbulence, preserving dissipative orientation and nonnegative pressure loss. A limitation is that the effect should not be claimed in the asymptotically small-Q creeping-flow regime, where the parent remains an excellent approximation."
  },
