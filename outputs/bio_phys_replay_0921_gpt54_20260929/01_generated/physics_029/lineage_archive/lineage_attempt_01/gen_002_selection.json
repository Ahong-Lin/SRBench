{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed mu, L, R, and Rho, the parent gives delta_p proportional to Q plus a single weak quadratic-in-Q correction from laminar inertia, so the dependence on flow rate has one shared low-order shape across all admissible conditions.",
      "child_relation": "Relax the fully developed assumption to include a developing-flow laminar entrance-loss contribution whose strength depends on a Reynolds-like combination of Q, Rho, mu, and R and is scaled by tube aspect ratio, so delta_p gains additional flow-rate curvature beyond the parent's single inertial correction.",
      "affected_inputs": [
        "Q",
        "L",
        "R",
        "mu",
        "Rho"
      ],
      "observable_effect": "When Q is increased at fixed mu, R, and Rho, short tubes show a stronger-than-parent excess pressure drop relative to long tubes because entrance development occupies a larger fraction of the tube; the parent with one shared parameter set cannot match both the long-tube near-Poiseuille trend and the short-tube extra curvature versus Q."
    },
    "diagnostic_groups": [
      {
        "name": "Re_tube",
        "expression": "2*Rho*Q/(pi*mu*R)",
        "role": "tube Reynolds number controlling laminar development strength"
      },
      {
        "name": "aspect",
        "expression": "L/R",
        "role": "tube slenderness setting the relative importance of entrance development"
      },
      {
        "name": "Poiseuille_scale",
        "expression": "8*mu*L*Q/(pi*R**4)",
        "role": "baseline fully developed viscous pressure-drop scale"
      }
    ],
    "activation_condition": "Observable for laminar but not asymptotically fully developed conditions, especially moderate Re_tube with finite aspect ratio so the hydrodynamic entrance length is not negligible compared with L; it fades for very long tubes or very small Re_tube.",
    "train_hidden_contrast": "Within training, varying Q at fixed fluid and radius already changes Re_tube and reveals mild non-Poiseuille curvature; in holdout, varying L/R exposes that the excess curvature is systematically larger for shorter tubes, extending the same entrance-development mechanism rather than introducing a new one.",
    "continuation_path": "Recover the parent law in the fully developed limit where entrance-length effects are negligible compared with tube length, e.g. L/R sufficiently large at fixed Re_tube, or in the very low-Re_tube limit where development corrections vanish.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model includes a finite laminar inertia correction but still treats the entire tube as effectively fully developed, omitting laminar entrance-region pressure losses that depend jointly on flow rate and tube aspect ratio.",
    "baseline_assumption": "The flow is steady, laminar, and fully developed.",
    "scientific_mechanism": "Hydrodynamic development from an entering profile toward the parabolic laminar profile adds extra viscous dissipation and pressure loss before fully developed conditions are reached.",
    "affected_symbols": [
      "Q",
      "L",
      "R",
      "mu",
      "Rho",
      "laminar_inertia_coeff"
    ],
    "rationale": "Parent response relationship: delta_p increases with Q through a baseline linear Poiseuille term plus one inertial correction, so at fixed mu, R, and Rho the target mapping has a single shared low-order curvature in Q. Changed target mapping: if L is varied while mu, R, Rho are held fixed, short tubes retain an entrance-development contribution that adds pressure drop with its own dependence on Reynolds number and aspect ratio, increasing both slope and curvature of delta_p versus Q relative to long tubes. This is a direct change to the scored mapping from supplied inputs to pressure drop, not merely an auxiliary internal trajectory. Concrete distinguishing condition: compare two tubes with the same R, mu, and Rho but different L/R in the laminar regime where Re_tube is moderate and entrance length is a noticeable fraction of L. The child predicts a larger fractional excess over fully developed behavior for the shorter tube as Q rises; a single refit of the parent's laminar_inertia_coeff cannot reproduce that systematic length-dependent curvature because its existing correction scales with Q through the same multiplicative L-prefactor as the base term and does not separately encode developing-flow occupancy of the tube. Limitation: if all admissible cases are very long tubes or extremely low Re_tube, this refinement would be weakly observable and the parent would remain adequate."
  },
