{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The parent maps (Delta,T) to n_bar through a single effective free-energy offset Delta - T log(Z_occ/Z_emp), so at fixed T the occupation is always a logistic curve in Delta with one common slope scale 1/T and only a temperature-shifted midpoint.",
      "child_relation": "Refine the ideal noninteracting single-level assumption by allowing weak occupancy-dependent level renormalization from the environment or image-charge/polarization effects, so the effective offset becomes occupancy dependent and equilibrium is determined self-consistently. Then at fixed T the n_bar-versus-Delta curve is no longer a pure logistic with one fixed curvature; its transition sharpens or broadens in an occupation-dependent way.",
      "affected_inputs": [
        "Delta",
        "T"
      ],
      "observable_effect": "When Delta is swept at two fixed temperatures in a regime of weak but nonzero feedback, the crossover width and local curvature change in a correlated way that cannot be matched by merely refitting g_occ, a_occ, E_occ, a_emp, E_emp once, because those only alter the temperature-dependent midpoint through partition weights while preserving the logistic-in-Delta form at each T."
    },
    "diagnostic_groups": [
      {
        "name": "x_parent",
        "expression": "(Delta - T*log(g_occ*(1 + a_occ*exp(-E_occ/T))/(1 + a_emp*exp(-E_emp/T))))/T",
        "role": "Parent effective dimensionless free-energy argument controlling the logistic occupation"
      },
      {
        "name": "w_ratio",
        "expression": "g_occ*(1 + a_occ*exp(-E_occ/T))/(1 + a_emp*exp(-E_emp/T))",
        "role": "Occupied-to-empty internal partition-weight ratio already present in the parent"
      },
      {
        "name": "betaDelta",
        "expression": "Delta/T",
        "role": "Baseline thermal control coordinate for the occupation crossover"
      }
    ],
    "activation_condition": "Observable when the occupancy-dependent renormalization energy is comparable to the thermal width over part of the sampled crossover, i.e. weak-to-moderate feedback on the scale of T, especially for Delta near the parent transition region where 0.1 < n_bar < 0.9.",
    "train_hidden_contrast": "In training, varying Delta at several fixed T values already exposes deviations from a single logistic shape in Delta; in holdout, the same mechanism persists and becomes more visible at lower T where a fixed renormalization scale competes more strongly with thermal broadening.",
    "continuation_path": "The parent law is recovered in the zero-feedback limit where the occupancy-dependent renormalization strength vanishes, restoring a Delta-independent effective level energy.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the level energy entering equilibrium statistics is independent of its own mean occupation, excluding physically common self-consistent environmental or polarization shifts of the addition energy.",
    "baseline_assumption": "Interactions beyond the single-occupancy restriction are absent.",
    "scientific_mechanism": "Weak mean-field occupancy-dependent energy renormalization of the level due to electrostatic/image-charge/environmental polarization, producing a self-consistent free-energy shift during particle exchange with the reservoir.",
    "affected_symbols": [
      "Delta",
      "T",
      "g_occ",
      "a_occ",
      "E_occ",
      "a_emp",
      "E_emp"
    ],
    "rationale": "Parent response relationship: at fixed T, changing Delta only translates a standard Fermi/logistic crossover whose slope with respect to Delta is fully set by T; the existing internal-state factors modify only the effective midpoint through log partition weights. Child change: allow the addition energy to depend on occupation itself, which changes the target mapping n_bar(Delta,T) rather than only an auxiliary quantity, because the equilibrium solution becomes self-consistent and the Delta sweep acquires altered curvature and width near partial occupation. Distinguishing condition: sweep Delta while holding each of two temperatures fixed, with the internal-state parameters fixed globally; under admissible weak-feedback conditions where the renormalization scale is not negligible compared with T, the child predicts systematic sharpening or broadening around the crossover that a single refitted parent parameter set cannot reproduce across both temperatures, since the parent remains exactly logistic in Delta at every T. This is a realistic refinement for a single localized level coupled to a polarizable environment. Limitation: if the feedback scale is much smaller than all sampled temperatures, the effect becomes hard to distinguish and the parent is an adequate approximation."
  },
