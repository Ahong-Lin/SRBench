{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "threshold_surface",
      "parent_relation": "With fixed temperature and chemistry, the equilibrium activation fraction is a bounded monotone function of voltage alone with one shared half-activation scale and one shared steepness profile.",
      "child_relation": "Release the fixed-environment assumption by allowing the activation midpoint to depend on an independently varied extracellular ion condition, so the equilibrium activation becomes a bounded monotone function on a two-input surface m_inf(V, S) whose voltage threshold shifts systematically with that condition.",
      "affected_inputs": [
        "V"
      ],
      "observable_effect": "Across recordings taken at different extracellular conditions, the activation curve translates along the voltage axis while retaining finite lower and upper plateaus; a single parent parameter set cannot match both the low-condition and high-condition threshold locations simultaneously."
    },
    "diagnostic_groups": [
      {
        "name": "voltage_offset",
        "expression": "V - V_half",
        "role": "Parent voltage distance from the nominal half-activation point"
      },
      {
        "name": "local_steepness_denominator",
        "expression": "k_activation*(1 + curvature_scale*(V - V_half))",
        "role": "Parent effective voltage-sensitivity scale controlling local sigmoid width and asymmetry"
      }
    ],
    "activation_condition": "Observable when equilibrium activation curves are measured over the same voltage range under at least two extracellular environments that shift gating energetics by an amount comparable to or larger than the local transition width, while activation remains monotone and bounded between the finite plateaus.",
    "train_hidden_contrast": "In training, modest environment changes already produce visible left/right displacement of the activation curve; in holdout, the same mechanism extends to somewhat broader environments where the threshold shift continues smoothly rather than requiring separate refits for each condition.",
    "continuation_path": "Recover the parent law when the added environmental dependence vanishes, e.g. the new threshold-shift coefficient tends to zero or the new input is held fixed at its reference value for all samples.",
    "freedom_change": "add_input",
    "promoted_symbol": null,
    "promotion_reason": "The missing effect is a genuine environment-dependent change in the scored equilibrium mapping. Existing voltage-only inputs cannot express condition-dependent threshold shifts without incorrectly refitting separate parameter sets for each environment.",
    "gap_statement": "The current model assumes one universal half-activation location for all measurements, omitting experimentally realistic shifts of the activation threshold caused by changes in extracellular conditions while the membrane is still clamped to equilibrium.",
    "baseline_assumption": "Temperature and extracellular ion concentrations are fixed.",
    "scientific_mechanism": "Extracellular ionic conditions can alter surface-potential screening or electrostatic stabilization of gating conformations, shifting the voltage required for half-activation without requiring dynamics or violating bounded monotone activation.",
    "affected_symbols": [
      "V_half",
      "V"
    ],
    "rationale": "The parent already captures a static bounded activation curve with voltage-dependent asymmetry, but it still uses a single shared threshold reference V_half for all observations. A realistic next refinement is to relax the fixed-environment assumption and let an independently varied extracellular condition shift the activation threshold. The varied condition is the new extracellular input; the held-fixed aspects are the equilibrium protocol, voltage clamp duration, and finite activation plateaus. Under admissible conditions where the environmental perturbation is strong enough to move the midpoint by a noticeable fraction of the activation width but not so strong as to break monotonic activation, the child predicts a family of activation curves whose midpoint moves across conditions. The scored target mapping changes directly because m_inf at the same V differs between environments. A single parent parameter set cannot reproduce this cross-condition contrast: its one V_half and one curvature profile can fit only one common threshold trajectory in V, so it cannot simultaneously place the transition region at distinct voltages for multiple environments without separate refits. This is therefore a consequential target-mapping refinement rather than a decorative algebraic change."
  },
