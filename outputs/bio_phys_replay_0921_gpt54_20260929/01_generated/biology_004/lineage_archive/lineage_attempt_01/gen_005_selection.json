{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "latent_occupancy",
    "response_change": {
      "type": "weight_exchange",
      "parent_relation": "The two activation subpopulations have a fixed mixture weight, so changing extracellular condition S_ext only shifts and broadens each branch while their relative contribution stays constant at all conditions.",
      "child_relation": "The extracellular condition S_ext also redistributes equilibrium occupancy between the primary and secondary activation subpopulations, making the effective mixture weight condition dependent and changing which branch dominates the activation curve as S_ext varies.",
      "affected_inputs": [
        "V",
        "S_ext"
      ],
      "observable_effect": "At fixed V near the crossover region between the two branch midpoints, m_inf can increase with S_ext mainly because the higher-activation branch gains occupancy, producing an S_ext-dependent shoulder or skew change that cannot be reproduced by only shifting/broadening two branches with one fixed global weight."
    },
    "diagnostic_groups": [
      {
        "name": "screen_occ",
        "expression": "S_ext/(S_half + S_ext)",
        "role": "existing extracellular occupancy scale controlling screening strength"
      },
      {
        "name": "branch_sep",
        "expression": "threshold_shift_max*(1 - subpopulation_shift_ratio)*S_ext/(S_half + S_ext)",
        "role": "condition-dependent voltage separation between primary and secondary branch half-activation shifts"
      },
      {
        "name": "cross_bias",
        "expression": "(V - V_half)*threshold_shift_max*(1 - subpopulation_shift_ratio)*S_ext/(S_half + S_ext)",
        "role": "regime where branch separation and clamp voltage jointly expose mixture redistribution"
      }
    ],
    "activation_condition": "Most visible when subpopulation_weight is in an intermediate range, subpopulation_shift_ratio differs appreciably from 1 so the two branch thresholds separate with S_ext, and V samples the midpoint/shoulder region rather than only deep plateaus where both branches are nearly 0 or 1.",
    "train_hidden_contrast": "In training, the mechanism appears as S_ext-dependent skew or shoulder changes at sampled voltages near activation onset; in holdout, the same occupancy redistribution extends to larger S_ext where branch dominance crosses over more strongly because the saturating screening occupancy continues to rise toward its asymptote.",
    "continuation_path": "Recover the parent law when extracellular redistribution of subpopulation occupancy vanishes, so the mixture weight becomes S_ext-independent and equal to the original constant subpopulation_weight.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model allows extracellular condition to alter each subpopulation's activation energetics but assumes the fraction of channels occupying those subpopulations is fixed across conditions.",
    "baseline_assumption": "Relax the assumption that subpopulation_weight is constant; instead, treat the weak heterogeneity as an equilibrium partition whose occupancy can itself depend on the same extracellular screening variable already present.",
    "scientific_mechanism": "Extracellular ions can differentially stabilize channel microenvironments or conformational subensembles, changing not only each branch's half-activation but also the equilibrium fraction of channels assigned to each quasi-equilibrium activation pathway.",
    "affected_symbols": [
      "V",
      "S_ext",
      "subpopulation_weight",
      "subpopulation_shift_ratio",
      "threshold_shift_max",
      "S_half"
    ],
    "rationale": "Parent response: with V varied and S_ext held at different fixed values, activation is always a convex combination of two sigmoids with one shared constant branch weight. Child response: with the same V and S_ext protocol, the branch weight itself changes with S_ext, so the apparent activation curve can change asymmetrically as extracellular condition rises, not just translate or broaden. A concrete contrast is obtained by comparing two S_ext levels at fixed V near the voltage where the two branch contributions are comparable: the child can show a selective increase in the contribution of one branch, creating a stronger shoulder or altered local skew, whereas the parent with a single refitted constant weight must preserve the same branch proportion at all S_ext and therefore cannot match both low-S_ext and high-S_ext shoulder prominence simultaneously. This remains a bounded monotone equilibrium activation law and is admissible as long as observations include intermediate activation fractions rather than only saturation plateaus. Limitation: if subpopulation_shift_ratio is effectively 1 or data only cover deep plateaus, the redistribution becomes weakly identifiable and the parent may suffice."
  },
