{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The parent maps ligand concentration to occupancy through a single effective dissociation scale whose crowding dependence is monotone and concentration-independent apart from the existing heterogeneity broadening variable x = heterogeneity_width*(1 + environment_modulation*crowding_level)*L/Kd_eff.",
      "child_relation": "Refine the assumption that crowding shifts only the mean affinity by allowing the crowding-induced affinity shift itself to saturate with heterogeneity amplitude, so the effective threshold movement with crowding weakens once crowding-driven disorder is already large.",
      "affected_inputs": [
        "crowding_level",
        "heterogeneity_width",
        "L"
      ],
      "observable_effect": "At fixed heterogeneity_width, the occupancy-vs-crowding curve at intermediate ligand can bend from initially steep threshold shift to a weaker incremental shift at higher crowding, while low-crowding behavior remains close to the parent."
    },
    "diagnostic_groups": [
      {
        "name": "Kd_eff_parent",
        "expression": "Kd*exp(-affinity_shift_coupling*crowding_level/(1 + heterogeneity_width*(1 + environment_modulation*crowding_level)))",
        "role": "Parent effective central dissociation scale under crowding"
      },
      {
        "name": "w_env",
        "expression": "heterogeneity_width*(1 + environment_modulation*crowding_level)",
        "role": "Crowding-modulated static heterogeneity amplitude"
      },
      {
        "name": "reduced_ligand",
        "expression": "L/(Kd*exp(-affinity_shift_coupling*crowding_level/(1 + heterogeneity_width*(1 + environment_modulation*crowding_level))))",
        "role": "Ligand level relative to the parent crowding-shifted central affinity"
      }
    ],
    "activation_condition": "Observable when crowding_level is varied over a range where w_env changes from small to order-one or larger, and ligand concentration is near the binding midpoint so threshold shifts alter theta_bound appreciably rather than being hidden in the low- or high-saturation limits.",
    "train_hidden_contrast": "In training, moderate crowding already shows broadening and threshold movement; in holdout at higher crowding or larger heterogeneity_width, the child predicts diminishing additional threshold shift rather than the parent's continued same-form shift, producing a changed occupancy-crowding curvature with one shared parameter set.",
    "continuation_path": "Recover the parent law when the new saturation control tends to zero or when heterogeneity_width*(1 + environment_modulation*crowding_level) is small so the crowding shift reduces to the current form.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the mean crowding-induced affinity shift is controlled by a fixed rational function of crowding-modulated heterogeneity width, implying one specific threshold-movement pattern across all disorder amplitudes.",
    "baseline_assumption": "Crowding changes the ensemble's central effective dissociation scale through a single unsaturating functional dependence on the same heterogeneity factor that broadens the curve.",
    "scientific_mechanism": "In disordered enzyme ensembles, additional crowding can broaden microstate populations faster than it keeps shifting the ensemble-mean affinity; once disorder is substantial, opposite microstate contributions partly cancel further mean-affinity motion, causing saturation of the threshold shift while broadening continues.",
    "affected_symbols": [
      "crowding_level",
      "heterogeneity_width",
      "environment_modulation",
      "affinity_shift_coupling",
      "L",
      "Kd"
    ],
    "rationale": "A realistic next refinement is to relax the parent's fixed-form coupling between disorder growth and mean-affinity shift, not to add a wholly new process. The parent already includes crowding-dependent broadening, skew, and mean shift, but it ties the mean shift to a single threshold law. Vary crowding_level while holding Kd, heterogeneity_width, environment_modulation, and ligand concentration fixed near half-occupancy. The parent predicts a single-form monotone threshold displacement with crowding. A child with saturation of the crowding-induced affinity shift at large disorder predicts that early crowding strongly moves the midpoint, but later crowding mainly broadens/skews the isotherm with less additional midpoint motion. This is a direct change in the scored mapping theta_bound(L,crowding_level,...) rather than only an auxiliary interpretation. The effect is scientifically admissible when disorder becomes appreciable; it is weak in the limits L much less than Kd_eff or L much greater than Kd_eff because occupancy is already near 0 or 1. Refitting existing parent parameters cannot generally mimic both the low-crowding steep shift and the high-crowding weakened incremental shift across a broad crowding range with one shared parameter set, because the parent's threshold-motion curvature is locked to its existing functional form."
  },
