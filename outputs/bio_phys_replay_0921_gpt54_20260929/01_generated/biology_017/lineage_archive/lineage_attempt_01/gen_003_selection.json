{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed consumer abundance C, feeding-derived consumer growth increases with resource abundance R as a single saturating Beddington-DeAngelis curve with one shared saturation scale, so the recruitment-vs-R curvature does not change qualitatively with recent resource history.",
      "child_relation": "Replace the assumption of instantaneous conversion of consumed resource into new consumers with a delayed maturation pipeline represented by a juvenile consumer state. Then dC_dt depends on recruitment from the juvenile pool rather than directly on current feeding, so the instantaneous adult growth response to current R becomes history-dependent and can lag behind current feeding conditions.",
      "affected_inputs": [
        "R",
        "C"
      ],
      "observable_effect": "After a resource pulse or during fast predator-prey oscillations, the parent predicts immediate adult-growth acceleration when R rises, whereas the child predicts strong current feeding with only delayed adult increase; thus two times with similar current (R,C) but different recent trajectories can show different dC_dt."
    },
    "diagnostic_groups": [
      {
        "name": "feeding_flux",
        "expression": "conversion_efficiency*encounter_rate*R*C/(1 + handling_saturation_scale*R + consumer_interference_scale*C)",
        "role": "current production of new consumer biomass/offspring from feeding"
      },
      {
        "name": "adult_loss",
        "expression": "consumer_mortality_rate*C",
        "role": "background adult consumer loss rate"
      },
      {
        "name": "per_capita_feeding",
        "expression": "conversion_efficiency*encounter_rate*R/(1 + handling_saturation_scale*R + consumer_interference_scale*C)",
        "role": "resource-dependent instantaneous recruitment pressure per consumer"
      }
    ],
    "activation_condition": "Most visible when resource abundance changes on timescales comparable to consumer maturation, such as during repeated predator-prey cycles or transient resource pulses; weak when maturation is effectively instantaneous relative to population change.",
    "train_hidden_contrast": "In training regions with moderate oscillations, the lag appears as softened and delayed adult-growth peaks relative to feeding flux; in holdout with sharper or larger-amplitude resource swings, the same maturation mechanism produces stronger phase lag and altered peak timing rather than merely a rescaled gain.",
    "continuation_path": "Recover the parent law in the fast-maturation limit where juvenile residence time tends to zero and juvenile mortality is negligible, so feeding-derived production is converted almost instantaneously into adult consumer growth.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A genuine maturation delay is not representable with only the current adult consumer and resource states, because dC_dt must depend on stored past feeding through an internal population compartment rather than a memoryless function of current R and C.",
    "gap_statement": "The model treats all feeding-derived recruitment as instantly appearing in the reproducing/mortality-bearing consumer class, omitting juvenile development time.",
    "baseline_assumption": "Individuals within each population are equivalent, so there is no stage structure and no delay between resource consumption and addition to the consumer population counted by C.",
    "scientific_mechanism": "Consumed resources first generate immature consumers that survive and mature into adults after a finite developmental period.",
    "affected_symbols": [
      "R",
      "C",
      "conversion_efficiency",
      "consumer_mortality_rate",
      "encounter_rate",
      "handling_saturation_scale",
      "consumer_interference_scale"
    ],
    "rationale": "A realistic next refinement is to relax the instantaneous-conversion assumption by introducing juvenile consumers. In the parent, holding C fixed, increasing R immediately raises dC_dt through the same saturating feeding term, so the adult response is a single-phase memoryless function of current states. In the child, current feeding still creates consumers, but they enter a juvenile compartment first; adult dC_dt is then governed by maturation inflow minus adult mortality. This changes the scored target mapping itself, not only an auxiliary trajectory, because the target is dC_dt and it no longer follows current feeding instantaneously. The contrast is observable under the actual ODE protocol from the given initial conditions once trajectories generate varying recent histories: for similar current R and C reached on the rising versus falling side of a cycle, the child can produce different dC_dt due to different juvenile backlog, while a single parent parameter set cannot because its dC_dt is uniquely determined by current R and C. The effect is scientifically admissible when developmental delay is not negligible relative to ecological turnover; if maturation is extremely fast, the refinement collapses back to the parent."
  },
