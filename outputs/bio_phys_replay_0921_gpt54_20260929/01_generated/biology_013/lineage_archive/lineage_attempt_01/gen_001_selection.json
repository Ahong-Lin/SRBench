{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With fixed transmission_rate, the target mapping is dI_dt = I*(transmission_rate*S - removal_rate), so for fixed I the dependence on S is linear with constant slope transmission_rate*I and a single threshold at S = removal_rate/transmission_rate.",
      "child_relation": "Replace the constant transmission effectiveness by a susceptibility-limited contact function so that dI_dt remains proportional to I but its dependence on S bends away from strict linearity; the marginal effect of additional susceptible fraction changes with S instead of staying constant.",
      "affected_inputs": [
        "S",
        "I",
        "transmission_rate"
      ],
      "observable_effect": "Across trajectories that visit both low-S and high-S regimes, infectious growth accelerates less-than-linearly at low susceptible availability and approaches the parent law only in the weak-saturation limit, changing early decline/growth curvature and shifting the approach to the infection peak."
    },
    "diagnostic_groups": [
      {
        "name": "force_of_infection",
        "expression": "transmission_rate*S*I",
        "role": "Parent bilinear incidence driving new infections"
      },
      {
        "name": "net_growth_margin",
        "expression": "transmission_rate*S - removal_rate",
        "role": "Parent per-infectious net growth criterion"
      },
      {
        "name": "susceptible_availability",
        "expression": "S",
        "role": "Resource level whose effect is currently assumed exactly linear"
      }
    ],
    "activation_condition": "Observable when trajectories span a nontrivial range of susceptible fraction, especially when S is not uniformly near zero and not confined to an infinitesimal neighborhood where any smooth refinement is locally linear; the contrast is strongest when depletion carries S from high to moderate/low values during the observed window.",
    "train_hidden_contrast": "In training, the mechanism appears as altered curvature of dI_dt versus S along epidemic rise and decline under the same initial-condition protocol. In holdout trajectories that deplete susceptibility further, the same saturation of transmission effectiveness produces a larger deviation from the parent's linear-in-S mapping.",
    "continuation_path": "Recover the parent law in the limit where the susceptibility-saturation correction becomes negligible over the observed S range, yielding an effectively constant transmission gain.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes each added susceptible individual contributes the same incremental transmission opportunity regardless of susceptible availability, i.e. strictly mass-action incidence with no saturation or diminishing returns in effective contact formation.",
    "baseline_assumption": "Transmission characteristics are constant through time and enter infection generation as an exactly bilinear homogeneous-mixing term transmission_rate*S*I.",
    "scientific_mechanism": "Saturating effective contact formation or partial contact limitation, where the conversion of available susceptibles into realized infectious contacts has diminishing returns as susceptible availability changes, while removal remains first-order.",
    "affected_symbols": [
      "S",
      "I",
      "transmission_rate"
    ],
    "rationale": "A realistic next refinement is to relax the exact bilinear incidence assumption rather than adding a wholly new compartment. The parent target mapping uses a single gain on S: for fixed I, increasing S changes dI_dt with constant slope. A child with susceptibility-limited transmission changes the mapping itself, not just an auxiliary trajectory, because dI_dt as a function of observed S and I is no longer linear in S. The distinguishing condition is to compare portions of observed trajectories with the same order of magnitude of I but different susceptible availability: hold removal_rate fixed and use the standard initial conditions so that S declines over time. Under the parent, one refitted transmission_rate gives the same marginal sensitivity of dI_dt to S everywhere. Under the child, that sensitivity is stronger in one S regime and weaker in another, producing different curvature and a shifted peak condition along the same observable epidemic course. This is scientifically admissible in closed-population outbreaks where contact realization or susceptible accessibility is not perfectly proportional to S. The limitation is that if observations only cover an extremely narrow S interval, the refinement may be hard to distinguish because any smooth nonlinear incidence looks approximately linear there."
  },
