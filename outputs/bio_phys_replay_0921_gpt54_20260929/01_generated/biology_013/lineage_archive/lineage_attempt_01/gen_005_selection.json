{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed S and removal terms, the transmission contribution to dI_dt is proportional to I times a burden-suppressed saturating function of S, so the net per-capita growth changes approximately linearly with I near low prevalence aside from the lagged burden effect.",
      "child_relation": "Replace the implicit first-order infectiousness assumption with a saturating contribution of infectious burden to transmission, so at fixed S and removal terms the transmission contribution grows sublinearly with I when I is not small, bending the dI_dt-versus-I relation downward even before removal dominates.",
      "affected_inputs": [
        "S",
        "I",
        "B",
        "transmission_rate"
      ],
      "observable_effect": "Across trajectories that reach moderate infectious prevalence while S is still appreciable, the rise of I slows earlier and the epidemic peak is broader/lower than the parent predicts; near very small I the child remains close to the parent."
    },
    "diagnostic_groups": [
      {
        "name": "effective_susceptible_access",
        "expression": "S/(susceptible_saturation*(1 + transmission_burden_gain*B/(removal_burden_saturation + B)) + S)",
        "role": "Current burden-suppressed access of susceptibles to realized transmission"
      },
      {
        "name": "burden_activated_removal",
        "expression": "1 + removal_burden_gain*B/(removal_burden_saturation + B)",
        "role": "Current prevalence-responsive removal multiplier"
      },
      {
        "name": "infectious_load_ratio",
        "expression": "I",
        "role": "Present infectious fraction whose transmission contribution is currently assumed exactly first-order"
      }
    ],
    "activation_condition": "Observable when I reaches a non-negligible fraction of the population while S remains above the contact-limitation scale, so repeated contacts, local overlap, or finite effective mixing make added infectious individuals less than proportionally productive; weak when I stays very small throughout.",
    "train_hidden_contrast": "In training, early-to-mid epidemic growth already shows slight downward bending of dI_dt versus I at moderate prevalence; in holdout, larger peaks extend this same mechanism into clearer sublinear transmission and stronger peak flattening without changing the sign structure.",
    "continuation_path": "Recover the parent by taking the infectious-saturation scale to infinity, which restores exactly first-order transmission in I.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes every additional infectious individual contributes proportionally to new infections at all prevalence levels, after only susceptible-side and burden-side suppression are applied.",
    "baseline_assumption": "Transmission is first-order in the infectious fraction, with no saturation or overlap on the infectious source side.",
    "scientific_mechanism": "At moderate prevalence, infectious individuals increasingly compete for the same susceptible contacts or share overlapping contact neighborhoods, so total force of infection rises sublinearly with infectious abundance even in a closed homogeneous benchmark.",
    "affected_symbols": [
      "S",
      "I",
      "B",
      "transmission_rate",
      "susceptible_saturation",
      "transmission_burden_gain",
      "removal_burden_saturation"
    ],
    "rationale": "A realistic next refinement is to relax the parent’s exact mass-action dependence on I within the transmission term, not to add a wholly new biological process. The parent already includes susceptible limitation and burden-responsive suppression, but it still uses a single-phase linear infectiousness law: holding S, B, and parameters fixed, the transmission part of dI_dt scales exactly with I. Varying prevalence over trajectories while keeping the same parameter set and the same initial-condition contract, this implies one shared local slope of transmission with respect to I near low and moderate prevalence. In the child, the slope decreases as I grows because infectious contribution saturates, creating changed curvature in the scored target mapping dI_dt(S,I,B). This contrast is scientifically admissible when prevalence becomes moderate before susceptibles are exhausted; then overlap in contacted susceptibles or finite effective mixing reduces marginal transmission per extra infectious individual. The effect is not merely in an auxiliary state because it directly changes the target equation’s dependence on observed I. Limitation: if all observed trajectories remain in the very low-I regime, the refinement is weakly identifiable and the parent is approximately recovered."
  },
