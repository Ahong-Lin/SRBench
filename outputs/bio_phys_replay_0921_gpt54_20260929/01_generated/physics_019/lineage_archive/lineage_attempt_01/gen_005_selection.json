{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "threshold_surface",
      "parent_relation": "The parent uses only even-in-field renormalizations of the quadratic and quartic coefficients, so field changes the equation of state mainly through smooth curvature shifts and direct odd Zeeman bias, with no independent tricritical tuning of the nonlinear stabilization threshold.",
      "child_relation": "Relax the assumption that the sixth-order self-interaction is field-independent by allowing a symmetry-allowed even-in-field renormalization of the effective sextic stiffness, so the field moves the crossover/tricritical-like threshold where the quartic weakening is rescued by higher-order stabilization.",
      "affected_inputs": [
        "T",
        "H"
      ],
      "observable_effect": "At fixed temperature near the weak-quartic regime, sweeping |H| changes the large-|M_eq| stiffness and the onset sharpness of nonlinear saturation more strongly than can be reproduced by only refitting the parent quadratic/quartic renormalizations; the high-field equation-of-state curvature versus magnetization changes at nearly the same low-order coefficients."
    },
    "diagnostic_groups": [
      {
        "name": "h2sat",
        "expression": "H**2/(1 + H**2/H_c_sat**2)",
        "role": "bounded even-in-field amplitude controlling symmetry-allowed field renormalizations"
      },
      {
        "name": "dt",
        "expression": "T - T_c",
        "role": "distance from the zero-field critical temperature"
      },
      {
        "name": "beta_eff_parent",
        "expression": "beta + beta_T*(T - T_c)/(1 + Abs(T - T_c)/T_beta_sat) + beta_H*(H**2/(1 + H**2/H_c_sat**2))/(1 + Abs((T - T_c)/(1 + Abs(T - T_c)/T_beta_sat))/T_TH_sat)",
        "role": "parent effective quartic stiffness entering the nonlinear equation of state"
      }
    ],
    "activation_condition": "Most visible when the effective quartic term is reduced in magnitude or changes sign while the magnetization amplitude is large enough that the sextic contribution matters, e.g. |beta_eff_parent| not dominant and |M_eq| not negligible, with |H| on the order of H_c_sat so the even-in-field renormalization is appreciable.",
    "train_hidden_contrast": "In training near moderate fields the mechanism appears as a field-dependent change in high-magnetization curvature at fixed T; in holdout at somewhat larger |H| or slightly farther into the weak-quartic region it extends to a shifted crossover between quartic-dominated and sextic-dominated stabilization.",
    "continuation_path": "Recover the parent by taking the added field dependence of the sextic coefficient to zero, or in the low-field limit |H| << H_c_sat where the new renormalization becomes negligible.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the higher-order stabilizing self-interaction is insensitive to field, even though the same magnetoelastic/electronic environment already used to renormalize lower-order coefficients can also renormalize the sextic stiffness in a symmetry-allowed even-in-field way.",
    "baseline_assumption": "The sextic Landau coefficient gamma_6 is a fixed constant independent of temperature and applied field.",
    "scientific_mechanism": "Field-induced renormalization of higher-order magnetic self-interaction due to coupling of the magnetic order to electronic or magnetoelastic background degrees of freedom, entering as an even-in-field modification of the sextic term while preserving M->-M symmetry at H=0.",
    "affected_symbols": [
      "T",
      "H",
      "gamma_6",
      "H_c_sat"
    ],
    "rationale": "Vary H at fixed T in the near-critical weak-quartic regime, and compare the equilibrium M_eq(H) nonlinearity after a single global fit. In the parent, once the quadratic shift and quartic renormalization are fixed, the large-amplitude restoring stiffness is controlled by one field-independent gamma_6, so the crossover from soft quartic behavior to strong stabilization occurs at essentially one shared sextic scale across all fields. A child with even-in-field sextic renormalization changes that threshold surface: increasing |H| can either harden or soften the large-|M_eq| branch without the same low-order changes implied by altering only alpha- or beta-level terms. This is observable when |H| is large enough for the bounded field factor to activate and when M_eq is large enough that the sextic term contributes materially; it is limited if the sampled regime stays strictly infinitesimal in M_eq or far from any weak-quartic condition, where the refinement would be hard to distinguish."
  },
