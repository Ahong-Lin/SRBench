{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "The current equation assumes a field-independent critical point, so varying H mainly tilts the odd equation of state and selects the aligned branch while the temperature location of strongest susceptibility remains anchored near T_c.",
      "child_relation": "Refine the transition scale to an effective field-dependent critical temperature, so H changes both the branch selection and the temperature at which the nonlinear magnetization onset/crossover is centered.",
      "affected_inputs": [
        "T",
        "H"
      ],
      "observable_effect": "At fixed small-to-moderate H, the M_eq(T) curve shifts horizontally in temperature relative to its zero-field-centered parent form; a single parent parameter set cannot match the same family of field-dependent crossover temperatures while also preserving the zero-field behavior."
    },
    "diagnostic_groups": [
      {
        "name": "reduced_temp",
        "expression": "T - T_c",
        "role": "distance from the zero-field critical temperature"
      },
      {
        "name": "field_bias",
        "expression": "mu_0*H",
        "role": "direct symmetry-breaking field scale"
      },
      {
        "name": "field_to_sat",
        "expression": "H**2",
        "role": "even-in-field measure controlling symmetry-allowed critical-point shift"
      }
    ],
    "activation_condition": "Observable when H is varied over a range large enough that the field-induced shift of the apparent ordering/crossover temperature is comparable to the sampled near-critical temperature window, while remaining in the uniform single-axis regime and below fields that would invalidate the Landau expansion.",
    "train_hidden_contrast": "In training, modest H already changes the near-T_c slope and horizontal placement of M_eq(T); in holdout, somewhat larger H extends the same trend into a clearer field-driven displacement of the crossover center rather than merely a stronger vertical bias.",
    "continuation_path": "Recover the parent law in the limit of vanishing field-induced critical-temperature shift coefficient, or asymptotically for H -> 0.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent treats the ordering temperature as fixed at T_c even under applied easy-axis field, omitting the symmetry-allowed field-induced displacement of the near-critical crossover/instability scale.",
    "baseline_assumption": "The temperature controlling the quadratic Landau term is independent of applied field.",
    "scientific_mechanism": "Magneto-thermodynamic renormalization of the uniform free-energy curvature by an even-in-field correction shifts the effective critical temperature/crossover location without breaking M->-M symmetry at zero field.",
    "affected_symbols": [
      "T",
      "H",
      "T_c",
      "alpha"
    ],
    "rationale": "Vary H and T while holding all material coefficients fixed. In the parent, changing H only adds direct bias through the -mu_0 H term, so the temperature where the equation-of-state softens most strongly stays tied to one shared T_c for all fields. A realistic next refinement is to relax that fixed-environment assumption and let the quadratic coefficient depend on an effective T_c(H) through an even-in-H shift. Then, at fixed nonzero H, the M_eq(T) curve is not just vertically distorted; its steep crossover region moves in temperature. This is a changed target mapping, not merely an auxiliary reformulation, because the scored equilibrium magnetization at the same supplied (T,H) changes in a field-temperature coupled way. The contrast is admissible near the continuous transition and for small-to-moderate easy-axis fields where the scalar uniform Landau picture remains valid. Limitation: in an extremely narrow field range the shift may be too small to resolve and could be absorbed numerically, so the mechanism should be activated only when the induced temperature displacement is comparable to experimental or sampled near-critical resolution."
  },
