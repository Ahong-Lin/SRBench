{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With fixed v_s, the target is a pure separable power law C_v \\propto T^3 v_s^{-3}, so at any fixed sound speed the log-log slope in temperature is exactly 3 and independent of condition.",
      "child_relation": "Relax the strictly linear acoustic-dispersion assumption so that finite-dispersion corrections modify the phonon density of states/occupation integral, producing a low-temperature Debye law at the coldest T but a systematic deviation from exact T^3 scaling as T increases within the acoustic regime.",
      "affected_inputs": [
        "T",
        "v_s"
      ],
      "observable_effect": "At fixed v_s, C_v/T^3 is constant in the parent but drifts with T in the child; equivalently the effective temperature exponent exceeds or falls below 3 away from the asymptotically low-T limit, which one shared parent parameter set cannot match across low and less-low temperatures."
    },
    "diagnostic_groups": [
      {
        "name": "reduced_heat_capacity",
        "expression": "5*C_v*hbar**3*v_s**3/(2*pi**2*k_B**4*T**3)",
        "role": "Equals 1 for the parent; temperature drift indicates departure from exact Debye T^3 scaling."
      },
      {
        "name": "log_sensitivity_vs",
        "expression": "-3",
        "role": "Parent sound-speed elasticity of the target under the ideal linear-dispersion assumption."
      }
    ],
    "activation_condition": "Temperatures remain below optical-phonon activation but are no longer asymptotically small compared with the acoustic-band cutoff, so nonlinearity of the acoustic dispersion becomes measurable while acoustic phonons still dominate.",
    "train_hidden_contrast": "Within training, mild drift of C_v/T^3 with T can appear at the upper end of the sampled low-temperature window; in holdout extended to somewhat higher but still sub-optical temperatures, the same curvature strengthens smoothly rather than introducing a new branch.",
    "continuation_path": "In the limit of asymptotically low temperature relative to the acoustic cutoff, the refined model must reduce to the parent Debye law C_v \\propto T^3/v_s^3.",
    "freedom_change": "add_input",
    "promoted_symbol": null,
    "promotion_reason": "The dispersion-curvature correction is controlled by an independent acoustic cutoff scale not determined by T and v_s alone in this benchmark; representing when the deviation from strict T^3 scaling turns on requires one additional sampled material/input quantity.",
    "gap_statement": "The parent treats the acoustic branches as perfectly linearly dispersing over all thermally occupied wavevectors, forcing an exact T^3 law throughout the sampled regime.",
    "baseline_assumption": "Only linearly dispersing acoustic branches contribute appreciably.",
    "scientific_mechanism": "Finite acoustic bandwidth / non-ideal acoustic dispersion causes the low-frequency Debye approximation to bend as thermal occupation approaches a non-negligible fraction of the acoustic cutoff.",
    "affected_symbols": [
      "T",
      "v_s"
    ],
    "rationale": "The parent response is a single-gain power law: varying T at fixed v_s always gives the same cubic slope, and varying v_s only rescales the amplitude by v_s^-3. A realistic next refinement is to relax the idealization of perfectly linear acoustic dispersion, which is scientifically natural before optical modes appear. The concrete distinguishing condition is to compare two temperature ranges at the same v_s while holding the new acoustic-cutoff-related condition fixed: deep in the low-T limit the child agrees with T^3, but at higher yet still acoustic-only temperatures the child shows curvature in C_v versus T, i.e. C_v/T^3 is no longer constant. A single refitted parent prefactor cannot reproduce both the asymptotic low-T match and the systematic drift at less-low T because its temperature exponent is locked to 3 everywhere. This changes the scored target mapping itself, not merely an auxiliary trajectory. The effect is admissible only when temperatures are high enough to sample beyond the strict long-wavelength limit but still low enough that optical-phonon and electronic contributions remain negligible."
  },
