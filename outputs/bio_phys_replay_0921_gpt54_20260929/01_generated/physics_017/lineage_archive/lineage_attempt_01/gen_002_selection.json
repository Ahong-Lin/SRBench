{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed v_s and Theta_a, C_v(T) is a single smooth Debye-like T^3 rise with one cutoff-curvature scale set only by T/Theta_a under a shared isotropic acoustic velocity.",
      "child_relation": "Replace the single isotropic acoustic velocity assumption by distinct longitudinal and transverse acoustic branch contributions, so the total heat capacity is a weighted sum of branch-specific T^3/(1+(T/Theta)^2)-type responses with different temperature bend scales and amplitudes through different sound speeds.",
      "affected_inputs": [
        "T",
        "v_s"
      ],
      "observable_effect": "When T is varied at fixed effective acoustic-speed setting, the low-temperature cubic coefficient and the onset of curvature no longer track as one locked shape; an intermediate-temperature shoulder/broader bend appears that a one-velocity parent cannot match with one shared parameter set across low and higher T."
    },
    "diagnostic_groups": [
      {
        "name": "reduced_temp",
        "expression": "T/Theta_a",
        "role": "existing acoustic-cutoff activation coordinate"
      },
      {
        "name": "debye_scale",
        "expression": "T**3/v_s**3",
        "role": "parent low-temperature acoustic scaling showing the single-velocity shortcut"
      }
    ],
    "activation_condition": "Observable when the crystal has appreciable acoustic branch anisotropy or longitudinal/transverse velocity splitting, and temperatures are low enough that acoustic phonons dominate but high enough that T/Theta_a is not asymptotically tiny, typically with T/Theta_a ~ 0.1 to 1 so branch-specific curvature can affect the summed C_v.",
    "train_hidden_contrast": "In training over low to moderate T, the child shows the same T^3 limit as T -> 0 but develops broader non-Debye bending from mixed branch velocities; in holdout at somewhat larger T/Theta_a the mismatch from the parent's single shared bend scale becomes stronger rather than disappearing.",
    "continuation_path": "Recover the parent when longitudinal and transverse sound speeds become equal, so the branch sum collapses to the single isotropic-velocity law with the same cutoff form.",
    "freedom_change": "add_input",
    "promoted_symbol": null,
    "promotion_reason": "A realistic branch-splitting refinement cannot be represented from the current inputs alone because one effective v_s does not encode independent longitudinal/transverse acoustic stiffness; one additional independently sampled acoustic-speed descriptor is needed to expose the target-mapping change.",
    "gap_statement": "The current model treats all three acoustic polarizations as sharing one isotropic sound speed, forcing one common low-temperature amplitude and one common curvature scale for the entire acoustic spectrum.",
    "baseline_assumption": "An effective isotropic sound speed represents all acoustic polarizations.",
    "scientific_mechanism": "Polarization-resolved acoustic phonons in a real crystal have distinct longitudinal and transverse sound speeds, so their thermal populations and finite-bandwidth deviations combine nontrivially in the total lattice heat capacity.",
    "affected_symbols": [
      "T",
      "v_s",
      "Theta_a"
    ],
    "rationale": "Parent response: varying T at fixed v_s gives one cubic low-T branch and one fixed crossover shape controlled only by T/Theta_a, while varying v_s simply rescales the amplitude as v_s^-3. Child response: with one additional acoustic branch-speed input, the measured C_v(T) becomes a sum of contributions with different amplitudes and different effective bend locations, changing the curvature of log C_v versus log T without violating positivity or the T->0 limit. Distinguishing condition: compare two crystals or conditions with the same fitted low-T cubic coefficient but different branch splitting; the child predicts different intermediate-T bending, whereas the parent with one shared refit of v_s and Theta_a cannot keep both the matched low-T amplitude and the broadened crossover shape. This is observable in the admissible regime where optical modes remain frozen and branch splitting is not negligible; if the crystal is nearly isotropic, the refinement weakens and the parent remains an adequate approximation."
  },
