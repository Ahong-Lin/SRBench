{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed v_s and v_l, the parent uses one shared quadratic reduced-temperature softening form for each acoustic branch, so C_v/T^3 bends smoothly with T using a single crossover shape set only by T/Theta_a and the velocity ratio.",
      "child_relation": "Replace the quadratic reduced-temperature correction by a stronger branch-resolved non-Debye curvature law tied to the same acoustic-cutoff scale, so the longitudinal and transverse contributions acquire different temperature-bending rates even when v_s and v_l are held fixed.",
      "affected_inputs": [
        "T",
        "v_s",
        "v_l",
        "Theta_a"
      ],
      "observable_effect": "When scanning T at fixed sound speeds, the child shows a different mid-low-temperature curvature of C_v/T^3 versus T, especially for anisotropic velocity ratios v_l/v_s > 1, where the longitudinal branch peels away from the transverse pair more unevenly than the parent can match with one refitted parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "x_t",
        "expression": "T/Theta_a",
        "role": "reduced temperature relative to the transverse acoustic cutoff"
      },
      {
        "name": "x_l",
        "expression": "T*v_s/(Theta_a*v_l)",
        "role": "longitudinal reduced temperature implied by the existing velocity-scaled cutoff"
      },
      {
        "name": "r_lv",
        "expression": "v_l/v_s",
        "role": "polarization anisotropy controlling separation of branch curvatures"
      }
    ],
    "activation_condition": "Visible for low-to-intermediate acoustic temperatures where T/Theta_a is not asymptotically small but still below optical activation, e.g. x_t ~ 0.2-0.8, with positive v_s and v_l and especially nontrivial anisotropy r_lv not too close to 1.",
    "train_hidden_contrast": "In training, modest T/Theta_a already reveals deviation from a single quadratic bend in C_v/T^3; in holdout at somewhat higher reduced temperature the same mechanism amplifies into stronger branch-dependent curvature without invoking new physics outside the acoustic regime.",
    "continuation_path": "In the limit where the refined branch-curvature correction coefficient tends to zero, or equivalently at T/Theta_a -> 0, the child reduces continuously to the parent Debye-like T^3 law with the parent's finite-bandwidth correction negligible.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the first finite-bandwidth departure from Debye behavior is fully captured by a simple quadratic reduced-temperature denominator for both acoustic branches, which is too restrictive once thermal occupation samples more of the branch-specific dispersion curvature.",
    "baseline_assumption": "The process of acoustic-bandwidth/dispersion correction is represented by the same lowest-order quadratic rational form for each branch after velocity rescaling.",
    "scientific_mechanism": "Higher-order nonlinearity in acoustic dispersion near the finite-bandwidth regime alters the phonon density-of-states correction beyond the leading quadratic term, producing branch-dependent curvature in the heat-capacity crossover while preserving the low-T Debye limit.",
    "affected_symbols": [
      "T",
      "v_s",
      "v_l",
      "Theta_a"
    ],
    "rationale": "Varied condition: temperature T is swept while v_s, v_l, and Theta_a are held fixed across samples. Parent response: C_v grows roughly as T^3 at very low T, then its normalized form C_v/T^3 decreases with a single simple curvature pattern determined by quadratic reduced-temperature denominators. Proposed refinement: relax that idealized quadratic crossover shape to include higher-order branch-sensitive dispersion curvature, still using only existing inputs. Observable contrast: at intermediate reduced temperature the child produces stronger or more asymmetric bending between longitudinal and transverse contributions, especially when v_l/v_s is appreciably above 1, whereas the parent with one shared parameter set cannot simultaneously fit both the early-onset and later-onset curvature across such conditions because it has only one fixed quadratic crossover form per branch. This changes the scored target mapping itself, not merely an auxiliary quantity. The effect is scientifically admissible below optical-phonon activation and disappears smoothly as T/Theta_a becomes small, where the original Debye T^3 law remains valid."
  },
