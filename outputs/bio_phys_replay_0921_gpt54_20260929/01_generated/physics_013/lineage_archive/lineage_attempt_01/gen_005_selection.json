{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The cross section uses a single Gaussian finite-size factor exp(-Q2*nuclear_charge_radius_scale**2/3), so log(dsigma_dOmega) decreases linearly with Q2 at fixed E, theta, and Z once the recoil and running-coupling pieces are factored out.",
      "child_relation": "Replace the Gaussian charge-form-factor assumption by a dipole-like elastic electric form factor, so the finite-size suppression becomes a rational function of Q2 with weaker low-Q2 slope-to-high-Q2 tail continuity and altered curvature in Q2.",
      "affected_inputs": [
        "Q2"
      ],
      "observable_effect": "At fixed E, theta, and Z, the child predicts less suppression at very low Q2 but a different intermediate-to-high-Q2 falloff shape than the parent’s straight-line semilog behavior; one shared parent radius parameter cannot match both the near-forward and larger-angle finite-size suppression simultaneously over a broad Q2 range."
    },
    "diagnostic_groups": [
      {
        "name": "half_transfer",
        "expression": "sin(theta/2)**2",
        "role": "Angular lever controlling the rise of momentum transfer away from the forward limit"
      },
      {
        "name": "size_transfer",
        "expression": "Q2*nuclear_charge_radius_scale**2",
        "role": "Dimensionless measure of when finite nuclear charge extent becomes observable"
      },
      {
        "name": "recoil_ratio",
        "expression": "Q2/(4*recoil_mass_scale**2)",
        "role": "Checks that the form-factor contrast is examined without confusing it with purely recoil-driven suppression"
      }
    ],
    "activation_condition": "Observable when Q2*nuclear_charge_radius_scale**2 is no longer much smaller than 1, while scattering remains elastic and the sampled Q2 range extends from near-pointlike to finite-size-sensitive values.",
    "train_hidden_contrast": "In training, the same mechanism already bends the finite-size dependence once size_transfer reaches order unity; in holdout at somewhat larger Q2 the difference strengthens because the Gaussian and dipole tails separate systematically.",
    "continuation_path": "Recover the parent effectively in the pointlike limit nuclear_charge_radius_scale -> 0, or across a restricted domain with Q2*nuclear_charge_radius_scale**2 << 1 where both form factors approach 1.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent treats the elastic nuclear electric form factor as purely Gaussian in Q2, which is an overly specific low-Q2 shape assumption for an extended charge distribution.",
    "baseline_assumption": "The nucleus is not just extended; its elastic charge form factor is assumed to remain Gaussian over the sampled momentum-transfer range.",
    "scientific_mechanism": "A more realistic alternative shape for the elastic charge distribution modifies how finite nuclear size suppresses scattering with momentum transfer, changing the Q2 curvature of the observable cross section without introducing new channels.",
    "affected_symbols": [
      "Q2",
      "nuclear_charge_radius_scale"
    ],
    "rationale": "The parent already includes finite-size suppression, so the next justified refinement is to relax its specific Gaussian shape rather than add a new process. Vary Q2 through changes in angle and/or beam energy while holding Z and the fitted shared parameters fixed. Then compare the finite-size factor after accounting for known Mott-like, recoil, and vacuum-polarization pieces. The parent implies a single semilog slope in Q2 from the Gaussian ansatz, whereas the child gives a different curvature profile: weaker initial suppression and a distinct tail behavior for the same characteristic size scale. This is observable when Q2*nuclear_charge_radius_scale**2 is order unity or larger but still within the elastic regime. A single refitted parent parameter can mimic one local Q2 window, but not both the low-Q2 onset and the higher-Q2 continuation across those conditions because the mismatch is in shape, not just overall scale. Limitation: if all sampled points satisfy Q2*nuclear_charge_radius_scale**2 << 1, the refinement is effectively unidentifiable and the parent is recovered."
  },
