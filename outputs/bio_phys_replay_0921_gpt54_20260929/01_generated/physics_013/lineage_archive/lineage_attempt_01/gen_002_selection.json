{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed Z and projectile charge, dsigma_dOmega scales with angle and energy only through the Mott factor times a single running-coupling denominator depending on Q2, effectively treating the target as an infinitely heavy source with no recoil-induced kinematic modification.",
      "child_relation": "Retain the electromagnetic single-exchange structure but relax the infinitely heavy stationary-target approximation so the angular and energy dependence acquires recoil kinematic distortion tied to the actual elastic momentum transfer, changing the curvature of dsigma_dOmega versus E and theta beyond the parent's separable Mott-with-running form.",
      "affected_inputs": [
        "E",
        "theta",
        "Q2"
      ],
      "observable_effect": "When theta is increased at fixed Z and moderate-to-high E, the child falls faster than the parent because finite target recoil suppresses large momentum-transfer scattering; at small theta or very heavy-target limit the two relations nearly coincide."
    },
    "diagnostic_groups": [
      {
        "name": "half_angle_sin2",
        "expression": "sin(theta/2)**2",
        "role": "Angular lever arm controlling momentum transfer and recoil visibility"
      },
      {
        "name": "mott_core",
        "expression": "cos(theta/2)**2/(E**2*sin(theta/2)**4)",
        "role": "Parent point-nucleus relativistic Coulomb-scattering kernel before additional kinematic refinement"
      },
      {
        "name": "running_den",
        "expression": "(1 - vacuum_polarization_strength*log(Q2_scale_reference/Q2))**2",
        "role": "Scale-dependent electromagnetic coupling correction already present in the parent"
      }
    ],
    "activation_condition": "Observable when the sampled kinematics reach non-negligible elastic momentum transfer, i.e. Q2 is not asymptotically small and backward or moderately large angles are included; the effect weakens in the heavy-target or small-angle limit where recoil becomes negligible.",
    "train_hidden_contrast": "Across training and holdout, compare fixed Z while varying E and theta so that one subset stays near small Q2 and another reaches substantially larger Q2. The parent with one shared parameter set preserves its original Mott-style curvature, while the recoil-refined child bends more strongly downward at the larger-transfer subset.",
    "continuation_path": "Recover the parent law in the infinite target-mass or vanishing-recoil limit, equivalently in the small-Q2/small-theta regime where recoil corrections become negligible.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current law assumes a perfectly fixed, infinitely massive nucleus, omitting finite nuclear recoil kinematics even though elastic electromagnetic scattering from a massive target generally deviates from the strict fixed-source Mott form at larger momentum transfer.",
    "baseline_assumption": "The nucleus is stationary and sufficiently massive that recoil is negligible.",
    "scientific_mechanism": "Finite target recoil in relativistic elastic electromagnetic scattering modifies the laboratory kinematics and therefore the differential cross-section shape at nonzero momentum transfer, without invoking nuclear structure or inelastic channels.",
    "affected_symbols": [
      "E",
      "theta",
      "Q2"
    ],
    "rationale": "A realistic next refinement is to relax the parent's no-recoil assumption rather than add a wholly new interaction. The parent target mapping is a fixed-environment shortcut: once Z and the running-coupling parameters are set, all E and theta dependence is forced into the same Mott angular kernel with running only through Q2. Vary E and theta while holding Z and the electromagnetic parameters fixed. In the child, finite recoil changes the kinematic suppression at larger transfer, producing a stronger downward bend with increasing theta and E than the parent can supply in the same functional family. This is a changed target mapping, not merely an auxiliary reinterpretation, because the scored dsigma_dOmega versus supplied kinematic inputs is directly altered. The effect is scientifically admissible in elastic point-nucleus scattering and remains compatible with non-negativity, charge-sign symmetry, and monotonic growth with Z. It becomes weak in the small-angle or effectively infinite-mass limit, which provides a clean continuation back to the parent. A single refit of the parent's existing constants cannot generally absorb this contrast across both low-transfer and higher-transfer conditions, because those constants only rescale the existing Mott-with-running shape and do not introduce the recoil-induced change in curvature across E and theta."
  },
