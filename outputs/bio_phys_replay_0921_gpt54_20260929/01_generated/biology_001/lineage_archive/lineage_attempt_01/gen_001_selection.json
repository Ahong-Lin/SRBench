{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With a constant viability advantage, dp_dt is a symmetric logistic-like parabola in p: selection_coefficient*p*(1-p), with a fixed peak at p=1/2 and one shared curvature shape across all observations.",
      "child_relation": "Relax the assumption of frequency-independent selection so the effective advantage depends on p itself, producing a skewed interior growth curve whose rise and decline with p are no longer constrained to the parent's symmetric single-gain form.",
      "affected_inputs": [
        "p",
        "selection_coefficient"
      ],
      "observable_effect": "Across trajectories that traverse low, intermediate, and high p, the interior maximum of dp_dt can shift away from p=1/2 and the left-versus-right side steepness can differ; a single constant-selection parent cannot match both sides with one shared parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "complement",
        "expression": "1 - p",
        "role": "Remaining frequency of the alternative allele that still limits further increase of the favored allele"
      },
      {
        "name": "logistic_kernel",
        "expression": "p*(1 - p)",
        "role": "Baseline finite-pool amplification term in the parent law"
      },
      {
        "name": "midpoint_offset",
        "expression": "p - 1/2",
        "role": "Coordinate diagnosing whether observed growth asymmetry occurs around the parent peak location"
      }
    ],
    "activation_condition": "The change is observable when allele performance is frequency dependent over a nontrivial interior range, so data sample p values on both sides of 1/2 rather than only near loss or fixation where all admissible models vanish at the boundaries.",
    "train_hidden_contrast": "In training, the mechanism can appear as mild asymmetry of dp_dt versus p over the sampled interior range; in holdout, the same frequency dependence extends that asymmetry more clearly, shifting the peak location or altering the decline near high p while preserving zero rates at p=0 and p=1.",
    "continuation_path": "Recover the parent law in the limit that the frequency-dependent correction vanishes, leaving a constant effective selection coefficient.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model omits frequency-dependent viability, treating the favored allele's advantage as constant regardless of how common it becomes.",
    "baseline_assumption": "The selective advantage is constant and frequency independent.",
    "scientific_mechanism": "Weak positive or negative frequency dependence in viability, such as crowding, social interaction, or ecological feedback that alters the favored allele's advantage as its own frequency changes.",
    "affected_symbols": [
      "p",
      "selection_coefficient"
    ],
    "rationale": "A realistic next refinement is to relax constant selection rather than add an unrelated process. The parent maps p to dp_dt through one symmetric kernel scaled by one constant gain, so varying p while holding selection_coefficient fixed always gives the same parabola with peak at p=1/2. If viability depends on allele frequency, then as p varies the effective advantage changes too, altering curvature of the scored target itself, not merely an auxiliary trajectory. The distinguishing condition is observations spanning interior frequencies below and above 1/2 at fixed experimental setting: the child can show faster-than-parent increase at low p but weaker-than-parent increase at high p, or the reverse, with the peak shifted off center. A single refitted parent parameter cannot reproduce such asymmetric shape across those conditions because it only rescales p*(1-p). This refinement remains scientifically admissible because the derivative still must vanish at p=0 and p=1, and the effect is only expected to be visible when data include enough interior range; if observations are confined very near the boundaries, the contrast may be weak."
  },
