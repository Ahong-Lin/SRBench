{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed q, dp_dt is a saturating monotone function of p with a single denominator scale 1 + q*p**2, so changing q only rescales the same basic p-response shape.",
      "child_relation": "Release the fixed rarity advantage assumption by letting the selective advantage itself weaken as the favored allele becomes common through the already present delayed feedback q, so dp_dt depends on p both through the parent saturation term and through a q-mediated reduction of effective selection.",
      "affected_inputs": [
        "p",
        "q",
        "selection_coefficient"
      ],
      "observable_effect": "Across trajectories with the same instantaneous q but different p, the favored allele can show an earlier and stronger interior flattening of dp_dt versus p than the parent allows with one shared parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "parent_kernel",
        "expression": "p*(1 - p)/(1 + q*p**2)",
        "role": "Current logistic-with-saturation shape multiplying the baseline advantage"
      },
      {
        "name": "feedback_load",
        "expression": "q*p",
        "role": "Joint indicator that the favored allele is both common and experiencing strong accumulated inhibitory feedback"
      }
    ],
    "activation_condition": "Observable when p reaches moderate to high values and q has risen above its baseline by feedback buildup, so accumulated inhibition is no longer negligible relative to the baseline advantage.",
    "train_hidden_contrast": "In training, low-to-moderate q and midrange p mainly show mild slowing; in holdout, larger feedback_load = q*p reveals stronger interior bending of dp_dt with p that extends the same mechanism rather than introducing a new regime.",
    "continuation_path": "Recover the parent law when the added feedback-induced weakening of selection is set to zero, or approximately when q*p stays small over the observed trajectory.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model treats feedback as acting only through one saturating slowdown factor in the denominator, while keeping the rarity advantage selection_coefficient itself fixed despite the same ecological or social feedback plausibly degrading realized viability advantage.",
    "baseline_assumption": "The selective advantage is constant and frequency independent.",
    "scientific_mechanism": "Accumulated crowding, niche depletion, or social antagonism associated with the favored allele can reduce its realized viability advantage itself, not just impose a separate multiplicative saturation term, producing stronger self-limitation when prevalence and delayed feedback are both high.",
    "affected_symbols": [
      "p",
      "q",
      "selection_coefficient"
    ],
    "rationale": "A realistic next refinement is to relax the parent assumption that selection_coefficient is constant. The parent target mapping from observed states to dp_dt is effectively a single-gain family: for any supplied q, selection_coefficient multiplies one fixed p-kernel, so one shared parameter set cannot create an additional q-dependent change in the curvature of dp_dt versus p beyond the existing denominator shape. Vary p along the observed trajectory while holding the supplied instantaneous q fixed and compare low versus high feedback_load regimes. In the parent, increasing q only deepens the same saturating slowdown. In the child, the same accumulated feedback also weakens realized viability advantage, so dp_dt falls more sharply at moderate-to-high p than the parent predicts, even before fixation is approached. This is scientifically admissible when the favored type's ecological or social burden grows with both prevalence and accumulated feedback. The change affects the scored target mapping directly because dp_dt as a function of the supplied states p and q changes; it is not merely a modification of q dynamics. A single parent refit cannot generally absorb this across conditions because it has only one route by which q influences dp_dt, namely the denominator saturation, whereas the child introduces an additional feedback-dependent reshaping of the p-response. Limitation: if trajectories remain confined to small p or q near baseline, the contrast will be weak and the parent may approximate it."
  },
