{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At any observed allele frequency p, the target mapping dp_dt is a single-valued saturating function of p with one fixed frequency-dependence scale, so trajectories with the same p share the same instantaneous slope regardless of elapsed evolutionary history.",
      "child_relation": "The effective frequency dependence strengthens or relaxes over time through a slowly adapting ecological or social feedback state, so dp_dt at the same p can differ between early and late phases of the trajectory because the saturation scale itself evolves.",
      "affected_inputs": [
        "p",
        "t"
      ],
      "observable_effect": "Holding the initial condition p(0)=0.5 fixed, early-time trajectories can show near-parent growth while later times at comparable interior p show stronger slowdown; equivalently, the dp_dt-versus-p curve bends over progressively rather than being fixed for the whole run."
    },
    "diagnostic_groups": [
      {
        "name": "logistic_core",
        "expression": "p*(1 - p)",
        "role": "Baseline finite-pool amplification term that sets the interior gain envelope"
      },
      {
        "name": "current_saturation_load",
        "expression": "frequency_dependence_strength*p**2",
        "role": "Parent's fixed self-limitation load that determines the static slowdown scale"
      }
    ],
    "activation_condition": "Observable when the feedback adapting the strength of frequency dependence evolves on a timescale comparable to allele-frequency change, so repeated observations over time span both an early weak-feedback phase and a later stronger-feedback phase while p remains in the interior away from 0 and 1.",
    "train_hidden_contrast": "In training, the mechanism appears as gradual departure from a single fixed dp_dt-versus-p curve; in holdout, the same history dependence extends to longer times or stronger adaptation, producing additional curvature change not reproducible by one static saturation parameter.",
    "continuation_path": "Recover the parent law when the feedback state is frozen or relaxes instantaneously to a constant value equal to the parent frequency_dependence_strength.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A fixed parameter cannot encode path-dependent changes in the saturation scale. To make dp_dt at the same observed p differ across evolutionary phases under one shared parameter set, the model needs one dynamic state representing accumulated ecological or social feedback.",
    "gap_statement": "The current model assumes that the strength of frequency-dependent slowdown is fixed throughout the trajectory, omitting delayed ecological or social feedback that is generated by allele prevalence and then feeds back onto selection.",
    "baseline_assumption": "The process already present—frequency-dependent reduction of effective advantage—acts instantaneously with a time-invariant strength parameter.",
    "scientific_mechanism": "Accumulation and relaxation of allele-associated crowding, niche depletion, or social interference causes the effective self-limitation experienced by the favored allele to depend on recent history rather than only its instantaneous frequency.",
    "affected_symbols": [
      "p",
      "frequency_dependence_strength"
    ],
    "rationale": "A realistic next refinement is to relax the parent's instantaneous-feedback assumption rather than adding a new unrelated force. The parent target mapping is single-phase: once p is known, dp_dt is fixed by one static saturating curve. Vary elapsed time along trajectories while holding the initial condition and all fixed parameters the same. Under delayed ecological feedback, two observations with similar interior p but different prior histories can have different dp_dt because inhibitory feedback has had more time to build up or decay. This changes the scored target mapping itself, not only an auxiliary trajectory, because dp_dt for p depends on evolutionary phase. The contrast is scientifically admissible when ecological or social buildup is neither negligible nor infinitely fast relative to allele-frequency change; if adaptation is extremely fast or absent, the child collapses back to the parent. A single refit of the parent parameters cannot reproduce both early weak-slowdown and later strong-slowdown regimes at the same p, because its dp_dt is a unique function of p with fixed curvature for the whole experiment."
  },
