{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed selection_coefficient and frequency_dependence_strength, dp_dt is a one-hump function of p with a single saturation scale set only by frequency_dependence_strength through selection_coefficient*p*(1 - p)/(1 + frequency_dependence_strength*p).",
      "child_relation": "Retain the same boundary zeros but replace the linear-in-p saturation of the effective advantage with a steeper self-limitation in p, so the interior rise and high-frequency decay are governed by different curvature than the parent while still depending only on p.",
      "affected_inputs": [
        "p",
        "frequency_dependence_strength"
      ],
      "observable_effect": "Across trajectories observed from the same initial condition, the favored allele can accelerate similarly at low p yet decelerate more sharply once p becomes common, shifting the location and sharpness of the interior peak in dp_dt versus p."
    },
    "diagnostic_groups": [
      {
        "name": "complement_pool",
        "expression": "1 - p",
        "role": "Remaining supply of the alternative allele that limits further increase"
      },
      {
        "name": "crowding_load",
        "expression": "frequency_dependence_strength*p",
        "role": "Parent's linear self-crowding scale in the effective advantage"
      },
      {
        "name": "interior_growth_kernel",
        "expression": "p*(1 - p)",
        "role": "Baseline logistic-shaped amplification envelope before frequency-dependent attenuation"
      }
    ],
    "activation_condition": "The contrast is visible when frequency_dependence_strength is not negligible and trajectories pass through moderate to high allele frequency, so the effective advantage is measurably reduced as p approaches the common-allele regime.",
    "train_hidden_contrast": "In training, moderate p already reveals a departure from the parent's fixed linear saturation; in holdout, later trajectory segments at higher p amplify this into a sharper slowdown that the same parent parameter set cannot match while preserving the earlier slope.",
    "continuation_path": "In the limit where the refined saturation law reduces to the parent's linear dependence on p, the current equation is recovered exactly.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the frequency-dependent reduction in selective advantage scales linearly with the favored allele's own frequency inside the saturation denominator, which may be too simple for stronger crowding or social feedback that turns on disproportionately once the allele is common.",
    "baseline_assumption": "The effective viability advantage is attenuated by a first-order, linearly increasing function of p with one fixed saturation shape.",
    "scientific_mechanism": "Nonlinear frequency dependence in viability, where self-limitation or social/ecological interference strengthens faster than linearly as the favored allele becomes common.",
    "affected_symbols": [
      "p",
      "selection_coefficient",
      "frequency_dependence_strength"
    ],
    "rationale": "A realistic next refinement is to relax the parent's linear saturation assumption rather than add a new process. The parent target mapping from p to dp_dt has one fixed attenuation shape: after multiplying by p(1-p), all frequency dependence beyond the finite complementary pool enters through a single linear crowding term frequency_dependence_strength*p in the denominator. Hold selection_coefficient fixed and compare low-to-moderate versus moderate-to-high p along the observed trajectory from the given initial condition p=0.5. Under stronger ecological or social self-limitation, the slowdown can be weak near p around 0.5 but become disproportionately stronger as p gets larger, producing changed curvature and a different peak location in dp_dt(p). A single refit of the parent parameters cannot independently preserve the earlier slope while also creating a later, sharper deceleration, because increasing frequency_dependence_strength to fit the high-p slowdown simultaneously alters the whole interior region through the same linear denominator. This refinement is scientifically admissible whenever frequency-dependent effects become appreciable only after the favored type is common; if such effects remain weak over the whole observed range, the contrast will be limited and the child will effectively collapse back toward the parent."
  },
