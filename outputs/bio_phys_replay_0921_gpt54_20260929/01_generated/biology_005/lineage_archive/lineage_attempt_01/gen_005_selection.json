{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "The adaptation current contributes instantaneously to dV_dt through a static saturating function of the instantaneous driving force V - adaptation_reversal_voltage, so for fixed V and A the outward adaptation efficacy is single-phase and memoryless.",
      "child_relation": "Adaptation efficacy is filtered by a slow permissive inactivation or availability state, so the effective A-to-dV_dt coupling depends on both present voltage and prior sustained depolarization, creating a delayed reduction of outward adaptation impact during prolonged subthreshold drive.",
      "affected_inputs": [
        "V",
        "A"
      ],
      "observable_effect": "Under the same constant applied_current and identical initial conditions, moderate sustained depolarization can show early strong adaptation-mediated slowing followed by partial recovery of dV_dt later in the trajectory as adaptation-channel availability declines; the parent only supports a single monotone settling phase once A rises."
    },
    "diagnostic_groups": [
      {
        "name": "depolarization_above_rest",
        "expression": "(V - resting_voltage + Abs(V - resting_voltage))/2",
        "role": "Subthreshold depolarizing regime that recruits slow adaptation-related gating processes"
      },
      {
        "name": "adaptation_drive_force",
        "expression": "V - adaptation_reversal_voltage",
        "role": "Instantaneous electrical driving force for the outward adaptation current"
      },
      {
        "name": "adaptation_effective_coupling",
        "expression": "A*(V - adaptation_reversal_voltage)*adaptation_conductance_saturation_scale/((V - adaptation_reversal_voltage) + adaptation_conductance_saturation_scale)",
        "role": "Parent memoryless adaptation contribution to membrane-voltage slope"
      }
    ],
    "activation_condition": "Visible when applied_current is large enough to keep V moderately above resting_voltage for times comparable to or longer than the adaptation time scale, but still below spike threshold, so slow cumulative gating changes can develop without leaving the subthreshold regime.",
    "train_hidden_contrast": "The same sustained-depolarization protocol that reveals saturating recruitment of A in training can also reveal a later weakening of adaptation efficacy during longer or slightly stronger holdout depolarizations; the mechanism extends the same subthreshold drive regime rather than requiring new interventions.",
    "continuation_path": "Recover the parent by taking the added availability process infinitely fast and fixed at full availability, or by setting its voltage dependence to zero so adaptation efficacy remains the original static function of V - adaptation_reversal_voltage.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A history-dependent loss of adaptation efficacy cannot be represented with the existing states because A currently encodes only recruited adaptation magnitude and membrane_capacitance affects charging rather than adaptation-channel availability; an additional slow state is needed to store cumulative permissive inactivation or depletion.",
    "gap_statement": "The current model assumes adaptation efficacy depends only on instantaneous driving force and adaptation magnitude, omitting slow use-dependent reduction of the outward adaptation mechanism during sustained subthreshold depolarization.",
    "baseline_assumption": "The voltage dependence of adaptation efficacy is memoryless and has no slow permissive/inactivating gate beyond A itself.",
    "scientific_mechanism": "Slow subthreshold inactivation or availability loss of adaptation-channel conductance, causing adaptation current efficacy to weaken after prolonged depolarization even while the recruited adaptation variable remains elevated.",
    "affected_symbols": [
      "V",
      "A",
      "adaptation_reversal_voltage",
      "adaptation_conductance_saturation_scale"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-phase assumption for the adaptation contribution to dV_dt. In the parent, once applied_current is fixed, the scored target mapping depends on V, A, and membrane_capacitance with adaptation efficacy determined only by the instantaneous driving force. Thus, for a given observed V and A, the parent predicts the same adaptation-induced outward slope contribution regardless of whether the cell just depolarized or has been held depolarized for a long time. A plausible child adds a slow availability state for the adaptation pathway, so prolonged depolarization can reduce effective outward current despite A remaining high. The concrete distinguishing condition is to compare two times within sustained constant-current responses while holding applied_current and all parameters fixed: an early depolarized epoch shortly after A has risen versus a later epoch after prolonged subthreshold depolarization. In the child, dV_dt at similar V and A can become less negative later because adaptation efficacy has declined; in the parent, one shared parameter set cannot produce this history-dependent phase shift because the mapping from supplied states to dV_dt is memoryless in adaptation efficacy. This effect is scientifically admissible in a subthreshold regime with moderate sustained depolarization lasting long enough for slow inactivation, and it disappears in the limit of negligible or frozen availability dynamics."
  },
