{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The environmental viability correction is a single signed saturating function of env, so at fixed parental mismatch and pre-selection heterozygosity the observed heterozygote fraction changes monotonically with one curvature regime as env varies.",
      "child_relation": "Replace the single-phase environmental response with a stress-window response in which heterozygote viability bias is weak near benign conditions and also weak again under extreme stress, peaking at intermediate |env| after mismatch modulation.",
      "affected_inputs": [
        "env",
        "p_f",
        "p_m"
      ],
      "observable_effect": "Holding p_f and p_m fixed, the child can produce a hump-shaped or shoulder-shaped dependence of observed heterozygosity on environment magnitude, whereas the parent is constrained to one monotone saturating trend."
    },
    "diagnostic_groups": [
      {
        "name": "H0",
        "expression": "p_f*(1 - p_m) + (1 - p_f)*p_m",
        "role": "pre-selection heterozygote fraction from random union"
      },
      {
        "name": "mismatch",
        "expression": "Abs(p_f - p_m)",
        "role": "parental allele-frequency divergence that modulates environmental sensitivity"
      },
      {
        "name": "env_load",
        "expression": "Abs(env)*(1 + mismatch_sens*Abs(p_f - p_m))",
        "role": "effective stress magnitude seen by the heterozygote viability pathway"
      }
    ],
    "activation_condition": "Visible when env spans near-benign through moderately stressful to strongly stressful values, with nonzero env_sel and appreciable mismatch_sens*Abs(p_f-p_m) so that the viability response can rise and then attenuate across the sampled range.",
    "train_hidden_contrast": "In training, moderate env values reveal initial rise of the viability effect; in holdout, more extreme env extends into the attenuation regime, exposing the non-monotone curvature while using the same fixed parental parameters.",
    "continuation_path": "Recover the parent by taking the added high-stress attenuation scale to infinity or zeroing its amplitude so the viability correction returns to a single tanh-like phase over the admissible env range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the environmental heterozygote viability bias is single-phase and monotone in environmental intensity, omitting plausible breakdown of heterozygote advantage or disadvantage under extreme stress after an intermediate optimum.",
    "baseline_assumption": "A bounded physiological pathway causes heterozygote viability bias to increase with effective environmental stress in only one saturating direction, with no secondary attenuation or reversal at very high stress.",
    "scientific_mechanism": "Stress-window heterosis: moderate stress can favor heterozygotes through buffering, but under extreme stress both heterozygotes and homozygotes approach uniformly low viability or heterozygote-specific costs saturate and collapse, reducing the net heterozygote bias.",
    "affected_symbols": [
      "p_f",
      "p_m",
      "env",
      "env_sel",
      "mismatch_sens",
      "crowding_curv"
    ],
    "rationale": "Parent response relationship: for fixed p_f and p_m, the target mapping is H0 plus a correction proportional to H0*(1-H0)/(1+crowding_curv*H0) times a single tanh of effective env, so the sign of the environmental effect is fixed by env_sel and its magnitude changes monotonically toward one plateau. Child change: keep the same Mendelian base and mismatch dependence, but relax the one-phase assumption so the environmental correction is strongest only over an intermediate stress window and attenuates at extreme |env|. Distinguishing condition: vary env across low, moderate, and high magnitude while holding p_f and p_m fixed at an intermediate-H0 cross with nonzero mismatch, for example any regime with 0<H0<1 and mismatch_sens*Abs(p_f-p_m) not negligible. Then the child predicts larger observed heterozygosity at intermediate stress than at both low and very high stress, whereas the parent with one shared parameter set cannot reproduce a decline after the initial rise because its env dependence is monotone apart from the fixed sign. This is a direct change in the scored target mapping, not only an auxiliary reinterpretation. The effect is scientifically admissible when stress physiology has an optimal buffering window; if sampled env never reaches the attenuation regime, the refinement may be weakly identifiable."
  },
