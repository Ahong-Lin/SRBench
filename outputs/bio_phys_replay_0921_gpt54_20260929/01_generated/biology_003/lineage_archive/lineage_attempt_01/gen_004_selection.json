{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The viability-selection correction is a logistic-like factor proportional to H0*(1-H0), where H0 = p_f*(1-p_m) + (1-p_f)*p_m, so at fixed env and mismatch the environment acts symmetrically with a single interior maximum at H0 = 0.5.",
      "child_relation": "Replace the symmetric H0*(1-H0) dependence with a genotype-composition-dependent nonlinear weighting that lets environmental selection on heterozygotes be weaker or stronger when heterozygotes are already common than when they are rare, while preserving symmetry in parental exchange and bounded output.",
      "affected_inputs": [
        "p_f",
        "p_m",
        "env",
        "env_sel",
        "mismatch_sens"
      ],
      "observable_effect": "At fixed env and fixed |p_f-p_m|, two crosses with different baseline heterozygosity but the same environmental drive no longer receive equal-magnitude viability correction around H0=0.5; the observed heterozygote fraction shows altered curvature and possible skew in its response to H0 that the parent cannot match with one shared parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "H0",
        "expression": "p_f*(1 - p_m) + (1 - p_f)*p_m",
        "role": "pre-selection Mendelian heterozygote fraction from random union"
      },
      {
        "name": "D",
        "expression": "Abs(p_f - p_m)",
        "role": "parental allele-frequency mismatch controlling stress sensitivity"
      },
      {
        "name": "E",
        "expression": "env_sel*tanh(env*(1 + mismatch_sens*Abs(p_f - p_m)))",
        "role": "effective signed environmental viability bias on heterozygotes"
      }
    ],
    "activation_condition": "Visible when env is large enough that tanh(env*(1 + mismatch_sens*|p_f-p_m|)) is appreciably away from zero and when crosses span a range of H0 values away from the forced endpoints 0 and 1.",
    "train_hidden_contrast": "In training, the effect appears as different curvature of observed heterozygosity versus H0 across ordinary ranges of env and mismatch; in holdout, the same mechanism extends to stronger environments where the asymmetric curvature persists after environmental saturation.",
    "continuation_path": "The parent law is recovered when the added composition dependence is turned off so the viability correction reduces back to a term proportional to H0*(1-H0).",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the environment-dependent viability effect on heterozygotes is maximal at intermediate heterozygote frequency with a fixed symmetric quadratic shape, irrespective of genotype composition beyond the scalar mismatch modulation of gain.",
    "baseline_assumption": "Environmental viability selection changes observed heterozygosity only through a single symmetric crowding factor H0*(1-H0) multiplying the environmental drive.",
    "scientific_mechanism": "Frequency-dependent crowding or competitive buffering can make the marginal viability effect of being heterozygous depend non-quadratically on the pre-selection heterozygote share itself, even under the same external environment and parental mismatch.",
    "affected_symbols": [
      "p_f",
      "p_m",
      "env",
      "env_sel",
      "mismatch_sens"
    ],
    "rationale": "A realistic next refinement is to relax the fixed symmetric quadratic response of the viability term to baseline heterozygosity. The parent mapping first computes H0 from p_f and p_m, then applies an environmental correction with one fixed curvature shape H0*(1-H0); env and mismatch only rescale that shape through a single gain E. Thus, holding env and |p_f-p_m| fixed while varying p_f and p_m so that H0 changes, the parent always predicts a correction symmetric about H0=0.5 with the same peak location and relative falloff. A child model that allows composition-dependent curvature changes the scored target mapping itself, not merely an auxiliary quantity: for the same E, observed G_het can rise more sharply when heterozygotes are initially rare than it falls when they are common, or vice versa, depending on the refined frequency dependence. This is scientifically admissible when viability is influenced by genotype-composition effects such as competition, buffering, or density-dependent exposure among zygotes. The contrast is observable for nonzero environmental drive and a sampled range of H0 values; it is limited near env≈0 where both parent and child collapse toward Mendelian H0, and at constrained endpoints where biology fixes G_het at 0 or 1."
  },
