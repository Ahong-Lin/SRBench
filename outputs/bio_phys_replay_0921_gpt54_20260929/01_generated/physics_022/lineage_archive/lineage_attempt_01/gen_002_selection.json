{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target dT1_dt depends on temperature difference only through a single odd saturating factor tanh(Abs(T2-T1)/conductance_deltaT_scale)*(T2-T1), so after fixing parameters the same gap magnitude gives the same conductance regardless of the absolute temperature level.",
      "child_relation": "Refine the already-present contact-transfer law so the effective conductance depends on both the gap and the mean contact temperature, making dT1_dt a non-separable function of DeltaT=T2-T1 and the common temperature level.",
      "affected_inputs": [
        "T1",
        "T2"
      ],
      "observable_effect": "For two trajectory segments with similar |T2-T1| but different mean temperature (hot-hot versus cold-cold), the child predicts different heat-transfer rates, whereas the parent predicts the same rate up to the sign set by T2-T1."
    },
    "diagnostic_groups": [
      {
        "name": "delta_T",
        "expression": "T2 - T1",
        "role": "driving temperature difference and heat-flow direction"
      },
      {
        "name": "abs_gap_over_scale",
        "expression": "Abs(T2 - T1)/conductance_deltaT_scale",
        "role": "parent conductance activation coordinate"
      },
      {
        "name": "mean_T",
        "expression": "(T1 + T2)/2",
        "role": "absolute contact temperature level that can modify interfacial transfer efficiency"
      }
    ],
    "activation_condition": "Observable when the admissible temperature range spans appreciable variation in mean temperature while |T2-T1| visits overlapping values across that range; e.g. early hot trajectories and later cooler trajectories both pass through comparable gaps.",
    "train_hidden_contrast": "Within training, the mechanism already appears because the system cools/warms through a range of mean temperatures while the gap shrinks. In holdout, the same dependence extends to trajectories starting at different absolute levels but similar initial gaps.",
    "continuation_path": "In the limit of negligible mean-temperature dependence, or over a narrow temperature window where mean_T is effectively constant, the child reduces to the parent law.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model treats the contact conductance transition as a function only of temperature difference magnitude, omitting plausible dependence of interfacial heat transfer on the absolute temperature level of the contacting bodies.",
    "baseline_assumption": "The contact conductance is constant apart from its existing dependence on |T2-T1|; specifically, it does not vary with the mean contact temperature.",
    "scientific_mechanism": "Temperature-dependent interfacial transfer coefficient or thermal boundary conductance, which commonly changes with material properties and transport coefficients evaluated near the contact temperature.",
    "affected_symbols": [
      "T1",
      "T2",
      "contact_conductance",
      "conductance_deltaT_scale"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-gain assumption for the contact law without adding a new process. Hold heat capacities fixed and compare times or trajectory segments where the gap magnitude |T2-T1| is similar, but the mean temperature (T1+T2)/2 differs. The parent target mapping gives essentially the same conductance factor at those matched gaps because only |T2-T1| enters the nonlinearity. A child law with mean-temperature-dependent conductance changes the slope/curvature of dT1_dt versus DeltaT across absolute temperature levels: the same gap can relax faster at higher mean temperature if the interface becomes more conductive there, or slower if the opposite trend holds. This contrast is scientifically admissible in the current isolated two-body experiment because the evolving trajectory naturally samples decreasing mean temperature while still visiting a continuum of gap values. A single refit of the parent parameters cannot reproduce systematic rate differences at matched gap but different mean temperature, except approximately over a narrow temperature window where the omitted dependence is weak; that narrow-window limit is the continuation path back to the parent."
  },
