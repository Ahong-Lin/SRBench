{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target rate dT1_dt is a constant-gain linear function of the instantaneous temperature difference, dT1_dt = (contact_conductance/heat_capacity_1)*(T2 - T1).",
      "child_relation": "Retain contact-driven exchange but relax the constant-conductance assumption so the gain depends on the current temperature contrast, making dT1_dt a nonlinear odd function of (T2 - T1) whose magnitude grows faster at larger contrasts while preserving heat-flow direction.",
      "affected_inputs": [
        "T1",
        "T2",
        "contact_conductance"
      ],
      "observable_effect": "Across trajectories with the same bodies but different initial temperature separations, the larger-separation case relaxes disproportionately faster early on than predicted by any single constant conductance, while near equilibrium the response approaches the parent linear law."
    },
    "diagnostic_groups": [
      {
        "name": "delta_T",
        "expression": "T2 - T1",
        "role": "instantaneous thermodynamic driving difference for inter-body heat flow"
      },
      {
        "name": "abs_delta_T",
        "expression": "Abs(T2 - T1)",
        "role": "magnitude of the contact nonequilibrium that can modulate effective conductance"
      },
      {
        "name": "energy_weighted_mean",
        "expression": "(heat_capacity_1*T1 + heat_capacity_2*T2)/(heat_capacity_1 + heat_capacity_2)",
        "role": "conserved mean temperature for the isolated two-body system"
      }
    ],
    "activation_condition": "Observable when the admissible experiment spans small and moderate temperature differences so that |T2 - T1| is not negligible compared with the scale over which contact conductance changes, while both bodies remain well mixed and the contact remains passive.",
    "train_hidden_contrast": "In training, varying the initial temperature gap already changes the early-time slope of T1 beyond simple proportional scaling; in holdout with even larger but still physically admissible gaps, the same contrast extends as stronger initial relaxation curvature toward the same conserved mean.",
    "continuation_path": "Recover the parent law in the limit of temperature-independent conductance, equivalently when the conductance-modulation scale is very large relative to |T2 - T1| over all observed trajectories.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model treats thermal contact conductance as constant even when the temperature drop across the interface changes substantially, omitting a common source of nonlinear heat-transfer strength.",
    "baseline_assumption": "The contact conductance is constant.",
    "scientific_mechanism": "Temperature-difference-dependent effective thermal contact conductance at the interface, arising from realistic contact physics or transfer coefficients that vary with contact temperature conditions.",
    "affected_symbols": [
      "T1",
      "T2",
      "contact_conductance"
    ],
    "rationale": "A natural next refinement is to relax the idealization of constant contact conductance rather than add a new process. The parent target mapping uses a single fixed gain from temperature difference to dT1_dt, so every trajectory differs only by the current value of T2 - T1. Holding heat capacities fixed and preserving isolation, if one compares admissible runs with different initial temperature separations, the parent predicts the same normalized slope dT1_dt/(T2 - T1) at all times. In contrast, with temperature-dependent conductance, that normalized slope changes with |T2 - T1|: large separations produce stronger initial heat exchange and faster early curvature of T1(t), while small separations revert toward the parent linear behavior. This changes the scored target mapping directly because dT1_dt at a given observed (T1,T2) depends nonlinearly on the separation, not merely through auxiliary hidden dynamics. The effect is scientifically admissible whenever the interface transfer coefficient varies appreciably across the temperature-drop range sampled; if the sampled range is too narrow, the refinement may be hard to distinguish and the parent becomes an adequate approximation."
  },
