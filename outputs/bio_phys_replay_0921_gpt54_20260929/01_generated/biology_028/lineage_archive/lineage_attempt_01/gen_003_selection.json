{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed H, dT_c_dt depends linearly on 1-H, and H relaxes toward a single smooth exponential equilibrium of T_c-thermal_set_point, so recovery remains effectively one-phase with a single delayed effector pathway across mild perturbations.",
      "child_relation": "Retain aggregate heat-loss control but allow thermoeffector recruitment speed itself to depend on thermal displacement, so H approaches its equilibrium faster for larger positive T_c-thermal_set_point and more slowly near baseline, changing the T_c trajectory from a single-phase relaxation to amplitude-dependent early steepening followed by slower late approach.",
      "affected_inputs": [
        "T_c",
        "H",
        "thermoeffector_adjustment_time"
      ],
      "observable_effect": "Across trajectories starting modestly versus more strongly above the set point, the larger displacement shows disproportionately faster initial cooling and earlier H rise, while near-baseline recovery remains slower; one shared parent time constant cannot match both early and late portions simultaneously."
    },
    "diagnostic_groups": [
      {
        "name": "temp_error",
        "expression": "T_c - thermal_set_point",
        "role": "signed thermal displacement driving effector recruitment"
      },
      {
        "name": "heat_loss_gap",
        "expression": "exp((heat_loss_sensitivity + heat_loss_curvature*(T_c - thermal_set_point)**2)*(T_c - thermal_set_point)) - H",
        "role": "distance of current heat-loss factor from its instantaneous equilibrium"
      },
      {
        "name": "target_cooling_drive",
        "expression": "metabolic_heat_production*(1 - H)/effective_heat_capacity",
        "role": "instantaneous core-temperature tendency under current recruited heat loss"
      }
    ],
    "activation_condition": "Observable when initial T_c is above thermal_set_point by enough that thermoeffector recruitment is appreciably engaged yet still within mild recovery, so positive temp_error spans small-to-moderate values over the sampled trajectory; the contrast is weak if trajectories remain extremely close to equilibrium throughout.",
    "train_hidden_contrast": "In training, differing portions of the same mild-recovery trajectories already contain larger versus smaller temp_error. In holdout, the same mechanism extends to somewhat larger initial displacements, revealing stronger acceleration of early H recruitment and more pronounced non-single-exponential cooling.",
    "continuation_path": "Recover the parent by making recruitment speed independent of temperature, i.e. reducing the temperature dependence of the adjustment-time law to a constant thermoeffector_adjustment_time.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent assumes a fixed thermoeffector adjustment time across all thermal displacements, although aggregate vasomotor and sudomotor recruitment commonly accelerates when core temperature is further above the set point.",
    "baseline_assumption": "The delayed aggregate heat-loss response has one constant first-order time scale, independent of the magnitude and sign of core-temperature deviation.",
    "scientific_mechanism": "Temperature-dependent effector recruitment kinetics: stronger thermal error drives faster approach of aggregate heat loss toward its temperature-dependent equilibrium, while near-equilibrium recruitment remains slower.",
    "affected_symbols": [
      "T_c",
      "H",
      "thermoeffector_adjustment_time",
      "thermal_set_point"
    ],
    "rationale": "A realistic next refinement is to relax the constant-kinetics assumption already built into H dynamics, rather than add a new process. The parent target mapping from observed states to dT_c_dt is constrained by a single delayed phase: H always approaches its equilibrium with the same characteristic time, so after refitting one shared parameter set it cannot produce both relatively slow near-baseline adaptation and disproportionately rapid early cooling when T_c starts further above thermal_set_point. Here the varied condition is the magnitude of T_c-thermal_set_point along or across mild recovery trajectories; ambient conditions, clothing, activity, metabolic_heat_production, and effective_heat_capacity remain fixed. The child changes the response relationship by making the effective slope/curvature of the T_c-to-H pathway state dependent: larger positive thermal displacement speeds H recruitment, which in turn steepens the early dT_c_dt response before relaxing toward the same stable equilibrium. This is scientifically admissible under mild heat recovery, where heat loss remains positive and aggregate thermoeffector activation is stronger when warmer. The observable contrast is in the scored target because dT_c_dt changes through altered H values over time, not merely in an unscored auxiliary state shape. The limitation is that if observations stay extremely close to equilibrium, the added kinetic nonlinearity may be hard to distinguish from the parent."
  },
