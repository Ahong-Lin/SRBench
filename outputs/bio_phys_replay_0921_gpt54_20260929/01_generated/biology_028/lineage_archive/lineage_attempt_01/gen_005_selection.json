{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "The target mapping dT_c_dt(T_c,H,H_slow) uses a fixed metabolic_heat_production, so all temperature recovery is governed only by heat-loss recruitment and the net cooling drive at a given thermal state is independent of recovery phase.",
      "child_relation": "Allow metabolic heat production to undergo slow first-order suppression after mild heat elevation, so dT_c_dt at the same T_c, H, and H_slow can differ between early and late recovery because internal heat generation is lower later in the trajectory.",
      "affected_inputs": [
        "T_c",
        "H",
        "H_slow",
        "metabolic_heat_production"
      ],
      "observable_effect": "For mild above-set-point recoveries under fixed environment, late recovery can cool faster than the parent predicts even after heat-loss factors have begun relaxing, because transient metabolic suppression reduces inward heat flux."
    },
    "diagnostic_groups": [
      {
        "name": "thermal_error",
        "expression": "T_c - thermal_set_point",
        "role": "Signed core-temperature displacement driving thermoregulatory activation"
      },
      {
        "name": "effective_heat_loss_factor",
        "expression": "(1 - slow_effector_weight)*H + slow_effector_weight*H_slow",
        "role": "Current combined thermoeffector heat-loss multiplier"
      },
      {
        "name": "above_setpoint_gate",
        "expression": "Piecewise((0, T_c - thermal_set_point <= 0), ((T_c - thermal_set_point)/(slow_recruitment_threshold + (T_c - thermal_set_point)), True))",
        "role": "Existing mild-heat activation regime where a slow metabolic adjustment would be physiologically observable"
      }
    ],
    "activation_condition": "Observable for mild but sustained above-set-point excursions where T_c - thermal_set_point is positive for long enough that a slower autonomic suppression of metabolic heat production can develop; weak or negligible for near-baseline trajectories and very short perturbations.",
    "train_hidden_contrast": "In training, the mechanism appears as modest extra late-phase cooling during recoveries with longer residence above the set point; in holdout, the same effect extends to trajectories with similar amplitudes but different durations, producing duration-dependent phase separation at matched T_c.",
    "continuation_path": "Recover the parent by taking the metabolic-suppression amplitude to zero or its adjustment time to zero/infinity such that metabolic_heat_production remains effectively constant.",
    "freedom_change": "parameter_to_state",
    "promoted_symbol": "metabolic_heat_production",
    "promotion_reason": "A fixed parameter cannot encode trajectory-history-dependent internal heat generation. To create an observable phase-dependent change in dT_c_dt under the same environmental conditions, metabolic_heat_production must be allowed to evolve as a state.",
    "gap_statement": "The model assumes constant metabolic heat production during recovery, omitting the plausible slow reduction in endogenous heat production that accompanies passive recovery from mild heat load.",
    "baseline_assumption": "metabolic_heat_production is constant across the entire trajectory and does not adapt to sustained elevation of core temperature.",
    "scientific_mechanism": "Slow heat-induced suppression of thermogenic/metabolic heat production during recovery, operating in parallel with delayed heat-loss recruitment under otherwise fixed ambient conditions.",
    "affected_symbols": [
      "T_c",
      "H",
      "H_slow",
      "metabolic_heat_production",
      "thermal_set_point",
      "slow_recruitment_threshold"
    ],
    "rationale": "The parent already includes fast and slow heat-loss effectors, so its scored target mapping is effectively single-phase: once T_c, H, and H_slow are specified, dT_c_dt is fully determined by a constant inward metabolic term minus heat loss. A realistic next refinement is to relax the constant-metabolism assumption, not to add another decorative heat-loss branch. Under fixed humidity, clothing, activity, and ambient temperature, mild heat exposure can still transiently suppress internal heat generation during recovery. This changes the target mapping itself, not only an auxiliary trajectory, because dT_c_dt directly depends on metabolic_heat_production. The concrete distinguishing condition is to compare recoveries that reach similar T_c and similar effective heat-loss factor but differ in how long they have remained above the set point. The parent with one shared parameter set predicts the same dT_c_dt at matched T_c, H, and H_slow regardless of phase; the child predicts more negative dT_c_dt later in a prolonged recovery due to reduced metabolic input. This is admissible for mild positive thermal_error on the scale already activating H_slow, and it remains limited: if excursions are too small or brief, the added process may be practically unobservable."
  },
