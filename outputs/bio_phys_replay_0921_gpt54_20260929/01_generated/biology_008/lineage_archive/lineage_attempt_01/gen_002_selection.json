{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "For fixed receptor abundance, activity is a scaled hyperbola in ligand concentration with one effective dissociation scale K_d*(1 + alpha_R*R_tot), so R_tot only shifts ligand sensitivity through a single linear threshold factor.",
      "child_relation": "Allow receptor abundance to also change the steepness of the apparent binding/activation curve, so the ligand-response at different R_tot is no longer reducible to a single shifted hyperbola and shows receptor-dependent curvature while remaining monotone.",
      "affected_inputs": [
        "L",
        "R_tot"
      ],
      "observable_effect": "Across conditions with different R_tot but fixed downstream kinetics, the rise of A with L can be broader at low receptor abundance and sharper at high receptor abundance even after matching low-dose sensitivity, which the parent cannot reproduce with one shared parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "ligand_to_apparent_Kd",
        "expression": "L/(K_d*(1 + alpha_R*R_tot))",
        "role": "dimensionless ligand level relative to the receptor-density-shifted affinity scale"
      },
      {
        "name": "receptor_density_shift",
        "expression": "alpha_R*R_tot",
        "role": "strength of receptor-abundance modulation already present in the parent"
      },
      {
        "name": "activation_partition",
        "expression": "k_activation/(k_activation + k_deactivation)",
        "role": "maximal active fraction among ligand-bound receptors"
      }
    ],
    "activation_condition": "Observable when ligand is scanned across values around and above the apparent binding scale K_d*(1 + alpha_R*R_tot) and receptor abundance varies enough that density-dependent effects are not negligible but remain within the monotone regime; e.g. alpha_R*R_tot is order 0.1 to 1 rather than asymptotically small.",
    "train_hidden_contrast": "In training, modest R_tot variation can reveal that equal fold-changes in L do not collapse onto one shared hyperbola after rescaling by the parent threshold; in holdout, extending to somewhat higher R_tot amplifies the receptor-dependent steepening while preserving monotone saturation.",
    "continuation_path": "Recover the parent law when the receptor-dependent steepness parameter tends to zero, giving the original single-threshold hyperbolic dependence on L.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes receptor abundance only changes the apparent dissociation scale linearly, but not the shape of the ligand-response curve.",
    "baseline_assumption": "The parent treats receptor-density effects as a pure shift in K_d, implying one shared hyperbolic ligand-response shape across all receptor abundances.",
    "scientific_mechanism": "Receptor clustering or local multivalent avidity at higher surface abundance can make activation effectively more cooperative with respect to ligand occupancy, changing response curvature without introducing dynamics.",
    "affected_symbols": [
      "L",
      "R_tot",
      "K_d",
      "alpha_R"
    ],
    "rationale": "Varied conditions: extracellular ligand concentration L is scanned and receptor abundance R_tot differs between experiments; held fixed are k_activation, k_deactivation, and the no-adaptation static measurement setting. Parent mapping: A versus L is always a scaled Michaelis-like curve whose only R_tot effect is the single threshold K_d*(1 + alpha_R*R_tot). Proposed refinement: relax that idealization so receptor abundance also changes curve steepness, producing a genuine L-by-R_tot interaction in the scored mapping itself, not merely an auxiliary quantity. Concrete contrast: two receptor-abundance conditions can be arranged to have similar low-L slope after refitting a shared threshold-like scale, yet differ in mid-range curvature and approach to saturation; the parent with one parameter set cannot change curvature independently of threshold because every condition remains the same hyperbola after rescaling. This is scientifically admissible when receptor-density-dependent clustering is present but not so strong as to violate monotone saturation or push A outside [0,1]. Limitation: if the studied R_tot range is very narrow or alpha_R*R_tot is negligible everywhere, the effect may be hard to distinguish and the parent may remain adequate."
  },
