{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "The current target mapping uses transmission_rate*S*I/(1 + saturation_strength*I), so prevalence-dependent transmission saturation depends only on total infectious prevalence I and not on how much of that prevalence has progressed into the later infectious subphase.",
      "child_relation": "Refine the transmission saturation assumption so the effective infection term depends on both I and I_phase, allowing the same total I to generate different dI_dt when the infectious pool is compositionally shifted toward later-stage cases that more strongly suppress effective contact or transmission.",
      "affected_inputs": [
        "S",
        "I",
        "I_phase",
        "saturation_strength"
      ],
      "observable_effect": "At matched S and total I, outbreaks observed on the downslope or near the peak with larger I_phase would show weaker infection growth than early-rise outbreaks with smaller I_phase; the parent cannot express this composition-dependent split because its infection term is fixed by I alone."
    },
    "diagnostic_groups": [
      {
        "name": "force_of_infection_parent",
        "expression": "transmission_rate*S*I/(1 + saturation_strength*I)",
        "role": "Current incidence contribution to the target"
      },
      {
        "name": "phase_fraction",
        "expression": "I_phase/(I + 1.0e-12)",
        "role": "Composition of current infectious prevalence in the later recoverable subphase"
      },
      {
        "name": "removal_load",
        "expression": "recovery_rate*I_phase/(1 + phase_saturation*I_phase)",
        "role": "Current removal pressure already present in the target"
      }
    ],
    "activation_condition": "Observable when I is appreciable and I_phase varies within its admissible range 0 <= I_phase <= I during the sampled rise, peak, and decline; especially near and after the peak when phase progression has created substantial late-stage occupancy.",
    "train_hidden_contrast": "Within the same outbreak trajectory, early times and later times can share similar I but differ in I_phase; training already contains this phase-composition variation, and holdout extends it to stronger late-stage occupancy near the decline.",
    "continuation_path": "Recover the parent law in the limit where transmission saturation depends only on total I and is insensitive to infectious-stage composition.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes that prevalence-dependent transmission suppression is controlled only by total infectious prevalence, ignoring that later-stage infectious occupancy may alter behavior, contact ability, or effective infectiousness differently from earlier-stage cases even at the same I.",
    "baseline_assumption": "The transmission saturation denominator is a function of I alone and is independent of infectious-stage composition.",
    "scientific_mechanism": "Stage-composition-dependent effective transmission, where accumulation in the later infectious subphase modifies the saturation of transmission beyond what is explained by total prevalence alone.",
    "affected_symbols": [
      "S",
      "I",
      "I_phase",
      "saturation_strength",
      "phase_progression_rate"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-phase transmission assumption, not to add a wholly new process. The parent already includes stage structure in recovery through I_phase but keeps transmission saturation tied only to aggregate I. In an acute outbreak, individuals in later infectious stages may be more symptomatic, less mobile, more likely to self-isolate, or otherwise less effective at sustaining transmission-generating contact. Holding transmission_rate, recovery_rate, and the closed-population setting fixed, vary the within-outbreak condition represented by I_phase at matched S and I. The parent predicts the same incidence contribution whenever S and I match, because I_phase affects dI_dt only through the recovery term. The child would instead produce lower infection influx when I_phase is larger, changing the target mapping itself rather than only auxiliary trajectories. This contrast is admissible under the current observation protocol because I_phase is an observed state supplied to the solver and naturally increases after the early growth phase through progression. A single refitted parent parameter set cannot reproduce a systematic split in the infection term at matched S and I across low-versus-high I_phase conditions, because its transmission contribution has no I_phase dependence at all. The limitation is that this effect is weak when I is very small or when I_phase remains near zero, so it is mainly visible around intermediate-to-high prevalence and later outbreak stages."
  },
