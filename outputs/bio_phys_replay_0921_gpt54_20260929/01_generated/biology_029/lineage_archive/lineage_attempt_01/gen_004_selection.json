{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The infection gain term decreases hyperbolically with total effective infectious burden through transmission_rate*S*I/(1 + saturation_strength*(I + I_phase)), so increasing I_phase only weakens transmission with a fixed linear weighting inside one shared denominator.",
      "child_relation": "Retain the same states but relax the assumption that later-phase occupancy suppresses transmission with the same linear weighting at all occupancies; instead, let the transmission reduction bend nonlinearly with I_phase so the dI_dt response to changing stage composition has occupancy-dependent curvature.",
      "affected_inputs": [
        "S",
        "I",
        "I_phase",
        "saturation_strength"
      ],
      "observable_effect": "At fixed S and I, early increases in I_phase can have little additional effect on dI_dt but larger reductions once I_phase becomes appreciable, or vice versa depending on the refined saturation shape; this changes how fast epidemic growth flattens near the peak as stage composition shifts."
    },
    "diagnostic_groups": [
      {
        "name": "force_of_infection_load",
        "expression": "S*I",
        "role": "baseline mass-action exposure available for transmission"
      },
      {
        "name": "stage_composition",
        "expression": "I_phase/(I + I_phase + 1.0e-12)",
        "role": "fraction of infectious burden occupying the later subphase"
      },
      {
        "name": "effective_burden",
        "expression": "I + I_phase",
        "role": "current prevalence scale where transmission saturation activates"
      }
    ],
    "activation_condition": "Observable when infectious prevalence is no longer infinitesimal and I_phase becomes a non-negligible share of the infectious burden, so stage composition changes during the rise-to-peak transition while transmission saturation is active.",
    "train_hidden_contrast": "Within the sampled single-outbreak trajectory, the mechanism appears as changing curvature of dI_dt versus stage composition at similar S*I levels; in holdout regions later in the outbreak, the same nonlinear stage-composition effect becomes stronger as I_phase accumulates further.",
    "continuation_path": "The child should reduce to the parent when the refined I_phase dependence is taken to its linear-limit form over the observed occupancy range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes a single linear contribution of I_phase inside the transmission-saturation denominator, forcing one fixed shape for how later-stage occupancy modifies infection pressure.",
    "baseline_assumption": "Later infectious subphase occupancy affects transmission reduction through the same first-order weighting at all occupancies.",
    "scientific_mechanism": "Behavioral withdrawal, symptom-linked contact loss, or repeated-contact crowding may intensify nonlinearly as the later infectious subphase accumulates, making transmission suppression depend on stage composition with curved rather than purely linear sensitivity.",
    "affected_symbols": [
      "S",
      "I",
      "I_phase",
      "saturation_strength"
    ],
    "rationale": "A realistic next refinement is to change the mathematical form of stage-composition-dependent transmission saturation, not to add a new process. The parent target mapping from observed states to dI_dt is a single-threshold form: for fixed S and I, increasing I_phase only enters through one shared linear denominator term and therefore imposes one fixed concavity in the transmission contribution. Under the outbreak protocol, S declines and I_phase lags behind I, so there are intervals near the approach to peak where S*I is still substantial but stage composition differs. In those admissible conditions, a child with nonlinear dependence on I_phase in the transmission saturation can predict a different flattening pattern of dI_dt as I_phase rises. The contrast is a changed target mapping, not merely altered auxiliary trajectories, because dI_dt directly uses I_phase and its response to I_phase at fixed S and I is reshaped. A single refit of the parent parameters can move the overall saturation scale, but cannot reproduce two distinct local sensitivities of dI_dt to I_phase across low- and moderate-I_phase regimes if the true relationship bends away from the parent's linear weighting. This remains scientifically bounded because the mechanism only activates once prevalence and later-stage occupancy are appreciable; near outbreak start, the child should effectively collapse back toward the parent behavior."
  },
