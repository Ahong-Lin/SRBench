{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "For fixed s and c, new_infection_rate increases with exposure q*i as a one-parameter Michaelis-Menten saturating curve with a single shared half-saturation scale exposure_half_saturation independent of susceptible availability.",
      "child_relation": "Keep the same bounded contact-limited acquisition mechanism but relax the assumption that the half-saturation scale is fixed: make effective saturation depend on susceptible fraction so that crowding of susceptible encounters changes the curvature of the exposure-response while preserving vanishing at i=0 and s=0 and a finite high-exposure ceiling.",
      "affected_inputs": [
        "s",
        "i",
        "q",
        "exposure_half_saturation"
      ],
      "observable_effect": "When q*i is varied at fixed c, the rise toward saturation is steeper or more delayed depending on s; thus two strata with different s show different exposure-response curvature that cannot be matched by one parent half-saturation value."
    },
    "diagnostic_groups": [
      {
        "name": "exposure",
        "expression": "q*i",
        "role": "effective infectious exposure driving acquisition opportunities"
      },
      {
        "name": "susceptible_weighted_exposure",
        "expression": "q*i/s",
        "role": "exposure per available susceptible, highlighting regimes where susceptible availability alters apparent saturation"
      },
      {
        "name": "normalized_response",
        "expression": "(q*i)/(exposure_half_saturation + q*i)",
        "role": "parent bounded acquisition fraction used as the baseline comparison"
      }
    ],
    "activation_condition": "Observable when susceptible fraction varies meaningfully away from a narrow constant band while q*i spans values below and above exposure_half_saturation; especially informative for intermediate exposure where curvature is identifiable and 0 < s <= 1.",
    "train_hidden_contrast": "In training, modest variation in s already reveals that the exposure-response bends differently at the same q*i; in holdout, broader s variation extends this same curvature difference rather than introducing a new mechanism.",
    "continuation_path": "Recover the parent law in the limit where susceptible dependence of the effective half-saturation vanishes, so the saturation scale becomes the constant exposure_half_saturation for all s.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes a single susceptibility-independent exposure half-saturation, so all susceptible strata share the same normalized exposure-response shape after multiplication by s.",
    "baseline_assumption": "The effective-exposure level at which acquisition reaches half of its contact-limited maximum is fixed and does not vary with the susceptible fraction.",
    "scientific_mechanism": "Encounter competition and repeated contact among the shrinking susceptible pool can change how quickly additional infectious exposure converts into new acquisitions, making the apparent saturation scale depend on susceptible availability.",
    "affected_symbols": [
      "s",
      "i",
      "q",
      "exposure_half_saturation"
    ],
    "rationale": "A realistic next refinement is to relax the fixed-threshold assumption already present in the saturating acquisition term, not to add a wholly separate process. The parent mapping is s*c times a saturating function of q*i with one shared half-saturation parameter, so changing s only rescales the curve vertically. Scientifically, if the susceptible pool is sparse or dense, the same infectious exposure can be distributed differently across susceptible encounter opportunities, altering how quickly the acquisition response approaches its contact-limited ceiling. Vary q*i while holding c fixed and compare two admissible susceptible fractions s1 and s2 within 0<s<=1. In the parent, the ratio new_infection_rate/(s*c) as a function of q*i is identical for both strata, because curvature is controlled only by exposure_half_saturation. In the child, that normalized curve changes with s, giving an observable curvature contrast at intermediate exposures. This is a true target-mapping change, not merely an auxiliary reinterpretation, because the predicted instantaneous rate for the same supplied inputs changes. A single refit of the parent parameters cannot reproduce different normalized q*i-response shapes across varying s; it can only choose one common threshold and one common curvature family. The refinement remains scientifically admissible because the rate stays nonnegative, vanishes when s=0 or i=0, and can be constructed to retain a finite high-exposure bound."
  },
