{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed s, the acquisition probability per susceptible is a single Hill-type saturating function of aggregate exposure q*i, with one shared effective threshold and one shared curvature value determined only by linear modulation in s and i.",
      "child_relation": "At fixed s, the exposure-acquisition relation transitions from near-linear response at low infectious prevalence to stronger saturation at higher infectious prevalence because infectious prevalence not only shifts threshold/curvature but also changes how close contact opportunities are to independent across susceptibles, producing a prevalence-dependent saturation shape that cannot be represented by one single-phase Hill form over all i.",
      "affected_inputs": [
        "i",
        "s",
        "q"
      ],
      "observable_effect": "When q and s are held fixed and i is varied from low to moderate values, the child can show a delayed onset of strong saturation at low i but a sharper approach to the contact ceiling at higher i; the parent can only bend this tradeoff through one Hill family and cannot match both low-i near-proportional growth and high-i compressed approach-to-ceiling with one shared parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "effective_exposure",
        "expression": "q*i",
        "role": "aggregate infectious opportunity presented to susceptibles"
      },
      {
        "name": "shape_index",
        "expression": "1 + susceptible_curvature_modulation*s + infectious_curvature_modulation*i",
        "role": "current parent cooperativity index governing exposure-response curvature"
      },
      {
        "name": "effective_half_sat",
        "expression": "exposure_half_saturation/((1 + susceptible_saturation_modulation*s)*(1 + infectious_threshold_modulation*i))",
        "role": "current parent half-saturation scale after susceptible and infectious modulation"
      }
    ],
    "activation_condition": "Observable for 0<s<=1 with q*i spanning below and above the effective half-saturation scale, especially when i varies over a moderate range where repeated or redundant infectious contacts begin to matter but s is not near zero; negligible at very small q*i or i≈0.",
    "train_hidden_contrast": "In training, variation in i at fixed s and q can reveal mild deviation from a single Hill phase; in holdout, the same mechanism becomes clearer when q*i extends further into the saturating regime, exposing different low-i versus high-i approach shapes to the same contact ceiling.",
    "continuation_path": "Recover the parent when the added prevalence-dependent shape refinement is set to zero so the exposure-response remains a single Hill-type saturating function with the existing threshold and curvature modulation.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current law assumes one single-phase Hill-type acquisition response to aggregate exposure, so infectious prevalence can only alter threshold and exponent smoothly within that same family.",
    "baseline_assumption": "All infectious-contact opportunities are effectively summarized by one homogeneous saturating exposure-response phase, with no additional prevalence-dependent transition between near-independent and redundant contact opportunity sampling.",
    "scientific_mechanism": "As infectious prevalence rises, contacts experienced by susceptibles can shift from approximately independent rare opportunities to more redundant repeated opportunities from overlapping infectious sources, changing the shape of saturation itself rather than only the threshold or Hill exponent.",
    "affected_symbols": [
      "i",
      "s",
      "q",
      "exposure_half_saturation",
      "infectious_curvature_modulation",
      "infectious_threshold_modulation"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-phase exposure-response assumption. The parent already lets s and i modulate the threshold and curvature, but it still forces all observations onto one Hill-type saturating family. Vary i while holding s and q fixed, over admissible 0<=i<=1 with q*i crossing the effective half-saturation region. Under the child mechanism, low i corresponds to more nearly independent infectious opportunities and therefore a more gradual early rise, whereas higher i creates more redundant overlap and a more compressed final approach to the same finite contact-limited ceiling. This is a changed target mapping, not merely an auxiliary reinterpretation, because the instantaneous new_infection_rate versus supplied inputs changes directly. A single refit of the parent parameters may mimic part of this behavior locally, but cannot generally match both the low-i and higher-i shape regimes simultaneously when both are present in the sampled domain. The effect is scientifically limited if data stay entirely in the unsaturated low-exposure regime or if i remains extremely small, where both parent and child collapse toward approximately linear dependence on q*i."
  },
