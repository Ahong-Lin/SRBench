{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "The parent uses one susceptible-modulated half-saturation scale, so at fixed s the dependence of new_infection_rate on exposure q*i is a standard single Michaelis-type rise with a fixed shape, and changing s mainly rescales the overall prefactor and shifts that one threshold.",
      "child_relation": "Refine the acquisition response so that susceptible availability also changes the curvature of the exposure-response, not only its half-saturation location, making the q*i to new_infection_rate mapping steeper at low exposure and more abruptly saturating when s is high.",
      "affected_inputs": [
        "s",
        "q",
        "i"
      ],
      "observable_effect": "Across low versus high susceptible fraction, with c fixed and exposure q*i swept through the half-saturation regime, the child shows different normalized response shapes after matching low-exposure slope or half-saturation, whereas the parent can only shift one common saturating curve."
    },
    "diagnostic_groups": [
      {
        "name": "effective_exposure",
        "expression": "q*i",
        "role": "Instantaneous infectious exposure intensity entering the acquisition response"
      },
      {
        "name": "susceptible_modified_scale",
        "expression": "exposure_half_saturation/(1 + susceptible_saturation_modulation*s)",
        "role": "Parent effective half-saturation scale set by susceptible availability"
      },
      {
        "name": "normalized_exposure_parent",
        "expression": "q*i*(1 + susceptible_saturation_modulation*s)/exposure_half_saturation",
        "role": "Parent dimensionless exposure coordinate controlling where saturation begins"
      }
    ],
    "activation_condition": "Observable when q*i spans from well below to around or above exposure_half_saturation/(1 + susceptible_saturation_modulation*s), and s varies appreciably within [0,1]; the contrast is strongest away from the trivial limits s=0 or i=0.",
    "train_hidden_contrast": "In training, variation of q*i at moderate s reveals departure from a single shared Michaelis shape; in holdout, larger s extends the same mechanism by making the exposure-response more switch-like than any one-threshold parent fit can reproduce across all s values simultaneously.",
    "continuation_path": "Recover the parent law in the limit that the added susceptible dependence of response shape vanishes, leaving only the original susceptible effect on the half-saturation scale.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes susceptible fraction alters only the effective half-saturation scale of exposure, while the saturation shape itself is fixed across crowding and mixing conditions.",
    "baseline_assumption": "Acquisition follows a single-shape contact-limited saturation in q*i, with susceptible dependence entering only through a shared threshold parameter.",
    "scientific_mechanism": "Heterogeneity in who remains susceptible can make incremental exposure more cooperative or more concentrated as s changes, altering the curvature of the exposure-to-acquisition response even without adding new state dynamics.",
    "affected_symbols": [
      "s",
      "q",
      "i",
      "exposure_half_saturation",
      "susceptible_saturation_modulation"
    ],
    "rationale": "A realistic next refinement is to relax the fixed-shape saturation assumption rather than add a separate omitted process. The parent already contains exposure limitation and susceptible modulation, but it compresses all susceptible effects into one threshold-like scale. Vary q*i while holding c fixed and compare two admissible susceptible fractions, for example low-to-moderate versus high s. The parent predicts that, after accounting for the multiplicative s factor and the shifted half-saturation exposure_half_saturation/(1 + susceptible_saturation_modulation*s), both conditions share the same normalized concave response shape. A child in which s also changes curvature produces a distinct target mapping: at high s the rate can rise more sharply near onset and saturate more abruptly, or conversely more gradually, than at low s. This is a direct change in the scored mapping from supplied inputs s, q, and i, not merely an auxiliary reinterpretation. The effect is scientifically admissible when exposure traverses the saturating regime; if q*i stays asymptotically small everywhere, the difference collapses to near-linear behavior and may be hard to identify. A single refit of the parent parameters cannot generally absorb an s-dependent shape change across multiple s conditions because it has only one shared Hill/Michaelis shape with one susceptible-controlled scale, not separate curvature control."
  },
