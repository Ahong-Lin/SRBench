{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed N, the target depends on latent crowding through a single saturating factor competition_strength*C/(1 + crowding_saturation_scale*C), so realized suppression rises approximately linearly for small C and then approaches a fixed-gain asymptote, with the same crowding sensitivity shape regardless of accumulated crowding history beyond the current C value.",
      "child_relation": "Release the assumption that crowding damage saturates hyperbolically with one fixed curvature by allowing stronger high-C compression of additional crowding damage, so at fixed N the mapping from C to dN_dt bends downward more sharply after moderate crowding while matching the parent at low C.",
      "affected_inputs": [
        "N",
        "C",
        "crowding_saturation_scale"
      ],
      "observable_effect": "Across trajectories that reach similar N but different latent crowding levels C, the child predicts weaker incremental decreases in dN_dt once C is already large than the parent's single hyperbolic saturation allows, while remaining nearly unchanged when C is small."
    },
    "diagnostic_groups": [
      {
        "name": "net_low_density_rate",
        "expression": "per_capita_birth_rate - background_mortality_rate",
        "role": "baseline per-capita growth margin before crowding suppression"
      },
      {
        "name": "crowding_load",
        "expression": "C",
        "role": "latent accumulated crowding pressure governing delayed suppression"
      },
      {
        "name": "realized_competition_prefactor",
        "expression": "competition_strength*N*(1 + abundance_crowding_curvature*N)",
        "role": "abundance-scaled multiplier converting latent crowding pressure into instantaneous loss"
      },
      {
        "name": "saturation_argument",
        "expression": "crowding_saturation_scale*C",
        "role": "dimensionless regime marker for whether crowding saturation is weak or strong"
      }
    ],
    "activation_condition": "Observable when trajectories enter moderate-to-high latent crowding, i.e. crowding_saturation_scale*C is order one or larger, while N remains positive so the competition term materially contributes; at low C the child should reduce closely to the parent.",
    "train_hidden_contrast": "In training, small and moderate crowding episodes mainly identify the shared low-C slope; in holdout, longer overshoot or sustained high-density transients create larger C where the child's stronger high-C curvature changes dN_dt at similar N, revealing the refinement.",
    "continuation_path": "Recover the parent law in the limit where the added curvature control of the saturation function vanishes, restoring the original 1/(1 + crowding_saturation_scale*C) form.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes a single hyperbolic saturation shape for how latent crowding pressure translates into per-capita competitive loss, which can be too rigid when severe crowding causes additional pressure to have progressively less marginal effect than that one-shape law permits.",
    "baseline_assumption": "Crowding-mediated damage saturates with one fixed Michaelis-like denominator 1 + crowding_saturation_scale*C.",
    "scientific_mechanism": "Under very strong crowding, most individuals may already be fully exposed to interference or local depletion, so further increases in latent crowding pressure produce extra suppression with diminishing marginal impact stronger than simple hyperbolic saturation.",
    "affected_symbols": [
      "N",
      "C",
      "crowding_saturation_scale",
      "competition_strength",
      "abundance_crowding_curvature"
    ],
    "rationale": "A realistic next refinement is to relax the parent's fixed-shape saturation assumption rather than add a new process. The parent target mapping from observed states to dN_dt uses C through one shared hyperbolic gain, so once N is fixed the only way crowding changes the target is a single saturating curve in C. Varying condition: compare times or trajectories with similar N but different latent crowding pressure C generated by the existing delayed state dynamics; hold fixed the demographic parameters and abundance-dependent prefactor. Parent response: incremental suppression with increasing C always follows the same hyperbolic bending. Child response: suppression still increases monotonically with C and never improves growth, but the slope with respect to C falls off faster at high C, changing the curvature of the scored mapping itself, not merely the auxiliary C trajectory. This is scientifically admissible during overshoot or prolonged high-density episodes where C accumulates enough that crowding_saturation_scale*C is not small. Limitation: if all observed data remain in the low-C regime, the refinement will be weakly identifiable and effectively collapse to the parent."
  },
