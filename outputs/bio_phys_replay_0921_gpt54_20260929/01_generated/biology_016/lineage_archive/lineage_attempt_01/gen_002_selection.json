{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The crowding loss is an instantaneous saturating function of current abundance alone, so for any observed N the target dN_dt is fixed by a single-phase density-response curve.",
      "child_relation": "Crowding damage is mediated by a dynamically accumulating crowding/condition state, so the same observed N can map to different dN_dt depending on recent trajectory through that latent state.",
      "affected_inputs": [
        "N"
      ],
      "observable_effect": "During transient growth toward carrying levels, net growth is initially less suppressed than the parent predicts at a given N, but after sustained high abundance it becomes more suppressed at similar N because the accumulated crowding state lags behind abundance changes."
    },
    "diagnostic_groups": [
      {
        "name": "net_low_density_rate",
        "expression": "per_capita_birth_rate - background_mortality_rate",
        "role": "Intrinsic low-density per-capita growth baseline"
      },
      {
        "name": "crowding_load_parent",
        "expression": "competition_strength*N/(1 + crowding_saturation_scale*N)",
        "role": "Parent instantaneous per-capita crowding burden as a function of abundance"
      },
      {
        "name": "abundance_scale",
        "expression": "crowding_saturation_scale*N",
        "role": "Dimensionless regime indicator for onset of saturating crowding effects"
      }
    ],
    "activation_condition": "Observable when the trajectory passes from low abundance into moderate/high abundance so that crowding_saturation_scale*N is order 1 or larger and there is enough elapsed time for a slowly relaxing crowding condition to depart from its initial level; weak if all observations stay near equilibrium or only in the near-zero-density regime.",
    "train_hidden_contrast": "In training, transient approach to high density can already show delayed suppression relative to the parent's single-phase curve; in holdout with longer observation windows or stronger excursions into crowding, the same delay yields larger hysteretic curvature in dN_dt versus N.",
    "continuation_path": "Recover the parent law in the fast-relaxation limit where the added crowding-condition state instantaneously tracks abundance, or when its coupling to N is taken to the algebraic form used by the parent.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A delayed density-dependence mechanism cannot be represented with N alone because the scored target would remain a single-valued function of current abundance; one additional state is needed to encode recent crowding history and alter the N to dN_dt mapping.",
    "gap_statement": "The model assumes density dependence acts without delay, but many populations experience crowding damage through slowly accumulating resource depletion, waste buildup, or stress that persists after abundance changes.",
    "baseline_assumption": "Density dependence acts without delay",
    "scientific_mechanism": "A latent crowding-pressure state accumulates under high abundance and relaxes over time, causing delayed suppression of net growth.",
    "affected_symbols": [
      "N",
      "competition_strength",
      "crowding_saturation_scale"
    ],
    "rationale": "Vary time along the single observed trajectory while holding the shared parameter set fixed. In the parent, dN_dt is determined solely by current N, so two times with similar N must have essentially the same net growth. A realistic refinement is delayed crowding: as N rises, the effective crowding pressure builds more slowly than abundance, and after prolonged high density it remains elevated even if N later changes modestly. Then the child permits different dN_dt values at similar N during early versus later phases of the same trajectory. This is a genuine target-mapping change, not merely an auxiliary-state change, because the solver is scored on dN_dt conditional on supplied observations and N alone no longer determines it. The contrast is scientifically admissible when abundance traverses regimes from crowding_saturation_scale*N much less than 1 into order-1 or larger values over observation times comparable to the crowding-state relaxation time. If the entire trajectory stays near low density or the latent process relaxes effectively instantaneously, the refinement collapses back toward the parent and may not be distinguishable."
  },
