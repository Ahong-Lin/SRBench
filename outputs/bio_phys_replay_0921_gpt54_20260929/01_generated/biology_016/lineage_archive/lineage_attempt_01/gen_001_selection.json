{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The parent gives a linear decline of per-capita net growth with abundance: (dN_dt/N) = per_capita_birth_rate - background_mortality_rate - competition_strength*N, so crowding reduces growth with one fixed slope and one fixed carrying-capacity scale.",
      "child_relation": "Replace the linear crowding assumption with saturating crowding damage so the per-capita net growth still decreases monotonically with N but bends from an approximately linear decline at low-to-moderate abundance toward a weaker additional suppression at high abundance.",
      "affected_inputs": [
        "N",
        "competition_strength"
      ],
      "observable_effect": "Across trajectories that pass from low into high abundance, the child predicts less negative curvature in dN_dt versus N at large N than the parent's exact parabola, while preserving near-exponential increase at low N."
    },
    "diagnostic_groups": [
      {
        "name": "per_capita_net_growth",
        "expression": "(per_capita_birth_rate - background_mortality_rate) - competition_strength*N",
        "role": "Parent linear crowding-induced decline in per-capita growth"
      },
      {
        "name": "crowding_load",
        "expression": "competition_strength*N",
        "role": "Dimensionless-or-scaled abundance load controlling departure from the low-density regime"
      },
      {
        "name": "absolute_growth_parent",
        "expression": "N*((per_capita_birth_rate - background_mortality_rate) - competition_strength*N)",
        "role": "Parent target mapping used as the baseline shape to be refined"
      }
    ],
    "activation_condition": "Observable when trajectories include both low-density and crowding-dominated segments, specifically when competition_strength*N is small at early times but reaches order 1 over the sampled trajectory so curvature of the crowding effect can be seen.",
    "train_hidden_contrast": "In training, the mechanism appears as near-parent behavior at low N and mild deviation as N approaches the equilibrium scale; in holdout, the same monotone saturating crowding law produces a clearer high-density flattening of dN_dt(N) that a single quadratic parent law cannot match with one shared parameter set.",
    "continuation_path": "Recover the parent in the weak-saturation limit where the refined crowding function is approximated by its first-order Taylor expansion in N, yielding an effectively linear per-capita crowding term.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent assumes each additional individual increases competitive suppression by the same amount at all densities, forcing one fixed linear crowding slope in per-capita net growth.",
    "baseline_assumption": "Density dependence acts as a strictly linear function of abundance in the per-capita growth rate.",
    "scientific_mechanism": "Interference or space limitation can make added crowding effects saturate per capita once most individuals already experience strong local competition, so further abundance increases still reduce net growth but with diminishing incremental effect.",
    "affected_symbols": [
      "N",
      "competition_strength",
      "per_capita_birth_rate",
      "background_mortality_rate"
    ],
    "rationale": "A realistic next refinement is to relax the parent's linear crowding assumption without adding new ecological compartments. The parent response relationship is a single-threshold logistic form: dN_dt is exactly quadratic in N, and per-capita net growth declines with one constant slope as N increases. Varying N along the observed continuous trajectory while holding per_capita_birth_rate, background_mortality_rate, and competition_strength fixed, the child would instead produce a monotone but curved decline in per-capita net growth. The observable contrast is that low-density behavior remains approximately proportional to N, but at high abundance the target mapping dN_dt(N) no longer follows a single parabola; crowding suppression bends toward saturation. This is scientifically admissible in closed populations with constant environment when competition reflects finite contact or occupancy effects rather than unlimited pairwise penalty growth. This changes the scored target mapping directly, not merely an auxiliary trajectory. A single refitted parent parameter set cannot reproduce both the near-linear low-density onset and the weaker-than-quadratic high-density suppression over the same trajectory because the parent fixes the second-order form once its low-density slope and equilibrium scale are chosen. The limitation is that if all observations stay in the small-competition_strength*N regime, the refinement will be practically indistinguishable from the parent."
  },
