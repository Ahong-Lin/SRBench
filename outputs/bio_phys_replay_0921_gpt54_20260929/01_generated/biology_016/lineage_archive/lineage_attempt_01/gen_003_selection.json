{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed crowding pressure C, the crowding loss in dN_dt is proportional to N with coefficient competition_strength*C/(1 + crowding_saturation_scale*C), so the per-capita suppression increases linearly with N only through multiplication by abundance.",
      "child_relation": "Replace the linear abundance dependence of realized crowding loss with a stronger high-density dependence, so that at fixed latent crowding pressure C the suppression term bends downward more sharply as N rises; equivalently, the per-capita net growth declines with N in a convex way rather than by a single shared gain.",
      "affected_inputs": [
        "N",
        "C"
      ],
      "observable_effect": "Across trajectories that reach similar C but different N, the child predicts disproportionately stronger negative dN_dt at larger N, producing earlier peak abundance and sharper deceleration after overshoot than the parent."
    },
    "diagnostic_groups": [
      {
        "name": "crowding_load",
        "expression": "C",
        "role": "Latent delayed density-pressure level"
      },
      {
        "name": "realized_crowding_exposure",
        "expression": "N*C",
        "role": "Current abundance exposed to latent crowding pressure"
      },
      {
        "name": "per_capita_net_growth_parent",
        "expression": "per_capita_birth_rate - background_mortality_rate - competition_strength*C/(1 + crowding_saturation_scale*C)",
        "role": "Parent per-capita net growth implied by current state"
      }
    ],
    "activation_condition": "Observable when abundance spans a moderate-to-high range before settling, so that N varies appreciably while C is nonzero and not fully saturating; especially during delayed-crowding transients after initial growth.",
    "train_hidden_contrast": "In training, moderate overshoot episodes already show some mismatch if deceleration steepens with abundance; in holdout, larger excursions in N at similar C amplify this curvature difference and separate the child from any parent with one shared competition gain.",
    "continuation_path": "Recover the parent law in the limit where the added nonlinear abundance effect tends to the linear form, i.e. the extra density-curvature parameter goes to zero or its scaling makes realized suppression effectively proportional to N over the observed range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes that once latent crowding pressure C is specified, realized competitive suppression scales linearly with abundance N, ignoring intensified local encounters or patch depletion at high abundance under the same delayed crowding background.",
    "baseline_assumption": "For fixed C, each added individual contributes the same incremental realized competition loss to total population change.",
    "scientific_mechanism": "High abundance can amplify encounter-based interference or local resource overlap on top of delayed crowding pressure, making realized competitive loss increase more than linearly with N even when C is held fixed.",
    "affected_symbols": [
      "N",
      "C",
      "competition_strength",
      "crowding_saturation_scale"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-gain assumption for abundance in the competition term without adding a new state. The parent target mapping from observed states to dN_dt is linear in N at fixed C, so one shared parameter set enforces the same marginal slope of crowding loss with respect to abundance across low and high population levels. Vary N along trajectories while holding the same governing parameters and considering times with comparable nonzero C. Under the parent, the ratio of crowding loss to N depends only on C. In the child, that ratio would also become more adverse at higher N, changing the curvature of dN_dt versus N. This is scientifically admissible when populations transiently reach moderate or high abundance before crowding relaxation catches up; delayed density dependence then creates windows where similar C can coincide with different N values. The effect is a changed target mapping, not merely altered auxiliary dynamics, because dN_dt as a function of supplied states (N,C) is directly modified. A single refit of existing parent parameters cannot reproduce stronger suppression at high N while keeping weaker suppression at low N for the same C, since the parent only rescales one linear N factor and cannot introduce this state-dependent curvature."
  },
