{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The depletion term in dx_dt scales linearly with the available resource x through presynaptic_rate*(1 - release_site_occupancy)*u*x, so at fixed u and release_site_occupancy the dependence of resource loss on x has constant slope.",
      "child_relation": "Relax the linear-release assumption so depletion depends nonlinearly on x, reflecting reduced release probability when only a small fraction of vesicles remain docked/primed and stronger-than-linear depletion only when the pool is well stocked.",
      "affected_inputs": [
        "x",
        "u",
        "release_site_occupancy",
        "presynaptic_rate"
      ],
      "observable_effect": "At matched intermediate x the successor can show weaker depletion near low x but similar or stronger depletion near high x, producing a bent x-to-dx_dt relation that the parent's single linear x gain cannot match across depletion levels."
    },
    "diagnostic_groups": [
      {
        "name": "effective_event_drive",
        "expression": "presynaptic_rate*u*(1 - release_site_occupancy)",
        "role": "effective rate of release-triggering presynaptic drive after facilitation and site refractoriness"
      },
      {
        "name": "recovery_flux",
        "expression": "(1 - x)/(recovery_time_constant*(1 + replenishment_fatigue))",
        "role": "instantaneous replenishment tendency toward refilling"
      },
      {
        "name": "depletion_flux_parent",
        "expression": "presynaptic_rate*u*x*(1 - release_site_occupancy)",
        "role": "parent linear resource-consumption law used as the baseline contrast coordinate"
      }
    ],
    "activation_condition": "Observable when x traverses a broad depleted-to-replete range during sustained trains, especially moderate to high effective_event_drive where depletion is appreciable but x remains within 0 to 1 and recovery still contributes.",
    "train_hidden_contrast": "Within training, early versus later portions of sustained stimulation already sample high-x and lower-x regimes; in holdout, changing presynaptic_rate extends the same contrast by shifting how quickly trajectories move through those x regimes.",
    "continuation_path": "In the limit that the nonlinear release dependence reduces to proportionality in x, the parent depletion law is recovered exactly.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes every increment of available vesicle resource contributes equally to immediate release, i.e. depletion is exactly proportional to x over the full admissible range.",
    "baseline_assumption": "Release-dependent depletion of the available vesicle pool is linear in the available-resource fraction x.",
    "scientific_mechanism": "State-dependent release competence within the readily releasable pool: when the pool is nearly depleted, the remaining vesicles are less effectively release-ready on average, so effective depletion grows sublinearly with x rather than strictly linearly.",
    "affected_symbols": [
      "x",
      "u",
      "release_site_occupancy",
      "presynaptic_rate"
    ],
    "rationale": "A realistic next refinement is to relax the linear x dependence of the depletion term rather than adding another latent process. In the parent, holding presynaptic_rate fixed and comparing times or conditions with similar u and release_site_occupancy, dx_dt changes with x through a straight-line depletion contribution. That creates a single-gain shortcut: one shared slope in x must fit both well-stocked and nearly depleted regimes. A child with nonlinear release competence changes the target mapping itself, not only auxiliary trajectories, because dx_dt as a function of observed x bends. The concrete contrast is obtained during maintained stimulation from the stated initial condition x=0.8 as x declines: at low x the child predicts less additional depletion than the parent's linear law, while near high x it can remain close to the parent. A single refit of existing parent parameters cannot reproduce this changed curvature across both regimes, because those parameters only rescale recovery and the overall linear depletion prefactor, not the shape of depletion versus x. This is scientifically admissible under sustained trains that actually drive x away from 1; if depletion is always tiny and x stays near 1, the difference becomes weak and should be acknowledged as limited."
  },
