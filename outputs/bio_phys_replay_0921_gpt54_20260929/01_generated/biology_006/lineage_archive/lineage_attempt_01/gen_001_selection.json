{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "dx_dt depends on x and u through a linear recovery term with one fixed recovery_time_constant, so for fixed x and u the recovery contribution has a single slope in depletion depth (1-x).",
      "child_relation": "Make recovery slow down when facilitation-driven use is sustained, so the recovery contribution becomes state dependent and bends with ongoing u/rate load rather than remaining a single linear-in-(1-x) term.",
      "affected_inputs": [
        "x",
        "u",
        "presynaptic_rate",
        "recovery_time_constant"
      ],
      "observable_effect": "At matched depletion x, higher sustained facilitation/activity produces a more negative dx_dt than the parent predicts because replenishment is transiently depressed; this creates extra curvature in dx_dt versus x across low- and high-rate conditions."
    },
    "diagnostic_groups": [
      {
        "name": "depletion_depth",
        "expression": "1 - x",
        "role": "distance from the fully replenished vesicle pool"
      },
      {
        "name": "use_load",
        "expression": "presynaptic_rate*u",
        "role": "instantaneous activity-dependent release demand placed on the pool"
      },
      {
        "name": "depletion_flux",
        "expression": "presynaptic_rate*u*x",
        "role": "current vesicle consumption flux"
      }
    ],
    "activation_condition": "Observable during maintained moderate-to-high presynaptic_rate trains where facilitation elevates u above baseline for long enough that replenishment cannot be treated as having one constant time scale; weakest near very low rate or u approximately baseline_utilization.",
    "train_hidden_contrast": "Within training, varying presynaptic_rate already changes sustained u and depletion. The same mechanism extends in holdout to stronger trains by predicting disproportionately slower refill at similar x, not just proportionally larger depletion.",
    "continuation_path": "Recover the parent law when activity-dependent modulation of replenishment vanishes, so the effective recovery time becomes the constant recovery_time_constant independent of u or presynaptic_rate.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A transient depression of replenishment is a dynamical fatigue process with memory; existing x and u do not uniquely encode how long high use has persisted, so a dedicated state is needed to distinguish equal instantaneous x,u pairs reached after short versus prolonged trains.",
    "gap_statement": "The model assumes vesicle recovery proceeds with a fixed time constant regardless of recent presynaptic use, omitting use-dependent slowing of recruitment/refilling during sustained activity.",
    "baseline_assumption": "Vesicle recovery and facilitation time scales remain constant.",
    "scientific_mechanism": "Activity-dependent fatigue of the replenishment machinery or reserve-pool mobilization, causing recovery of available vesicles to slow during prolonged high release demand and relax back afterward.",
    "affected_symbols": [
      "x",
      "u",
      "presynaptic_rate",
      "recovery_time_constant"
    ],
    "rationale": "Parent response relationship: for observed x and u, dx_dt = (1-x)/recovery_time_constant - presynaptic_rate*u*x, so the recovery part is independent of activity history and has a single linear dependence on depletion depth. Proposed refinement: let sustained release load build a replenishment-fatigue state that slows recovery, changing the scored target mapping itself because dx_dt at the same x can differ depending on recent high-rate/high-u exposure. Distinguishing condition: vary presynaptic_rate across maintained trains while holding the initial conditions and parent parameters shared. Compare times when x is similarly depleted but one condition has experienced stronger sustained facilitation/use. The child predicts more negative dx_dt in the stronger-use condition because recovery is additionally slowed; the parent with one fixed recovery_time_constant cannot reproduce that history-dependent curvature and must assign the same recovery at matched x regardless of prior load. This is scientifically admissible under moderate-to-high rates where facilitation is activated and depletion persists; under weak stimulation the added effect may be too small to separate, which is a limitation rather than hidden evidence."
  },
