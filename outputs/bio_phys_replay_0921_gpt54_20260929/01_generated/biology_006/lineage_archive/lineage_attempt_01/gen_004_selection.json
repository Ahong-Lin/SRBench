{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed presynaptic_rate, u, and release_site_occupancy, depletion in dx_dt scales as a single quadratic factor u*x**2 times the effective event rate, so the sensitivity of resource loss to facilitation is independent of replenishment state except through multiplicative scaling.",
      "child_relation": "Relax the assumption that facilitation acts with constant potency across all presynaptic resource states by making depletion sensitivity to u weaken when replenishment_fatigue is high, creating a non-separable interaction between u and replenishment_fatigue in dx_dt.",
      "affected_inputs": [
        "u",
        "replenishment_fatigue",
        "presynaptic_rate",
        "release_site_occupancy",
        "x"
      ],
      "observable_effect": "During sustained high-rate trains that build replenishment_fatigue, increasing u no longer produces proportionally equal extra depletion; early-train dx_dt becomes more facilitation-sensitive than late-train dx_dt at matched x and presynaptic_rate."
    },
    "diagnostic_groups": [
      {
        "name": "effective_trigger_rate",
        "expression": "presynaptic_rate*(1 - release_site_occupancy)",
        "role": "Rate of presynaptic events that can still effectively trigger release"
      },
      {
        "name": "depletion_drive",
        "expression": "presynaptic_rate*(1 - release_site_occupancy)*u*x**2",
        "role": "Parent instantaneous release-dependent depletion demand"
      },
      {
        "name": "fatigue_load",
        "expression": "u*replenishment_fatigue",
        "role": "Joint regime where facilitation is present but replenishment machinery is already stressed"
      }
    ],
    "activation_condition": "Observable when presynaptic_rate is high enough and sustained long enough that replenishment_fatigue reaches moderate values while u remains above baseline; weak or negligible near replenishment_fatigue≈0 or very low presynaptic_rate.",
    "train_hidden_contrast": "In training, the mechanism appears as mild late-train bending of dx_dt versus u under sustained stimulation; in holdout, the same interaction extends to stronger fatigue regimes where depletion saturates relative to the parent’s separable product form.",
    "continuation_path": "Recover the parent law in the limit that fatigue-dependent modulation of facilitation potency vanishes, equivalently when replenishment_fatigue stays near zero over the experiment.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes facilitation multiplies depletion with fixed efficacy regardless of the current fatigue state of vesicle replenishment, making depletion a separable product of facilitation and fatigue effects.",
    "baseline_assumption": "Release-dependent depletion is modulated by facilitation and replenishment fatigue through independent multiplicative factors only; fatigue slows recovery but does not reshape how facilitation translates into resource consumption.",
    "scientific_mechanism": "Under sustained use, residual-calcium-driven facilitation can become less effective at increasing actual vesicle consumption when replenishment/mobilization is fatigued, because extra release drive cannot be converted into proportionally more effective depletion once supply-side readiness is stressed.",
    "affected_symbols": [
      "u",
      "replenishment_fatigue",
      "presynaptic_rate",
      "release_site_occupancy",
      "x"
    ],
    "rationale": "A realistic next refinement is to change the assumption of separable depletion gain. In the parent, varying u at fixed presynaptic_rate, x, and release_site_occupancy changes dx_dt through a single multiplicative factor, while replenishment_fatigue only slows the recovery branch. Thus the parent predicts the same facilitation-to-depletion gain shape early and late in a train once x is matched, apart from overall recovery offset. A scientifically plausible refinement is that high replenishment_fatigue reduces how strongly facilitation can convert presynaptic activity into actual vesicle loss, because the supply side becomes the bottleneck. The observable contrast is obtained by varying time within a maintained moderate-to-high-rate train while holding presynaptic_rate fixed and comparing epochs with low versus elevated replenishment_fatigue: the child predicts diminished marginal effect of u on dx_dt in the fatigued epoch, whereas the parent with one shared parameter set preserves a fixed separable u gain in the depletion term. This is admissible because replenishment_fatigue is already a modeled state that can enter a moderate range under sustained drive. The effect is limited when trains are too weak or short to build fatigue, in which case the child should reduce toward the parent."
  },
