{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With fixed nu and S_act, log(k/nu)=S_act-DeltaF/T is linear in 1/T at fixed DeltaF, so the temperature effect is controlled by one shared Arrhenius slope set only by DeltaF.",
      "child_relation": "Replace the strictly linear temperature dependence of the activation free energy with a weak heat-capacity contribution, so log(k/nu) gains nonlinear curvature in 1/T at fixed DeltaF while remaining monotone over the admissible regime.",
      "affected_inputs": [
        "T",
        "DeltaF"
      ],
      "observable_effect": "Across preparations that vary T at fixed DeltaF and nu, the parent predicts straight-line Arrhenius plots, whereas the child predicts systematic bending with temperature that cannot be matched by one shared refitted S_act and DeltaF over the full range."
    },
    "diagnostic_groups": [
      {
        "name": "invT",
        "expression": "1/T",
        "role": "Arrhenius coordinate for testing linear versus curved temperature response"
      },
      {
        "name": "barrier_ratio",
        "expression": "DeltaF/T",
        "role": "dimensionless activation scale controlling rarity"
      },
      {
        "name": "entropic_fraction",
        "expression": "S_act*T/DeltaF",
        "role": "size of the current entropic correction relative to the reference barrier when DeltaF>0"
      }
    ],
    "activation_condition": "Observable when the sampled temperature range is broad enough that activation free-energy curvature with T is resolvable, yet the effective barrier remains positive and events remain rare; practically when the additional thermal correction is a non-negligible fraction of DeltaF across the upper part of the T range.",
    "train_hidden_contrast": "In training, moderate T variation already reveals slight deviation from a straight Arrhenius line; in holdout with a wider or shifted T range, the same mechanism amplifies into clearer curvature rather than a mere parameter rescaling.",
    "continuation_path": "The parent law is recovered in the zero heat-capacity-difference limit, where the activation free energy becomes affine in T again.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the activation entropy contribution is temperature independent, making the activation free energy exactly linear in T and the Arrhenius plot exactly linear in 1/T.",
    "baseline_assumption": "Relax the assumption that transition-state and basin thermodynamic differences are exhausted by a constant activation entropy; allow their heat-capacity difference to modify the barrier with temperature.",
    "scientific_mechanism": "Temperature-dependent activation free energy from a heat-capacity difference between the transition state and the initial metastable basin, causing non-Arrhenius curvature even in an equilibrated bath.",
    "affected_symbols": [
      "T",
      "DeltaF",
      "S_act",
      "nu"
    ],
    "rationale": "Parent response: for fixed DeltaF and nu, varying T changes k through log(k/nu)=S_act-DeltaF/T, a straight line in 1/T with one shared slope and intercept. Proposed child: keep the same rare-event transition picture but replace the constant-entropy approximation by a thermodynamically more realistic temperature-dependent activation free energy, which changes the slope with T and introduces curvature. Distinguishing condition: vary T over an admissible range while holding DeltaF and nu fixed across repeated equilibrium preparations; then compare the shape of log(k/nu) versus 1/T. The child shows systematic curvature, while the parent with any single refitted parameter set can only produce a straight line, so it cannot reproduce both low-T and high-T behavior simultaneously. This is a true change in the scored target mapping, not merely an auxiliary reinterpretation. The effect is scientifically admissible when thermal softening beyond the linear entropy term is measurable but not so strong that the effective barrier becomes negative or the dilute-event assumption fails. Limitation: if the sampled T window is very narrow, the curvature may be practically indistinguishable from a refit of DeltaF and S_act, so the refinement is only consequential over a sufficiently broad temperature span."
  },
