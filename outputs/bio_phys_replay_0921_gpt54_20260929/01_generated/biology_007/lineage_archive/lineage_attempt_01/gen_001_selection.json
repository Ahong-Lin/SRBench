{
  "plan": {
    "operation": "add_term",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "The excitatory derivative depends instantaneously on the current inhibitory activity I, so for fixed E the inhibitory suppression of dE_dt has no additional lag structure beyond tau_I.",
      "child_relation": "Excitatory dynamics are additionally suppressed by a delayed inhibitory influence carried by a synaptic gating state, so for fixed E and similar instantaneous I, dE_dt depends on both present inhibition and its recent history.",
      "affected_inputs": [
        "E",
        "I",
        "tau_I"
      ],
      "observable_effect": "After a fixed perturbation that elevates E and recruits I, the child can show delayed deeper suppression and lagged rebound of dE_dt relative to I, whereas the parent ties suppression too directly to instantaneous I."
    },
    "diagnostic_groups": [
      {
        "name": "net_drive_E",
        "expression": "w_EE*E - w_EI*I + external_drive_E - threshold_E",
        "role": "Instantaneous excitatory net drive in the parent recruitment map"
      },
      {
        "name": "inh_to_exc_ratio",
        "expression": "w_EI*I/(w_EE*E + external_drive_E + 1.0e-12)",
        "role": "Relative strength of inhibitory feedback compared with excitatory drive"
      },
      {
        "name": "inh_recruitment_drive",
        "expression": "w_IE*E + external_drive_I - threshold_I",
        "role": "Drive recruiting inhibitory activity and therefore setting up delayed feedback regimes"
      }
    ],
    "activation_condition": "Observable when perturbation-driven E is high enough to recruit I appreciably and inhibitory feedback is neither negligible nor immediately saturating, so recent inhibitory history matters over times comparable to or somewhat longer than tau_I.",
    "train_hidden_contrast": "In training, the same post-perturbation trajectories already contain transient rises in I after E activation; the delayed-feedback mechanism would alter the timing and depth of excitatory suppression within those trajectories, and in holdout this extends to stronger or longer transients where lagged inhibitory aftereffects become more pronounced.",
    "continuation_path": "Recover the parent law when the added inhibitory synaptic-memory effect is taken to zero strength or vanishingly fast so that delayed inhibition collapses to no extra contribution beyond the instantaneous I term.",
    "freedom_change": "add_state",
    "promoted_symbol": null,
    "promotion_reason": "A delayed inhibitory aftereffect depends on recent inhibitory history, which cannot be represented by the current Markovian target mapping from only E and I without an additional state carrying synaptic gating or inhibitory trace memory.",
    "gap_statement": "The model omits explicit delayed inhibitory synaptic action on the excitatory population, treating inhibition as if its full effect is instantaneous once I is known.",
    "baseline_assumption": "Synaptic transmission delays are absorbed into effective population time scales.",
    "scientific_mechanism": "Finite-time inhibitory synaptic gating or inhibitory trace accumulation that continues to suppress excitatory recruitment after inhibitory population activity has risen.",
    "affected_symbols": [
      "E",
      "I",
      "tau_I",
      "w_EI"
    ],
    "rationale": "A realistic next refinement is to separate inhibitory population activation from the inhibitory synaptic effect experienced by excitation. The parent target mapping has a single-phase shortcut: for any observed pair (E, I), the inhibitory contribution to dE_dt is fixed immediately by I through one sigmoidal drive. Under fixed external drives and fixed initial conditions, vary the effective strength of perturbation-driven inhibitory recruitment along trajectories by considering epochs before and after I has risen. In the parent, once I is specified, dE_dt cannot distinguish whether that I has just increased or has been elevated long enough to build synaptic inhibition. In the child, the same instantaneous I can correspond to weaker or stronger suppressive effect depending on recent history, producing a measurable lag between inhibitory activation and maximal excitatory suppression. This changes the scored target mapping itself, not just auxiliary trajectories, because dE_dt at a given observed E and I would differ across trajectory phases through the added inhibitory-memory state. The effect is scientifically admissible when inhibition is recruited dynamically after excitation and synaptic action is not infinitely fast; if inhibition stays tiny or permanently saturated, the extra phase structure becomes weak."
  },
