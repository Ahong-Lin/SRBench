{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "threshold_surface",
      "parent_relation": "Excitatory recruitment depends on inhibitory influence through divisive gain reduction and delayed subtractive suppression, but the excitatory threshold itself is fixed across inhibitory states.",
      "child_relation": "Excitatory recruitment threshold is shifted by inhibitory synaptic engagement, so the same recurrent-external drive can lie above threshold when S_I is low and below threshold when S_I is high, producing a state-dependent threshold surface in (E,I,S_I).",
      "affected_inputs": [
        "E",
        "I",
        "S_I",
        "threshold_E"
      ],
      "observable_effect": "At matched net drive w_EE*E - w_EI*I + external_drive_E, the decline of dE_dt with increasing S_I is weak near quiescent drive but becomes much sharper when the drive is near the effective recruitment knee, because inhibition now shifts the knee location instead of only changing slope and adding multiplicative suppression."
    },
    "diagnostic_groups": [
      {
        "name": "net_drive_E",
        "expression": "w_EE*E - w_EI*I + external_drive_E - threshold_E",
        "role": "Baseline excitatory distance from recruitment threshold before any added threshold modulation"
      },
      {
        "name": "shunted_gain_E",
        "expression": "gain_E/(1 + shunt_SI_E*S_I)",
        "role": "Existing inhibitory divisive control of excitatory sigmoid steepness"
      },
      {
        "name": "delayed_inhib_load",
        "expression": "S_I*E",
        "role": "Existing delayed suppressive inhibitory load on the excitatory population"
      }
    ],
    "activation_condition": "Observable when S_I rises to moderate values after inhibitory recruitment and the excitatory net drive remains near threshold, so small threshold shifts can switch the sigmoid occupancy appreciably; weak when S_I stays near zero or the drive is already deep in saturation or deep below threshold.",
    "train_hidden_contrast": "Within training trajectories, early low-S_I epochs and later elevated-S_I epochs can occur under the same fixed external drive; in holdout, the same mechanism extends to stronger recurrent buildup or slower inhibitory decay where threshold displacement becomes more pronounced over time.",
    "continuation_path": "Recover the parent law when inhibitory threshold-shift strength tends to zero, leaving only the existing divisive gain shunt and delayed multiplicative suppression.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes inhibition can only reduce excitatory gain and impose delayed suppressive loss, but not move the excitatory recruitment threshold itself, omitting a common conductance-like and network-bias effect whereby inhibition raises the effective activation threshold.",
    "baseline_assumption": "The excitatory recruitment threshold threshold_E is constant and independent of inhibitory synaptic engagement.",
    "scientific_mechanism": "Inhibitory synaptic input can hyperpolarize or otherwise bias the excitatory population so that more recurrent-plus-external excitation is required to recruit the same fraction of available excitatory neurons, i.e. inhibition induces a state-dependent threshold increase.",
    "affected_symbols": [
      "E",
      "I",
      "S_I",
      "threshold_E",
      "gain_E",
      "shunt_SI_E"
    ],
    "rationale": "A realistic next refinement is to relax the fixed-threshold assumption for excitatory recruitment. The parent target mapping already lets S_I lower excitatory gain and adds delayed suppression proportional to S_I*E, but for any fixed parameter set its sigmoid knee in net drive remains anchored at threshold_E. Vary condition by following one trajectory over time under fixed external_drive_E and initial conditions, holding parameters fixed, and compare epochs with similar net recurrent-external drive but different S_I due to inhibitory delay. In the parent, increased S_I mainly flattens the sigmoid and adds post-recruitment suppression; it cannot fully reproduce a systematic rightward displacement of the recruitment knee itself across these epochs with one shared parameter set. In the child, elevated S_I raises the effective threshold, so near-threshold states show a stronger drop in dE_dt than far-from-threshold states, changing the target mapping from a fixed-threshold sigmoid plus suppression into a moving-threshold sigmoid. This is scientifically admissible when inhibitory trace is appreciable and excitation operates near onset; if trajectories live only in deep saturation or near zero activity, the distinction becomes weak and should be stated as such."
  },
