{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The parent uses one smooth tanh-saturating visible-strength drift and one smooth tanh-saturating dispersive mass shift, so the line shape has a single characteristic detuning scale for numerator variation and a single characteristic detuning scale for real-part skewing.",
      "child_relation": "Replace the smooth odd tanh energy dependence in the channel-strength drift with a threshold-like onset in the same energy variable, so the visible coupling changes weakly below the opening scale and more sharply just above it, producing asymmetric local curvature in the resonance shoulder that is not captured by one globally smooth odd saturation.",
      "affected_inputs": [
        "sqrt_s",
        "Lambda_C",
        "alpha"
      ],
      "observable_effect": "When scanning sqrt_s upward through the resonance while holding M, Gamma, C, Delta_disp, and Lambda_disp fixed, the cross section develops a more abrupt change in shoulder curvature on one side of the peak associated with channel opening, instead of the parent's smoothly distributed skew across both sides."
    },
    "diagnostic_groups": [
      {
        "name": "detuning",
        "expression": "sqrt_s**2 - M**2",
        "role": "signed squared-energy offset from the nominal resonance mass shell"
      },
      {
        "name": "scaled_detuning_C",
        "expression": "(sqrt_s**2 - M**2)/Lambda_C**2",
        "role": "dimensionless coordinate controlling visible-channel variation relative to its activation scale"
      },
      {
        "name": "propagator_core",
        "expression": "((sqrt_s**2 - M**2) - Delta_disp*tanh((sqrt_s**2 - M**2)/Lambda_disp**2))**2 + M**2*(Gamma*sqrt_s/M)**2",
        "role": "existing denominator controlling resonance localization and skew"
      }
    ],
    "activation_condition": "Visible when the sampled energy window includes the vicinity of the channel-opening scale represented within the current Lambda_C-controlled drift, with |sqrt_s**2 - M**2| comparable to Lambda_C**2 and non-negligible alpha; the effect is most apparent for moderate widths so the shoulder shape is resolved.",
    "train_hidden_contrast": "In training, the mechanism appears as mild asymmetry and unequal shoulder curvature near resonance; in holdout with somewhat broader detuning coverage, the sharper one-sided onset continues while the parent remains locked to a single smooth odd saturation.",
    "continuation_path": "Recover the parent in the limit where the threshold-like onset is broadened into a smooth odd saturation across the full scan window, or when alpha -> 0 so the numerator becomes effectively constant.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent treats the visible channel-strength evolution as a globally smooth odd crossover in detuning, but a real decay channel can turn on with threshold-like phase-space behavior that changes the local shoulder curvature more abruptly on one side of the resonance.",
    "baseline_assumption": "The effective channel strength is modeled as a smooth tanh function across the sampled energy window rather than as a threshold-governed onset tied to kinematic opening of the selected final channel.",
    "scientific_mechanism": "Threshold phase-space activation of the selected visible decay channel modifies the energy dependence of the numerator more sharply near opening than a single smooth tanh drift.",
    "affected_symbols": [
      "sqrt_s",
      "alpha",
      "Lambda_C"
    ],
    "rationale": "Parent response relationship: at fixed M, Gamma, C, Delta_disp, and Lambda_disp, varying sqrt_s changes sigma_res through a Breit-Wigner-like denominator with smooth odd numerator modulation, giving one broadly distributed skew/curvature pattern. Proposed child change: keep the same overall resonance structure but relax the assumption that the visible coupling drift is globally smooth; instead use a threshold-like onset in sqrt_s for the numerator, creating a localized curvature change in the rising or falling shoulder near the opening scale. Distinguishing condition: compare scans with the same fixed resonance parameters and nonzero alpha over an energy range where |sqrt_s**2 - M**2| is of order Lambda_C**2. The child predicts weaker variation below opening and a sharper post-opening shoulder bend, whereas the parent's single tanh with one shared parameter set spreads the change smoothly and symmetrically in detuning-sign structure. This is an actual target-mapping change, not only an auxiliary reinterpretation, because sigma_res(sqrt_s,...) itself changes shape. Admissible limitation: if alpha is very small or the scan window never reaches the activation region, the refinement is effectively hidden and the parent is adequate."
  },
