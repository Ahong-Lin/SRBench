{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed C, Gamma, alpha, Lambda_C, Delta_disp, and Lambda_disp, the resonance numerator varies only through a single smooth detuning drift while the width term scales effectively linearly with sqrt_s, so the line shape has one characteristic shoulder/peak curvature scale around M.",
      "child_relation": "Replace the current globally smooth channel-strength drift by a stronger near-threshold phase-space factor tied to the resonance virtuality, so the visible numerator changes curvature sharply on one side of the peak while remaining smooth elsewhere.",
      "affected_inputs": [
        "sqrt_s",
        "M"
      ],
      "observable_effect": "When scanning sqrt_s across M with all other parameters held fixed and M lying near a visible-channel opening scale, the low-energy side of the resonance rises more slowly and bends more sharply than the high-energy side; one shared refitted parent parameter set with only a smooth log drift cannot match both the near-threshold shoulder and the far-from-threshold normalization trend."
    },
    "diagnostic_groups": [
      {
        "name": "detuning",
        "expression": "sqrt_s**2 - M**2",
        "role": "Invariant-mass offset controlling distance from the nominal pole"
      },
      {
        "name": "scaled_detuning_C",
        "expression": "(sqrt_s**2 - M**2)/Lambda_C**2",
        "role": "Dimensionless coordinate for visible-channel variation saturation"
      },
      {
        "name": "scaled_detuning_disp",
        "expression": "(sqrt_s**2 - M**2)/Lambda_disp**2",
        "role": "Dimensionless coordinate for dispersive skew saturation"
      },
      {
        "name": "reduced_energy",
        "expression": "sqrt_s/M",
        "role": "Relative scan energy controlling asymmetry around the pole"
      }
    ],
    "activation_condition": "Observable when the scanned window includes energies close enough to a channel-opening-induced visible phase-space onset that the numerator changes over a narrower detuning range than the broad log saturation, while Gamma remains finite and the resonance is still isolated.",
    "train_hidden_contrast": "In training, moderate detuning already shows asymmetric shoulder curvature from threshold activation; in holdout, farther scans extend the same mechanism into a more saturated numerator regime, preserving the contrast between sharp near-onset bending and smoother far-tail behavior.",
    "continuation_path": "Recover the parent law in the limit where the threshold activation scale is taken broad compared with the scan window, so the sharper phase-space factor reduces to the existing smooth drift.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent treats visible-channel energy dependence as a single smooth detuning drift, which is too idealized when the selected decay channel turns on through threshold phase space and produces a sharper one-sided numerator curvature near resonance.",
    "baseline_assumption": "The effective channel strength is represented by a globally smooth function of detuning across the sampled energy window.",
    "scientific_mechanism": "Threshold phase-space activation of the selected visible decay channel modifies the numerator more abruptly near channel opening than a single smooth logarithmic drift.",
    "affected_symbols": [
      "sqrt_s",
      "M",
      "C",
      "alpha",
      "Lambda_C"
    ],
    "rationale": "Parent response: sigma_res is a bounded skewed resonance whose numerator changes only smoothly with detuning, while the denominator already includes width broadening and a saturating dispersive mass shift. The scientific gap is not a missing separate production source but an overly smooth assumption for how the selected final-state channel strength varies with energy. A natural refinement is therefore to change that assumption and encode threshold-like visible phase-space activation in the numerator. Distinguishing condition: vary sqrt_s across the resonance while holding M, Gamma, C, alpha, Lambda_C, Delta_disp, and Lambda_disp fixed, in the admissible regime where the selected channel opens within or near the scanned window. Then the child predicts a sharper curvature change on the opening side of the peak than the parent, whose single smooth drift cannot simultaneously fit the near-threshold shoulder suppression and the more weakly varying far-side normalization using one shared parameter set. This changes the scored target mapping directly, not merely an auxiliary trajectory. Limitation: if the scan window lies far from any visible threshold, the refinement becomes hard to observe and the parent is approximately recovered."
  },
