{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed M and Gamma, sigma_res as a function of sqrt_s is a single symmetric Breit-Wigner-like peak whose shape is controlled only by one shared width scale and one constant normalization C.",
      "child_relation": "Relax the assumption that the effective channel strength is constant across the scanned energy window, so the resonance numerator acquires a mild energy dependence and the peak height and shoulder falloff vary with sqrt_s beyond what a single constant C can produce.",
      "affected_inputs": [
        "sqrt_s"
      ],
      "observable_effect": "When scanning sqrt_s across M with M and Gamma held fixed, the line shape develops asymmetric shoulder weighting or altered peak-top curvature from the energy dependence of the visible coupling/branching strength, not just from the width term already present."
    },
    "diagnostic_groups": [
      {
        "name": "detuning",
        "expression": "(sqrt_s**2 - M**2)/M**2",
        "role": "dimensionless distance from resonance controlling off-shell deformation"
      },
      {
        "name": "width_ratio",
        "expression": "Gamma/M",
        "role": "relative intrinsic width setting how much of the scan samples off-shell coupling variation"
      },
      {
        "name": "scaled_energy",
        "expression": "sqrt_s/M",
        "role": "dimensionless collision energy governing possible channel-strength drift across the window"
      }
    ],
    "activation_condition": "Observable when the scanned energy window spans a non-negligible fraction of M or several Gamma around resonance, so any smooth energy dependence of the effective production-decay strength across the resonance is not negligible compared with experimental variation; weakest in a very narrow window tightly centered on M.",
    "train_hidden_contrast": "In training, the mechanism already changes curvature between the peak core and near shoulders as sqrt_s varies; in holdout over a wider scan, the same energy dependence extends this asymmetry or curvature drift farther from resonance.",
    "continuation_path": "Recover the parent law when the effective channel strength is energy independent across the scan window.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the effective channel strength C is constant with energy, even though production and selected-channel coupling factors can vary smoothly with off-shell energy across a resonance scan.",
    "baseline_assumption": "The effective channel strength is constant across the sampled energy window.",
    "scientific_mechanism": "Energy-dependent visible coupling or branching factor for the selected final channel, producing a slowly varying numerator across the resonance.",
    "affected_symbols": [
      "sqrt_s",
      "C",
      "M",
      "Gamma"
    ],
    "rationale": "Parent response relationship: with sqrt_s varied and M, Gamma, C held fixed, the target is a bounded resonance peak whose numerator is effectively constant apart from the already included width factor, so one shared parameter set gives one fixed peak-top curvature and symmetric shoulder weighting. Natural refinement: keep the isolated resonance picture but relax constant channel strength, allowing the production-times-decay factor to drift with sqrt_s. This changes the scored target mapping itself, not merely an auxiliary quantity, because sigma_res at the same M and Gamma now depends on sqrt_s through both denominator and effective numerator. Distinguishing condition: compare near-peak and shoulder regions in scans with fixed M and Gamma, especially when |sqrt_s-M| is of order Gamma to a few Gamma and the scan width is not tiny relative to M; the child can show different curvature or mild asymmetry between low- and high-energy sides that a parent with one constant C cannot reproduce simultaneously across the whole scan. This is scientifically admissible because off-shell couplings and visible branching fractions often vary smoothly with energy, while remaining non-negative and finite. Limitation: if the sampled window is extremely narrow around M, such variation may be too small to identify, so the refinement may effectively collapse back to the parent there."
  },
