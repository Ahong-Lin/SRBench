{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed substrate concentration, pH modulates activity through one productive protonation window bounded by a low-pH and a high-pH transition, so the log-rate profile is controlled by a single pair of apparent ionization flanks with substrate-dependent shifts but only one central active phase.",
      "child_relation": "Allow the alkaline loss-of-activity transition to be non-ideal as well, so substrate can reshape not only the window position but also the upper-flank curvature and shoulder/broadening behavior through coupled protonation microstates on the basic side.",
      "affected_inputs": [
        "pH",
        "S"
      ],
      "observable_effect": "Across substrate levels, the high-pH side can change from a simple single-slope falloff to a broader or sharper alkaline shoulder while the acidic side remains similar, altering the pH-profile width and asymmetry in a way the parent cannot match with one fixed alkaline steepness."
    },
    "diagnostic_groups": [
      {
        "name": "theta",
        "expression": "S/(K_M + S)",
        "role": "Substrate-occupancy factor controlling how binding redistributes protonation microstates"
      },
      {
        "name": "acid_drive",
        "expression": "(n_low0 + delta_n_low*S/(K_M + S))*(pKa_low - pH - delta_pKa_low*S/(K_M + S))",
        "role": "Effective acidic-side log10 inactivation drive already present in the parent"
      },
      {
        "name": "base_drive",
        "expression": "pH - pKa_high - delta_pKa_high*S/(K_M + S)",
        "role": "Alkaline-side displacement from the apparent upper transition"
      }
    ],
    "activation_condition": "Most visible when pH samples extend through and above the alkaline activity-loss flank and substrate occupancy varies appreciably from low to near-saturating values, i.e. S spanning values below and around K_M so theta changes substantially.",
    "train_hidden_contrast": "In training, varying pH at several substrate levels already reveals substrate-dependent movement of the active window; in holdout, the same mechanism predicts that the upper-flank curvature and apparent width also change with substrate rather than only translating rigidly.",
    "continuation_path": "Recover the parent when the alkaline non-ideality vanishes, e.g. the added high-pH steepness correction tends to zero and the effective alkaline Hill coefficient returns to the parent's constant n_high.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current law assumes the high-pH inactivation branch has a fixed idealized steepness except for a horizontal pKa shift, even though the low-pH branch already allows microstate-coupled non-ideality and substrate-dependent reshaping.",
    "baseline_assumption": "The alkaline transition is represented by a single fixed apparent Hill coefficient n_high that does not change with substrate occupancy or microstate redistribution.",
    "scientific_mechanism": "Coupled protonation microstates or conformational substates linked to the alkaline catalytic group can make the high-pH inactivation step non-ideal, and substrate binding can redistribute those microstates so the alkaline flank steepness changes with occupancy.",
    "affected_symbols": [
      "pH",
      "S",
      "n_high",
      "K_M",
      "delta_pKa_high"
    ],
    "rationale": "The parent maps inputs to rate through one productive pH window with substrate-dependent boundary shifts, but on the alkaline side it enforces a single-phase falloff shape because n_high is fixed for all S. A realistic next refinement is to relax that idealization and let the alkaline branch have occupancy-dependent non-ideal steepness, paralleling the already admitted low-pH microstate complexity. The varied conditions are pH and substrate concentration, with temperature and ionic strength fixed as stated. The concrete contrast is at two substrate regimes, one with S much less than K_M and one with S comparable to or greater than K_M: the parent can shift the alkaline midpoint through delta_pKa_high but cannot, with one shared parameter set, make the high-pH descent broaden at one S and sharpen at another while keeping the acidic branch approximately unchanged. This is an actual target-mapping change because v_pH itself versus supplied pH and S changes shape, not merely an unobserved auxiliary quantity. The effect is admissible when measurements cover the alkaline flank; if data never reach above the upper apparent pKa, the refinement would be weakly identifiable, which is a limitation rather than a reason to invent another mechanism."
  },
