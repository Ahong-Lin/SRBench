{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The adult gain term is linear in juvenile abundance, so dA_dt increases with a constant slope maturation_rate with respect to J when A is held fixed.",
      "child_relation": "Replace constant per-capita maturation with density-limited maturation so the adult gain from juveniles rises approximately linearly at low J but with reduced marginal gain at high J, creating a saturating or crowding-curved dependence of dA_dt on J.",
      "affected_inputs": [
        "J",
        "A",
        "maturation_rate"
      ],
      "observable_effect": "At fixed A, doubling J increases dA_dt nearly proportionally when J is low, but less than proportionally when J is high enough for juvenile crowding to impede maturation; the parent cannot produce this changing slope because its J-to-dA_dt mapping is exactly linear."
    },
    "diagnostic_groups": [
      {
        "name": "adult_net_loss",
        "expression": "adult_mortality_rate*A",
        "role": "Adult loss term held fixed when isolating how juvenile abundance changes adult gain"
      },
      {
        "name": "juvenile_to_adult_flux_parent",
        "expression": "maturation_rate*J",
        "role": "Parent maturation flux with constant per-capita transition"
      },
      {
        "name": "juvenile_load",
        "expression": "J",
        "role": "Crowding scale candidate controlling departure from linear maturation"
      }
    ],
    "activation_condition": "The contrast is visible when juvenile abundance spans a range where crowding in the juvenile stage is non-negligible relative to the maturation bottleneck, while adult abundance and mortality are observed over the same protocol; at very low J the child should reduce to the parent approximately.",
    "train_hidden_contrast": "In training, moderate variation in J already shows a weaker-than-linear increase of dA_dt with J at fixed A; in holdout, larger J extends the same mechanism into clearer saturation or stronger downward curvature rather than introducing a qualitatively new process.",
    "continuation_path": "In the weak-crowding limit, or as the crowding coefficient tends to zero, the maturation term reverts to maturation_rate*J and the parent law is recovered.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes juveniles mature at a constant per-capita rate regardless of juvenile density, omitting competition or developmental bottlenecks within the juvenile stage.",
    "baseline_assumption": "Per-capita demographic rates are constant over time and density dependence is negligible over the modeled abundance range.",
    "scientific_mechanism": "Juvenile crowding can slow development or access to resources, reducing effective maturation at higher juvenile abundance without violating nonnegative stage transitions.",
    "affected_symbols": [
      "J",
      "A",
      "maturation_rate"
    ],
    "rationale": "A realistic next refinement is to relax the constant-maturation assumption rather than add a wholly new process. The parent target mapping for adult change is dA_dt = maturation_rate*J - adult_mortality_rate*A, so when A is held fixed the slope with respect to J is constant. Vary juvenile abundance through the existing coupled dynamics or across observed times while holding the adult mortality process unchanged; under juvenile crowding, the adult gain term should bend downward with increasing J because each additional juvenile contributes less maturation flux than the previous one. This is a direct change in the scored target mapping, not only in auxiliary juvenile trajectories, because dA_dt itself changes from linear in J to a curved dependence. The contrast is scientifically admissible when juvenile densities are high enough that development is resource- or space-limited, but not so extreme that the stage interpretation breaks down. A single refit of the parent parameters cannot reproduce both low-J near-linear gain and high-J attenuated gain across those conditions, because changing maturation_rate only rescales one constant slope and changing adult_mortality_rate only shifts the A-dependent loss term."
  },
