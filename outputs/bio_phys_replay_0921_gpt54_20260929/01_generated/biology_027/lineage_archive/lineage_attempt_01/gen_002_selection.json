{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "The parent maps autonomic tone deviation to supported pressure with one fixed cubic-shaped gain, so the pressure restoring drive depends on u alone and has the same slope at a given u regardless of whether pressure is above or below the set point.",
      "child_relation": "Refine the autonomic pressure-support law so its effective gain depends jointly on autonomic tone deviation and pressure error, representing pressure-dependent vascular recruitment or runoff opposition; then the same u can generate different pressure support when P_a is low versus high.",
      "affected_inputs": [
        "u",
        "P_a",
        "P_set"
      ],
      "observable_effect": "For matched autonomic-tone excursions after perturbations of different amplitude, low-pressure episodes show stronger pressure recovery per unit u than near-set-point episodes, producing amplitude-dependent damping/recovery that the parent's fixed u-to-pressure map cannot match with one shared parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "tone_dev",
        "expression": "u - u_baseline",
        "role": "Autonomic deviation from baseline recruitment"
      },
      {
        "name": "pressure_error",
        "expression": "P_set - P_a",
        "role": "Instantaneous baroreflex-relevant pressure deficit or excess"
      },
      {
        "name": "parent_support",
        "expression": "autonomic_pressure_gain*(u - u_baseline)*(1 - (u - u_baseline)**2)",
        "role": "Current pressure support contributed by autonomic tone alone"
      }
    ],
    "activation_condition": "Observable when transient pressure errors are large enough that vascular and flow-support efficacy differs between hypotensive and near-baseline states, while u remains in its admissible interior range so the interaction is not masked by hard tone saturation.",
    "train_hidden_contrast": "In training, modest perturbations mainly reveal near-linear recovery around the set point; in holdout, larger but still physiological perturbations expose that autonomic support is more effective during deeper hypotension than the parent's single fixed gain predicts.",
    "continuation_path": "Recover the parent by taking the pressure-dependence of autonomic efficacy to zero, so pressure support becomes a function of u alone with the original fixed cubic saturation form.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes autonomic effector tone produces the same incremental arterial-pressure support at a given u regardless of the prevailing arterial pressure, omitting state-dependent efficacy of vasoconstrictor/cardiac support when pressure and runoff conditions differ.",
    "baseline_assumption": "Autonomic modulation of cardiac and vascular support is represented by a pressure-independent static saturating function of u alone.",
    "scientific_mechanism": "Pressure-dependent effectiveness of autonomic support: during hypotension, recruited tone can oppose peripheral runoff and support cardiac delivery more effectively than at higher pressures, so the pressure response to tone is not separable from the current pressure state.",
    "affected_symbols": [
      "P_a",
      "u",
      "P_set",
      "autonomic_pressure_gain",
      "u_baseline"
    ],
    "rationale": "A realistic next refinement is to relax the separability assumption in the P_a equation rather than adding an unrelated state. The parent target mapping is dP_a_dt=f(u)-P_a over a fixed time constant, with all autonomic support compressed into one pressure-independent cubic of tone deviation. Vary the size/sign of the initial pressure perturbation while holding fixed P_set, pressure_time_constant, autonomic_time_constant, baroreflex_sensitivity, and the observation protocol. Then compare episodes that transiently pass through similar u but different P_a. The parent predicts the same autonomic pressure-support contribution at those matched u values, because P_a only enters through passive relaxation toward the supported level. A child with pressure-dependent autonomic efficacy predicts a different slope/curvature of dP_a_dt versus u when P_a is far below versus near P_set. This changes the scored target mapping itself, not merely the auxiliary u trajectory. The contrast is scientifically admissible for brief perturbations large enough to create measurable hypotension or hypertension but still bounded so P_a stays positive and u remains between zero and one. A single refit of the parent's existing parameters cannot reproduce this across conditions because changing autonomic_pressure_gain rescales support uniformly across all pressures, whereas the proposed refinement changes support conditionally on pressure error at fixed u."
  },
