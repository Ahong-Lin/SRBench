{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The pressure equation maps autonomic tone to supported pressure with a single constant slope, d(dP_a_dt)/du = autonomic_pressure_gain/pressure_time_constant, independent of the current tone level.",
      "child_relation": "Replace the constant autonomic pressure support gain by a saturating tone-to-pressure effect so that incremental pressure support is larger around mid-range tone and smaller near the lower and upper tone bounds.",
      "affected_inputs": [
        "u",
        "P_a",
        "autonomic_pressure_gain"
      ],
      "observable_effect": "For matched small perturbations near baseline versus larger perturbations that drive u close to 0 or 1, the child predicts compressed pressure excursions and weaker late pressure support at extreme tone, whereas the parent keeps the same linear pressure response per unit tone everywhere."
    },
    "diagnostic_groups": [
      {
        "name": "tone_departure",
        "expression": "u - u_baseline",
        "role": "Signed autonomic deviation from baseline entering pressure support"
      },
      {
        "name": "pressure_error",
        "expression": "P_set - P_a",
        "role": "Baroreflex drive magnitude"
      },
      {
        "name": "tone_headroom",
        "expression": "u*(1 - u)",
        "role": "Available autonomic operating-range factor; largest at mid tone and small near saturation"
      }
    ],
    "activation_condition": "Visible when pressure perturbations are large enough that the observed u trajectory spends appreciable time away from baseline and approaches either bound, while P_a remains positive and the restoring feedback remains bounded.",
    "train_hidden_contrast": "Across training episodes with modest versus stronger initial pressure errors, both measured with the same state observation protocol, the child extends the parent by predicting that the P_a response per unit change in u bends over as u nears 0 or 1 instead of remaining affine.",
    "continuation_path": "In the limit where observed u stays in a narrow neighborhood of u_baseline, the saturating tone-to-pressure map linearizes and recovers the parent law with an effective local gain.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes autonomic support of arterial pressure is affine in effector tone over the full admissible range, ignoring diminishing marginal hemodynamic effect near low and high sympathetic/vascular activation.",
    "baseline_assumption": "Autonomic modulation of cardiac and vascular support enters the pressure equation through a constant gain multiplying u - u_baseline.",
    "scientific_mechanism": "Combined cardiac and vascular effector recruitment is bounded, so additional autonomic tone produces diminishing pressure support as the available recruitable reserve is exhausted near tone saturation.",
    "affected_symbols": [
      "u",
      "P_a",
      "autonomic_pressure_gain",
      "u_baseline"
    ],
    "rationale": "A realistic next refinement is to relax the parent's constant-gain mapping from autonomic tone to arterial pressure support. The parent relationship is linear: each unit change in u produces the same change in the P_a target derivative regardless of whether tone is near baseline or near its bounds. Scientifically, short-term autonomic support represents finite recruitable chronotropic, inotropic, and vasomotor reserve, so equal increments in u should have less pressure effect once tone is already high, and similarly less further withdrawal effect once tone is already very low. The distinguishing condition is to compare responses from modest versus larger pressure perturbations while holding P_set, pressure_time_constant, autonomic_time_constant, and baroreflex_sensitivity fixed. Under larger perturbations, the observed u trajectory can approach 0 or 1 due to the existing logistic baroreflex term, making the changed curvature in the P_a mapping observable under the current initial-condition and observation contract. The child then predicts that pressure recovery flattens relative to the parent at extreme tone, reducing overshoot or undershoot amplitude for the same u displacement. A single refitted parent gain cannot reproduce both the near-baseline slope and the compressed extreme-tone response across these conditions, because its dP_a_dt dependence on u remains affine with one shared slope. This is a target-mapping change, not merely an auxiliary-trajectory change, since dP_a_dt itself becomes a nonlinear function of the supplied state u."
  },
