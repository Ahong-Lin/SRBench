{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target slope is linear in the concentration difference, dC1_dt = exchange_rate*(C2 - C1), with one constant relaxation rate for all concentration contrasts.",
      "child_relation": "The exchange process remains conservative and sign-restoring, but the effective transfer weakens at large concentration contrast because interfacial turbulent exchange becomes mixing-limited, so dC1_dt is a nonlinear odd function of (C2 - C1) with smaller per-unit-gradient slope at large |C2-C1| than near equilibrium.",
      "affected_inputs": [
        "C1",
        "C2",
        "exchange_rate"
      ],
      "observable_effect": "Holding exchange_rate fixed, trajectories starting from larger concentration differences show slower-than-exponential initial relaxation relative to the parent, while small differences still relax approximately linearly near equilibrium."
    },
    "diagnostic_groups": [
      {
        "name": "deltaC",
        "expression": "C2 - C1",
        "role": "Driving concentration contrast for inter-volume exchange"
      },
      {
        "name": "contrast_mag",
        "expression": "Abs(C2 - C1)",
        "role": "Magnitude of disequilibrium controlling departure from linear exchange"
      },
      {
        "name": "total_mass_proxy",
        "expression": "C1 + C2",
        "role": "Conserved total tracer concentration for equal closed volumes"
      }
    ],
    "activation_condition": "Observable when the admissible concentration contrast is not asymptotically small, i.e. |C2-C1| is large enough that exchange is no longer proportional to contrast over the sampled range; near equilibrium the parent remains a good approximation.",
    "train_hidden_contrast": "In training, moderate contrasts can already reveal slight downward curvature of dC1_dt versus (C2-C1); in holdout, larger contrasts extend the same mechanism and show a clearer sublinear response without changing conservation or the final equalized state.",
    "continuation_path": "Recover the parent law in the small-contrast limit where the nonlinear exchange function linearizes to exchange_rate*(C2-C1).",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes exchange intensity is proportional to concentration difference at all contrasts, omitting mixing-limited saturation of turbulent interfacial transport when the two volumes are strongly segregated.",
    "baseline_assumption": "The exchange intensity is constant in time and proportional to concentration difference with one shared linear gain over the full concentration range.",
    "scientific_mechanism": "Finite interfacial stirring efficiency causes conservative but sublinear tracer transfer at large concentration contrast, while retaining linear relaxation close to equilibrium.",
    "affected_symbols": [
      "C1",
      "C2",
      "exchange_rate"
    ],
    "rationale": "A realistic next refinement is to relax the globally linear-flux assumption without adding new states: for passive conservative exchange, the parent maps the observed state pair only through a single constant gain multiplying deltaC = C2-C1. Varying the initial contrast while holding exchange_rate fixed, the parent predicts the same proportional slope at every contrast and therefore exponential decay of the difference with one timescale. A scientifically plausible child instead keeps the sign of transport from high to low concentration and conserves total tracer, but makes the target mapping dC1_dt versus deltaC bend downward at large |deltaC| because finite turbulent contact or entrainment limits how efficiently separated fluid parcels exchange tracer. This changes the scored target mapping itself, not only auxiliary trajectories: the instantaneous dC1_dt for a given observed (C1,C2) becomes smaller in magnitude than the parent's linear prediction when contrast is large, yet matches the parent approximately for small contrast. The contrast is observable under the existing initial-condition protocol because the supplied states already traverse from a large initial difference toward equilibrium; admissible activation is therefore the early-to-mid transient where |C2-C1| remains appreciable. Limitation: if observations stay confined to very small contrasts, the refinement would collapse back to the parent and may not be distinguishable."
  },
