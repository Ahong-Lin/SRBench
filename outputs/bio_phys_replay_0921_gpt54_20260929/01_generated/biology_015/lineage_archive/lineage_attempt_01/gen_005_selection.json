{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The infectious loss term is a monotone saturating function of infectious_maturation alone, so at fixed E and I the mapping from infectious_maturation to dI_dt has one fixed concavity pattern set only by the Hill-like factor.",
      "child_relation": "Keep removal increasing with infectious-stage age, but allow the age effect to gate removal more weakly when the remaining exposed pool is still large, so dI_dt depends on the joint state (infectious_maturation, E) rather than infectious_maturation alone.",
      "affected_inputs": [
        "infectious_maturation",
        "E",
        "I"
      ],
      "observable_effect": "Across trajectories with the same infectious_maturation and I but different remaining E, the child permits slower early infectious decline when E is still high and stronger decline later after E is depleted, changing the curvature and timing of the I peak."
    },
    "diagnostic_groups": [
      {
        "name": "age_load",
        "expression": "infectious_maturation**2/(1 + infectious_maturation**2)",
        "role": "current saturating infectious-stage ageing signal already driving removal"
      },
      {
        "name": "remaining_exposed_fraction",
        "expression": "E/(E + progression_feedback_scale)",
        "role": "dimensionless indicator that the cohort is still early in follow-up with a substantial latent pool"
      },
      {
        "name": "infectious_loss_flux",
        "expression": "removal_rate*I",
        "role": "baseline scale of infectious depletion against which modulation is observed"
      }
    ],
    "activation_condition": "Observable when infectious_maturation has reached order 1 so the existing ageing effect is active, while E still varies appreciably over follow-up relative to progression_feedback_scale; then early-versus-late cohort phase can alter removal at the same I.",
    "train_hidden_contrast": "In training, the mechanism appears as altered peak timing and asymmetric rise-fall shape of I within the same closed cohort trajectory; in holdout, the same joint dependence extends to trajectories where exposed depletion is slower or faster, yielding different decline onset at matched infectious_maturation.",
    "continuation_path": "Recover the parent law when the exposed-state modulation strength tends to zero, so removal depends only on infectious_maturation as before.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes infectious-stage maturation affects removal identically at all follow-up phases, ignoring that symptom-driven isolation or clinical exit can be delayed while substantial latent-stage burden remains and accelerate once the cohort has largely transitioned.",
    "baseline_assumption": "The age-dependent removal modifier is a single-phase function of infectious_maturation only and is independent of the remaining exposed pool.",
    "scientific_mechanism": "Within a closed outbreak cohort, operational and behavioral removal readiness can depend not only on how mature current infections are but also on whether the cohort is still in an early transition phase with many latent individuals versus a later phase when most cases have declared and are more readily detected or resolved.",
    "affected_symbols": [
      "E",
      "I",
      "infectious_maturation",
      "removal_rate",
      "progression_feedback_scale"
    ],
    "rationale": "A realistic next refinement is to relax the parent's single-phase removal assumption rather than add a wholly new process. The parent target mapping for dI_dt uses progression_rate*E as inflow and a removal term that is fully determined by I and infectious_maturation; once those are fixed, changing the remaining exposed burden E cannot alter infectious loss except indirectly through future auxiliary dynamics. That is a scientific shortcut because in a closed cohort, the same infectious-stage age may correspond to different operational phases: early while many individuals are still latent, or late after most have progressed. Holding I and infectious_maturation fixed and varying E within admissible nonnegative ranges, the parent predicts identical removal, whereas the child would predict weaker effective age-triggered removal at high E and stronger removal at low E. This changes the scored target mapping itself, not only an auxiliary trajectory, because dI_dt at the observed state now depends jointly on E and infectious_maturation. The contrast is observable when E remains appreciable relative to progression_feedback_scale during the period where infectious_maturation is already non-negligible; then the timing and curvature of the rise-to-fall transition in I differ. A single shared refit of the parent cannot reproduce both early muted decline and later sharper decline at matched infectious_maturation because its removal law has no exposed-dependent degree of response."
  },
