{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed extinction_rate, dp_dt depends on occupancy through a cubic colonization term colonization_rate*p*(1-p)*(1+colonization_density_dependence*p) minus a linear extinction loss, so colonization efficiency changes only linearly with p inside the occupancy-limited factor.",
      "child_relation": "Replace the linear density-dependence factor in colonization with a saturating occupancy effect so that increases in occupancy initially strengthen or weaken colonization efficiency but then level off at higher p, changing the curvature of dp_dt versus p while preserving zero colonization at p=0 and p=1.",
      "affected_inputs": [
        "p",
        "colonization_density_dependence"
      ],
      "observable_effect": "Across trajectories spanning low to moderate versus high occupancy, the child shows early occupancy-driven change in colonization slope that weakens at high p, whereas the parent enforces one fixed linear trend in colonization efficiency across the whole occupancy range."
    },
    "diagnostic_groups": [
      {
        "name": "occupancy_open_fraction",
        "expression": "p*(1 - p)",
        "role": "baseline availability of occupied sources and empty targets"
      },
      {
        "name": "extinction_load",
        "expression": "extinction_rate*p",
        "role": "instantaneous regional loss pressure from occupied patches"
      },
      {
        "name": "occupancy_level",
        "expression": "p",
        "role": "state along which the colonization-efficiency curvature is diagnosed"
      }
    ],
    "activation_condition": "The contrast is visible when trajectories visit a broad occupancy range, especially intermediate to high p where occupancy-dependent colonization modulation is appreciable but empty patches remain available; if p stays very near 0 or 1 the difference is weak because colonization is already constrained by p*(1-p).",
    "train_hidden_contrast": "In training, both models may match low-to-mid occupancy growth, but in held-out segments reaching higher occupancy the child can flatten the occupancy effect on colonization efficiency while the parent must continue the same linear dependence on p inside the colonization factor.",
    "continuation_path": "Recover the parent by taking the saturation scale to be very large, so the saturating occupancy modifier reduces to the existing approximately linear dependence over the observed range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes that density-dependent modulation of colonization efficiency changes linearly with occupancy over the whole landscape occupancy range, which is often too idealized once source interference or facilitation saturates.",
    "baseline_assumption": "Every incremental increase in occupancy has the same proportional effect on colonization efficiency after accounting for the existing p*(1-p) occupancy-limitation term.",
    "scientific_mechanism": "Landscape-scale facilitation or interference among occupied patches typically saturates because additional occupied patches become redundant propagule sources or because crowding effects cannot intensify indefinitely.",
    "affected_symbols": [
      "p",
      "colonization_rate",
      "colonization_density_dependence"
    ],
    "rationale": "A realistic next refinement is to relax the parent's linear occupancy effect within colonization efficiency rather than adding a wholly new process. The parent target mapping has a single-gain shortcut: at fixed extinction_rate, the occupancy-dependent modifier of colonization is forced to vary linearly with p, so one shared parameter set imposes the same trend from low to high occupancy. Scientifically, source facilitation or interference should often saturate because occupied patches become overlapping dispersal sources or because social/Allee-like gains cannot keep increasing proportionally forever. Vary occupancy along the actual trajectory while holding colonization_rate, colonization_density_dependence, and the extinction process fixed. Then compare dp_dt at moderate versus high occupancy. The parent predicts continued linear strengthening or weakening of colonization efficiency with p, whereas the child would show diminishing incremental effect at higher p, i.e. a curvature change in the p-to-dp_dt mapping itself, not merely in an auxiliary state. This is observable whenever trajectories traverse enough of the interior interval away from the boundary zeros imposed by p*(1-p). The refinement respects occupancy bounds and keeps colonization zero at p=0 and p=1. Its limitation is that if observations stay in a narrow low-p band, the parent may approximate the child well because a saturating function is locally linear there."
  },
