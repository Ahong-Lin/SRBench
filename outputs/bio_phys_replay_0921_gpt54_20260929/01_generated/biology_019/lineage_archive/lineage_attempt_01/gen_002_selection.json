{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "With constant extinction_rate, the target mapping dp_dt(p) is time-invariant: at a given occupancy p the instantaneous decline term is always the same regardless of recent occupancy history.",
      "child_relation": "Let extinction susceptibility relax dynamically after occupancy changes, so dp_dt depends on both current p and a lagged extinction state. The same p can then have different dp_dt during post-colonization buildup versus post-decline recovery.",
      "affected_inputs": [
        "p",
        "extinction_rate"
      ],
      "observable_effect": "A hysteretic time-pattern appears: after a rapid rise in p, extinction remains temporarily elevated or depressed relative to its long-run level, shifting the net growth curve over time in a way the parent cannot match with one fixed extinction parameter."
    },
    "diagnostic_groups": [
      {
        "name": "occupancy_gap",
        "expression": "1 - p",
        "role": "fraction of empty habitat available for colonization"
      },
      {
        "name": "net_parent_growth",
        "expression": "colonization_rate*p*(1 - p)*(1 + colonization_density_dependence*p) - extinction_rate*p",
        "role": "parent instantaneous occupancy change under fixed extinction"
      },
      {
        "name": "colonization_flux_parent",
        "expression": "colonization_rate*p*(1 - p)*(1 + colonization_density_dependence*p)",
        "role": "parent colonization contribution before subtracting extinction"
      }
    ],
    "activation_condition": "Observable when occupancy changes on a timescale comparable to habitat deterioration or rescue relaxation, so extinction risk does not instantaneously track current occupancy; strongest for intermediate p where both colonization and extinction are appreciable.",
    "train_hidden_contrast": "In training, early and late segments with similar p but different recent trajectories can show different dp_dt; in holdout, the same lag effect extends to trajectories with stronger transient departures from equilibrium.",
    "continuation_path": "Recover the parent law in the fast-relaxation or zero-coupling limit where the dynamic extinction susceptibility collapses to the constant extinction_rate.",
    "freedom_change": "parameter_to_state",
    "promoted_symbol": "extinction_rate",
    "promotion_reason": "A time-lagged extinction susceptibility cannot be represented with only the current occupancy state and fixed parameters, because the mechanism requires memory of recent conditions at the same p.",
    "gap_statement": "The model assumes local extinction risk is constant in time, ignoring delayed habitat degradation or delayed rescue effects that make extinction susceptibility relax rather than instantaneously equal a fixed value.",
    "baseline_assumption": "Colonization and extinction rates are constant over time",
    "scientific_mechanism": "Extinction susceptibility is an internal ecological condition that adjusts gradually, creating memory in patch loss after occupancy changes.",
    "affected_symbols": [
      "p",
      "extinction_rate"
    ],
    "rationale": "A realistic next refinement is to relax the assumption of time-constant extinction by turning extinction_rate into a dynamic state that tracks changing regional conditions with lag. In the parent, holding parameters fixed, dp_dt is a single-valued function of p, so two times with the same occupancy must have the same instantaneous change. In the child, varying time along one trajectory while holding the observed occupancy p fixed, different recent occupancy histories can produce different extinction pressure and hence different dp_dt. This is a genuine target-mapping change, not merely an auxiliary-state embellishment, because the scored derivative of p changes at fixed p through the added memory variable. The contrast is admissible when occupancy is not stationary and the relaxation timescale is neither negligible nor infinitely slow relative to occupancy change. If relaxation is effectively instantaneous, the added mechanism collapses back to the parent; if occupancy barely moves, the lag is weak and the effect may be hard to see. A single refit of all parent parameters cannot reproduce such history dependence across conditions with matched p but differing recent trajectories, because the parent has no memory channel."
  },
