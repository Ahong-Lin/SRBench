{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "For fixed host_susceptible_background, host_transmission_rate, and host_infection_capacity, the host-incidence term increases with Iv through one saturating scale proportional to (1 - Ih / host_infection_capacity), giving a single shared Iv-to-dIh_dt curvature across Ih levels.",
      "child_relation": "Refine the vector-to-host saturation law so that crowding of infected hosts also changes how quickly additional infectious vectors lose marginal effectiveness, making the Iv response bend earlier at high Ih and later at low Ih rather than being controlled by one shared saturation shape.",
      "affected_inputs": [
        "Iv",
        "Ih",
        "vector_to_host_saturation_scale",
        "host_infection_capacity"
      ],
      "observable_effect": "When Iv is varied across low to moderate and high ranges while comparing low-Ih versus high-Ih conditions, the host infection derivative shows stronger compression of the Iv response at high Ih than the parent can match with one common parameter set."
    },
    "diagnostic_groups": [
      {
        "name": "host_free_capacity",
        "expression": "1 - Ih/host_infection_capacity",
        "role": "remaining host infection headroom"
      },
      {
        "name": "vector_pressure_ratio",
        "expression": "Iv/vector_to_host_saturation_scale",
        "role": "infectious-vector load relative to the baseline host-exposure saturation scale"
      },
      {
        "name": "capacity_weighted_pressure",
        "expression": "Iv/(vector_to_host_saturation_scale*(1 - Ih/host_infection_capacity))",
        "role": "current parent saturation coordinate coupling vector pressure to remaining host capacity"
      }
    ],
    "activation_condition": "Observable when Ih spans a nontrivial fraction of host_infection_capacity and Iv reaches values comparable to or above vector_to_host_saturation_scale times the remaining host-capacity factor; weak in the dilute regime Ih << host_infection_capacity and Iv << vector_to_host_saturation_scale.",
    "train_hidden_contrast": "In training, low-to-moderate Ih may already show mild Iv saturation; in holdout with higher Ih and comparable Iv, the same mechanism produces earlier curvature and stronger diminishing returns in dIh_dt.",
    "continuation_path": "Recover the parent by taking the added crowding dependence in the saturation scale to zero so the Iv response returns to a single shared saturation law controlled only by vector_to_host_saturation_scale and residual capacity.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current host-incidence law assumes one fixed functional form for how infectious-vector pressure saturates, with host crowding affecting transmission only through a simple residual-capacity factor and a proportional scaling inside the denominator.",
    "baseline_assumption": "Biting/contact limitation seen by susceptible hosts is represented by a single Iv saturation scale whose shape does not change beyond linear dependence on remaining host infection capacity.",
    "scientific_mechanism": "As infected-host occupancy rises, susceptible hosts become harder to reach and repeated bites or contacts are increasingly wasted on already infected or unavailable hosts, so the marginal gain from additional infectious vectors declines more sharply than in the baseline law.",
    "affected_symbols": [
      "Ih",
      "Iv",
      "vector_to_host_saturation_scale",
      "host_infection_capacity"
    ],
    "rationale": "A realistic next refinement is to relax the idealized host-incidence saturation form rather than adding a wholly new process. The parent target mapping from observed (Ih, Iv) to dIh_dt uses a single Iv saturation threshold structure, so after accounting for the explicit prefactor (1 - Ih/host_infection_capacity), all Ih levels share the same basic Iv-response shape. Scientifically, high host infection crowding should not only reduce available capacity multiplicatively; it should also change the marginal effectiveness of additional infectious vectors because contacts are increasingly redirected toward already infected or otherwise unavailable hosts. The distinguishing condition is to compare dIh_dt versus Iv at two different observed Ih levels while holding host_transmission_rate, host_susceptible_background, host_removal_rate, and host_infection_capacity fixed. In the child, the Iv-to-dIh_dt curve has stronger downward curvature at larger Ih; in the parent, one refitted parameter set cannot independently match both low-Ih and high-Ih curvature if the observed contrast exceeds what the single shared saturation law permits. This effect is admissible and observable only when both infected hosts and infected vectors are sufficiently abundant for saturation to matter; near the disease-free regime the refinement collapses toward the parent and may be hard to identify."
  },
