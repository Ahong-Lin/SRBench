{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "With constant host_transmission_rate, the target mapping from (Ih,Iv) to dIh_dt is time-invariant: at fixed Ih and Iv the host-incidence slope is the same early and late in the outbreak.",
      "child_relation": "Release host_transmission_rate from a fixed parameter to a dynamic state representing transient vector-to-host transmission competence or control/adaptation level, so the same (Ih,Iv) can produce different dIh_dt at different phases through feedback of transmission conditions.",
      "affected_inputs": [
        "Ih",
        "Iv",
        "host_transmission_rate"
      ],
      "observable_effect": "At matched Ih and Iv values reached at different times, host infection growth is stronger before competence/control decay and weaker later; the parent cannot create this hysteresis-like phase dependence because its target depends only on current Ih and Iv with fixed parameters."
    },
    "diagnostic_groups": [
      {
        "name": "host_force_parent",
        "expression": "host_transmission_rate*host_susceptible_background*(Iv/(1 + Iv/(vector_to_host_saturation_scale*(1 - Ih/host_infection_capacity)/(1 + infected_host_crowding_saturation_strength*Ih/host_infection_capacity))))*(1 - Ih/host_infection_capacity)",
        "role": "Current vector-to-host incidence term before host removal"
      },
      {
        "name": "host_capacity_fraction",
        "expression": "Ih/host_infection_capacity",
        "role": "Progress toward host infection occupancy limit"
      },
      {
        "name": "vector_pressure",
        "expression": "Iv/vector_to_host_saturation_scale",
        "role": "Normalized infected-vector pressure relative to the current saturation scale"
      }
    ],
    "activation_condition": "Observable when the modeled interval is long enough for transmission competence or intervention pressure to drift appreciably on a timescale comparable to host infection dynamics, while Ih and Iv revisit or pass through overlapping ranges during early versus later phases.",
    "train_hidden_contrast": "In training, the effect appears as gradual departure from a single time-invariant incidence curve; in holdout, the same mechanism extends to later phases where equal Ih and Iv no longer imply equal dIh_dt because the transmission state has evolved further.",
    "continuation_path": "In the limit where host_transmission_rate has zero dynamics or is clamped constant, the parent law is exactly recovered.",
    "freedom_change": "parameter_to_state",
    "promoted_symbol": "host_transmission_rate",
    "promotion_reason": "A fixed coefficient cannot encode phase-dependent transmission efficacy under identical Ih and Iv. To create an observable change in the scored target mapping rather than merely auxiliary dynamics, transmission intensity itself must evolve as a state.",
    "gap_statement": "The parent assumes vector-to-host transmission efficiency is constant through time, omitting gradual changes in transmission competence or control/adaptation that alter host incidence even at the same instantaneous infected host and vector abundances.",
    "baseline_assumption": "Transmission and removal parameters are constant through time.",
    "scientific_mechanism": "Transient evolution of effective vector-to-host transmission rate due to changing vector competence, host protection behavior, or intervention buildup/waning during the modeled outbreak.",
    "affected_symbols": [
      "Ih",
      "Iv",
      "host_transmission_rate"
    ],
    "rationale": "A realistic next refinement is to relax the constant-transmission assumption already used in the host-incidence term. The parent target mapping is a fixed-environment law: holding Ih and Iv fixed fixes dIh_dt up to one shared parameter set. Scientifically, however, vector-to-host transmission can drift over the outbreak because of accumulating control, behavioral protection, or competence loss/gain, so equal Iv acting on equal residual host capacity need not generate equal host incidence at different times. The concrete distinguishing condition is to compare early versus late portions of the same trajectory where Ih and Iv fall in overlapping ranges, while host_susceptible_background, vector_susceptible_background, host_infection_capacity, and removal parameters remain fixed. Parent response: one time-invariant slope from Iv to dIh_dt at each Ih. Child response: that slope shifts over phase because host_transmission_rate evolves, yielding a measurable phase contrast in dIh_dt at matched Ih and Iv. This is admissible when the transmission-rate drift is neither negligible nor so fast that it is effectively reabsorbed into noise; if the observation window is too short or the promoted state remains nearly constant, the contrast will be weak, and the parent is then an adequate approximation."
  },
