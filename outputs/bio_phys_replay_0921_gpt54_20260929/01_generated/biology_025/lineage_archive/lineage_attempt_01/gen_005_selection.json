{
  "plan": {
    "operation": "add_term",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "S_O2 depends only on P_O2 and a sample-level variant mixture, so all curvature changes are attributed to hemoglobin subpopulation weighting and fixed cooperative parameters under one held environment.",
      "child_relation": "S_O2 depends on P_O2 and an added independently varied carbon dioxide tension that shifts effective affinity and can differentially modulate baseline and variant occupancy curves, creating a P_O2-by-environment interaction in the equilibrium saturation mapping.",
      "affected_inputs": [
        "P_O2",
        "hemoglobin_variant_fraction"
      ],
      "observable_effect": "At the same P_O2 and hemoglobin_variant_fraction, samples exposed to higher carbon dioxide tension show lower saturation mainly over the mid-loading range, with little separation near zero pressure and a compressed difference near the plateau."
    },
    "diagnostic_groups": [
      {
        "name": "reduced_pressure_baseline",
        "expression": "P_O2/P50_O2",
        "role": "baseline loading coordinate relative to the characteristic half-saturation scale"
      },
      {
        "name": "variant_loading_coordinate",
        "expression": "P_O2/(P50_O2*variant_P50_ratio)",
        "role": "variant-subpopulation loading coordinate relative to its affinity scale"
      },
      {
        "name": "mixture_axis",
        "expression": "hemoglobin_variant_fraction",
        "role": "composition coordinate controlling how strongly subpopulation-specific environmental sensitivity is expressed"
      }
    ],
    "activation_condition": "Observable when equilibrated samples are compared across independently imposed carbon dioxide tensions large enough to shift effective affinity, especially for intermediate reduced pressures near the transition region; the effect is weak at very low P_O2 and vanishes as saturation approaches the bounded plateau.",
    "train_hidden_contrast": "Within training, the mechanism appears as systematic mid-range horizontal/shape shifts across imposed environment values at fixed P_O2 and composition; in holdout, the same interaction extends to unseen combinations of P_O2 and variant fraction without changing the low- and high-pressure limits.",
    "continuation_path": "Recover the parent law when carbon dioxide tension is fixed across all samples or when the new environment-coupling coefficient tends to zero, so effective affinity and cooperative shape no longer vary with that added condition.",
    "freedom_change": "add_input",
    "promoted_symbol": null,
    "promotion_reason": "The current contract holds acid-base and carbon dioxide conditions fixed, so no existing symbol can represent the known Bohr/carbamino environmental modulation. A new independently sampled static input is required to make that interaction observable in the scored equilibrium mapping rather than hidden inside refit constants.",
    "gap_statement": "The model omits sample-to-sample environmental modulation of equilibrium oxygen affinity by carbon dioxide tension, forcing all observed dissociation-curve variation to be explained only by P50_O2 and hemoglobin subpopulation composition.",
    "baseline_assumption": "Carbon dioxide tension is constant and therefore has no explicit role in the saturation curve.",
    "scientific_mechanism": "Bohr/carbamino regulation alters hemoglobin allosteric balance and effective oxygen affinity at equilibrium, shifting oxygen loading differently across the pressure range and potentially differently for baseline versus variant hemoglobin fractions.",
    "affected_symbols": [
      "P_O2",
      "P50_O2",
      "hemoglobin_variant_fraction",
      "variant_P50_ratio"
    ],
    "rationale": "The parent already maps equilibrium saturation as a weighted sum of baseline and variant Adair-like binding curves, with P_O2 varied and temperature, acidity, and carbon dioxide held fixed. A realistic next refinement is to release carbon dioxide tension as an independently varied condition because hemoglobin oxygen loading is well known to depend on it even at equilibrium. This is a changed target mapping, not merely an auxiliary interpretation: for the same P_O2 and hemoglobin_variant_fraction, the child predicts different S_O2 across carbon dioxide conditions. The concrete contrast is that higher carbon dioxide lowers effective affinity, so the saturation difference is largest around the transition region and small near both the zero-loading and high-pressure plateau limits. A single parent parameter set cannot reproduce that pattern across multiple imposed carbon dioxide tensions because the parent has no environmental input; it can only fit one common curve family over all such samples, or absorb one condition at the expense of another. The effect is scientifically admissible when carbon dioxide tension is intentionally varied while other within-sample conditions remain controlled or co-adjusted so monotone bounded saturation is preserved. If carbon dioxide is truly fixed experimentally, this mechanism cannot activate and the parent remains adequate."
  },
