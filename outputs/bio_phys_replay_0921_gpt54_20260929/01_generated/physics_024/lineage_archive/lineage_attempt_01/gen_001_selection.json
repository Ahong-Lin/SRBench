{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "Above the breakaway threshold, the parent gives a linear map from applied force to acceleration with constant slope 1/m and a constant offset from kinetic friction.",
      "child_relation": "Keep the same stick-slip structure, but replace constant kinetic friction magnitude by a speed-weakening/applied-load-dependent effective sliding resistance so the post-breakaway acceleration is no longer exactly affine in F; its slope with respect to F changes across sliding conditions.",
      "affected_inputs": [
        "F",
        "m"
      ],
      "observable_effect": "For fixed m and increasing |F| above breakaway, acceleration grows faster than the parent's straight-line prediction because the opposing sliding friction does not remain a constant magnitude over the whole sliding regime."
    },
    "diagnostic_groups": [
      {
        "name": "static_margin",
        "expression": "Abs(F)/(m*g)",
        "role": "Applied horizontal loading normalized by normal force; indicates approach to and excursion beyond frictional thresholds"
      },
      {
        "name": "signed_drive",
        "expression": "F/m",
        "role": "Bare acceleration scale from the applied force before frictional reduction"
      }
    ],
    "activation_condition": "Observable when |F| exceeds mu_s*m*g by a non-negligible margin so the block is in sliding, and across a range of suprathreshold loads large enough that assuming one constant kinetic-friction level becomes inaccurate.",
    "train_hidden_contrast": "In training, moderate suprathreshold loads can already show slight non-affine post-breakaway acceleration versus F at fixed m; in holdout, the same curvature becomes clearer at larger static_margin without changing the sticking regime below threshold.",
    "continuation_path": "Recover the parent by taking the effective sliding-friction law to a constant value mu_k independent of sliding condition, restoring a linear post-breakaway branch.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model idealizes kinetic friction as having a constant magnitude once sliding begins, giving one shared post-breakaway slope and offset for all suprathreshold forcing levels.",
    "baseline_assumption": "Static and sliding friction coefficients are constant.",
    "scientific_mechanism": "Real dry sliding contacts often show non-Coulomb kinetic friction, with effective sliding resistance varying across the sliding regime rather than remaining exactly constant after breakaway.",
    "affected_symbols": [
      "F",
      "m",
      "mu_k"
    ],
    "rationale": "Parent response relationship: for each fixed mass, acceleration is exactly zero for |F|<=mu_s*m*g, then becomes an affine antisymmetric function of F with slope 1/m and constant friction offset mu_k*g beyond threshold. A realistic next refinement is to relax only the constant-sliding-friction assumption while preserving zero acceleration in sticking and friction opposing motion. Varied conditions: sweep signed applied force F over subthreshold and suprathreshold values while holding g, mu_s, and the refined friction-law parameters fixed, and compare several masses m. Concrete contrast: at fixed m, the parent predicts that equal increments in F produce equal increments in a everywhere in the sliding regime; the child predicts changing incremental gain with |F| once sliding is active because the effective opposing friction is not constant. This is a changed target mapping, not merely an auxiliary trajectory change, since a(F,m) itself changes on the observed static relation. Admissible activation is the sliding regime with sufficiently broad suprathreshold forcing; below threshold both parent and child still give a=0, so no contrast is claimed there. A single refitted parent parameter set cannot reproduce systematic curvature of a versus F across those sliding conditions because its post-breakaway branch is constrained to be exactly linear for each m."
  },
