{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "Above the load-dependent static threshold, the parent uses a single saturating weakening law for kinetic friction that depends only on the excess force ratio Abs(F)/(m*g) minus the breakaway level, so the acceleration-force curve has one fixed post-breakaway curvature shape for all admissible loads.",
      "child_relation": "Keep the same stick-slip structure and antisymmetry, but relax the assumption that the suprathreshold weakening has one fixed saturation shape: let the effective kinetic resistance vary with normalized load m*g/N0 as well as excess force, so the post-breakaway acceleration curve changes curvature across masses or gravities even after accounting for the parent's existing static-threshold shift.",
      "affected_inputs": [
        "F",
        "m",
        "g"
      ],
      "observable_effect": "At fixed normalized force ratio just above and moderately above breakaway, light-load and heavy-load cases show different rates of approach from breakaway friction toward asymptotic sliding friction; one shared parent parameter set cannot match both the near-threshold and farther-above-threshold acceleration curvature across those load conditions."
    },
    "diagnostic_groups": [
      {
        "name": "load_ratio",
        "expression": "m*g/N0",
        "role": "dimensionless normal-load level controlling contact state"
      },
      {
        "name": "excess_ratio",
        "expression": "Abs(F)/(m*g) - (mu_s + eta*log(1 + m*g/N0))",
        "role": "dimensionless suprathreshold distance beyond breakaway"
      },
      {
        "name": "signed_drive",
        "expression": "F/(m*g)",
        "role": "normalized applied forcing setting the net acceleration branch"
      }
    ],
    "activation_condition": "Observable when Abs(F) exceeds the static threshold by an O(1/gamma) normalized excess and the explored load ratio m*g/N0 varies enough that contact-pressure effects can modify the weakening transition without violating dry-contact assumptions; the contrast is strongest for moderate suprathreshold forcing, not deep in the asymptotic large-force limit or fully stuck regime.",
    "train_hidden_contrast": "In training, varying F at several m or g values already reveals post-breakaway shape differences; in holdout, broader load ratios extend the same mechanism by changing how quickly the sliding friction approaches its asymptote after breakaway.",
    "continuation_path": "Recover the parent by taking the new load-dependence of the suprathreshold weakening shape to zero, so the weakening law depends only on excess force as in the current equation.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current law allows normal load to shift the static breakaway threshold, but it still assumes a single universal post-breakaway weakening curve for kinetic friction across all normal loads.",
    "baseline_assumption": "The mathematical form of suprathreshold kinetic-friction weakening is independent of normal load once force is measured relative to m*g and breakaway.",
    "scientific_mechanism": "Real dry contacts can have pressure-dependent evolution of the sliding contact population, causing the Stribeck-like weakening transition width or saturation rate to depend on normal load even when the asymptotic Coulomb scale remains proportional to m*g.",
    "affected_symbols": [
      "F",
      "m",
      "g",
      "beta",
      "gamma",
      "eta",
      "N0"
    ],
    "rationale": "The parent target mapping is piecewise: zero acceleration below a load-dependent breakaway threshold, then an antisymmetric sliding branch whose friction drop from breakaway to kinetic saturation has one fixed shape set by beta and gamma. A realistic next refinement is to relax that single-phase post-breakaway assumption, not to add a wholly new process. Vary m or g while holding the material parameters fixed and compare acceleration as F is swept from just above threshold to several threshold widths above it. The parent can move the threshold with eta and N0, but with one shared beta and gamma it predicts the same normalized post-breakaway curvature for all loads. The child instead allows that curvature or saturation scale to depend on load ratio m*g/N0, producing a concrete target-mapping change: two experiments with different normal loads but matched excess force ratio need not have the same acceleration increment above breakaway. This is scientifically admissible in dry sliding contacts with pressure-sensitive microcontact evolution. The effect is observable only in the sliding regime and before the weakening has fully saturated; in the stuck branch or at very large forcing the parent and child can look similar. No new input is needed because m and g already vary independently and supply the normal-load information required to expose the omitted interaction."
  },
