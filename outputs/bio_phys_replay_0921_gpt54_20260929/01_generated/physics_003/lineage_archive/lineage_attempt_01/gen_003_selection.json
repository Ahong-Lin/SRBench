{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The parent uses one pressure-ratio loss factor multiplying both the subcritical and choked branches, so at fixed p0, A, and gas properties the T0 dependence enters only through the effective gamma and a common 1/sqrt(T0) scaling.",
      "child_relation": "Refine the nonideal-loss assumption so the discharge loss also depends on thermodynamic state through a Reynolds-/viscosity-linked temperature effect, making the pressure-ratio sensitivity and the choked-flow level change with T0 beyond what gamma(T0) alone produces.",
      "affected_inputs": [
        "T0",
        "r_p"
      ],
      "observable_effect": "At fixed p0 and A, two temperatures can show similar near-unity-r_p behavior but different curvature and plateau depression as r_p decreases; the warmer case can have systematically different loss growth than the colder case, not captured by the parent's single shared loss-vs-r_p shape."
    },
    "diagnostic_groups": [
      {
        "name": "gamma_eff",
        "expression": "gamma - gamma_drop_max*(1 - exp(-(T0 - T_gamma_ref)/T_gamma_scale))",
        "role": "effective caloric property already controlling ideal compressible expansion and choking"
      },
      {
        "name": "pressure_drop_loading",
        "expression": "1 - r_p",
        "role": "nondimensional loading that drives the existing nonideal loss activation"
      },
      {
        "name": "thermal_flow_scale",
        "expression": "sqrt(T0)",
        "role": "temperature scale entering velocity, density, and likely viscous-loss similarity in the restriction"
      }
    ],
    "activation_condition": "Observable when T0 varies over a wide enough admissible range that viscosity/Reynolds-related discharge behavior changes appreciably while r_p spans from weak drop to near choking; strongest for moderate-to-strong pressure drops where the existing loss term is active.",
    "train_hidden_contrast": "Within training, modest T0 variation already perturbs the loss-curvature versus r_p; in holdout, broader T0 excursions amplify a temperature-by-pressure-ratio interaction in mass-flow suppression that the parent's separable loss factor cannot match with one parameter set.",
    "continuation_path": "Recover the parent by taking the temperature dependence of the nonideal loss to zero, so the loss factor returns to a function of r_p alone.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model treats nonideal contraction/separation loss as a function only of pressure-drop loading, even though the same geometry's effective discharge behavior also varies with thermodynamic state through transport-property changes tied to temperature.",
    "baseline_assumption": "Relax the parent assumption that the discharge-loss law has a fixed shape in r_p independent of thermodynamic state.",
    "scientific_mechanism": "Temperature-dependent transport properties change boundary-layer thickness, separation tendency, and effective vena-contracta/discharge behavior, altering how irreversible loss grows with pressure-drop loading and how much the choked-flow plateau is depressed.",
    "affected_symbols": [
      "T0",
      "r_p",
      "loss_coeff",
      "loss_exponent"
    ],
    "rationale": "Parent response relationship: at fixed p0 and A, the nonideal correction is separable, with one shared loss-vs-r_p law multiplying the ideal compressible expression; temperature changes only affect the ideal-gas/choking core through gamma_eff and the explicit 1/sqrt(T0) factor. Child change: make the loss activation itself depend on T0, producing a genuine change in the scored mapping m_dot(T0,r_p) rather than only in an auxiliary quantity. Distinguishing condition: vary T0 while holding p0, A, and gas constants fixed, and sweep r_p from near 1 toward and below the choking threshold. Then compare the curvature of m_dot versus r_p and the relative depression of the choked plateau across temperatures. A single parent parameter set cannot generally reproduce both because its loss factor has one r_p shape for all T0; refitting loss_coeff and loss_exponent only changes that shape globally, whereas the child allows the shape or strength of loss activation to vary with T0. This is scientifically admissible in steady adiabatic restriction flow when transport-property variation is appreciable; if the T0 range is narrow or the flow remains in a regime with negligible loss activation, the refinement may be weak, which should be acknowledged."
  },
