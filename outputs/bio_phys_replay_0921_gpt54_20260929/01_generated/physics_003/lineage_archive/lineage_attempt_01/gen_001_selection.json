{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With fixed gamma and R_specific, m_dot is a fixed piecewise function of pressure ratio r_p multiplied by p0*A/sqrt(T0); the subcritical branch shape and choking threshold are invariant across all runs.",
      "child_relation": "Relax the fixed-caloric-properties assumption so gamma becomes temperature-dependent within the isentropic nozzle formula, making the subcritical branch shape and effective choking behavior vary with T0 even at fixed gas identity and area.",
      "affected_inputs": [
        "T0",
        "r_p",
        "gamma"
      ],
      "observable_effect": "At fixed p0 and A, varying T0 changes more than the overall 1/sqrt(T0) scale: the sensitivity of m_dot to r_p and the curvature of the unchoked branch shift systematically, and the high-flow limiting value changes in a way a single constant-gamma parent cannot match across cold and hot conditions."
    },
    "diagnostic_groups": [
      {
        "name": "pressure_drive",
        "expression": "r_p",
        "role": "downstream-to-upstream pressure ratio controlling approach to choking"
      },
      {
        "name": "thermal_loading",
        "expression": "T0",
        "role": "reservoir temperature that would modulate caloric properties in the refinement"
      },
      {
        "name": "choke_margin_parent",
        "expression": "r_p - (2/(gamma + 1))**(gamma/(gamma - 1))",
        "role": "distance from the parent critical-pressure-ratio threshold"
      }
    ],
    "activation_condition": "Observable when T0 varies enough that caloric properties are not effectively constant over the sampled range, while the gas remains single-phase and the steady adiabatic nozzle picture remains admissible; strongest near the unchoked-to-choked transition and across broad T0 sweeps.",
    "train_hidden_contrast": "In training, the mechanism appears as temperature-dependent reshaping of the r_p-response rather than a pure amplitude rescaling; in holdout, the same effect extends to different r_p regions, especially near the parent critical threshold where curvature and limiting-flow differences become clearer.",
    "continuation_path": "Recover the parent law in the calorically perfect-gas limit where gamma is effectively constant over the sampled T0 range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current law assumes fixed caloric properties, so temperature only enters through the trivial prefactor 1/sqrt(T0) and cannot alter the pressure-ratio response shape.",
    "baseline_assumption": "The gas has fixed caloric properties and a fixed composition.",
    "scientific_mechanism": "Caloric imperfection: excitation of internal molecular modes with temperature changes the effective ratio of specific heats, which in turn changes compressible expansion and choking behavior.",
    "affected_symbols": [
      "T0",
      "r_p",
      "gamma",
      "R_specific"
    ],
    "rationale": "Parent response: at fixed A and p0, m_dot versus r_p has one invariant unchoked curve and one invariant choked plateau shape determined by a single constant gamma, while T0 only rescales all points by 1/sqrt(T0). Child response: when T0 varies and caloric properties are allowed to change, the slope d m_dot/d r_p and curvature of the unchoked branch change with T0, and the limiting choked coefficient also shifts. Concrete contrast: compare cold and hot reservoir conditions at the same p0 and A while sweeping r_p through values above and near the critical ratio. The parent with one shared constant gamma can only vertically rescale by T0 and therefore cannot reproduce a systematic temperature-dependent change in the r_p sensitivity or critical-region shape. This is a changed target mapping, not merely an auxiliary reinterpretation, because the predicted mass flow from supplied inputs changes directly. Limitation: if the admissible T0 range is narrow enough that gamma is effectively constant, the refinement collapses back to the parent and may be weakly identifiable."
  },
