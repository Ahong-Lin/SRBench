  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The scored target mapping is deta_dt = u, so at fixed observed u the parent predicts a strictly linear one-to-one kinematic slope independent of wave amplitude or stored restoring-memory state.",
      "child_relation": "Relax the exact graph-following kinematic assumption by introducing a weak amplitude-dependent metric correction in the surface-elevation rate, so the effective mapping from observed modal velocity to deta_dt acquires curvature with eta through a factor depending on eta**2.",
      "affected_inputs": [
        "u",
        "eta"
      ],
      "observable_effect": "At equal observed u but different |eta|, the child predicts slightly different deta_dt magnitudes; larger excursions give a systematically modified displacement-rate slope that the parent cannot reproduce because its target map is amplitude-independent."
    },
    "diagnostic_groups": [
      {
        "name": "kinematic_state",
