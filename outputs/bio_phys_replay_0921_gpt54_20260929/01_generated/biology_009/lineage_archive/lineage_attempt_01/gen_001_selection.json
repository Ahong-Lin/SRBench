{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The target mapping is linear in the observed states: dS_dt increases with a fixed positive gain in E through recycling_rate*E and decreases with a fixed negative gain in S through internalization_rate*S, so the contribution of the endosomal pool to surface recovery is proportional at all E.",
      "child_relation": "Replace constant endosomal recycling efficiency by a saturating endosome-to-surface return process, so the positive effect of E on dS_dt grows approximately linearly at low E but bends toward a ceiling at high E.",
      "affected_inputs": [
        "E",
        "S"
      ],
      "observable_effect": "Across trajectories that reach different endosomal loads, the child predicts diminishing marginal surface replenishment from additional E, yielding slower-than-linear recovery of dS_dt at high E compared with the parent's straight-line dependence."
    },
    "diagnostic_groups": [
      {
        "name": "total_receptor",
        "expression": "S + E",
        "role": "overall receptor load that determines whether the endosomal pool can become large enough for recycling capacity limits to matter"
      },
      {
        "name": "endo_surface_ratio",
        "expression": "E/(S + 1.0e-12)",
        "role": "relative sequestration into endosomes, indicating regimes where return flux from E substantially shapes dS_dt"
      },
      {
        "name": "surface_balance_parent",
        "expression": "receptor_production_rate - internalization_rate*S + recycling_rate*E",
        "role": "parent predicted surface-rate balance used to identify departures from linear E-driven recovery"
      }
    ],
    "activation_condition": "Observable when E spans from low values to values large enough that recycling machinery is no longer effectively first order over the sampled time course; practically, this requires appreciable endosomal accumulation from internalization while receptor_production_rate, internalization_rate, and endosomal_degradation_rate are held fixed across compared conditions.",
    "train_hidden_contrast": "In training, mild endosomal accumulation can look nearly linear; in holdout, larger transient E exposes downward curvature in the E to dS_dt relationship from saturating recycling rather than a single shared linear gain.",
    "continuation_path": "Recover the parent law in the low-occupancy limit where endosomal abundance stays well below the recycling saturation scale, making recycling effectively first order in E.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes recycling from endosomes remains first order with unlimited capacity even when the endosomal pool becomes large after altered receptor production.",
    "baseline_assumption": "Trafficking rates are constant over the modeled interval, specifically that recycling_rate represents an E-independent proportional return flux for all endosomal abundances.",
    "scientific_mechanism": "Capacity-limited endosomal sorting and recycling, where recycling machinery or carrier formation saturates as endosomal receptor load increases.",
    "affected_symbols": [
      "E",
      "recycling_rate",
      "S"
    ],
    "rationale": "A realistic next refinement is to relax the idealization of constant first-order recycling. The parent target mapping from observed states to dS_dt is affine, with a fixed slope with respect to E equal to recycling_rate. That creates a single-gain shortcut: once one parameter set is chosen, doubling E always doubles the recycling contribution to dS_dt regardless of endosomal load. Scientifically, recycling often uses finite sorting and vesicle-budding capacity, so at higher E the incremental return to the surface should diminish. The concrete distinguishing condition is to compare time windows or experiments with the same fixed receptor_production_rate, internalization_rate, and endosomal_degradation_rate but different achieved endosomal accumulation E due to different initial transients under the given ODE protocol. The parent predicts the same linear E-to-dS_dt slope everywhere, whereas the child predicts a smaller effective slope at larger E, i.e. curvature in the scored target mapping itself, not only in the auxiliary E trajectory. This contrast is admissible when internalization drives E into a moderate-to-high regime relative to recycling capacity; if E stays small throughout observations, the refinement collapses back to the parent and may be weakly identifiable."
  },
