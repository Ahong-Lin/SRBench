{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "The parent uses one shared quality relief scale inside the handling penalty, so resource_quality only shifts the effective handling time through a fixed hyperbolic factor independent of attack_rate. At fixed R, increasing attack_rate raises F toward saturation with the same quality sensitivity structure across trials.",
      "child_relation": "Relax the assumption that quality effects on processing are independent of capture tempo: under the child, the handling penalty from low resource_quality becomes stronger when attack_rate is high, creating a nonseparable attack_rate-by-resource_quality effect on the saturation scale and on the curvature of F versus attack_rate or R.",
      "affected_inputs": [
        "attack_rate",
        "resource_quality",
        "R"
      ],
      "observable_effect": "At the same R, low-quality resources depress feeding much more strongly in high-attack_rate trials than in low-attack_rate trials; equivalently, the difference in high-density plateau between good and poor quality widens with attack_rate."
    },
    "diagnostic_groups": [
      {
        "name": "encounter_load",
        "expression": "attack_rate*R",
        "role": "gross capture initiation pressure that determines how often handling overlap or rejection costs can accumulate"
      },
      {
        "name": "quality_relief",
        "expression": "1/(1 + resource_quality_half_sat*resource_quality)",
        "role": "remaining low-quality processing burden under the parent assumption"
      },
      {
        "name": "crowding_fraction",
        "expression": "R/(1 + resource_crowding_half_sat*R)",
        "role": "degree to which density-driven crowding burden is activated"
      }
    ],
    "activation_condition": "Observable when trials span both low and high encounter load attack_rate*R and also span resource_quality from near 0 to values with resource_quality_half_sat*resource_quality around or above 1; the contrast is strongest at moderate to high R where handling limits feeding.",
    "train_hidden_contrast": "In training, the mechanism appears as a modest attack_rate-dependent widening of quality effects on near-saturating feeding. In holdout with more extreme attack_rate or poorer quality, the same coupling produces a larger divergence in plateaus and curvature that the parent's single quality scale cannot match with one global parameter set.",
    "continuation_path": "Recover the parent law in the limit where the attack_rate dependence of the quality-related handling penalty vanishes, so quality modifies handling through the current fixed hyperbolic factor only.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes that resource quality alters handling by the same fractional rule regardless of how rapidly captures are initiated, omitting the realistic possibility that poor-quality items cause disproportionately more interruption, sorting, or rejection when consumers are engaging targets quickly.",
    "baseline_assumption": "Consumer hunger and handling ability are constant across trials in the specific sense that the quality-induced extension of handling time is independent of attack tempo and depends only on resource_quality through one shared half-saturation form.",
    "scientific_mechanism": "Low-quality items often require extra assessment, rejection, or partial processing, and these costs scale up when encounters are frequent because consumers more often interrupt handling, switch targets, or make suboptimal choices under high capture tempo.",
    "affected_symbols": [
      "attack_rate",
      "resource_quality",
      "handling_time",
      "quality_handling_scale",
      "resource_quality_half_sat"
    ],
    "rationale": "A realistic next refinement is to change the assumption that quality and encounter tempo affect handling independently. The parent already includes a quality-dependent handling penalty and an attack-rate-amplified crowding penalty, but the quality term itself has one fixed shape across all attack_rate conditions. Vary attack_rate and resource_quality while holding the other parameters fixed and compare feeding at moderate to high R where handling matters. In the parent, the proportional quality effect on effective handling is locked to a single hyperbolic function of resource_quality, so one shared parameter set cannot make quality differences small at low attack_rate yet substantially larger at high attack_rate except through indirect saturation shifts that also alter other regimes. The child instead makes low-quality processing costs strengthen with encounter load, changing the target mapping itself: F becomes more sensitive to resource_quality when attack_rate is high, especially near saturation. This is scientifically admissible when poor-quality items can be rejected, partially consumed, or interrupt handling more often under rapid successive encounters. The contrast is weak at very low R or very high resource_quality because handling penalties are then minimally expressed, so activation requires nontrivial encounter load and quality variation."
  },
