{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "With attack_rate varied across trials and handling_time fixed, the parent gives F = attack_rate*R/(1 + attack_rate*handling_time*R), so all conditions share one hyperbolic saturation shape controlled by a single handling threshold 1/(attack_rate*handling_time).",
      "child_relation": "Relax the assumption that post-capture processing time is constant across resource densities by allowing effective handling to lengthen with resource density due to interference among simultaneously encountered items or choice/positioning delays. Then F remains increasing and bounded but bends downward more strongly at higher R than a single constant-handling hyperbola predicts.",
      "affected_inputs": [
        "R",
        "attack_rate",
        "handling_time"
      ],
      "observable_effect": "At fixed handling_time and across independently varied attack_rate conditions, low-R slopes still scale with attack_rate, but high-R approach to saturation is slower and more curved at larger R; one shared parent parameter set cannot match both the near-linear rise and the extra late-stage flattening."
    },
    "diagnostic_groups": [
      {
        "name": "encounter_load",
        "expression": "attack_rate*handling_time*R",
        "role": "baseline Holling occupancy/load that controls departure from linear feeding"
      },
      {
        "name": "low_density_gain",
        "expression": "attack_rate*R",
        "role": "first-order encounter-limited intake scale"
      }
    ],
    "activation_condition": "Observable when attack_rate*handling_time*R spans from much less than 1 into order 1 or larger, especially at higher R where concurrent encounter pressure can make effective processing delays non-negligible while resource density is still externally maintained.",
    "train_hidden_contrast": "In training, moderate encounter_load reveals the standard rise-to-saturation transition; in holdout or extended conditions with larger R or attack_rate, the same mechanism produces stronger-than-hyperbolic downward curvature without changing the zero-at-zero or bounded monotone behavior.",
    "continuation_path": "Recover the parent law in the limit where density-dependent extension of handling is negligible over the sampled range, so effective handling tends to the constant handling_time.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current law assumes each captured resource always requires the same mean processing time regardless of how many resources are simultaneously encountered at higher densities.",
    "baseline_assumption": "Consumer hunger and handling ability are constant across trials, interpreted mathematically as a resource-density-independent handling_time within each observation.",
    "scientific_mechanism": "At higher resource densities, consumers can experience crowding of capture opportunities, suboptimal choice, repositioning, or partial overlap among attempted captures that increases effective per-item processing burden beyond a constant mean handling time.",
    "affected_symbols": [
      "R",
      "attack_rate",
      "handling_time"
    ],
    "rationale": "A realistic next refinement is to change the constant-handling assumption rather than add a separate omitted process. The parent already includes encounter and processing limitation, but it compresses all post-capture effects into one fixed handling_time, forcing a single-threshold hyperbola. Here the experimentally varied inputs are R and attack_rate, with handling_time held fixed as a parameter. Under admissible conditions where attack_rate*handling_time*R is small, parent and child should agree closely because feeding is encounter-limited. When R is increased so attack_rate*handling_time*R reaches order 1 or larger, the child predicts additional downward curvature: feeding stays nonnegative, zero at R=0, bounded, and nondecreasing, but saturates more gradually than the parent. A single refitted parent parameter set cannot reproduce both the low-density slope determined by attack_rate and the stronger high-density flattening across these same conditions, because changing constant handling_time shifts one hyperbolic scale but does not create density-dependent curvature within a condition. This is observable directly in the scored static F(R, attack_rate) mapping, not merely in auxiliary trajectories."
  },
