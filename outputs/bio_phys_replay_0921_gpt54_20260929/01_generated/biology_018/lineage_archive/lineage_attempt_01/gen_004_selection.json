{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "asymptotic_change",
      "parent_relation": "At fixed attack_rate, F rises monotonically with R and approaches a single handling-limited plateau determined by attack_rate and an effective handling time whose crowding extension saturates with R.",
      "child_relation": "At fixed attack_rate, F still rises monotonically with R, but the high-R approach to saturation depends on resource profitability/quality because low-quality resources impose longer effective processing than high-quality ones, shifting both curvature and the asymptotic feeding ceiling across trials.",
      "affected_inputs": [
        "R",
        "attack_rate"
      ],
      "observable_effect": "Across trials with similar attack_rate but different latent resource profitability conditions, the same low-to-intermediate density slope can lead to different high-density plateaus; the parent can only move these together through one shared handling scale."
    },
    "diagnostic_groups": [
      {
        "name": "encounter_load",
        "expression": "attack_rate*R",
        "role": "gross capture-initiation pressure before handling limitation"
      },
      {
        "name": "crowding_fraction",
        "expression": "resource_crowding_half_sat*R/(1 + resource_crowding_half_sat*R)",
        "role": "extent to which density-dependent crowding contribution has approached saturation"
      },
      {
        "name": "baseline_processing_share",
        "expression": "attack_rate*handling_time*R",
        "role": "share of denominator due to low-crowding handling alone"
      }
    ],
    "activation_condition": "Visible when resource types or trial conditions alter average profitability/processing burden over a range where attack_rate*R is large enough for handling limitation to matter; especially at moderate-to-high R where asymptotic differences can be resolved.",
    "train_hidden_contrast": "In training, variation in attack_rate and R already reveals the onset of handling limitation; in holdout, extending to conditions with stronger differences in average resource profitability exposes that curves with comparable low-R rise can separate more strongly at high R than the parent allows.",
    "continuation_path": "Recover the parent when resource profitability is effectively constant across all trials, so the added heterogeneity dependence collapses to a single shared handling law.",
    "freedom_change": "add_input",
    "promoted_symbol": null,
    "promotion_reason": "Existing inputs R and attack_rate cannot distinguish whether changes in saturation come from encounter pressure or from trial-to-trial differences in average resource profitability/processing burden. A new independently sampled static input is needed to represent that experimentally varied resource-quality condition.",
    "gap_statement": "The current model assumes all resources are equally detectable and profitable, so one shared handling law applies to every trial even when resource quality differences could change post-capture processing time and thus the saturation ceiling.",
    "baseline_assumption": "Resources are equally detectable and profitable.",
    "scientific_mechanism": "Resource quality/profitability heterogeneity alters effective handling duration per captured item, with poorer or more difficult items taking longer to subdue, consume, or reject, thereby lowering the high-density feeding plateau without requiring a different encounter process.",
    "affected_symbols": [
      "R",
      "attack_rate",
      "handling_time"
    ],
    "rationale": "A realistic next refinement is to relax equal profitability rather than add an unrelated new process. The parent target mapping has a single shared saturation structure: once attack_rate and R are given, all trial-to-trial differences must be absorbed into the same handling_time and crowding parameters. If experiments vary average resource quality while holding consumer identity, observation interval, and resource density protocol fixed, then two conditions can show similar low-R increase with R but different high-R plateaus because poor-quality items take longer to process after encounter. This is a direct change in the scored mapping F(R, attack_rate, quality), not merely an auxiliary trajectory change. The effect is admissible and observable when R is high enough that handling limits feeding, while low-R behavior may remain similar because encounters are still scarce. A single parent parameter set cannot reproduce condition-specific asymptotes across such quality conditions unless it is allowed to refit handling_time separately by condition, which is exactly the omitted freedom. The limitation is that if quality does not vary or only varies negligibly over the sampled regime, the added input would not activate and the parent is adequate."
  },
