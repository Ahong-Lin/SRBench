{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "phase_shift",
      "parent_relation": "With vacuum propagation, the transition probability depends only on the single oscillation phase kappa_osc*delta_m2*L/E_nu and amplitude sin(2*theta_mix)**2, so for fixed theta_mix and delta_m2 the L/E_nu pattern is universal.",
      "child_relation": "Relax the vacuum assumption to propagation in a constant matter background, where the effective mixing angle and oscillation phase are altered by the medium; the target mapping gains an environment-dependent phase and amplitude distortion relative to the vacuum L/E_nu curve.",
      "affected_inputs": [
        "L",
        "E_nu",
        "theta_mix",
        "delta_m2"
      ],
      "observable_effect": "At fixed theta_mix and delta_m2, scanning E_nu at fixed L no longer follows one universal vacuum sinusoid: oscillation extrema shift in E_nu and the conversion peak height is modified by the medium."
    },
    "diagnostic_groups": [
      {
        "name": "vac_phase",
        "expression": "kappa_osc*delta_m2*L/E_nu",
        "role": "parent vacuum oscillation phase controlling extrema locations"
      },
      {
        "name": "mix_amp",
        "expression": "sin(2*theta_mix)**2",
        "role": "parent vacuum conversion amplitude"
      },
      {
        "name": "baseline_ratio",
        "expression": "L/E_nu",
        "role": "control coordinate for comparing vacuum-universal versus medium-distorted oscillation patterns"
      }
    ],
    "activation_condition": "Observable when the matter-induced forward-scattering potential is not negligible compared with delta_m2/(2*E_nu), over long baselines and suitable energies; in dilute matter or short-baseline/high-delta_m2 limits the vacuum law is recovered.",
    "train_hidden_contrast": "The same coherent two-state oscillation pattern remains visible in training, but in the extended regime of longer baselines or energies where matter effects compete with the vacuum term, the extrema positions and peak heights depart systematically from a single vacuum L/E_nu curve.",
    "continuation_path": "Taking the matter potential to zero recovers the parent vacuum oscillation probability exactly.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current law assumes propagation in vacuum, omitting refractive phase and effective mixing changes induced by coherent forward scattering in matter.",
    "baseline_assumption": "Propagation occurs in vacuum.",
    "scientific_mechanism": "MSW-type matter modification of two-flavor neutrino oscillations in a constant-density medium.",
    "affected_symbols": [
      "L",
      "E_nu",
      "theta_mix",
      "delta_m2",
      "kappa_osc"
    ],
    "rationale": "Parent response relationship: for fixed theta_mix and delta_m2, varying L and E_nu only through L/E_nu produces a universal sinusoidal conversion pattern with fixed peak height sin(2*theta_mix)**2 and extrema set by one shared phase scale. Proposed child change: relax the vacuum assumption so the medium alters both effective phase accumulation and effective mixing. Distinguishing condition: hold theta_mix and delta_m2 fixed, compare short/dilute versus long/medium-affected propagation while varying E_nu at fixed L. In the parent, one shared parameter set predicts the same vacuum sinusoid in both conditions because the target depends only on L/E_nu. In the child, the medium causes an energy-dependent shift of extrema and a change in peak conversion strength, which a single refit of the vacuum amplitude and phase constant cannot reproduce across both conditions simultaneously. This is a true target-mapping change, not merely an auxiliary trajectory change, because the scored probability-versus-input relation itself is altered. The refinement is scientifically admissible when coherent propagation still holds and matter density can be approximated as constant along the path; if matter effects are negligible, the contrast disappears and the parent is the correct limit."
  },
