{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed E_total and I, v_instantaneous increases hyperbolically with S using a single inhibitor-independent K_m term modified only by inhibitor occupancy, so the normalized substrate-response shape is the same apart from the competitive right-shift in apparent affinity.",
      "child_relation": "Retain competitive inhibition but relax the assumption that substrate binding remains ideal at all substrate loads by allowing weak substrate self-crowding/self-inhibition in the substrate-dependent denominator contribution, so the rate bends downward relative to the parent at high S even when I is fixed.",
      "affected_inputs": [
        "S",
        "I",
        "E_total"
      ],
      "observable_effect": "When I and E_total are held fixed and S is swept into a regime comparable to or above K_m, the child predicts a weaker approach to saturation than the parent; across low-S and high-S portions of the same sweep, one shared parent parameter set cannot match both the initial rise and the extra high-S flattening."
    },
    "diagnostic_groups": [
      {
        "name": "substrate_load",
        "expression": "S/K_m",
        "role": "dimensionless substrate-occupancy scale controlling departure from ideal Michaelis behavior"
      },
      {
        "name": "inhibitor_load",
        "expression": "I/K_i",
        "role": "dimensionless competitive inhibitor loading"
      },
      {
        "name": "binding_competition",
        "expression": "K_m*(1 + I/K_i + inhibitor_nonlinearity*(I/K_i)**2)/S",
        "role": "relative weight of competitive binding penalty versus substrate level"
      }
    ],
    "activation_condition": "Observable when substrate is varied from sub-K_m to several-fold K_m while inhibitor remains in a reversible initial-rate regime; the refinement is most visible at moderate-to-high substrate load where ideal Michaelis saturation begins to fail but finite initial-rate assumptions still hold.",
    "train_hidden_contrast": "In training, moderate S already shows slight downward deviation from the parent's simple hyperbola; in holdout at higher S with similar I and E_total, the same mechanism produces stronger flattening rather than a mere rescaling.",
    "continuation_path": "Recover the parent law in the limit of vanishing substrate self-crowding/self-inhibition strength.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the substrate contribution to the rate law stays ideal Michaelis-Menten at all admissible substrate concentrations, with non-ideality allowed only on the inhibitor side.",
    "baseline_assumption": "Relax the assumption that substrate binding/turnover remains perfectly first-order in the denominator contribution with respect to substrate load over the whole initial-rate sweep.",
    "scientific_mechanism": "Weak substrate self-inhibition or substrate-induced crowding of productive enzyme binding causes the effective substrate-response curve to flatten at high substrate concentration even before leaving the initial-rate regime.",
    "affected_symbols": [
      "S",
      "K_m",
      "I",
      "K_i",
      "inhibitor_nonlinearity"
    ],
    "rationale": "A realistic next refinement is to modify the substrate-side idealization rather than adding a new species. The parent already captures reversible competitive inhibition and a nonlinear inhibitor occupancy penalty, but at fixed I and E_total it still enforces a single Michaelis-type substrate saturation shape. In many enzyme assays, sufficiently high substrate can weakly reduce productive turnover or productive binding through self-inhibition/crowding without requiring product buildup or time dependence. The distinguishing condition is a substrate sweep with I held fixed at low or moderate reversible values and E_total held fixed: the parent predicts a standard hyperbolic rise whose curvature is fully determined by one apparent affinity term, whereas the child predicts additional downward curvature at higher S. This changes the scored mapping v(S,I,E_total), not merely an auxiliary trajectory. The effect is admissible only when S reaches order K_m or above; if all data remain far below K_m, the refinement would be poorly identifiable, which is a limitation."
  },
