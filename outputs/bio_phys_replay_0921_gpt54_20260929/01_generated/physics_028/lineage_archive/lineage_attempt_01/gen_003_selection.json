{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_phase",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The parent treats the weak-field relativistic effect as a first-order factor in 3*G*M_c/(r*c**2), multiplied with the oblateness factor, so at fixed J2 it produces essentially one shared low-order curvature of T versus r and M_c.",
      "child_relation": "Refine the relativistic circular-orbit assumption from a truncated weak-field factor to the exact Schwarzschild circular-orbit dependence while keeping the same static circular-orbit setting; this changes how rapidly T bends as compactness G*M_c/(r*c**2) grows, especially at smaller r and larger M_c.",
      "affected_inputs": [
        "r",
        "M_c",
        "c"
      ],
      "observable_effect": "At fixed J2 and R_eq, the period rises above the parent prediction more sharply as r decreases toward a few gravitational radii; the child shows stronger compactness-driven curvature in T(r,M_c) that a single parent parameterization cannot match simultaneously at weak and stronger compactness."
    },
    "diagnostic_groups": [
      {
        "name": "compactness",
        "expression": "G*M_c/(r*c**2)",
        "role": "dimensionless relativistic field strength controlling deviation from Newtonian circular-orbit timing"
      },
      {
        "name": "oblateness_scale",
        "expression": "J2*(R_eq/r)**2",
        "role": "dimensionless quadrupole correction scale that remains separable in the parent and can be held fixed to isolate the relativistic refinement"
      }
    ],
    "activation_condition": "Observable when compactness G*M_c/(r*c**2) is not asymptotically tiny but still below the circular-orbit existence limit, with weak-to-moderate oblateness correction so the orbit remains circular and the static approximation is meaningful; negligible in the far-field limit.",
    "train_hidden_contrast": "In training, variation over r and M_c already changes compactness; in holdout, smaller r or larger M_c extends the same compactness trend and exposes the stronger curvature of the exact relativistic mapping rather than a new force.",
    "continuation_path": "As G*M_c/(r*c**2) -> 0, the refined relativistic factor expands back to the parent's weak-field form, recovering the parent law to leading order.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current equation includes relativity only through a low-order weak-field correction, which omits the known stronger nonlinear dependence of exact circular-orbit timing on compactness in a static spherically symmetric field.",
    "baseline_assumption": "The relativistic correction is adequately represented by the first-order weak-field factor (1 - 3*G*M_c/(r*c**2)) within the circular-orbit period formula.",
    "scientific_mechanism": "Exact Schwarzschild circular-orbit kinematics make the period depend nonlinearly on compactness beyond first order, producing stronger bending of the period-radius relation near compact central masses.",
    "affected_symbols": [
      "r",
      "M_c",
      "c",
      "G",
      "J2",
      "R_eq"
    ],
    "rationale": "The parent response maps T from r and M_c through a Newtonian r^(3/2)/sqrt(M_c) trend times a low-order multiplicative correction from oblateness and relativity. A realistic next refinement is to relax only the relativistic truncation already present, not to add a new force. Hold J2, R_eq, and c fixed and vary r and M_c: the parent predicts a single weak-field compactness dependence, whereas the child predicts a steeper increase in T as compactness grows. This is a changed target mapping, not merely an auxiliary reinterpretation, because the scored output T itself acquires different curvature versus the supplied inputs. The contrast is scientifically admissible for circular orbits outside the strong-field breakdown region; in the far field the effect becomes small and the parent is recovered. A single shared parent form cannot reproduce both the weak-field behavior and the stronger compactness-induced curvature across those conditions because its relativistic dependence is fixed to the first-order structure."
  },
