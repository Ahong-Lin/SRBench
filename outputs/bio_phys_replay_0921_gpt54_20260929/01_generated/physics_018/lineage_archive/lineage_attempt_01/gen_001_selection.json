{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The restoring contribution to dv_dt is linear in displacement, dv_dt = -phonon_frequency**2*Q - damping_rate*v, so at fixed v the acceleration varies with a single constant slope in Q.",
      "child_relation": "Relax the harmonic-potential assumption so the restoring force acquires amplitude dependence from lattice anharmonicity; at fixed v, dv_dt becomes a nonlinear function of Q with displacement-dependent slope/curvature while still pointing toward equilibrium for admissible amplitudes.",
      "affected_inputs": [
        "Q",
        "v"
      ],
      "observable_effect": "Across trajectories with different prepared phonon amplitudes but the same material coefficients and damping, the child predicts amplitude-dependent softening or stiffening of the restoring acceleration, visible as non-elliptic phase portraits and amplitude-dependent oscillation period/peak acceleration that one shared linear spring constant cannot match."
    },
    "diagnostic_groups": [
      {
        "name": "restoring_branch",
        "expression": "phonon_frequency**2*Q",
        "role": "baseline linear restoring acceleration coordinate"
      },
      {
        "name": "phase_plane",
        "expression": "Q**2 + (v/phonon_frequency)**2",
        "role": "oscillation amplitude proxy for comparing small- and larger-excursion trajectories"
      }
    ],
    "activation_condition": "Observable when the coherent displacement is large enough that anharmonic corrections to the lattice potential are no longer negligible but still small enough that the potential remains single-well and damping stays dissipative; practically, compare low-amplitude and moderate-amplitude trajectories under the same post-preparation environment.",
    "train_hidden_contrast": "Within training, moderate excursions already bend the dv_dt-versus-Q relation away from a single line; in holdout, larger but still stable excursions extend the same amplitude-dependent curvature rather than introducing a new mechanism.",
    "continuation_path": "In the small-amplitude limit, or as the anharmonic coefficient tends to zero, the restoring force reduces to the parent harmonic law.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent assumes an exactly harmonic lattice restoring potential over the full sampled displacement range, omitting the first physically relevant anharmonic correction to coherent optical-phonon motion.",
    "baseline_assumption": "The restoring potential is harmonic.",
    "scientific_mechanism": "Lattice anharmonicity modifies the phonon restoring force at finite displacement, producing amplitude-dependent oscillation frequency and acceleration curvature without external driving.",
    "affected_symbols": [
      "Q",
      "v",
      "phonon_frequency"
    ],
    "rationale": "A realistic next refinement is to relax the exactly harmonic restoring-force assumption rather than adding a new bath or drive. Hold fixed the material coefficients and damping environment along each trajectory, and vary only the prepared initial amplitude already admissible in coherent-phonon experiments. The parent then maps Q to restoring acceleration with one constant slope, so after subtracting damping the dv_dt-versus-Q relation is a straight line for all amplitudes. An anharmonic child changes the target mapping itself: the slope of dv_dt with respect to Q depends on Q, giving measurable curvature in acceleration-displacement data and amplitude-dependent period or peak acceleration. A single shared parent parameter set cannot reproduce both small-amplitude near-harmonic motion and moderate-amplitude softened/stiffened motion across those conditions, because refitting phonon_frequency only changes one global linear slope. This refinement is scientifically admissible provided excursions remain centered around the same equilibrium and do not cross into structural instability; if all observed amplitudes are truly infinitesimal, the contrast will be weak and the parent remains an effective approximation."
  },
