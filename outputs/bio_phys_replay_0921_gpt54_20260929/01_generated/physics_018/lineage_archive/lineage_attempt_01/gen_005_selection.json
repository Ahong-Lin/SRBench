{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The damping contribution to dv_dt is linear in v with an effective coefficient damping_rate + amplitude_dependent_damping*y, so at fixed Q and y the target changes with a single constant slope in v.",
      "child_relation": "Replace the linear viscous damping assumption by a velocity-saturating dissipative law so that, at fixed Q and y, the damping-induced part of dv_dt remains odd and opposing motion but its slope with respect to v decreases at larger |v|.",
      "affected_inputs": [
        "v",
        "Q",
        "y",
        "amplitude_dependent_damping",
        "damping_rate"
      ],
      "observable_effect": "Large-amplitude ringdown segments with high velocity show weaker-than-linear additional deceleration versus |v|, while small-velocity late-time dynamics remain close to the parent linear damping behavior."
    },
    "diagnostic_groups": [
      {
        "name": "effective_linear_damping",
        "expression": "damping_rate + amplitude_dependent_damping*y",
        "role": "Current parent damping strength multiplying v"
      },
      {
        "name": "velocity_excursion",
        "expression": "Abs(v)",
        "role": "Magnitude of instantaneous phonon speed where drag-law curvature would appear"
      },
      {
        "name": "amplitude_activation",
        "expression": "Q**2/(damping_saturation_scale + Q**2)",
        "role": "Displacement-controlled activation level of the delayed damping channel"
      }
    ],
    "activation_condition": "Observable when trajectories reach a regime with substantial delayed damping activation y and sufficiently large |v| during early or intermediate ringdown, while remaining in the post-preparation undriven decay scenario.",
    "train_hidden_contrast": "In training, moderate excursions can reveal nearly linear damping near v≈0 and the onset of drag-law bending at larger |v|; in holdout, stronger initial oscillations extend the same monotone curvature change without introducing a different mechanism.",
    "continuation_path": "Recover the parent law in the limit where the velocity-saturation scale is large compared with all observed |v|, so the damping law reduces to the existing linear-in-v form.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The current model assumes the dissipative force is exactly proportional to velocity even when the anharmonically activated decay channel is strongly engaged, omitting plausible saturation of frictional energy transfer at high phonon speed.",
    "baseline_assumption": "Damping is linear in the phonon velocity for all post-preparation excursions.",
    "scientific_mechanism": "Finite-rate anharmonic scattering into bath modes can make the effective friction law sublinear at high instantaneous phonon velocity, while still remaining odd in v and strictly dissipative.",
    "affected_symbols": [
      "v",
      "Q",
      "y",
      "damping_rate",
      "amplitude_dependent_damping"
    ],
    "rationale": "A realistic next refinement is to relax the parent's globally linear damping assumption rather than add a new process. The parent target mapping is dv_dt = restoring(Q) minus an effective damping coefficient times v, so for fixed Q and y every v-slice is a straight line with one slope. That is a single-gain shortcut. A scientifically natural child keeps the same delayed damping state y and the same restoring-force structure, but changes the damping law so the target's dependence on v bends at larger speed. The varied condition is the accessible velocity magnitude along trajectories, especially comparing early high-speed oscillation segments against late low-speed segments, while material parameters and the post-preparation environment are held fixed across each trajectory. Under admissible strong-preparation conditions, y can be appreciable and |v| can transiently be large; then the child predicts weaker incremental deceleration per added speed than the parent. A single refitted parent parameter set cannot reproduce both the near-origin linear slope and the reduced large-|v| slope across those conditions, because its v-dependence is exactly linear once Q and y are specified. This changes the scored target mapping itself, not merely an auxiliary trajectory. The limitation is that if all observed trajectories stay in a small-|v| regime, the refinement becomes hard to distinguish and effectively collapses back to the parent."
  },
