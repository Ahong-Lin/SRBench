{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The scored target mapping is deta_dt = u, so for observed trajectories the parent treats the displacement rate as exactly linear in the supplied modal velocity, independent of free-surface steepness except indirectly through the auxiliary evolution of u.",
      "child_relation": "Retain kinematic coupling but relax the small-slope graph assumption so the vertical surface-displacement rate depends on the local free-surface normal geometry of the single mode, making deta_dt a nonlinear function of both u and eta through steepness.",
      "affected_inputs": [
        "u",
        "eta",
        "mode_wavenumber"
      ],
      "observable_effect": "Holding u fixed while varying |mode_wavenumber*eta|, the child predicts reduced vertical displacement rate relative to u at larger steepness, whereas the parent always gives the same deta_dt = u."
    },
    "diagnostic_groups": [
      {
        "name": "steepness",
        "expression": "mode_wavenumber*eta",
        "role": "dimensionless modal free-surface slope scale controlling departure from small-slope kinematics"
      },
      {
        "name": "kinematic_pair",
        "expression": "u/(1 + (mode_wavenumber*eta)**2)",
        "role": "candidate geometry-reduced displacement-rate scale under finite-slope kinematics"
      }
    ],
    "activation_condition": "Observable when the modal steepness |mode_wavenumber*eta| is not negligible but remains within non-breaking single-mode conditions, e.g. moderate O(0.1-1) steepness with finite depth and bounded oscillations.",
    "train_hidden_contrast": "In training, weakly nonlinear restoring dynamics already create trajectories where eta and u vary jointly; extending to moderate steepness reveals that samples with similar u but different |mode_wavenumber*eta| have different deta_dt, exposing target curvature absent from the parent.",
    "continuation_path": "Recover the parent law in the small-slope limit |mode_wavenumber*eta| << 1, where the geometric correction tends to 1 and deta_dt -> u.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The target equation keeps the kinematic relation exact only under the small-slope surface-graph approximation, even though the system already includes weakly nonlinear finite-amplitude geometry in the restoring force.",
    "baseline_assumption": "The parent assumes the modal vertical displacement rate equals the modal velocity amplitude exactly, independent of instantaneous surface steepness.",
    "scientific_mechanism": "Finite-slope free-surface kinematics: for a single-mode interface represented as a graph, the vertical motion of the surface is reduced relative to the along-mode velocity amplitude by geometric projection when slope is no longer asymptotically small.",
    "affected_symbols": [
      "eta",
      "u",
      "mode_wavenumber"
    ],
    "rationale": "A natural next refinement is to make the scored target itself respond to the same finite-amplitude geometry already admitted in the auxiliary restoring term. Vary the observed state pair (eta,u) along trajectories while holding mode_wavenumber and fluid_depth fixed. In the parent, any two observations with the same u produce identical deta_dt regardless of eta, so the target mapping has a fixed-environment shortcut with respect to steepness. In the child, observations with equal u but different |mode_wavenumber*eta| produce different deta_dt, introducing measurable curvature in the target mapping. This is scientifically admissible in the moderate-steepness, non-breaking regime already suggested by the existing weakly nonlinear correction. The contrast is a true change in the scored mapping, not merely an auxiliary-trajectory modification. A single parent parameter refit cannot reproduce this across conditions because no parameter in deta_dt = u can create dependence on eta once u is supplied to the solver; the parent always predicts unit slope with respect to u and zero dependence on eta."
  },
