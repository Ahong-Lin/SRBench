{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_threshold",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The inhibitory sensor activates with a linear calcium dependence k_sensor_activation*C*(1-H), so at fixed H the suppression pathway strength grows with a single low-calcium slope and no intrinsic activation threshold curvature.",
      "child_relation": "Replace the linear calcium dependence of sensor activation by a steeper saturating calcium dependence so that inhibition accumulates weakly at very low C and disproportionately faster once C reaches a moderate activation range.",
      "affected_inputs": [
        "C",
        "H",
        "k_sensor_activation"
      ],
      "observable_effect": "Across fixed stimulus_strength with identical initial conditions, low-amplitude calcium elevations produce less inhibition buildup than in the parent, while moderate elevations trigger earlier and stronger delayed suppression, changing pulse width and the onset of oscillation termination."
    },
    "diagnostic_groups": [
      {
        "name": "release_drive",
        "expression": "stimulus_strength*(1 - H)/(1 + release_inactivation_scale*C)",
        "role": "Instantaneous stimulus-gated release drive after direct inhibition"
      },
      {
        "name": "sensor_load",
        "expression": "C",
        "role": "Calcium level currently driving inhibitory sensor activation"
      },
      {
        "name": "net_buffer_sink",
        "expression": "k_buffer_bind*C*(1 - B)/(1 + buffer_binding_scale*C) - k_buffer_unbind*B",
        "role": "Instantaneous reversible buffering sink strength"
      }
    ],
    "activation_condition": "Observable when C traverses a low-to-moderate range during transients or oscillations, so that sensor activation is neither always near zero nor always fully saturated; especially when stimulus_strength is large enough for CICR to lift C into this regime but clearance and inactivation still terminate excursions.",
    "train_hidden_contrast": "In training, the same mechanism changes how H accumulates during ordinary calcium pulses; in holdout, the contrast extends to stronger pulses where the steeper activation curvature produces earlier shutdown and altered oscillation envelopes.",
    "continuation_path": "The parent law is recovered in the limit where the refined sensor-activation nonlinearity reduces to linear dependence on C over the sampled range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The inhibitory sensor is assumed to respond proportionally to cytosolic calcium at all low-to-moderate concentrations, omitting the common cooperative or saturating occupancy needed to represent a delayed feedback branch with a sharper calcium sensitivity.",
    "baseline_assumption": "Sensor activation rate is linear in free calcium concentration with one fixed slope and no intrinsic curvature or threshold-like occupancy effect.",
    "scientific_mechanism": "Cooperative calcium binding or multistep occupancy in the inhibitory sensor, causing nonlinear accumulation of the active inhibitory fraction as calcium rises.",
    "affected_symbols": [
      "C",
      "H",
      "k_sensor_activation",
      "k_sensor_relaxation"
    ],
    "rationale": "A realistic next refinement is to relax the parent's linear sensor-activation law rather than adding a new process. The parent target mapping from observed states to dC_dt uses H as the only delayed inhibitor, but H itself is generated from a single-slope calcium response. Vary stimulus_strength while holding all other parameters and initial conditions fixed. In the parent, stronger stimuli mainly scale the amplitude and duration of C excursions, and H accumulation follows proportionally because dH_dt has no activation curvature beyond the (1-H) occupancy factor. In a child with cooperative or saturating calcium dependence of sensor activation, small calcium excursions generated under weaker stimulus produce noticeably less H buildup than predicted by the parent, whereas moderate excursions generated under stronger stimulus cross into a steeper activation range and suppress release sooner. This changes the scored mapping indirectly but consequentially through H, because the observed dC_dt at the same C and H trajectory history now comes from a differently curved H evolution that feeds back onto release. The contrast is scientifically admissible when calcium pulses reach the sensor's activation range; if C stays uniformly tiny or uniformly very high, the refinement becomes hard to distinguish. A single refitted parent parameter set cannot generally match both weak-response underactivation and moderate-response sharp feedback onset across those conditions, because changing k_sensor_activation only rescales one linear slope instead of introducing the needed curvature."
  },
