{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "The acceleration is an affine linear combination of displacement and velocity, dv_dt = -(spring_stiffness/mass)*x - (damping_coefficient/mass)*v, so at fixed v the slope with respect to x is constant.",
      "child_relation": "Relax the linear-spring assumption so the restoring force stiffens with amplitude, making dv_dt depend nonlinearly on x while keeping damping opposing motion and equilibrium at x=0 unchanged.",
      "affected_inputs": [
        "x",
        "v",
        "spring_stiffness"
      ],
      "observable_effect": "For larger |x| at similar v, the magnitude of restoring acceleration grows faster than linearly, producing amplitude-dependent curvature in dv_dt versus x that is absent in the parent."
    },
    "diagnostic_groups": [
      {
        "name": "disp_vel_plane",
        "expression": "x*v",
        "role": "Separates turning-point regions from high-speed crossing regions when comparing restoring and damping contributions."
      },
      {
        "name": "amplitude_scale",
        "expression": "x**2",
        "role": "Measures departure from the small-displacement regime where linear Hooke response is valid."
      },
      {
        "name": "parent_accel_core",
        "expression": "-(spring_stiffness/mass)*x - (damping_coefficient/mass)*v",
        "role": "Baseline linear target mapping to compare against amplitude-dependent restoring curvature."
      }
    ],
    "activation_condition": "Observable when sampled trajectories include displacements large enough that spring extension leaves the strictly linear Hooke regime, while damping remains dissipative and motion stays bounded; the effect is weakest near x=0.",
    "train_hidden_contrast": "In training, modest amplitude variation would already show small systematic curvature in acceleration versus displacement; in holdout with larger initial displacement magnitudes but the same fixed damping and mass, the deviation strengthens as faster-than-linear restoring acceleration.",
    "continuation_path": "Recover the parent law in the small-amplitude limit where nonlinear spring corrections vanish over the sampled displacement range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes the spring response stays exactly linear over all sampled displacements, omitting realistic amplitude-dependent stiffness of a mechanical spring outside the strict small-deflection regime.",
    "baseline_assumption": "The spring response is linear over the sampled displacements.",
    "scientific_mechanism": "Weak conservative geometric/material nonlinearity in the spring restoring force, such as Duffing-type hardening stiffness.",
    "affected_symbols": [
      "x",
      "v",
      "spring_stiffness",
      "mass"
    ],
    "rationale": "A natural next refinement is to relax the idealized linear restoring-force assumption rather than add a new dissipation channel. The parent target mapping has a single constant displacement gain: at any fixed velocity, changing x changes dv_dt with the same slope everywhere. If initial displacement is varied while mass, linear damping strength, and the equilibrium location are held fixed, a weak hardening spring gives a concrete contrast: near x=0 the acceleration-displacement relation remains close to linear, but at larger |x| the restoring acceleration becomes steeper, so turning points at larger amplitudes show disproportionately larger inward acceleration than a single globally refit linear spring can reproduce. This is a true change in the scored target mapping dv_dt(x,v), not merely an auxiliary-state effect. The admissible regime is underdamped bounded motion with nonincreasing mechanical energy; a conservative odd-in-x spring nonlinearity preserves zero equilibrium, and linear damping still opposes motion. A single refit of spring_stiffness and damping_coefficient cannot match both the near-origin slope and the stronger large-amplitude restoring curvature across trajectories with different initial amplitudes, because the parent remains exactly linear in x."
  },
