{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "single_gain",
    "response_change": {
      "type": "curvature_change",
      "parent_relation": "At fixed P, autonomic drive S changes cardiac delivery and peripheral resistance with constant linear gains, so the target mapping dP_dt versus S has one fixed curvature set only by the reciprocal runoff term.",
      "child_relation": "Relax the linear vascular actuation assumption so that the resistance effect of S saturates at high drive, making the target mapping dP_dt versus S bend more strongly at low to moderate S and flatten at high S.",
      "affected_inputs": [
        "P",
        "S"
      ],
      "observable_effect": "During trajectories that transiently span low and high autonomic drive, pressure recovery becomes initially more sensitive to S but shows diminishing additional pressor effect near maximal drive, compared with the parent's continued near-linear increase in vasomotor effect."
    },
    "diagnostic_groups": [
      {
        "name": "runoff_load",
        "expression": "P/(peripheral_resistance_baseline + peripheral_resistance_gain*S)",
        "role": "Current parent peripheral runoff term opposing pressure rise"
      },
      {
        "name": "autonomic_level",
        "expression": "S",
        "role": "Instantaneous vasomotor activation level that may enter a saturating effector law"
      },
      {
        "name": "pressure_drive_balance",
        "expression": "cardiac_delivery_baseline + cardiac_delivery_gain*S - P/(peripheral_resistance_baseline + peripheral_resistance_gain*S)",
        "role": "Net arterial filling tendency whose dependence on S gains new curvature under the refinement"
      }
    ],
    "activation_condition": "Observable when the trajectory visits a broad enough S range, especially moderate-to-high vasomotor drive where further resistance recruitment should taper rather than increase indefinitely; P must remain positive and within the sampled transient recovery range.",
    "train_hidden_contrast": "In training, low-to-moderate S still resembles the parent law, but holdout segments reaching stronger sympathetic activation reveal diminishing incremental pressure support from additional S that one shared linear-gain parent cannot match simultaneously with the low-S slope.",
    "continuation_path": "Recover the parent law in the limit where the saturation scale is large enough that the saturating resistance law is effectively linear over the observed S range.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The model assumes autonomic vasomotor drive recruits peripheral resistance with a constant gain across the full normalized drive range, omitting physiological saturation of vasoconstrictor effect.",
    "baseline_assumption": "Cardiac and vascular effects of autonomic drive are instantaneous relative to the modeled neural adjustment time.",
    "scientific_mechanism": "Finite vascular smooth-muscle and arteriolar receptor recruitment causes diminishing additional peripheral resistance at high autonomic drive even while neural drive S continues to increase.",
    "affected_symbols": [
      "P",
      "S"
    ],
    "rationale": "A realistic next refinement is to keep the same states and feedback architecture but replace the linear S-to-resistance mapping with a saturating monotone form. The parent target relation from observed states to dP_dt is effectively governed by one shared vascular gain, so at fixed P it cannot express both a steep early vasoconstrictor effect and diminished marginal effect near high S. Varying condition: the coupled transient is observed from the prescribed initial condition while P and S evolve naturally, so different times along the trajectory sample different S levels; held fixed: posture, blood volume, metabolic demand, hormones, and the baroreflex command form. Observable contrast: under stronger hypotensive excursions that drive S toward its upper range, the child predicts flattening of the pressor benefit from further S increases, whereas the parent keeps adding resistance approximately linearly and therefore overstates late high-drive support if fitted to early low-drive behavior. This changes the scored target mapping dP_dt(P,S), not merely the auxiliary S trajectory, because the runoff denominator itself acquires different S-curvature. The effect is admissible whenever S reaches moderate to high values; if all data remain near a narrow low-S band, the refinement may be weakly identifiable, and in that restricted regime the parent is approximately recovered."
  },
