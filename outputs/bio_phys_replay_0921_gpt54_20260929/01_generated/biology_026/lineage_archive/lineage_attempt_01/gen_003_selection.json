{
  "plan": {
    "operation": "add_term",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "With filtration conditions fixed, E_G is a one-input monotone function of L_G with a single shared saturation scale sigma_G and capacity Tm_G for all observations.",
      "child_relation": "Allow excretion at a given filtered load to depend jointly on L_G and urine flow state via an added independent input that weakens effective tubular glucose reclamation, so the L_G-to-E_G curve shifts upward and steepens under higher flow even when Tm_G is unchanged.",
      "affected_inputs": [
        "L_G"
      ],
      "observable_effect": "At the same L_G, higher tubular/urine flow produces earlier and greater glucosuria; low-load excretion can remain near zero while intermediate-load excretion separates across flow conditions."
    },
    "diagnostic_groups": [
      {
        "name": "load_fraction",
        "expression": "L_G/Tm_G",
        "role": "how close filtered glucose delivery is to aggregate transport capacity"
      },
      {
        "name": "splay_ratio",
        "expression": "L_G/sigma_G",
        "role": "where the current rounded saturation transition is sampled"
      }
    ],
    "activation_condition": "Observable when an additional admissible flow-related condition is varied across experiments while nephron number remains fixed, especially for L_G on the order of sigma_G to Tm_G where reabsorptive reserve is partial rather than complete or exhausted.",
    "train_hidden_contrast": "Within training, variation of filtered load under at least two fixed flow conditions would show different glucosuria curves; in holdout, the same flow dependence persists and becomes more apparent in the intermediate-load regime where the parent's single curve cannot fit all conditions with one parameter set.",
    "continuation_path": "Recover the parent law when the added flow influence is absent or fixed to the reference condition so that reabsorptive efficiency no longer varies across observations.",
    "freedom_change": "add_input",
    "promoted_symbol": null,
    "promotion_reason": "The stated phenomenon currently fixes tubular flow conditions, so no existing symbol can encode a physiologically distinct flow-dependent modulation of reabsorption. A new independently sampled input is required for the changed target mapping to become observable.",
    "gap_statement": "The model omits known flow dependence of proximal tubular glucose reclamation, treating the transport environment as invariant so that only filtered load controls excretion.",
    "baseline_assumption": "The nephron population and filtration conditions are fixed; specifically, tubular flow conditions do not vary and therefore do not alter effective glucose reabsorption at a given filtered load.",
    "scientific_mechanism": "Variation in tubular flow or osmotic diuresis changes luminal transit and concentration gradients, reducing fractional glucose reabsorption before the nominal aggregate transport maximum is reached and thereby increasing urinary glucose excretion at the same filtered load.",
    "affected_symbols": [
      "L_G",
      "Tm_G",
      "sigma_G"
    ],
    "rationale": "Parent response: with all conditions held fixed, increasing L_G alone moves E_G along one shared monotone titration curve, with near-complete reabsorption at low load and progressive approach to capacity-limited excretion as load rises. Proposed refinement: vary an independent flow-related condition while holding nephron population and baseline filtration architecture fixed, and let that condition modulate tubular reclamation efficiency. Then the scored mapping itself changes, not merely an auxiliary trajectory: for the same observed L_G, E_G becomes larger under higher flow, with the contrast most visible at intermediate loads where some transport reserve remains. A single refitted parent parameter set cannot reproduce two systematically separated E_G-versus-L_G curves across flow conditions because it provides only one environment-independent mapping from L_G to E_G. The effect is scientifically admissible in diuretic or osmotic-flow perturbation regimes; if flow is truly fixed in all data, this mechanism cannot activate and should not be claimed."
  },
