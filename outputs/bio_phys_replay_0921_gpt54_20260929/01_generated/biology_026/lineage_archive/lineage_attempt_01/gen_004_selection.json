{
  "plan": {
    "operation": "change_assumption",
    "parent_shortcut": "fixed_environment",
    "response_change": {
      "type": "interaction_emergence",
      "parent_relation": "At fixed Q_G, excretion is an affine function of a single saturating reabsorption term 1 - exp(-L_G/sigma_G), so flow only rescales the same load-dependent saturation shape through a separable product Q_G*(1 - exp(-L_G/sigma_G)).",
      "child_relation": "Make the saturation-onset scale itself depend on flow condition, so Q_G changes not only the amplitude of reabsorptive weakening but also how early aggregate saturation develops with L_G.",
      "affected_inputs": [
        "L_G",
        "Q_G"
      ],
      "observable_effect": "Across low versus high Q_G, the glucosuria curve versus L_G separates earlier and with different onset curvature, not just by a proportional increase after the same characteristic load scale."
    },
    "diagnostic_groups": [
      {
        "name": "load_to_capacity",
        "expression": "L_G/Tm_G",
        "role": "filtered glucose challenge relative to aggregate transport capacity"
      },
      {
        "name": "rounded_saturation",
        "expression": "1 - exp(-L_G/sigma_G)",
        "role": "parent aggregate saturation progress variable"
      },
      {
        "name": "flow_load_interaction",
        "expression": "Q_G*L_G/sigma_G",
        "role": "regime where flow can shift apparent saturation onset"
      }
    ],
    "activation_condition": "Observable when Q_G spans a meaningful fraction of its admissible range and L_G is in the sub-saturating to near-saturating regime L_G ~ sigma_G, before excretion is trivially pinned near L_G - small reabsorption reserve.",
    "train_hidden_contrast": "In training, moderate Q_G already changes excretion at intermediate loads; in holdout with higher Q_G or broader L_G, the same mechanism predicts an earlier left-shift of glucosuria onset rather than only a larger vertical offset.",
    "continuation_path": "Recover the parent by taking the flow-dependence of the saturation scale to zero, so sigma_G is again constant across Q_G.",
    "freedom_change": "none",
    "promoted_symbol": null,
    "promotion_reason": "",
    "gap_statement": "The parent assumes tubular flow only weakens reabsorption through a separable multiplicative factor on a fixed population saturation curve, ignoring that altered transit/concentration conditions can also shift the apparent load scale at which aggregate saturation emerges.",
    "baseline_assumption": "Relax the assumption that one shared sigma_G governs the approach to saturation identically across all flow conditions.",
    "scientific_mechanism": "Higher tubular flow or osmotic diuresis can reduce contact time and modify luminal gradients, causing effective aggregate glucose reabsorptive saturation to appear at lower filtered loads as flow rises.",
    "affected_symbols": [
      "L_G",
      "sigma_G",
      "Q_G",
      "flow_sens_G"
    ],
    "rationale": "The parent already captures progressive saturation and a flow-related loss of reclamation, but it enforces one fixed saturation scale sigma_G for every Q_G. Vary L_G and Q_G while holding Tm_G, nephron population, and steady conditions fixed. Under the parent, changing Q_G only rescales the same rounded load-response shape because the only interaction is separable in Q_G and the parent saturation progress variable. A realistic refinement is that higher Q_G shifts the apparent onset of aggregate saturation to lower L_G, changing curvature and local slope of E_G(L_G) at intermediate loads. This is scientifically admissible when flow variation is large enough to alter transit time or concentration gradients yet not so extreme that assumptions of steady accounting fail. The contrast is in the scored mapping itself: for the same L_G, high Q_G can produce earlier glucosuria onset and a different bend location, not merely a larger excretion increment after refitting one shared parameter set. A single parent parameter set cannot reproduce both unchanged bend location and flow-dependent left-shift across Q_G because sigma_G is fixed there; refitting flow_sens_G only changes amplitude of the same shape. Limitation: if sampled L_G values are all far below or far above sigma_G, the shifted onset would be hard to observe."
  },
